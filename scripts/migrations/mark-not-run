#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

# Forget that a migration ran, so the next build applies it again.
#
#   scripts/migrations/mark-not-run 20260731_add_thing
#
# Was written against Postgres and never updated when the store became SQLite, so it
# reached for psql (not installed) via DARK_CONFIG_DB_DBNAME (not a variable we set,
# which under `set -u` meant it couldn't even get that far).

if [[ "$#" -ne 1 ]]; then
  echo "usage: $0 <migration name, or any unique part of it>" >&2
  exit 1
fi

NAME="$1"
DB="${DARK_CONFIG_RUNDIR}/${DARK_CONFIG_DB_NAME:-data.db}"

if [[ ! -f "$DB" ]]; then
  echo "No database at $DB. Run: scripts/dev/build" >&2
  exit 1
fi

matches=$(sqlite3 "$DB" \
  "SELECT name FROM system_migrations_v0 WHERE name LIKE '%${NAME}%';")

if [[ -z "$matches" ]]; then
  echo "No migration recorded as run matching '${NAME}'." >&2
  exit 1
fi

sqlite3 "$DB" "DELETE FROM system_migrations_v0 WHERE name LIKE '%${NAME}%';"

echo "Marked not-run:"
while IFS= read -r m; do echo "    $m"; done <<< "$matches"
echo "They'll be applied again by the next scripts/dev/build."
