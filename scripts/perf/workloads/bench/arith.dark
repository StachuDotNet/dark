// Arithmetic: builtin-call heavy, deep recursion. A deliberately different shape from `steady`,
// since the two disagree substantially on per-Apply cost.
//
// Staged into `rundir/perf-workloads/` by `scripts/perf/bench`, which is also the only thing that
// runs it. An A/B runs this source against an OLDER published binary too, so it calls only Dark
// wrappers, whose names outlive the builtins under them: the raw `Builtin.` calls it used to make had
// both been renamed or removed by the time anyone ran it again.
let hot (n: Int) (acc: Int) : Int =
  if n <= 0 then
    acc
  else
    let a = acc + 1
    let b = a + 2
    let c = b + 3
    let d = c + 4
    let e = d + 5
    hot (n - 1) e

let _warm = hot 200 0
let _reset = Darklang.LanguageTools.InterpreterStats.reset ()
let t0 = Stdlib.DateTime.__monotonicMilliseconds ()
let result = hot 4000 0
let t1 = Stdlib.DateTime.__monotonicMilliseconds ()
Stdlib.printLine ("elapsed_ms=" + (Stdlib.toString (t1 - t0)) + " stats=" + (Darklang.LanguageTools.InterpreterStats.get ()))
