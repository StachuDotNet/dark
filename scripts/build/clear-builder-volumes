#!/usr/bin/env bash

# Remove the docker volumes the dev containers use, so the next start rebuilds from
# scratch. Run from the host, with the containers stopped.
#
#   scripts/build/clear-builder-volumes           this clone's build volume
#   scripts/build/clear-builder-volumes --all     every clone's, plus the caches
#
# It used to remove a volume called `dark_build`. Build output has been per-clone
# since the container-picker fix, as `dark_build_<clone>`, so that removed a leftover
# from the old scheme, none of the volumes actually in use, and then aborted on the
# first name that no longer existed.

set -euo pipefail

case "${1:-}" in
  -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --all|"") ;;
  *) echo "Unknown flag: $1. Try --help" >&2; exit 1 ;;
esac

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )"/../.. && pwd )"

remove() {
  local v
  for v in "$@"; do
    if docker volume rm "$v" > /dev/null 2>&1; then
      echo "removed $v"
    else
      echo "skipped $v (in use by a running container, or not there)"
    fi
  done
}

if [[ "${1:-}" == "--all" ]]; then
  mapfile -t builds < <(docker volume ls --format '{{.Name}}' | grep '^dark_build' || true)
  remove "${builds[@]}" \
    dark_nuget \
    darklang-dark-extension-volume \
    darklang-dark-extension-volume-insiders
else
  # Matches devcontainer.json's `dark_build_${localWorkspaceFolderBasename}`.
  remove "dark_build_$(basename "$DIR")"
  echo
  echo "That's this clone only. For every clone's, plus the nuget and extension"
  echo "caches:  $0 --all"
fi
