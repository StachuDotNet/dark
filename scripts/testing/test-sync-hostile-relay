#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# The sync and branch clients, against a relay that answers badly.
#
# `test-relay-routes` checks the relay when the CLIENT misbehaves. This is the mirror, and it is the half
# that was wrong: a relay answering 200 with a body the client could not read got "Pushed N ops (0 new)",
# after which the push was RECORDED as done. Point the client at a working relay afterwards and it says
# "Already up to date" while your work is not there, and never asks again. Open item 45.
#
# What is asserted, in order of how much it would cost to get wrong:
#
#   1. An unreadable reply must not be reported as a completed push, and must not record one. This is the
#      data-loss case: everything else here is a message being wrong.
#   2. Nothing crashes, hangs, or leaks an interpreter error, whatever the relay does.
#   3. What the relay LISTS is not trusted: branch ids that are not uuids never reach a URL (item 47).
#
# The relay is `fixtures/hostile-relay.py`, one failure mode per port.

set -euo pipefail

CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
WORK=rundir/hostile-relay-test
FIXTURE=scripts/testing/fixtures/hostile-relay.py

fail() { echo "FAIL: $1" >&2; exit 1; }

rm -rf "$WORK"; mkdir -p "$WORK"

MODES=(9081 9082 9084 9085)
EXTRA_MODES=(9087)
for m in "${MODES[@]}" "${EXTRA_MODES[@]}"; do
  python3 "$FIXTURE" "$m" >/dev/null 2>&1 &
done
trap 'pkill -f "$FIXTURE" 2>/dev/null || true' EXIT
sleep 2

client() {  # client <name> -> echoes its rundir
  local name="$1"
  local dir="$PWD/$WORK/$name"
  rm -rf "$dir"; mkdir -p "$dir"
  cp rundir/data.db "$dir/data.db"
  sqlite3 "$dir/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true
  DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" identity "$name" >/dev/null 2>&1
  echo "$dir"
}

clean_output() { sed 's/\x1b\[[0-9;]*m//g'; }

for m in "${MODES[@]}"; do
  dir=$(client "c$m")
  DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" fn "/Hostile.T.f$m" '() : Int64 = 1L' >/dev/null 2>&1

  out=$(timeout 60 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" sync "http://localhost:$m" 2>&1 | clean_output || true)

  grep -qE "Encountered a Runtime Error|No matching case found|but got [A-Za-z]+|Call stack" <<<"$out" \
    && fail "sync against relay mode $m crashed"

  # 1. The data-loss case. A push may only be recorded when the relay confirmed it. What the client
  #    records is the set of ops the relay holds (`sync_pushed`); a row here for a relay that never
  #    confirmed anything means the next push skips work the relay does not have.
  recorded=$(sqlite3 "$dir/data.db" "SELECT count(*) FROM sync_pushed WHERE relay = 'http://localhost:$m';" 2>/dev/null || echo 0)
  if [[ "$recorded" != "0" ]]; then
    fail "relay mode $m did not confirm the push, but the client recorded $recorded op(s) as held (work would be lost)"
  fi
  echo "  ok   mode $m: no crash, and no push recorded without a confirmation"
done

# 3. A relay that lists junk instead of branch ids: the junk must not reach a URL or the terminal.
dir=$(client "cbranch")
out=$(timeout 60 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" branch pull "http://localhost:9081" 2>&1 | clean_output || true)
grep -q "are not branch ids" <<<"$out" || fail "a junk branch list was not rejected"
grep -q "count" <<<"$out" && fail "the relay's junk was echoed back into the output"
echo "  ok   a junk branch list is rejected without echoing it"

# 4. A cursor that points past ops the local log no longer has.
#
#    The relay-instance check catches a relay REPLACED at an address. It cannot catch this: the relay is
#    the same one, and the client's own log lost ops sitting BEHIND its cursor (a rebuild rewrites main's
#    log; the cursor is not part of it). The client then asks for nothing past the cursor, gets nothing,
#    and reports success forever while `sync status` says it is thousands of ops behind. Seen for real on
#    a store holding 28k ops against a relay holding 201k, where the documented remedy changed nothing.
dir=$(client "cstale")
sqlite3 "$dir/data.db" \
  "INSERT OR REPLACE INTO config_v0 (key, value) VALUES
     ('sync.cursor.http://localhost:9087', '500'),
     ('sync.relay-instance.http://localhost:9087', 'inst-hostile-9087');" 2>/dev/null || true

out=$(timeout 60 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" pull "http://localhost:9087" 2>&1 | clean_output || true)
grep -q "points past ops this store doesn't have" <<<"$out" \
  || fail "a cursor past missing ops did not rewind (client would pull zero forever)"
echo "  ok   a cursor past ops this store lost rewinds instead of pulling zero forever"


# 5. A relay that restarts under a pull. Page 1 lands; page 2's connection drops. The client must not
#    record the relay's position off that pull (it would skip the un-pulled ops for good), and the next
#    pull must pick up where the last page landed.
python3 "$FIXTURE" 9088 >/dev/null 2>&1 &
sleep 1
dir=$(client "crestart")
out=$(timeout 120 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" pull "http://localhost:9088" 2>&1 | clean_output || true)
grep -q "a page didn't land" <<<"$out" \
  || fail "a pull that lost page 2 did not say so; got: $out"
seen=$(sqlite3 "$dir/data.db" "SELECT count(*) FROM config_v0 WHERE key = 'sync.head.http://localhost:9088';" 2>/dev/null || echo 0)
[[ "$seen" == "0" ]] || fail "the relay's position was recorded off a pull that lost a page"
out=$(timeout 120 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" pull "http://localhost:9088" 2>&1 | clean_output || true)
grep -qE "^Pulled|^Nothing new" <<<"$out" \
  || fail "the pull after the relay came back did not finish; got: $out"
echo "  ok   a relay that dies mid-pull: position not recorded, and the next pull finishes"

# 6. A peer that upgraded before you did. The refusal has to name BOTH versions, the one the bundle
#    claims and the one this build speaks, or the person cannot tell which side to upgrade.
python3 "$FIXTURE" 9089 >/dev/null 2>&1 &
sleep 1
dir=$(client "cfuture")
out=$(timeout 120 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" pull "http://localhost:9089" 2>&1 | clean_output || true)
grep -q "sync format v99 not understood by this build, which speaks v" <<<"$out" \
  || fail "a bundle from a newer format was not refused naming both versions; got: $out"
grep -qE "Encountered a Runtime Error|No matching case found|Call stack" <<<"$out" \
  && fail "a bundle from a newer format crashed the client"
echo "  ok   a peer on a newer wire format is refused, naming both versions"

# 2. A relay that never answers: the client must give up rather than wedge.
#
#    `sync status` rather than `sync`, deliberately. A full sync makes four requests in sequence and the
#    per-request timeout is 30s, so it reports correctly after about two minutes -- I measured 123s and
#    briefly read that as a hang, which it is not. One request proves the timeout works and costs a
#    quarter as much, and a gate that takes two minutes to say something it could say in thirty seconds
#    is a gate people start skipping.
python3 "$FIXTURE" 9086 >/dev/null 2>&1 &
sleep 1
dir=$(client "chang")
start=$(date +%s)
out=$(timeout 120 env DARK_CONFIG_RUNDIR="$dir" "$PWD/$CLI" sync status "http://localhost:9086" 2>&1 | clean_output || true)
elapsed=$(( $(date +%s) - start ))

[[ "$elapsed" -ge 115 ]] && fail "a relay that never answers wedged the client (still going after ${elapsed}s)"
grep -qE "timeout|timed out|failed" <<<"$out" \
  || fail "a relay that never answers did not produce a failure message; got: $out"
echo "  ok   a relay that never answers: gave up after ${elapsed}s and said so"

echo "sync + branch clients: a relay that answers badly cannot make them claim, or record, a push."
