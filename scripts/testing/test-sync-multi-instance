#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# Sync, with more than two parties and more than one shape of work.
#
# The other sync gates cover one client against a relay that behaves (`test-setup`) or misbehaves
# (`test-sync-hostile-relay`). Neither says anything about what this substrate is FOR: several instances,
# several branches, several agents working at once, and work moving between them.
#
# Every scenario here is isolated -- its own relay, its own port, its own stores -- because the first
# version of this shared one store across scenarios and spent two rounds blaming the product for state
# an earlier scenario had left behind. Isolation is the point, not an implementation detail.
#
# What it covers, in order: a round trip; two instances authoring at once; idempotence; the write secret
# never reaching an op; a divergent edit recorded as a conflict on both sides with the same resolution;
# a branch pushed from one instance, pulled by another, merged, and reaching a third; a branch EDITED
# several times and read back on both sides; a review queue
# staging work inert until approved; and four agents on four branches merged into one main.

set -uo pipefail

CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
ROOT=rundir/sync-multi
SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
# Our own port, and nothing else on it. A relay left over from an earlier run answers on the port you
# expected with a secret you have forgotten, and every push comes back 401 as if the product were broken.
PORT=$(( 9200 + RANDOM % 300 ))
pass=0; fail=0

# No pkill. This used to `pkill -9 -f Matter.router`, which kills every relay in the container
# including one a developer is running by hand in tmux to poke at `/m`. The problem it was for --
# a leftover relay answering on the port we wanted with a secret we had forgotten -- is what the
# random port above solves, and this gate traps its own $RPID on the way out. Check the port instead.
if command -v ss > /dev/null && ss -ltn 2>/dev/null | grep -q ":$PORT "; then
  echo "port $PORT is already in use; re-run (the port is random per run)" >&2
  exit 2
fi

rm -rf "$ROOT"; mkdir -p "$ROOT"
ok()   { pass=$((pass+1)); printf '  ok   %s\n' "$1"; }
bad()  { fail=$((fail+1)); printf '  FAIL %s\n       got: %s\n' "$1" "$(head -c 150 <<<"$2" | tr '\n' ' ')"; }
# Case-sensitive and anchored: `-i` let "Pushed" match "nothing new to push", "merged" match "not
# merged", and "conflict" match "Conflict detection did not run", so a refusal read as a pass.
want() { if grep -qE "$2" <<<"$3"; then ok "$1"; else bad "$1" "$3"; fi; }
wantnot() { if grep -qE "$2" <<<"$3"; then bad "$1" "$3"; else ok "$1"; fi; }

# An instance is a STORE plus a HOME: the capability grant is keyed on HOME, so sharing one would let
# these tread on the developer's own grant.
mk() { local n=$1; mkdir -p "$ROOT/$n/home"; scripts/testing/_copy-store "$ROOT/$n/data.db"
       sqlite3 "$ROOT/$n/data.db" 'DELETE FROM config_v0;'; rm -f "$ROOT/$n/cli-config.json"; }
x()  { local n=$1; shift; DARK_CONFIG_RUNDIR="$PWD/$ROOT/$n" HOME="$PWD/$ROOT/$n/home" "$PWD/$CLI" "$@" 2>&1 | sed 's/\x1b\[[0-9;]*m//g'; }

mk relay; mk A; mk B; mk C; mk D
DARK_CONFIG_RUNDIR="$PWD/$ROOT/relay" HOME="$PWD/$ROOT/relay/home" DARK_MATTER_WRITE_SECRET="$SECRET" \
  "$PWD/$CLI" serve Darklang.Matter.router --port "$PORT" > "$ROOT/relay/log" 2>&1 &
RPID=$!
trap 'kill $RPID 2>/dev/null' EXIT
sleep 8
kill -0 $RPID 2>/dev/null || { echo "the relay we started is not running"; exit 2; }
want "the relay answers" "^200$" "$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$PORT/ping")"
for i in A B C D; do x $i connect "http://localhost:$PORT" --secret "$SECRET" > /dev/null; done
x B pull > /dev/null; x C pull > /dev/null

echo "== a round trip"
x A fn /SM.T.one '() : Int64 = 41L' > /dev/null; x A commit "A's work" -y > /dev/null
want "A pushes" "^Pushed [1-9][0-9]* ops" "$(x A push)"
want "B pulls" "^Pulled [1-9][0-9]* new op" "$(x B pull)"
want "B runs it" "^41$" "$(x B eval 'SM.T.one ()' | tail -1)"

echo "== two instances authoring at the same time"
( x A fn /SM.T.a '() : Int64 = 1L' > /dev/null; x A commit "A" -y > /dev/null; x A push > "$ROOT/a.log" 2>&1 ) & PA=$!
( x B fn /SM.T.b '() : Int64 = 2L' > /dev/null; x B commit "B" -y > /dev/null; x B push > "$ROOT/b.log" 2>&1 ) & PB=$!
wait $PA $PB   # named: the relay is a background job too, and it never exits
want "A's push landed" "^Pushed [1-9][0-9]* ops" "$(cat "$ROOT/a.log")"
want "B's push landed" "^Pushed [1-9][0-9]* ops" "$(cat "$ROOT/b.log")"
x C pull > /dev/null
want "C sees A's" "^1$" "$(x C eval 'SM.T.a ()' | tail -1)"
want "C sees B's" "^2$" "$(x C eval 'SM.T.b ()' | tail -1)"

echo "== idempotence, and the secret"
want "re-push is a no-op" "^Already up to date with .* nothing new to push\.$" "$(x A push)"
want "re-pull is a no-op" "^Nothing new at " "$(x C pull)"
HEX=$(echo -n "$SECRET" | od -An -tx1 | tr -d ' \n' | tr 'a-f' 'A-F')
want "no op carries the write secret" "^0$" "$(sqlite3 "$ROOT/relay/data.db" "SELECT count(*) FROM package_ops WHERE hex(op_blob) LIKE '%$HEX%';")"

echo "== a divergent edit, each side pulling before it pushes"
x A fn /SM.T.same '() : Int64 = 100L' > /dev/null; x A commit "A version" -y > /dev/null; x A push > /dev/null
x B fn /SM.T.same '() : Int64 = 200L' > /dev/null; x B commit "B version" -y > /dev/null
want "B's pull records the divergence" "^1 conflict\(s\) auto-resolved by recency" "$(x B pull)"
x B push > /dev/null
want "A's pull applies it" "^Pulled [1-9][0-9]* new op" "$(x A pull)"
# Only B diverged: it held work it had not pushed when A's version arrived. A had already pushed, so
# from A's side one party moved since the agreed base, which is an update rather than a conflict. That
# asymmetry is the model, not a gap -- but it means "both push before either pulls" resolves by recency
# with nothing filed anywhere, which is worth knowing before you rely on the record.
bconf=$(x B conflicts --json)
# The JSON files a conflict as owner / modules / name, not as one dotted string, so this looks for the
# fields rather than the name a person would type.
want "B filed it against the name" '"name":"same".*"status":"pending"' "$bconf"
bres=$(sed -n 's/.*"autoResolvedTo":"\([0-9a-f]*\)".*/\1/p' <<<"$bconf" | head -1)
if [[ -n "$bres" ]]; then ok "and recorded which version won"; else bad "recorded which version won" "$bconf"; fi
# B authored `same` after A, so recency makes B's 200 the winner on both sides: asserted on the VALUE,
# not on the two agreeing, which they would also do by both being wrong.
want "A means the later edit" "^200$" "$(x A eval 'SM.T.same ()' | tail -1)"
want "and so does B" "^200$" "$(x B eval 'SM.T.same ()' | tail -1)"
# Override to the side that CHANGES something: on B the local side (A in the listing) is the 200 the
# fold kept, so B, the incoming side, is A's 100. Overriding to the kept side exercised the
# nothing-to-do arm, and the old pattern matched "override failed:" too.
want "an override is non-interactive" "^overrode #[0-9a-f]{8}: SM\.T\.same now binds [0-9a-f]{8}" "$(x B conflicts override SM.T.same B)"
want "and it took effect" "^100$" "$(x B eval 'SM.T.same ()' | tail -1)"

echo "== a branch, pushed from one instance and merged on another"
x A branch create feat > /dev/null
x A --branch feat fn /SM.T.onFeat '() : Int64 = 77L' > /dev/null
x A --branch feat commit "feat work" -y > /dev/null
want "A pushes the branch" "^pushed branch \"feat\" to " "$(x A branch push feat)"
AID=$(x A whoami | sed 's/.*: //' | tr -d ' ')
want "B pulls A's branches" "^imported branch \"feat\" \([1-9][0-9]* op\(s\)\)" "$(x B branch pull --from "$AID")"
want "B has it" "^feat \([0-9a-f]{8}\) <- main" "$(x B branches)"
# The control first (the name exists and eval works), then the exact refusal on main.
want "B runs it on the branch" "^77$" "$(x B --branch feat eval 'SM.T.onFeat ()' | tail -1)"
want "and B's main does not" "^Error: SM\.T\.onFeat not found$" "$(x B eval 'SM.T.onFeat ()' | tail -1)"
want "B merges it" "^Merged [1-9][0-9]* op\(s\) from branch \"feat\" into its parent\.$" "$(x B --branch feat merge feat)"
x B push > /dev/null; x C pull > /dev/null
want "C gets it on main" "^77$" "$(x C eval 'SM.T.onFeat ()' | tail -1)"

echo "== merged work reaches the relay when main was pushed in between"
# A branch op's rowid is minted when it is AUTHORED. Push main after that and any rowid cursor has
# stepped past it; the merge then flips it effective below the cursor, and a cursor-based push
# never sent it. The push has to ask what the relay HOLDS, not where it last stopped.
x A switch main > /dev/null  # A is still standing on feat, and a branch created there is feat's child
x A branch create late > /dev/null
x A --branch late fn /SM.T.late '() : Int64 = 88L' > /dev/null
x A --branch late commit "late work" -y > /dev/null
x A switch main > /dev/null
x A fn /SM.T.meanwhile '() : Int64 = 1L' > /dev/null; x A commit "meanwhile" -y > /dev/null
want "A pushes main in between" "^Pushed [1-9]" "$(x A push)"
want "A merges the branch" "^Merged [1-9]" "$(x A --branch late merge late)"
want "and the merge has something to push" "^Pushed [1-9]" "$(x A push)"
x C pull > /dev/null
want "C gets the merged work on main" "^88$" "$(x C eval 'SM.T.late ()' | tail -1)"

echo "== a review queue stages work inert until it is approved"
# D, which has never pulled: `pull` and `review pull` share ONE cursor per relay, so an instance that has
# already applied these ops can never stage them afterwards.

# FIRST, from a COLD cursor, which is a coworker's day one. An op pushed now sits past the first PAGE of
# a cursor at zero, because the shipped baseline alone is seven pages. `review pull` used to ask for one
# page and stop, so it staged nothing and answered "Nothing new to stage" -- indistinguishable from being
# up to date, while a plain `dark pull` would then apply the same ops without review.
#
# This block used to be ordered the other way round, with `x D pull` first, which drained every page and
# left the next op on page 1. That hid the bug: the gate was passing because it had worked around it.
x A switch main > /dev/null
x A fn /SM.T.coldstaged '() : Int64 = 66L' > /dev/null
x A commit "cold review" -y > /dev/null
x A push > /dev/null
want "a cold instance stages what sits past page 1" "^Staged [1-9][0-9]* op\(s\) from .* on branch \"review\"" "$(x D review pull)"
want "D evaluates at all" "^3$" "$(x D eval 'Stdlib.Int64.add 1L 2L' | tail -1)"
want "and it stays inert on main" "^Error: SM\.T\.coldstaged not found$" "$(x D eval 'SM.T.coldstaged ()' | tail -1)"
want "approving the cold queue lands it" "^Approved [1-9][0-9]* op\(s\) from \"review\" into main\.$" "$(x D review approve)"
want "and then main has it" "^66$" "$(x D eval 'SM.T.coldstaged ()' | tail -1)"

# Now the warm case: D is caught up, and the next push lands on the first page it asks for.
x D pull > /dev/null
x A switch main > /dev/null
x A fn /SM.T.staged '() : Int64 = 55L' > /dev/null; x A commit "for review" -y > /dev/null; x A push > /dev/null
echo "     [D cursor=$(sqlite3 "$ROOT/D/data.db" "SELECT value FROM config_v0 WHERE key LIKE 'sync.cursor%';") relay ops=$(sqlite3 "$ROOT/relay/data.db" 'SELECT count(*) FROM package_ops;') D ops=$(sqlite3 "$ROOT/D/data.db" 'SELECT count(*) FROM package_ops;')]"
want "D stages rather than applies" "^Staged [1-9][0-9]* op\(s\) from .* on branch \"review\"" "$(x D review pull)"
want "it does resolve on the queue's branch" "^55$" "$(x D --branch review eval 'SM.T.staged ()' | tail -1)"
want "it does not resolve on main" "^Error: SM\.T\.staged not found$" "$(x D eval 'SM.T.staged ()' | tail -1)"
want "D approves" "^Approved [1-9][0-9]* op\(s\) from \"review\" into main\.$" "$(x D review approve)"
want "and now main has it" "^55$" "$(x D eval 'SM.T.staged ()' | tail -1)"

echo "== four agents at once, each on its own branch"
AG=()
for n in 1 2 3 4; do
  ( x A branch create agent-$n > /dev/null 2>&1
    x A --branch agent-$n fn "/SM.Agents.a$n" "() : Int64 = ${n}0L" > /dev/null 2>&1
    x A --branch agent-$n commit "agent $n" -y > /dev/null 2>&1 ) &
  AG+=($!)
done
wait "${AG[@]}"
allok=true
for n in 1 2 3 4; do [[ "$(x A --branch agent-$n eval "SM.Agents.a$n ()" | tail -1)" == "${n}0" ]] || allok=false; done
if $allok; then ok "each agent's work is on its own branch"; else bad "each agent's work is on its own branch" "see above"; fi
for n in 1 2 3 4; do x A --branch agent-$n merge agent-$n > /dev/null 2>&1; done
x A switch main > /dev/null
allok=true
for n in 1 2 3 4; do [[ "$(x A eval "SM.Agents.a$n ()" | tail -1)" == "${n}0" ]] || allok=false; done
if $allok; then ok "all four merged into main intact"; else bad "all four merged into main intact" "see above"; fi
x A switch main > /dev/null
echo "     [A push: $(x A push | tail -1)]"
echo "     [C pull: $(x C pull | tail -1)]"
echo "     [A ops=$(sqlite3 "$ROOT/A/data.db" 'SELECT count(*) FROM package_ops;') relay=$(sqlite3 "$ROOT/relay/data.db" 'SELECT count(*) FROM package_ops;') C=$(sqlite3 "$ROOT/C/data.db" 'SELECT count(*) FROM package_ops;')]"
allok=true
for n in 1 2 3 4; do [[ "$(x C eval "SM.Agents.a$n ()" | tail -1)" == "${n}0" ]] || allok=false; done
if $allok; then ok "and another instance received all four"; else bad "another instance received all four" "see above"; fi

echo "== a branch EDITED several times, and what the other instance sees"
# One version per name is the easy case, and it was the only one covered. Three is where a branch
# overlay can disagree with itself: the name is bound three times, and anything that folds those ops by
# hash rather than by what the name currently binds picks an arbitrary one. `view` did exactly that and
# showed a different version than `eval` ran.
x A branch create edited > /dev/null
for v in 1 2 3; do
  x A --branch edited fn /SM.T.edited "() : Int64 = ${v}0L" > /dev/null
done
x A --branch edited commit "three versions" -y > /dev/null

want "A runs the newest" "^30$" "$(x A --branch edited eval 'SM.T.edited ()' | tail -1)"
want "and A SHOWS the newest" "^  30L$" "$(x A --branch edited view SM.T.edited)"

want "A pushes the branch" "^pushed branch \"edited\" to " "$(x A branch push edited)"
want "B pulls it" "^imported branch \"edited\" \([1-9][0-9]* op\(s\)\)" "$(x B branch pull --from "$AID")"
want "B runs the newest" "^30$" "$(x B --branch edited eval 'SM.T.edited ()' | tail -1)"
want "and B SHOWS the newest" "^  30L$" "$(x B --branch edited view SM.T.edited)"

x B --branch edited merge edited > /dev/null
want "merged into main, still the newest" "^30$" "$(x B eval 'SM.T.edited ()' | tail -1)"

echo "== a deprecation travels"
# Deprecation keys on CONTENT, not on a name, so it should apply on the other instance to the same hash
# under whatever that instance calls it. Nothing covered that it crosses the wire at all.
# The scenario above leaves A on a branch, and this one is about main.
x A switch main > /dev/null
x A fn /SM.T.old '() : Int64 = 5L' > /dev/null
x A commit "something to deprecate" -y > /dev/null
x A push > /dev/null; x B pull > /dev/null
want "B has it before" "^5$" "$(x B eval 'SM.T.old ()' | tail -1)"
bview=$(x B view SM.T.old)
want "B shows the definition" "^let old \(\)" "$bview"
wantnot "and does not call it deprecated" "DEPRECATED" "$bview"

x A deprecate fn SM.T.old --kind obsolete -m "moved on" --yes > /dev/null
x A commit "deprecate it" -y > /dev/null
want "A shows it deprecated" "DEPRECATED \(obsolete\)" "$(x A view SM.T.old)"
want "A pushes the deprecation" "^Pushed 1 ops" "$(x A push)"
want "B pulls it" "^Pulled 1 new op" "$(x B pull)"
want "and B shows it deprecated too" "DEPRECATED \(obsolete\)" "$(x B view SM.T.old)"
want "with the reason" "^   moved on$" "$(x B view SM.T.old)"

echo "== finishing a branch travels, so the other machine stops showing it as live work"
# Merging and archiving each author an op for exactly this reason: the projections are already updated
# locally, and the op is how the OTHER instance learns. Without it a colleague's branch list keeps
# offering work that is already in main, or a branch someone threw away.
x A switch main > /dev/null
x A branch create finished > /dev/null
x A --branch finished fn /SM.T.finished '() : Int64 = 3L' > /dev/null
x A --branch finished commit "work to finish" -y > /dev/null
x A branch push finished > /dev/null
x B branch pull --from "$AID" > /dev/null
want "B sees the branch as live" "^finished \([0-9a-f]{8}\) <- main  \[[1-9][0-9]* op" "$(x B branches)"

x A --branch finished merge finished > /dev/null
x A switch main > /dev/null
x A push > /dev/null
x B pull > /dev/null
want "B has the work on main now" "^3$" "$(x B eval 'SM.T.finished ()' | tail -1)"
blist=$(x B branches)
want "B's listing rendered" "^on main\. branches:" "$blist"
wantnot "and finished is not among them" "^finished \(" "$blist"
want "though it is still there when asked for all" "^finished \([0-9a-f]{8}\) <- main  \[merged\]$" "$(x B branches --all)"
# The relay still serves the bundle. Pulling it again must not revive a branch B has merged.
want "a re-pulled bundle does not revive a merged branch" "already merged here" "$(x B branch pull --from "$AID")"
wantnot "and it stays off the live list" "^finished \(" "$(x B branches)"

echo
echo "passed: $pass   failed: $fail"
[[ "$fail" -eq 0 ]]
