#!/usr/bin/env bash
# Check the boundary `dark agent run` draws, against a throwaway install.
#
#   scripts/testing/check-agent-sandbox <dark-binary>
#
# Inside the sandbox: the policy cannot be written or replaced, the binary cannot be written or
# moved, nested user namespaces are refused, the store can still be written, and
# `dark permissions allow` writes a request rather than a grant. Outside: the request can be
# approved, and a policy file edited by hand is noticed.
#
# Then the store, which the sandbox must leave writable: an agent rewrites the CLI's own entry
# function and the network and scheduling settings in it, and outside, the rewritten code does
# not run and the settings do not take effect. A debug build embeds no digests of its code, so
# with one (DARK_CHECK_STORE set) the rewritten code runs and that check says it skipped.
#
# Last, an impl the agent saves for a type the build already ships one for (`ToString for
# Int64`): outside, calls run the shipped one, and dark says once that the agent's does not run.
# A debug build ships nothing, so with one the agent's runs and that check says it skipped.
#
# Needs bubblewrap and unprivileged user namespaces, so it runs on a host, not in the dev
# container (Docker's AppArmor profile refuses bwrap's mounts). Exits 77 when bwrap cannot start
# here, 1 when a check fails, 0 when all pass. `Tests.AgentSandbox` runs it when it can.

set -euo pipefail

CLI="$(realpath "${1:?usage: $0 <dark-binary>}")"
# Not under /tmp: the sandbox has a /tmp of its own, and the files staged here must be visible in it.
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
WORK="$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/dark-agent-check-XXXXXX")"
trap 'chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"' EXIT

if ! bwrap --unshare-user --disable-userns --ro-bind / / --proc /proc true 2>/dev/null; then
  echo "skip: bwrap cannot start a sandbox here"
  exit 77
fi

# A copy of a live (WAL) store, through SQLite rather than cp. Python's, so no sqlite3 binary is needed.
copy_store() {
  python3 -c 'import sqlite3, sys; sqlite3.connect(sys.argv[1]).backup(sqlite3.connect(sys.argv[2]))' "$1" "$2"
}

failures=0
pass() { echo "ok    $1"; }
fail() { echo "FAIL  $1"; failures=$((failures + 1)); }

# A throwaway install of its own. A debug build has no store inside it, so give it a copy of
# DARK_CHECK_STORE when that is set.
export HOME="$WORK/home"
export DARK_CONFIG_TELEMETRY_EXPORTER=none
mkdir -p "$HOME/.darklang" "$WORK/project"
if [[ -n "${DARK_CHECK_STORE:-}" ]]; then
  export DARK_CONFIG_DB_NAME=data.db
  copy_store "$DARK_CHECK_STORE" "$HOME/.darklang/data.db"
fi
cd "$WORK/project"
dark() { "$CLI" "$@"; }
inside() { dark agent run sh -c "$1"; }

dark permissions list > /dev/null
POLICY="$HOME/.darklang/policy"
before="$(sha256sum "$POLICY/policies.bin")"

# A widened policy from another install: the obvious way around `dark` for an agent.
OTHER="$WORK/other"
mkdir -p "$OTHER/.darklang"
if [[ -n "${DARK_CHECK_STORE:-}" ]]; then
  copy_store "$DARK_CHECK_STORE" "$OTHER/.darklang/data.db"
fi
HOME="$OTHER" "$CLI" permissions allow all > /dev/null
cp "$OTHER/.darklang/policy/policies.bin" "$WORK/widened.bin"

out="$(inside "
  cp '$WORK/widened.bin' '$POLICY/policies.bin' 2>/dev/null && echo policy-replaced
  cp '$WORK/widened.bin' '$POLICY/policies.written' 2>/dev/null && echo copy-replaced
  true >> '$POLICY/policies.bin' 2>/dev/null && echo policy-writable
  mv '$POLICY' '$POLICY.moved' 2>/dev/null && echo policy-dir-moved
  mv '$HOME/.darklang' '$HOME/.darklang.moved' 2>/dev/null && echo store-dir-moved
  true >> '$CLI' 2>/dev/null && echo binary-writable
  touch '$(dirname "$CLI")/agent-probe' 2>/dev/null && echo binary-dir-writable
  mv '$(dirname "$CLI")' '$(dirname "$CLI").moved' 2>/dev/null && echo binary-dir-moved
  unshare -Ur true 2>/dev/null && echo nested-userns
  touch '$HOME/.darklang/agent-probe' && echo store-writable
  touch '$WORK/project/agent-probe' && echo project-writable
  touch '$HOME/agent-probe' 2>/dev/null && echo home-writable
  true
" 2>&1)" || true

# Put back anything that moved, so a broken sandbox cannot break the next run.
[[ -d "$POLICY.moved" ]] && mv "$POLICY.moved" "$POLICY"
[[ -d "$HOME/.darklang.moved" ]] && mv "$HOME/.darklang.moved" "$HOME/.darklang"
[[ -d "$(dirname "$CLI").moved" ]] && mv "$(dirname "$CLI").moved" "$(dirname "$CLI")"
rm -f "$(dirname "$CLI")/agent-probe"

for bad in policy-replaced copy-replaced policy-writable policy-dir-moved store-dir-moved \
  binary-writable binary-dir-writable binary-dir-moved nested-userns home-writable; do
  if grep -qx "$bad" <<< "$out"; then fail "inside: $bad"; else pass "inside: not $bad"; fi
done
for good in store-writable project-writable; do
  if grep -qx "$good" <<< "$out"; then pass "inside: $good"; else fail "inside: not $good"; fi
done
if [[ "$(sha256sum "$POLICY/policies.bin")" == "$before" ]]; then
  pass "the policy file is unchanged"
else
  fail "the policy file changed"
fi

# The `dark permissions allow` path makes a request, not a grant.
asked="$(dark agent run "$CLI" permissions allow all --why 'the check asks' 2>&1)" || true
if grep -q "this is request" <<< "$asked"; then pass "inside: allow writes a request"; else fail "inside: allow said: $asked"; fi
if dark permissions list | grep -qx "all"; then fail "the request granted itself"; else pass "the request granted nothing"; fi
if dark status 2>&1 | grep -q "1 permission request waiting"; then pass "status shows the request"; else fail "status does not show the request"; fi

listed="$(dark permissions requests)"
id="$(awk '/dark permissions allow all/ {print $1; exit}' <<< "$listed")"
if [[ -n "$id" ]]; then pass "requests lists it"; else fail "requests does not list it: $listed"; fi
dark agent run "$CLI" permissions requests approve "$id" > /dev/null 2>&1 || true
if dark permissions list | grep -qx "all"; then fail "the sandbox answered its own request"; else pass "the sandbox cannot answer a request"; fi
dark permissions requests approve "$id" > /dev/null
if dark permissions list | grep -qx "all"; then pass "approving applies it"; else fail "approving did not apply it"; fi
if dark permissions log | grep -q "by dark permissions requests approve $id"; then
  pass "the log says it came from a request"
else
  fail "the log does not say how it was granted"
fi

# Outside the sandbox, a hand edit is noticed and does not take effect.
dark permissions clear > /dev/null
cp "$WORK/widened.bin" "$POLICY/policies.bin"
noticed="$(dark permissions list 2>&1)"
if grep -q "changed outside dark:.*allowed all" <<< "$noticed"; then pass "outside: a hand edit is noticed"; else fail "outside: a hand edit went unnoticed"; fi
if grep -qx "all" <<< "$noticed"; then fail "outside: the hand edit took effect"; else pass "outside: the hand edit does not take effect"; fi

# The store. An agent saves code there, and the CLI's own code and the person's settings sit
# beside it, so it rewrites both: the CLI's entry function gets the instructions of one it wrote,
# which leaves a mark when it runs, and the settings open the network guard and name its function
# as the scheduling policy.
dark permissions review undo > /dev/null 2>&1 || true
STORE="$HOME/.darklang/data.db"
cat > "$WORK/store.py" <<'EOF'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
def fn(owner, modules, name):
    return db.execute(
        "SELECT item_hash FROM locations WHERE owner = ? AND modules = ? AND name = ?"
        " AND item_type = 'fn' AND live = 1 ORDER BY rowid DESC LIMIT 1",
        (owner, modules, name)).fetchone()[0]
entry = fn("Darklang", "Cli", "executeCliCommand")
if sys.argv[2] == "save":
    row = db.execute("SELECT rt_instrs FROM package_functions WHERE hash = ?", (entry,)).fetchone()
    open(sys.argv[3], "wb").write(row[0])
elif sys.argv[2] == "restore":
    db.execute("UPDATE package_functions SET rt_instrs = ? WHERE hash = ?",
               (open(sys.argv[3], "rb").read(), entry))
else:
    evil = fn("Agent", "Evil", "run")
    db.execute("UPDATE package_functions SET rt_instrs ="
               " (SELECT rt_instrs FROM package_functions WHERE hash = ?) WHERE hash = ?",
               (evil, entry))
    for key, value in [("http.loopback", "on"), ("http.private", "on"),
                       ("exec.policy", "Agent.Evil.run")]:
        db.execute("INSERT OR REPLACE INTO config_v0 (key, value) VALUES (?, ?)", (key, value))
    print("tampered")
db.commit()
EOF
cat > "$WORK/evil.dark" <<EOF
let run(args: List<String>): Int64 =
  let _ = Darklang.Stdlib.Cli.File.writeText("$WORK/ran-as-the-person", "the agent's code")
  0
EOF
python3 "$WORK/store.py" "$STORE" save "$WORK/entry.bin"

out="$(inside "
  '$CLI' config set http.loopback on 2>&1
  '$CLI' fn /Agent.Evil.run - < '$WORK/evil.dark' > /dev/null 2>&1 && echo authored
  python3 '$WORK/store.py' '$STORE' tamper
" 2>&1)" || true
if grep -q "outside \`dark agent run\`" <<< "$out"; then pass "inside: config set http.loopback is refused"; else fail "inside: config set http.loopback said: $out"; fi
if grep -qx "tampered" <<< "$out" && grep -qx "authored" <<< "$out"; then
  pass "inside: the store can be rewritten"
else
  fail "inside: the store could not be rewritten: $out"
fi

refused="$(dark version 2>&1)" || true
if [[ ! -e "$WORK/ran-as-the-person" ]]; then
  pass "outside: the rewritten CLI code does not run"
  if grep -q "will not run the function Darklang.Cli.executeCliCommand" <<< "$refused"; then
    pass "outside: dark says which code it refused"
  else
    fail "outside: dark did not say why: $refused"
  fi
elif [[ -n "${DARK_CHECK_STORE:-}" ]]; then
  echo "skip  outside: a debug build embeds no digests to check its own code against"
  rm -f "$WORK/ran-as-the-person"
else
  fail "outside: the rewritten CLI code ran as the person"
fi

python3 "$WORK/store.py" "$STORE" restore "$WORK/entry.bin"
if dark version > /dev/null 2>&1; then pass "outside: with the row put back, dark runs"; else fail "outside: dark does not run with the row put back"; fi
for key in http.loopback http.private; do
  if dark config get "$key" 2>&1 | grep -q "= on"; then fail "outside: $key from the store took effect"; else pass "outside: $key from the store does not take effect"; fi
done
if dark config get exec.policy 2>&1 | grep -q "Agent.Evil"; then fail "outside: exec.policy from the store took effect"; else pass "outside: exec.policy from the store does not take effect"; fi
dark config set http.loopback on > /dev/null
if dark config get http.loopback 2>&1 | grep -q "= on"; then pass "outside: the person can still set http.loopback"; else fail "outside: config set http.loopback did not take"; fi

# A rival for a shipped impl. Saving it is allowed (it is ordinary code in the agent's own
# package); running it in place of the shipped one is not.
cat > "$WORK/rival.dark" <<'EOF'
impl ToString for Int64 =
  let toString(i: Int64): String = "the agent's"
EOF
out="$(inside "'$CLI' impl Agent.Evil '$WORK/rival.dark' > /dev/null 2>&1 && echo authored" 2>&1)" || true
if grep -qx "authored" <<< "$out"; then pass "inside: a rival for a shipped impl can be saved"; else fail "inside: the rival impl was not saved: $out"; fi

said="$(dark eval 'Stdlib.toString(5)' 2> "$WORK/rival.err")" || true
told="$(grep -c "ToString for Int64: dark runs the impl it ships, not Agent.Evil.Int64.ToString" "$WORK/rival.err" || true)"
if [[ "$said" == "5" ]]; then
  pass "outside: a call runs the shipped impl, not the newer one"
  if [[ "$told" == "1" ]]; then
    pass "outside: dark says once that the newer one does not run"
  else
    fail "outside: dark said it $told times: $(cat "$WORK/rival.err")"
  fi
elif [[ -n "${DARK_CHECK_STORE:-}" ]]; then
  echo "skip  outside: a debug build ships no impls to prefer"
else
  fail "outside: the call ran the agent's impl: $said"
fi
if dark impls ToString 2>&1 | grep "Agent.Evil.Int64.ToString" | grep -q "dark runs the implementation it ships"; then
  pass "outside: dark impls marks the newer one not used"
elif [[ -n "${DARK_CHECK_STORE:-}" ]]; then
  echo "skip  outside: a debug build ships no impls to mark"
else
  fail "outside: dark impls does not mark it: $(dark impls ToString 2>&1)"
fi

if [[ "$failures" -gt 0 ]]; then
  echo "$failures check(s) failed"
  exit 1
fi
echo "all checks passed"
