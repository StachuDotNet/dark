#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# The workbench's SCM surfaces, with actual work in the store.
#
# Four things have to reach the screen: the branch list, a branch's changed items, the commit list and
# the conflicts. Home summarises them and the Changes view lists the draft.
#
# `test-workbench.expect` only ever opens the workbench on an EMPTY store, where every section says some
# version of "nothing here" -- which asserts that the view renders, not that it can show anything. So:
# build a store with a draft, a commit, a branch and a recorded conflict, and check each one reaches the
# screen. Every row asserted on here comes from an SCM API, so it is the data path under test as much as
# the drawing.

set -euo pipefail

CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
WORK=rundir/workbench-scm-test

rm -rf "$WORK"
mkdir -p "$WORK"
# ALL the config, not just `current_branch`: a copy of the dev store inherits `sync.relay` and the write
# secret, so one sync-shaped command in here would reach the REAL relay. Note this makes the store look
# like a first run to the SETUP check, so no wizard blocks startup. The greeting is a separate question:
# it follows commits/changes/relay, so a store with work in it still greets "Welcome back".
scripts/testing/_copy-store "$WORK/data.db"
sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

export DARK_CONFIG_RUNDIR="$PWD/$WORK"

# a commit, for History
"$PWD/$CLI" fn /WbScm.T.base '() : Int64 = 1L' >/dev/null 2>&1
"$PWD/$CLI" commit "workbench scm fixture" -y >/dev/null 2>&1

# a branch that diverges from main on one name, so merging it RECORDS a conflict
"$PWD/$CLI" branch create wb-scm >/dev/null 2>&1
"$PWD/$CLI" --branch wb-scm fn /WbScm.T.base '() : Int64 = 222L' >/dev/null 2>&1
"$PWD/$CLI" --branch main fn /WbScm.T.base '() : Int64 = 111L' >/dev/null 2>&1
"$PWD/$CLI" --branch wb-scm merge wb-scm >/dev/null 2>&1

# and an uncommitted draft on main, for Changes
"$PWD/$CLI" switch main >/dev/null 2>&1
"$PWD/$CLI" fn /WbScm.T.draft '() : Int64 = 9L' >/dev/null 2>&1

expect "$PWD/scripts/testing/_workbench-scm.expect" "$PWD/$CLI" "$PWD/$WORK" || exit 1

# And a QUIET store: commits, no conflict, no draft. Home then selects a commit on open and renders its
# detail, which the fixture above never reaches because its conflict is selected first.
QUIET="$WORK-quiet"
rm -rf "$QUIET"; mkdir -p "$QUIET"
scripts/testing/_copy-store "$QUIET/data.db"
sqlite3 "$QUIET/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true
export DARK_CONFIG_RUNDIR="$PWD/$QUIET"
"$PWD/$CLI" fn /WbQuiet.T.only '() : Int64 = 1L' >/dev/null 2>&1
"$PWD/$CLI" commit "workbench quiet fixture" -y >/dev/null 2>&1
exec expect "$PWD/scripts/testing/_workbench-quiet.expect" "$PWD/$CLI" "$PWD/$QUIET"
