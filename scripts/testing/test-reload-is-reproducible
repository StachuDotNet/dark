#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"
# Two reloads of one tree must agree on every op id.
#
# The trap: the parser mints ephemeral node ids into every expression, so an Add op whose id hashes a
# serialization carrying them changes id on every reload -- every upgrade grows every store, and two
# machines authoring the same fn make two ops. Add ops are identified by content; this keeps it that way.
#
# Runs against its OWN rundir, never the shared dev store. A reload is a purge-and-refill: it wipes
# `conflicts`, `sync_bases` and the rest, and drops whatever draft was open. `test-gates-are-clean`
# cannot catch that: two reloads leave the same op and location COUNTS behind, and counts are what the
# fingerprint compares. Main's ops only: a branch's ops are whatever the developer has on their branches.
set -euo pipefail

WORK=rundir/reload-reproducible
rm -rf "$WORK"
mkdir -p "$WORK/logs"
scripts/testing/_copy-store "$WORK/data.db"

export DARK_CONFIG_RUNDIR="$PWD/$WORK"

ids() {
  sqlite3 "$WORK/data.db" \
    "SELECT id FROM package_ops WHERE id NOT IN (SELECT op_id FROM op_branches) ORDER BY id"
}

./scripts/build/reload-packages > /dev/null 2>&1
first=$(ids)
./scripts/build/reload-packages > /dev/null 2>&1
second=$(ids)

n=$(wc -l <<<"$second")
differ=$(comm -3 <(echo "$first") <(echo "$second") | wc -l)
if [[ "$differ" -ne 0 ]]; then
  echo "test-reload-is-reproducible: $differ of $n op ids differ between two reloads of one tree"
  exit 1
fi
echo "test-reload-is-reproducible: two reloads of one tree agree on all $n op ids."
