#!/usr/bin/env bash
# Bring a store grown from a seed up to packages/ at HEAD using the store's own parser, so no
# F# parser runs: every .dark file changed since <seed-commit> (the commit the seed was cut at)
# is saved whole through `dark module`'s code, then committed. Deleted files aren't handled yet.
#
#   scripts/packages/boot-from-seed <seed-commit>
. ./scripts/devcontainer/_assert-in-container "$0" "$@"
set -euo pipefail

base="$1"
mapfile -t files < <(git diff --name-only "$base" HEAD -- 'packages/**.dark' | grep -v '_' || true)
for f in "${files[@]}"; do [[ -f "$f" ]] || echo "skipped, deleted: $f"; done
mapfile -t present < <(for f in "${files[@]}"; do [[ -f "$f" ]] && echo "$f"; done)
DARK_NO_FSHARP_PARSER=1 ./scripts/run-local-exec apply-package-files "${present[@]}"
