// The concurrency demo the browser build boots into, and the one worth showing first.
//
//   dark module /Demo.Browser - < docs/browser-concurrency-demo.dark
//
// In a tab: open `/?cmd=eval Demo.Browser.bothWays ()`.
//
// Not under `packages/`, for the same reason as the walkthrough fixture: everything there is
// authored into the store on every build, and these are demo data rather than library code.
//
// `httpbin.org/delay/1` is used because it sleeps for a second and sends
// `access-control-allow-origin: *`, so a browser tab is allowed to call it.

/// Ten reads of a one-second endpoint, through the ORDINARY map. Nothing in this function says
/// "concurrent": a read hands back a promise and nothing forces one until the count asks.
let overlapping () : String =
  let urls = Stdlib.List.repeatUnsafe 10 "https://httpbin.org/delay/1"
  let t0 = Stdlib.DateTime.now ()
  let pages = urls |> Stdlib.List.map (fun u -> Stdlib.HttpClient.get u [])
  let ok = pages |> Stdlib.List.filter (fun r -> Stdlib.Result.isOk r) |> Stdlib.List.length
  let ms = Stdlib.DateTime.subtractMs (Stdlib.DateTime.now ()) t0
  let n = Stdlib.Int.toString ok
  $"{n} reads of a 1s endpoint in {Stdlib.Int.toString ms} ms, overlapping"

/// The same ten, each forced where it is made. One `await` is the whole difference.
let oneAtATime () : String =
  let urls = Stdlib.List.repeatUnsafe 10 "https://httpbin.org/delay/1"
  let t0 = Stdlib.DateTime.now ()
  let pages = urls |> Stdlib.List.map (fun u -> Stdlib.await (Stdlib.HttpClient.get u []))
  let ok = pages |> Stdlib.List.filter (fun r -> Stdlib.Result.isOk r) |> Stdlib.List.length
  let ms = Stdlib.DateTime.subtractMs (Stdlib.DateTime.now ()) t0
  let n = Stdlib.Int.toString ok
  $"{n} reads of a 1s endpoint in {Stdlib.Int.toString ms} ms, one at a time"

/// Both, slow first, so the second line is the punchline. Same ten reads, same ordinary `map`;
/// the only difference is one `Stdlib.await`.
let bothWays () : String =
  let slow = oneAtATime ()
  let fast = overlapping ()
  slow ++ "\n" ++ fast
