module Tests

// Zero remains a valid interval, including an immediately stopped watch.
Stdlib.Cli.Dir.withTemp (fun dir -> let path = $"{dir}/watch" in let wrote = Stdlib.Cli.File.writeText path "x" in let watched = Stdlib.Cli.File.watch path 0.0 (fun () -> true) (fun () -> ()) in (wrote, watched) == (Ok (), Ok ())) = Ok true
