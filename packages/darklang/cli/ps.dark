/// `dark ps`: what is running in this instance right now.
///
/// The data is `Stdlib.Exec.list`/`inspect`/`cancel`; this file only renders it. One scheduler
/// per OS process, so this shows the processes of the `dark` you are in: from a shell that is
/// the CLI itself plus whatever it spawned (each `eval` expression is one); from the workbench
/// or a REPL it is everything that instance is running.
module Darklang.Cli.Ps


let idPrefix (id: Uuid) : String =
  Stdlib.String.slice (Stdlib.Uuid.toString id) 0 8


let entryText (branchId: Uuid) (entry: Stdlib.Exec.Entry) : String =
  match entry with
  | Function name -> PrettyPrinter.RuntimeTypes.fnName branchId name
  | Expr -> "an eval expression"


let eventSpecText (spec: Stdlib.Host.EventSpec) : String =
  match spec with
  | Key -> "a key"
  | StoreChanged -> "a store change"
  | Timer ms -> $"a timer ({Stdlib.Int64.toString ms} ms)"
  | ExecDone id -> $"process {idPrefix id} to finish"


let parkedText (branchId: Uuid) (parked: Stdlib.Exec.ParkedOn) : String =
  match parked with
  | Host op -> $"the host: {op}"
  // The builtin's bare name: `Builtin.` says nothing a reader of this column needs.
  | Builtin b -> b.name
  | PackageFn h -> PrettyPrinter.RuntimeTypes.FQFnName.package branchId h
  | Lambda -> "a lambda"
  | RareOpcode -> "the store"
  | Events specs -> specs |> Stdlib.List.map eventSpecText |> Stdlib.String.join " or "
  | Process id -> $"process {idPrefix id}"


let statusText (branchId: Uuid) (status: Stdlib.Exec.Status) : String =
  match status with
  | Runnable -> "running"
  | Parked on ->
    match on with
    | Events _ -> $"waiting for {parkedText branchId on}"
    | Process _ -> $"waiting for {parkedText branchId on}"
    | _ -> $"waiting on {parkedText branchId on}"
  | Done -> "finished"
  | Failed rte ->
    let message = PrettyPrinter.RuntimeTypes.RuntimeError.toString branchId rte
    $"failed: {message}"


let row (branchId: Uuid) (depth: Int) (p: Stdlib.Exec.Summary) : List<String> =
  let parent =
    match p.parent with
    | Some id -> idPrefix id
    | None -> ""
  let indent = Stdlib.String.repeat "  " depth
  [ idPrefix p.id
    $"{indent}{entryText branchId p.entry}"
    statusText branchId p.status
    Stdlib.Int64.toString p.slices
    parent ]


/// The rows as a tree, each with its process id: each process under the one that spawned it,
/// oldest first at every level. A process whose parent is not in the list (it finished and was
/// forgotten) is a root.
let treeRowsWithIds (branchId: Uuid) (all: List<Stdlib.Exec.Summary>) : List<(Uuid * List<String>)> =
  let ids = all |> Stdlib.List.map (fun p -> p.id)
  let isRoot (p: Stdlib.Exec.Summary) : Bool =
    match p.parent with
    | None -> true
    | Some pid -> Stdlib.Bool.not (Stdlib.List.``member`` ids pid)
  let under (depth: Int) (p: Stdlib.Exec.Summary) : List<(Uuid * List<String>)> =
    let children =
      all |> Stdlib.List.filter (fun c -> c.parent == Stdlib.Option.Option.Some p.id)
    Stdlib.List.append
      [ (p.id, row branchId depth p) ]
      (children |> Stdlib.List.map (fun c -> under (depth + 1) c) |> Stdlib.List.flatten)
  all |> Stdlib.List.filter isRoot |> Stdlib.List.map (fun p -> under 0 p) |> Stdlib.List.flatten

let treeRows (branchId: Uuid) (all: List<Stdlib.Exec.Summary>) : List<List<String>> =
  treeRowsWithIds branchId all |> Stdlib.List.map (fun (_, cells) -> cells)


let executionPointText (branchId: Uuid) (ep: Stdlib.Exec.ExecutionPoint) : String =
  match ep with
  | Source -> "(the entry point)"
  | Function name -> PrettyPrinter.RuntimeTypes.fnName branchId name
  | Lambda(parent, _exprId) -> $"a lambda in {executionPointText branchId parent}"


/// The process whose id starts with `prefix`, when exactly one does.
let find (prefix: String) : Stdlib.Result.Result<Stdlib.Exec.Summary, String> =
  let matches =
    Stdlib.Exec.list ()
    |> Stdlib.List.filter (fun p -> Stdlib.String.startsWith (Stdlib.Uuid.toString p.id) prefix)
  match matches with
  | [ one ] -> Stdlib.Result.Result.Ok one
  | [] -> Stdlib.Result.Result.Error $"no process whose id starts with {prefix}"
  | _ -> Stdlib.Result.Result.Error $"more than one process starts with {prefix}; give more of the id"


/// "812 B", "34 KB", "2.1 MB": bytes at a glance.
let bytesText (n: Int64) : String =
  let n = Stdlib.Int.fromInt64 n
  if n < 1024 then $"{Stdlib.Int.toString n} B"
  else if n < 1048576 then $"{Stdlib.Int.toString (Stdlib.Int.divide n 1024)} KB"
  else
    let tenths = Stdlib.Int.divide n 104858
    $"{Stdlib.Int.toString (Stdlib.Int.divide tenths 10)}.{Stdlib.Int.toString (Stdlib.Int.``mod`` tenths 10)} MB"

/// "0.3 s ago", "12 s ago", "4 min ago": how long something has been running, at a glance.
let startedAgoText (started: DateTime) : String =
  let ms = Stdlib.DateTime.subtractMs (Stdlib.DateTime.now ()) started

  if ms < 10000 then
    let tenths = Stdlib.Int.divide ms 100
    $"{Stdlib.Int.toString (Stdlib.Int.divide tenths 10)}.{Stdlib.Int.toString (Stdlib.Int.``mod`` tenths 10)} s ago"
  else if ms < 60000 then
    $"{Stdlib.Int.toString (Stdlib.Int.divide ms 1000)} s ago"
  else if ms < 3600000 then
    $"{Stdlib.Int.toString (Stdlib.Int.divide ms 60000)} min ago"
  else
    $"{Stdlib.Int.toString (Stdlib.Int.divide ms 3600000)} h ago"


/// The other Dark processes on this machine (a serve, a daemon, another terminal), one row each,
/// oldest first; this process is left out, its own table follows.
let machineRows () : List<List<String>> =
  let me = Stdlib.Cli.Sys.currentPid ()
  Stdlib.Exec.machineList ()
  |> Stdlib.List.filter (fun m -> (Stdlib.Int.fromInt64 m.pid) != me)
  |> Stdlib.List.map (fun m ->
    [ Stdlib.Int64.toString m.pid
      m.title
      (if m.branch == "" then "main" else m.branch)
      startedAgoText m.started
      m.command ])

let printMachine () : Unit =
  match machineRows () with
  | [] -> ()
  | rows ->
    Stdlib.Cli.UI.Table.print [ "pid", "process", "branch", "started", "command" ] rows
    Stdlib.printLine ""

let printList (branchId: Uuid) : Unit =
  printMachine ()
  let rows = treeRows branchId (Stdlib.Exec.list ())
  Stdlib.Cli.UI.Table.print [ "id", "entry", "status", "turns", "parent" ] rows


let startedAgo (started: DateTime) : String = startedAgoText started


/// One process in full. The short id names it, as everywhere else; <param full> adds the whole uuid.
let printShowWith (branchId: Uuid) (prefix: String) (full: Bool) : Unit =
  match find prefix with
  | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
  | Ok p ->
    match Stdlib.Exec.inspect p.id with
    | None -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"process {idPrefix p.id} is gone")
    | Some detail ->
      let s = detail.summary
      let id = if full then Stdlib.Uuid.toString s.id else idPrefix s.id
      Stdlib.printLine $"{id}  {entryText branchId s.entry}"
      Stdlib.printLine $"  status   {statusText branchId s.status}"
      Stdlib.printLine $"  started  {startedAgo s.started}"
      Stdlib.printLine $"  turns    {Stdlib.Int64.toString s.slices}"
      Stdlib.printLine $"  memory   {bytesText s.allocated} allocated"
      if s.inflight > 0L then
        Stdlib.printLine $"  reads in flight  {Stdlib.Int64.toString s.inflight}"
      else
        ()
      match s.parent with
      | Some pid -> Stdlib.printLine $"  parent   {if full then Stdlib.Uuid.toString pid else idPrefix pid}"
      | None -> ()
      match detail.frames with
      | [] -> ()
      | frames ->
        Stdlib.printLine "  call stack (outermost first):"
        frames
        |> Stdlib.List.iter (fun ep ->
          Stdlib.printLine $"    {executionPointText branchId ep}")

let printShow (branchId: Uuid) (prefix: String) : Unit = printShowWith branchId prefix false

/// The table, then every process in full: `dark eval 'Darklang.Cli.Ps.printAll ()'` from inside an
/// eval is the one line that shows a parent and its child with both stacks.
let printAll () : Unit =
  let branchId = SCM.PackageOps.currentBranch ()
  printList branchId
  Stdlib.Exec.list ()
  |> Stdlib.List.iter (fun p ->
    Stdlib.printLine ""
    printShow branchId (idPrefix p.id))


/// The escape hatch, not the stdlib verb: a process stuck in a host call is ended without waiting
/// for the call, so this is the one place the builtin is called by id.
let killById (id: Uuid) : Bool = Builtin.execKill id

let isPid (s: String) : Bool =
  match Stdlib.Int.parse s with
  | Ok _ -> true
  | Error _ -> false

let signalMachine (pid: String) (signal: Int) (said: String) : Unit =
  match Stdlib.Int.parse pid with
  | Error _ -> ()
  | Ok n ->
    let known = Stdlib.Exec.machineList () |> Stdlib.List.filter (fun m -> (Stdlib.Int.fromInt64 m.pid) == n)
    match known with
    | [] -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no Dark process on this machine has pid {pid}")
    | m :: _ ->
      match Stdlib.Cli.Posix.kill n signal with
      | Ok () -> Stdlib.printLine $"{said} {m.title} (pid {pid}) to stop"
      | Error _ -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"could not signal pid {pid}")

let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] -> printList state.currentBranchId
  | [ "--watch" ] ->
    let view =
      Apps.Model.View
        { name = "ps"
          title = "processes"
          init = "Darklang.Cli.Ps.Watch.init"
          update = "Darklang.Cli.Ps.Watch.update"
          render = "Darklang.Cli.Ps.Watch.render"
          every = Stdlib.Option.Option.Some 500L }
    match Apps.Host.openView state.currentBranchId view Stdlib.Option.Option.None with
    | Ok _ -> ()
    | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
  | [ "show", prefix ] -> printShow state.currentBranchId prefix
  | [ "show", prefix, "--full" ] -> printShowWith state.currentBranchId prefix true
  // A pid names another Dark process on this machine: `cancel` is TERM (the Ctrl-C path, which
  // suspends a traced run), `kill` is KILL. An id prefix names a process in this instance.
  | [ "cancel", pid ] when isPid pid -> signalMachine pid 15 "asked"
  | [ "kill", pid ] when isPid pid -> signalMachine pid 9 "killed"
  | [ "cancel", prefix ] ->
    match find prefix with
    | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
    | Ok p ->
      if Stdlib.Exec.cancel (Stdlib.Exec.Handle { id = p.id }) then
        Stdlib.printLine $"asked process {idPrefix p.id} to stop; it ends at its next turn"
      else
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"process {idPrefix p.id} is gone")
  | [ "kill", prefix ] ->
    match find prefix with
    | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
    | Ok p ->
      if killById p.id then
        Stdlib.printLine $"stopped process {idPrefix p.id} without waiting for what it was doing"
      else
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"process {idPrefix p.id} is gone")
  | _ -> Stdlib.printLine (help state)
  state


let complete (_state: AppState) (args: List<String>) : List<Completion.CompletionItem> =
  match args with
  | [] -> [ "show", "cancel", "kill" ] |> Stdlib.List.map Completion.simple
  | _ -> []


let help (_state: AppState) : String =
  [ "Usage: ps"
    "       ps --watch"
    "       ps show <id-prefix> [--full]"
    "       ps cancel <id-prefix> | <pid>"
    "       ps kill <id-prefix> | <pid>"
    ""
    "What is running: first every other Dark process on this machine (a serve, a daemon,"
    "another terminal; from the registry each one writes at startup), then this instance's"
    "own processes, oldest first, as a tree: a process is listed under the one that spawned"
    "it. `--watch` repaints every half second; esc quits, c and k on a row cancel or kill it."
    "`show` adds the call stack. `cancel` asks one to stop at its next turn, letting what it"
    "is doing on the host finish; `kill` does not wait for the host, for a process stuck in a"
    "call that never returns. Both take its children with it unless they were spawned"
    "detached."
    ""
    "A process is a wrapped VM the scheduler steps; the CLI's own run is one, and so is"
    "each expression an `eval` runs. See docs/processes.md in the repo." ]
  |> Stdlib.String.join "\n"


/// `ps --watch`: the same two tables, repainted every half second, with a cursor. Up and down
/// move it, `c` cancels the row under it, `k` kills it, Escape leaves.
module Watch =
  type Row =
    /// Another Dark process on this machine, by pid.
    | Machine of pid: Int * cells: List<String>
    /// A process in this instance, by id.
    | Local of id: Uuid * cells: List<String>

  type Model =
    { rows: List<Row>
      cursor: Int
      /// What the last `c`/`k` said, shown under the tables until the next key.
      note: String }

  type Msg = | Refresh

  let gather () : List<Row> =
    let branchId = SCM.PackageOps.currentBranch ()
    let me = Stdlib.Cli.Sys.currentPid ()
    let machine =
      Stdlib.Exec.machineList ()
      |> Stdlib.List.filter (fun m -> (Stdlib.Int.fromInt64 m.pid) != me)
      |> Stdlib.List.map (fun m ->
        Row.Machine(
          Stdlib.Int.fromInt64 m.pid,
          [ Stdlib.Int64.toString m.pid
            m.title
            (if m.branch == "" then "main" else m.branch)
            startedAgoText m.started ]))
    let all = Stdlib.Exec.list ()
    let local =
      treeRowsWithIds branchId all
      |> Stdlib.List.map (fun (id, cells) -> Row.Local(id, cells))
    Stdlib.List.append machine local

  let init () : Model = Model { rows = gather (); cursor = 0; note = "" }

  let clamp (m: Model) : Model =
    let n = Stdlib.List.length m.rows
    { m with cursor = Stdlib.Int.max 0 (Stdlib.Int.min m.cursor (n - 1)) }

  let act (m: Model) (hard: Bool) : Model =
    match Stdlib.List.getAt m.rows m.cursor with
    | None -> m
    | Some(Machine(pid, cells)) ->
      let signal = if hard then 9 else 15
      match Stdlib.Cli.Posix.kill pid signal with
      | Ok () -> { m with note = $"{(if hard then "killed" else "asked")} pid {Stdlib.Int.toString pid} to stop" }
      | Error _ -> { m with note = $"could not signal pid {Stdlib.Int.toString pid}" }
    | Some(Local(id, _)) ->
      let ok =
        if hard then killById id else Stdlib.Exec.cancel (Stdlib.Exec.Handle { id = id })
      if ok then { m with note = $"{(if hard then "killed" else "asked")} {idPrefix id} to stop" }
      else { m with note = $"{idPrefix id} is gone" }

  let update (m: Model) (event: Apps.Host.Event<Msg>) : Model =
    match event with
    | Tick -> clamp { m with rows = gather () }
    | Msg Refresh -> clamp { m with rows = gather () }
    | Key k ->
      match k.key with
      | UpArrow -> clamp { m with cursor = m.cursor - 1; note = "" }
      | DownArrow -> clamp { m with cursor = m.cursor + 1; note = "" }
      | _ ->
        match k.char with
        | Some "c" -> act m false
        | Some "k" -> act m true
        | _ -> { m with note = "" }

  let render (m: Model) : Stdlib.Cli.UI.Node.Node<Msg> =
    let mark (i: Int) (cells: List<String>) : List<String> =
      match cells with
      | first :: rest -> Stdlib.List.push rest ((if i == m.cursor then "> " else "  ") ++ first)
      | [] -> []
    let indexed = Stdlib.List.indexedMap m.rows (fun i r -> (i, r))
    let machineRows =
      indexed
      |> Stdlib.List.filterMap (fun (i, r) ->
        match r with
        | Machine(_, cells) -> Stdlib.Option.Option.Some(mark i cells)
        | _ -> Stdlib.Option.Option.None)
    let localRows =
      indexed
      |> Stdlib.List.filterMap (fun (i, r) ->
        match r with
        | Local(_, cells) -> Stdlib.Option.Option.Some(mark i cells)
        | _ -> Stdlib.Option.Option.None)
    Stdlib.Cli.UI.Node.column
      [ (if Stdlib.List.isEmpty machineRows then Stdlib.Cli.UI.Node.dim "no other Dark process on this machine"
         else Stdlib.Cli.UI.Node.table [ "pid", "process", "branch", "started" ] machineRows)
        Stdlib.Cli.UI.Node.text ""
        Stdlib.Cli.UI.Node.table [ "id", "entry", "status", "turns", "parent" ] localRows
        Stdlib.Cli.UI.Node.text ""
        Stdlib.Cli.UI.Node.dim (if m.note == "" then "up/down move, c cancel, k kill, esc quit" else m.note) ]
