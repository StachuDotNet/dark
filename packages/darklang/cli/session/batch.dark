/// `dark @s1`: run lines in a session, one numbered reply per statement, then a report on what the
/// batch changed. Statements split the way the REPL splits a paste (`Repl.splitStatements`).
module Darklang.Cli.Session.Batch

type Statement =
  | Bind(name: String, rhs: String)
  | Command(name: String, args: List<String>, stdin: Option<String>)
  | WatchAdd(String)
  | WatchRemove(String)
  | Expression(String)
  | Refused(String)


type ModuleCheck =
  { name: String
    checked: Int64
    /// (item, its issues)
    failures: List<(String * List<String>)> }


type WatchResult =
  { expression: String
    status: String
    value: String
    changed: Bool }


type Outcome =
  { replies: List<Reply>
    ms: Int64
    checks: List<ModuleCheck>
    watches: List<WatchResult> }


/// Commands that write declarations, so their module goes into the report's typecheck.
val writeCommands =
  [ "fn"
    "function"
    "val"
    "value"
    "type"
    "trait"
    "impl"
    "module"
    "edit"
    "delete"
    "rename"
    "deprecate"
    "test" ]


/// What a failed statement does to the rest of the batch.
type OnFailure =
  | Stop
  | KeepGoing


val replyLineCap = 20

val replyCharCap = 2000

val reportLineCap = 12


let stripAnsi(text: String): String =
  Stdlib.Regex.replaceAll(text, "\u001b\\[[0-9;?]*[A-Za-z]", "") |> Stdlib.Result.withDefault(text)


let outputLines(text: String): List<String> =
  stripAnsi(text)
  |> Stdlib.String.splitOnNewline
  |> Stdlib.List.map(fun l -> Stdlib.String.trimEnd(l))
  |> Stdlib.List.reverse
  |> Stdlib.List.dropWhile(fun l -> l == "")
  |> Stdlib.List.reverse


/// A success line's leading tick says nothing the reply's `ok` does not.
let dropGlyph(line: String): String =
  match Stdlib.String.toList(line) with
  | [g, s, ...rest] when Stdlib.display(s) == " " && Stdlib.Bool.not(Stdlib.Char.isASCII(g)) ->
    Stdlib.String.fromList(rest)
  | _ -> line


let indentOf(line: String): Int64 =
  Stdlib.String.length(line) - Stdlib.String.length(Stdlib.String.trimStart(line))


/// Remove the indent every non-blank line shares.
let dedent(lines: List<String>): String =
  let widths =
    lines
    |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "")
    |> Stdlib.List.map(fun l -> indentOf(l))

  let common =
    match widths with
    | [] -> 0
    | [w, ...ws] -> ws |> Stdlib.List.fold(w, fun(acc, x) -> if x < acc then x else acc)

  lines
  |> Stdlib.List.map(fun l -> Stdlib.String.dropFirst(l, common))
  |> Stdlib.String.join("\n")


let commandNames(state: AppState): List<String> =
  state.allCommandsCache
  |> Stdlib.List.fold([], fun(acc, h) ->
    Stdlib.List.concat(Stdlib.List.append(acc, h.name), h.aliases))


let firstWord(text: String): String =
  Stdlib.String.split(Stdlib.String.trim(text), " ")
  |> Stdlib.List.head
  |> Stdlib.Option.withDefault("")
  |> Stdlib.String.trim


let afterWord(text: String, word: String): String =
  Stdlib.String.trim(Stdlib.String.dropFirst(Stdlib.String.trim(text), Stdlib.String.length(word)))


/// A session runs under the instance policy and never changes it, so a batch's lines can do no
/// more than the same lines typed one by one.
let widensPermissions(args: String): Bool =
  let verb = firstWord(args)
  Stdlib.Bool.not(
    Stdlib.List.contains([ "", "list", "show", "approved", "approvals", "requirements" ], verb))


let classify(state: AppState, text: String): Statement =
  // a line copied from a shell, `dark fn ...`, means `fn ...`
  let text =
    if Stdlib.String.startsWith(text, "dark ") then
      Stdlib.String.dropFirst(text, 5)
    else
      text

  let word = firstWord(text)
  match Repl.parseLetBinding(text) with
  | Some((name, rhs)) -> Statement.Bind(name, rhs)
  | None ->
    if word == "watch" then
      Statement.WatchAdd(afterWord(text, word))
    else if word == "unwatch" then
      Statement.WatchRemove(afterWord(text, word))
    else if word == "session" || Stdlib.String.startsWith(word, "@") then
      Statement.Refused($"`{word}` cannot run inside a batch")
    else if word == "permissions" && widensPermissions(afterWord(text, word)) then
      Statement.Refused("a session cannot change permissions; run `dark permissions` outside it")
    else if Stdlib.List.contains(commandNames(state), word) then
      let lines = Stdlib.String.split(text, "\n")
      let firstLine = Stdlib.List.head(lines) |> Stdlib.Option.withDefault("")
      let rest = Stdlib.List.drop(lines, 1)
      match LanguageTools.Permissions.tokens(firstLine) with
      | None -> Statement.Refused("a quote is not closed")
      | Some(words) ->
        let endsInDash = Stdlib.List.last(words) == Option.Some("-")
        if endsInDash && Stdlib.Bool.not(Stdlib.List.isEmpty(rest)) then
          Statement.Command(word, Stdlib.List.drop(words, 1), Option.Some(dedent(rest)))
        else
          match LanguageTools.Permissions.tokens(text) with
          | None -> Statement.Refused("a quote is not closed")
          | Some(all) -> Statement.Command(word, Stdlib.List.drop(all, 1), Option.None)
    else
      Statement.Expression(text)


/// A value as a Dark literal you can paste back, or as `eval` prints it when it has none. "" for
/// unit.
let literal(branchId: Uuid, v: 'a): String =
  let dv = LanguageTools.RuntimeTypes.reflect(v)
  match dv with
  | DUnit -> ""
  | _ ->
    match LanguageTools.RuntimeTypesToProgramTypes.dvalToExpr(branchId, dv) with
    | Ok(e) ->
      PrettyPrinter.ProgramTypes.expr(PrettyPrinter.ProgramTypes.Context.forBranch(branchId), e)
    | Error(_) -> Stdlib.inspect(v)


/// An error's line numbers, less the <param k> lines of bindings put in front of what was typed.
let shiftLine(line: String, k: Int64): String =
  let fix(s: String, pattern: String, suffix: String): String =
    Stdlib.Regex.replaceAllWith(s, pattern, fun m ->
      match m.captures with
      | [Some(lead), Some(num)] ->
        match Stdlib.Int64.parse(num.text) with
        | Ok(n) when n > k -> lead.text + Stdlib.display(n - k) + suffix
        | _ -> m.text
      | _ -> m.text)
    |> Stdlib.Result.withDefault(s)

  if k == 0 then
    line
  else
    fix(fix(line, "(at )(\\d+):", ":"), "^(\\s*)(\\d+) \\|", " |")


/// Evaluate <param expr> with the bindings in scope: (the literal, or the error's lines; what it
/// printed on the way).
let evalLiteral(
  state: AppState,
  bindings: List<Repl.Binding>,
  expr: String)
  : (Result<String, List<String>> * List<String>) =
  let source = Repl.withBindings(bindings, expr)
  let (result, printed) = Workbench.captureOutputAnd(fun () ->
    match Eval.evaluateValue(state.accountID, state.currentBranchId, source, Eval.Harmful.Halt) with
    | Ok(v) -> Result.Ok(literal(state.currentBranchId, v))
    | Error(e) ->
      let k = Stdlib.List.length(Stdlib.String.split(Repl.bindingChain(bindings), "\n")) - 1
      Result.Error(
        outputLines(ExecutionError.formatForTerminal(state.accountID, state.currentBranchId, e))
        |> Stdlib.List.map(fun l -> shiftLine(l, k))))

  (result, outputLines(printed))


let errorLines(lines: List<String>): List<String> =
  match lines |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "") with
  | [first, ...rest] ->
    let first = Stdlib.String.trim(first)
    let first =
      if Stdlib.String.startsWith(first, "Error: ") then
        Stdlib.String.dropFirst(first, 7)
      else if Stdlib.String.startsWith(first, "error: ") then
        Stdlib.String.dropFirst(first, 7)
      else
        first

    Stdlib.List.prepend(rest, "error: " + first)
  | [] -> [ "error" ]


let reply(n: Int64, kind: String, status: String, lines: List<String>): Reply =
  Reply { n = n, kind = kind, status = status, lines = lines }


let runBind(state: AppState, r: Record, n: Int64, name: String, rhs: String): (Record * Reply) =
  let capture = Repl.captureExpr(r.bindings, state.currentBranchId, name, rhs)
  let (result, _stray) =
    Workbench.captureOutputAnd(fun () -> Eval.evaluate(state, capture, Eval.Harmful.Halt))

  let keep(binding: Repl.Binding, shown: String): (Record * Reply) =
    ({ r with bindings = Repl.upsert(r.bindings, binding) }, reply(n, "binding", "ok", [ shown ]))

  let uncaptured(): (Record * Reply) =
    keep(
      Repl.Binding { name = name, source = rhs, value = rhs, captured = false },
      $"ok {name} ~ {rhs}")

  match result with
  | Error(_) ->
    // the capture wrapper's error mentions code nobody wrote; ask again in their words
    let (plain, _) = evalLiteral(state, r.bindings, $"let {name} = {rhs}\n{name}")
    let lines =
      match plain with
      | Error(lines) -> lines
      | Ok(_) -> [ "could not bind " + name ]

    (r, reply(n, "binding", "error", errorLines(lines)))
  | Ok(None) -> uncaptured()
  | Ok(Some(out)) ->
    match Repl.readCaptured(out) with
    | Some(source) ->
      keep(
        Repl.Binding { name = name, source = source, value = source, captured = true },
        $"ok {name} = {source}")
    | None -> uncaptured()


let runExpression(state: AppState, r: Record, n: Int64, expr: String): Reply =
  match evalLiteral(state, r.bindings, expr) with
  | Ok(value), printed ->
    let head = if value == "" then "ok" else value
    match Stdlib.String.splitOnNewline(head) with
    | [first, ...more] ->
      reply(n, "expression", "ok", Stdlib.List.concat([ first ], Stdlib.List.concat(more, printed)))
    | [] -> reply(n, "expression", "ok", Stdlib.List.prepend(printed, "ok"))
  | Error(lines), printed ->
    reply(n, "expression", "error", Stdlib.List.concat(errorLines(lines), printed))


/// The module a write command's name lands in, relative names resolved against <param here>.
let moduleOfWrite(here: List<String>, name: String, args: List<String>): Option<String> =
  // of the `test` verbs only `test add` writes
  let isTestAdd = Stdlib.List.head(args) == Option.Some("add")
  let args = if name == "test" then Stdlib.List.drop(args, 1) else args
  let writes = Stdlib.List.contains(writeCommands, name) && (name != "test" || isTestAdd)
  if Stdlib.Bool.not(writes) then
    Option.None
  else
    let positional =
      args
      |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.String.startsWith(a, "-")))
      |> Stdlib.List.head

    match positional with
    | None -> Option.None
    | Some(target) ->
      let absolute = Stdlib.String.startsWith(target, "/")
      let target = if absolute then Stdlib.String.dropFirst(target, 1) else target
      let parts = Stdlib.String.split(target, ".") |> Stdlib.List.filter(fun p -> p != "")
      let full = if absolute then parts else Stdlib.List.concat(here, parts)

      // `module X` names the module itself; every other write names an item in one
      let path =
        if name == "module" then
          full
        else
          Stdlib.List.take(full, Stdlib.List.length(full) - 1)

      if Stdlib.List.isEmpty(path) then
        Option.None
      else
        Option.Some(Stdlib.String.join(path, "."))


let runCommand(
  state: AppState,
  n: Int64,
  name: String,
  args: List<String>,
  stdin: Option<String>)
  : (AppState * Reply * Option<String>) =
  // `edit` opens $EDITOR only when given nothing to apply: a patch, a file or `-` needs no terminal
  let editsWithoutEditor = name == "edit" && Stdlib.List.length(args) >= 2
  let refuse = fun why -> (state, reply(n, "command", "error", [ "error: " + why ]), Option.None)
  if Registry.takesScreen(state.allCommandsCache, name, args) then
    refuse($"`{name}` takes over the screen; run it outside a session")
  else if
    Registry.needsTerminal(state.allCommandsCache, name, args)
    && Stdlib.Bool.not(editsWithoutEditor)
  then
    refuse($"`{name}` asks a question here; add -y, or run it outside a session")
  else
    let here = modulePathOf(state.packageData.currentLocation)
    let before = { state with exitCode = 0, stdinText = stdin }
    let (after, out) =
      Workbench.captureOutputAnd(fun () -> Registry.executeCommand(name, before, args))

    let lines = outputLines(out) |> Stdlib.List.map(fun l -> dropGlyph(l))
    // a program that exits nonzero answered; a batch that tries the error paths goes on
    let isRun = name == "run" || name == "run-script"
    let exited = isRun && after.exitCode != 0
    let ok = after.exitCode == 0 || exited
    let lines =
      match ok, lines with
      | true, _ when exited -> Stdlib.List.prepend(lines, $"exit {Stdlib.display(after.exitCode)}")
      | true, [] -> [ "ok" ]
      | true, [first, ...rest] -> Stdlib.List.prepend(rest, "ok " + Stdlib.String.trimStart(first))
      | false, [] -> [ $"error: `{name}` exited {Stdlib.display(after.exitCode)}" ]
      | false, _ -> errorLines(lines)

    // a run leaves a trace: say which, so the next question is one command away
    let lines =
      if isRun then
        match Tracing.Store.list(1) with
        | [t] ->
          let short = Text.shortIdText(t.id)
          Stdlib.List.append(lines, $"trace {short}: dark traces show {short}")
        | _ -> lines
      else
        lines

    (
      { after with exitCode = 0, stdinText = Option.None, isExiting = false },
      reply(n, "command", (if ok then "ok" else "error"), lines),
      moduleOfWrite(here, name, args))


/// Run one statement: the state and record after it, its reply, and the module it wrote to.
let runStatement(
  state: AppState,
  r: Record,
  n: Int64,
  statement: Statement)
  : (AppState * Record * Reply * Option<String>) =
  match statement with
  | Bind(name, rhs) ->
    let (r2, rep) = runBind(state, r, n, name, rhs)
    (state, r2, rep, Option.None)
  | Expression(expr) -> (state, r, runExpression(state, r, n, expr), Option.None)
  | WatchAdd(expr) ->
    let watches =
      Stdlib.List.append(
        r.watches |> Stdlib.List.filter(fun w -> w.expr != expr),
        Watch { expr = expr, last = "" })

    (
      state,
      { r with watches = watches },
      reply(n, "watch", "ok", [ "ok watching " + expr ]),
      Option.None)
  | WatchRemove(expr) ->
    let watches = r.watches |> Stdlib.List.filter(fun w -> w.expr != expr)
    if Stdlib.List.length(watches) == Stdlib.List.length(r.watches) then
      (state, r, reply(n, "watch", "error", [ "error: not watching " + expr ]), Option.None)
    else
      (state, { r with watches = watches }, reply(n, "watch", "ok", [ "ok" ]), Option.None)
  | Command(name, args, stdin) ->
    let (s2, rep, touched) = runCommand(state, n, name, args, stdin)
    (s2, r, rep, touched)
  | Refused(why) -> (state, r, reply(n, "command", "error", [ "error: " + why ]), Option.None)


let checkModule(branchId: Uuid, name: String): ModuleCheck =
  let scope = Stdlib.String.split(name, ".")
  let report = Packages.AtRestCheck.checkModule(branchId, scope)
  let totals = Packages.Typecheck.counts(report.items)
  let failedOnly =
    Packages.Typecheck.OutputFilter
      { showChecked = false, showFailed = true, showIncomplete = false }

  let failures =
    Packages.Typecheck.listed(branchId, [], failedOnly, report.items)
    |> Stdlib.List.map(fun((label, item)) ->
      (
        label,
        Packages.AtRestCheck.issueLines(branchId, item.diagnostics)
        |> Stdlib.List.map(fun l -> stripAnsi(Stdlib.String.trim(l)))))

  ModuleCheck
    { name = name, checked = totals.checkedCount + totals.failedCount, failures = failures }


let runWatches(state: AppState, r: Record): (Record * List<WatchResult>) =
  let results =
    r.watches
    |> Stdlib.List.map(fun w ->
      match evalLiteral(state, r.bindings, w.expr) with
      | Ok(value), _ ->
        WatchResult { expression = w.expr, status = "ok", value = value, changed = value != w.last }
      | Error(lines), _ ->
        let message =
          errorLines(lines)
          |> Stdlib.List.head
          |> Stdlib.Option.withDefault("error")

        WatchResult { expression = w.expr, status = "error", value = message, changed = true })

  let watches = results |> Stdlib.List.map(fun w -> Watch { expr = w.expression, last = w.value })
  ({ r with watches = watches }, results)


/// Run <param text> in <param r>, starting from <param state>. Returns the record afterwards; the
/// caller saves it.
let run(state: AppState, r: Record, text: String, onFailure: OnFailure): (Record * Outcome) =
  let started = Stdlib.DateTime.now()
  let stored = SCM.PackageOps.currentBranch()
  let _ = SCM.PackageOps.selectBranch(branchOf(r))
  let (endState, endRecord, replies, _failed, touched) =
    Repl.splitStatements(text)
    |> Stdlib.List.indexedMap(fun(i, s) -> (i + 1, s))
    |> Stdlib.List.fold((enter(state, r), r, [], false, []), fun(acc, numbered) ->
      let (st, rc, replies, failed, touched) = acc
      let (n, text) = numbered
      let statement = classify(st, text)
      if failed && onFailure == OnFailure.Stop then
        (
          st,
          rc,
          Stdlib.List.append(replies, reply(n, "skipped", "skipped", [ "skipped" ])),
          failed,
          touched)
      else
        let (st2, rec2, rep, wrote) = runStatement(st, rc, n, statement)
        let touched =
          match wrote with
          | Some(m) when Stdlib.Bool.not(Stdlib.List.contains(touched, m)) ->
            Stdlib.List.append(touched, m)
          | _ -> touched

        (st2, rec2, Stdlib.List.append(replies, rep), failed || rep.status == "error", touched))

  let endBranch = endState.currentBranchId
  let checks = touched |> Stdlib.List.map(fun m -> checkModule(endBranch, m))
  let endRecord =
    { endRecord with
        branchId = Stdlib.display(endBranch)
        location = modulePathOf(endState.packageData.currentLocation)
        lastReplies = replies }

  let (endRecord, watches) = runWatches(endState, endRecord)
  let _ = SCM.PackageOps.selectBranch(stored)
  let ms = Stdlib.DateTime.subtractMs(Stdlib.DateTime.now(), started)
  (endRecord, Outcome { replies = replies, ms = ms, checks = checks, watches = watches })


let count(outcome: Outcome, status: String): Int64 =
  outcome.replies
  |> Stdlib.List.filter(fun r -> r.status == status)
  |> Stdlib.List.length


/// A reply cut to the caps: (its lines, how many lines were dropped). An error keeps its first
/// line and its hints, never a stack.
let capped(reply: Reply): (List<String> * Int64) =
  let lines =
    if reply.status == "error" then
      match reply.lines with
      | [first, ...rest] ->
        Stdlib.List.prepend(
          rest
          |> Stdlib.List.filter(fun l -> Stdlib.String.startsWith(Stdlib.String.trim(l), "hint")),
          first)
      | [] -> []
    else
      Stdlib.List.take(reply.lines, replyLineCap)

  let (kept, _chars) =
    lines
    |> Stdlib.List.fold(([], 0), fun(acc, l) ->
      let (kept, chars) = acc
      let size = Stdlib.String.length(l) + 1
      if chars + size > replyCharCap && Stdlib.Bool.not(Stdlib.List.isEmpty(kept)) then
        (kept, replyCharCap + 1)
      else if chars > replyCharCap then
        (kept, chars)
      else
        (Stdlib.List.append(kept, Stdlib.String.first(l, replyCharCap)), chars + size))

  (kept, Stdlib.List.length(reply.lines) - Stdlib.List.length(kept))


let reportLines(r: Record, outcome: Outcome): List<String> =
  let checkLines =
    outcome.checks
    |> Stdlib.List.map(fun c ->
      let head =
        $"typecheck {c.name}: {Stdlib.display(c.checked)} checked, {Stdlib.display(Stdlib.List.length(c.failures))} failed"

      let items =
        c.failures
        |> Stdlib.List.map(fun((label, issues)) ->
          let first = Stdlib.List.head(issues) |> Stdlib.Option.withDefault("")
          let first =
            if Stdlib.String.startsWith(first, "- ") then
              Stdlib.String.dropFirst(first, 2)
            else
              first

          $"  {label}: {first}")

      Stdlib.List.prepend(items, head))
    |> Stdlib.List.flatten

  let watchLines =
    outcome.watches
    |> Stdlib.List.map(fun w ->
      if w.status != "ok" then
        $"watch {w.expression} {w.value}"
      else if w.changed then
        $"watch {w.expression} = {w.value}"
      else
        $"watch {w.expression} unchanged")

  let all = Stdlib.List.concat(checkLines, watchLines)
  let shown =
    if Stdlib.List.length(all) > reportLineCap then
      Stdlib.List.append(
        Stdlib.List.take(all, reportLineCap - 1),
        $"... {Stdlib.display(Stdlib.List.length(all) - reportLineCap + 1)} more: dark session show {r.id}")
    else
      all

  let summary =
    $"{Stdlib.display(count(outcome, "ok"))} ok, {Stdlib.display(count(outcome, "error"))} failed, {Stdlib.display(count(outcome, "skipped"))} skipped, {Stdlib.display(outcome.ms)} ms"

  let where = $"{r.id} on {branchText(branchOf(r))}, at {locationText(r.location)}"
  Stdlib.List.flatten([ [ summary ], shown, [ where ] ]) |> Stdlib.List.map(fun l -> "-- " + l)


/// The batch's text: numbered replies, then the report.
let renderText(r: Record, outcome: Outcome): List<String> =
  let replyText =
    outcome.replies
    |> Stdlib.List.map(fun reply ->
      let (kept, more) = capped(reply)
      let shown =
        if more > 0 then
          Stdlib.List.append(
            kept,
            $"... {Stdlib.display(more)} more lines: dark session show {r.id} {Stdlib.display(reply.n)}")
        else
          kept

      replyLines({ reply with lines = shown }))
    |> Stdlib.List.flatten

  Stdlib.List.concat(replyText, reportLines(r, outcome))


type JsonReply =
  { n: Int64
    kind: String
    status: String
    text: String
    more: Int64 }


type JsonFailure =
  { name: String
    issues: List<String> }


type JsonCheck =
  { module: String
    checked: Int64
    failed: List<JsonFailure> }


type JsonSummary =
  { ok: Int64
    failed: Int64
    skipped: Int64
    ms: Int64 }


type JsonBatch =
  { session: String
    branch: String
    location: String
    replies: List<JsonReply>
    summary: JsonSummary
    typecheck: List<JsonCheck>
    watches: List<WatchResult> }


let toJson(r: Record, outcome: Outcome): JsonBatch =
  JsonBatch
    { session = r.id
      branch = branchText(branchOf(r))
      location = locationText(r.location)
      replies =
        outcome.replies
        |> Stdlib.List.map(fun reply ->
          let (kept, more) = capped(reply)
          JsonReply
            { n = reply.n
              kind = reply.kind
              status = reply.status
              text = Stdlib.String.join(kept, "\n")
              more = more })
      summary =
        JsonSummary
          { ok = count(outcome, "ok")
            failed = count(outcome, "error")
            skipped = count(outcome, "skipped")
            ms = outcome.ms }
      typecheck =
        outcome.checks
        |> Stdlib.List.map(fun c ->
          JsonCheck
            { module = c.name
              checked = c.checked
              failed =
                c.failures
                |> Stdlib.List.map(fun((label, issues)) ->
                  JsonFailure { name = label, issues = issues }) })
      watches = outcome.watches }


/// `dark @<id> [--continue] [--json] [<line> ...]`: run the lines given, or stdin's when none are,
/// then save the session. `dark @` uses the session `.darklang/session` names.
let executeCli(state: AppState, target: String, args: List<String>): AppState =
  let id = if target == "" then named() else Option.Some(target)
  let keepGoing = Stdlib.List.contains(args, "--continue")
  let json = Stdlib.List.contains(args, "--json")
  let lines = args |> Stdlib.List.filter(fun a -> a != "--continue" && a != "--json")
  match id |> Stdlib.Option.andThen(fun id -> load(id)) with
  | None ->
    match id with
    | Some(id) -> unknown(state, id)
    | None ->
      printErr($"no session here: no {sessionFile} in this directory or above")
      printHint("  `dark session use s1` names one; `dark @s1` runs in one.")
      { state with exitCode = 2 }
  | Some(r) ->
    let text =
      match lines with
      | [] -> Stdlib.Cli.Stdin.readAll()
      | lines -> Result.Ok(Stdlib.String.join(lines, "\n"))

    match text with
    | Error(message) ->
      printErr(message)
      { state with exitCode = 2 }
    | Ok(text) ->
      let onFailure = if keepGoing then OnFailure.KeepGoing else OnFailure.Stop
      let (r2, outcome) = run(state, r, text, onFailure)
      let _ =
        if json then
          let _ = printJson(Stdlib.Json.checkedSerialize<JsonBatch>(toJson(r2, outcome)))
          ()
        else
          renderText(r2, outcome) |> Stdlib.List.iter(fun l -> Stdlib.printLine(l))

      match save(r2) with
      | Error(message) ->
        printErr(message)
        { state with exitCode = 1 }
      | Ok(_) -> { state with exitCode = if count(outcome, "error") > 0 then 1 else 0 }
