/// Sessions that outlive one `dark` call: a named record of a branch, a place in the tree, `let`
/// bindings and watched expressions, kept in this instance's config under `session.<id>`. A batch
/// (`dark @s1`) loads the record, runs, and saves it back.
module Darklang.Cli.Session

type Watch =
  { expr: String
    /// What it showed after the last batch, so the report can say "unchanged".
    last: String }


type Reply =
  { n: Int64
    /// binding, expression, command or watch
    kind: String
    /// ok, error or skipped
    status: String
    /// The reply as printed, without its number. Never empty.
    lines: List<String> }


type Record =
  { id: String
    branchId: String
    /// The module the session stands in, by segment; empty for the root.
    location: List<String>
    bindings: List<Repl.Binding>
    watches: List<Watch>
    /// Every reply of the last batch in full, for `session show`.
    lastReplies: List<Reply> }


let key(id: String): String =
  "session." + id


let load(id: String): Option<Record> =
  match LanguageTools.LocalStore.configGet(key(id)) with
  | Some(text) ->
    match Stdlib.Json.parse<Record>(text) with
    | Ok(r) -> Option.Some(r)
    | Error(_) -> Option.None
  | None -> Option.None


let save(r: Record): Result<Unit, String> =
  match Stdlib.Json.checkedSerialize<Record>(r) with
  | Ok(text) -> LanguageTools.LocalStore.configSet(key(r.id), text)
  | Error(_) -> Result.Error($"could not save session {r.id}")


let ids(): List<String> =
  match LanguageTools.LocalStore.configGet("session.index") with
  | Some(text) ->
    match Stdlib.Json.parse<List<String>>(text) with
    | Ok(xs) -> xs
    | Error(_) -> []
  | None -> []


let setIds(xs: List<String>): Result<Unit, String> =
  match Stdlib.Json.checkedSerialize<List<String>>(xs) with
  | Ok(text) -> LanguageTools.LocalStore.configSet("session.index", text)
  | Error(_) -> Result.Error("could not save the session list")


/// Ids are never reused, so a caller still holding an ended id gets "no session", not someone
/// else's session.
let nextId(): String =
  let n =
    LanguageTools.LocalStore.configGet("session.next")
    |> Stdlib.Option.andThen(fun t -> Stdlib.Int64.parse(t) |> Stdlib.Result.toOption)
    |> Stdlib.Option.withDefault(1)

  let _ = LanguageTools.LocalStore.configSet("session.next", Stdlib.display(n + 1))
  "s" + Stdlib.display(n)


let branchOf(r: Record): Uuid =
  Stdlib.Uuid.parse(r.branchId) |> Stdlib.Result.withDefault(SCM.Branch.mainBranchId)


let modulePathOf(location: Packages.PackageLocation): List<String> =
  match location with
  | Module(path) -> path
  | Type(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Value(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Function(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Trait(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Impl(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Test(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)


let locationText(path: List<String>): String =
  if Stdlib.List.isEmpty(path) then "/" else Stdlib.String.join(path, ".")


let branchText(branchId: Uuid): String =
  if SCM.Branch.isMain(branchId) then
    SCM.Branch.mainBranchName
  else
    SCM.PackageOps.branchName(branchId)


/// <param state> standing where <param r> stands.
let enter(state: AppState, r: Record): AppState =
  { state with
      currentBranchId = branchOf(r)
      packageData =
        { state.packageData with currentLocation = Packages.PackageLocation.Module(r.location) } }


let summaryLine(r: Record): String =
  let b = Stdlib.List.length(r.bindings)
  let w = Stdlib.List.length(r.watches)
  $"{r.id}  branch {branchText(branchOf(r))}  at {locationText(r.location)}  {Stdlib.display(b)} bindings  {Stdlib.display(w)} watches"


let unknown(state: AppState, id: String): AppState =
  printErr($"no session {id}")
  printHint("  `dark session ls` lists them; `dark session new` makes one.")
  { state with exitCode = 2 }


/// The file that names a directory's session, so `dark @` there needs no id.
val sessionFile = ".darklang/session"


/// The session named by `.darklang/session` in <param dir> or the nearest directory above it.
let namedIn(dir: String): Option<String> =
  let path = dir + "/" + sessionFile
  if Stdlib.Cli.File.exists(path) then
    match Stdlib.Cli.File.readText(path) with
    | Ok(text) when Stdlib.String.trim(text) != "" -> Option.Some(Stdlib.String.trim(text))
    | _ -> Option.None
  else
    let up = Stdlib.Cli.Path.parent(dir)
    if up == dir || up == "." then Option.None else namedIn(up)


let named(): Option<String> =
  match Stdlib.Cli.Posix.getCwd() with
  | Ok(cwd) -> namedIn(cwd)
  | Error(_) -> Option.None


let executeUse(state: AppState, id: String): AppState =
  match load(id), Stdlib.Cli.Posix.getCwd() with
  | None, _ -> unknown(state, id)
  | Some(_), Error(_) ->
    printErr("could not tell which directory this is")
    failed(state)
  | Some(_), Ok(cwd) ->
    let written =
      Stdlib.Cli.Dir.createRecursive(cwd + "/.darklang")
      |> Stdlib.Result.andThen(fun _ ->
        Stdlib.Cli.File.writeText(cwd + "/" + sessionFile, id + "\n"))

    match written with
    | Ok(_) -> state
    | Error(e) ->
      printErr($"could not write {sessionFile}: {Stdlib.display(e)}")
      failed(state)


let executeNew(state: AppState, args: List<String>): AppState =
  let flag(name: String): Option<String> =
    args
    |> Stdlib.List.dropWhile(fun a -> a != name)
    |> Stdlib.List.drop(1)
    |> Stdlib.List.head

  let branch =
    match flag("--branch") with
    | Some(ref) -> Branch.resolveRef(ref)
    | None -> Option.Some(state.currentBranchId)

  let location =
    match flag("--at") with
    | Some(at) ->
      let at = if Stdlib.String.startsWith(at, "/") then Stdlib.String.dropFirst(at, 1) else at
      Stdlib.String.split(at, ".") |> Stdlib.List.filter(fun p -> p != "")
    | None -> modulePathOf(state.packageData.currentLocation)

  match branch with
  | None -> failed(state)
  | Some(branchId) ->
    let r =
      Record
        { id = nextId()
          branchId = Stdlib.display(branchId)
          location = location
          bindings = []
          watches = []
          lastReplies = [] }

    match save(r) |> Stdlib.Result.andThen(fun _ -> setIds(Stdlib.List.append(ids(), r.id))) with
    | Ok(_) ->
      Stdlib.printLine(r.id)
      state
    | Error(message) ->
      printErr(message)
      failed(state)


let executeEnd(state: AppState, id: String): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(_) ->
    let _ = LanguageTools.LocalStore.configUnset(key(id))
    let _ = setIds(ids() |> Stdlib.List.filter(fun x -> x != id))
    state


let executeList(state: AppState): AppState =
  match ids() |> Stdlib.List.filterMap(fun id -> load(id)) with
  | [] ->
    printHint("no sessions; `dark session new` makes one.")
    state
  | records ->
    records |> Stdlib.List.iter(fun r -> Stdlib.printLine(summaryLine(r)))
    state


let replyLines(reply: Reply): List<String> =
  match reply.lines with
  | [first, ...rest] ->
    Stdlib.List.prepend(
      rest |> Stdlib.List.map(fun l -> "  " + l),
      Stdlib.display(reply.n) + " " + first)
  | [] -> [ Stdlib.display(reply.n) ]


let executeShow(state: AppState, id: String, which: Option<String>): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(r) ->
    let chosen =
      match which with
      | None -> Result.Ok(r.lastReplies)
      | Some(text) ->
        match Stdlib.Int64.parse(text) with
        | Ok(n) ->
          match r.lastReplies |> Stdlib.List.filter(fun x -> x.n == n) with
          | [] -> Result.Error($"the last batch in {id} has no reply {text}")
          | found -> Result.Ok(found)
        | Error(_) -> Result.Error($"{text} is not a reply number")

    match chosen with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(replies) ->
      let header =
        if which == Option.None then
          Stdlib.List.flatten(
            [ [ $"branch {branchText(branchOf(r))}", $"at {locationText(r.location)}" ]
              r.bindings |> Stdlib.List.map(fun b -> $"let {b.name} = {b.source}")
              r.watches |> Stdlib.List.map(fun w -> $"watch {w.expr}") ])
          |> Stdlib.List.map(fun l -> "-- " + l)
        else
          []

      header |> Stdlib.List.iter(fun l -> Stdlib.printLine(l))

      replies
      |> Stdlib.List.iter(fun reply ->
        replyLines(reply) |> Stdlib.List.iter(fun l -> Stdlib.printLine(l)))

      state


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] -> executeList(state)
  | ["ls"] -> executeList(state)
  | ["new", ...rest] -> executeNew(state, rest)
  | ["use", id] -> executeUse(state, id)
  | ["end", id] -> executeEnd(state, id)
  | ["show", id] -> executeShow(state, id, Option.None)
  | ["show", id, n] -> executeShow(state, id, Option.Some(n))
  | _ ->
    printErr(
      "Usage: session new [--branch <name>] [--at <module>] | use <id> | ls | show <id> [<n>] | end <id>")

    failed(state)


let accepts(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("new", Accepts.withValues([ "--branch", "--at" ], Accepts.nothing()))
      ("use", Accepts.between(1, 1, []))
      ("ls", Accepts.nothing())
      ("show", Accepts.between(1, 2, []))
      ("end", Accepts.between(1, 1, [])) ],
    Accepts.nothing())


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: session new [--branch <name>] [--at <module>]   make a session, print its id (s1, ...)"
    "       session use <id>              write .darklang/session here, so `dark @` means <id>"
    "       session ls                    the sessions, one per line"
    "       session show <id> [<n>]       where it stands, and the last batch's replies in full"
    "       session end <id>              forget a session; its branch and code stay"
    ""
    "Run lines in a session with `dark @<id>` (or `dark @` where .darklang/session names one),"
    "as arguments or on stdin:"
    ""
    "  dark @s1 'view Me.Demo'"
    "  dark @s1 <<'EOF'"
    "  let xs = [1, 2, 3]"
    "  fn Me.Demo.double '(a: Int64): Int64 = a * 2'"
    "  Stdlib.List.map(xs, fun x -> Me.Demo.double(x))"
    "  watch Me.Demo.double(4)"
    "  EOF"
    ""
    "  --continue   run every line even after one fails"
    "  --json       the replies and report as one JSON object"
    ""
    "Each line is a command (as typed after `dark`), `let`, `watch <expr>` or a Dark expression;"
    "an indented line continues the one above, and a command ending in `-` reads its indented"
    "lines as stdin. One numbered reply per line, then `-- ` lines: a summary, the typecheck of"
    "each module the batch wrote to, watched values, and where the session stands. The first"
    "failure skips the rest. Exit 0 when every line worked, 1 when one failed, 2 when the batch"
    "could not start." ]
  |> Stdlib.String.join("\n")
