module Darklang.Cli.Packages.Edit

/// Change what already exists, without retyping it.
///
///   dark edit <name>           opens $EDITOR on the declaration, applies it on save
///   dark edit <name> <file>    applies that file, no editor and no terminal
///   dark edit <module>         every declaration directly under it, same two shapes
///
/// Two shapes because the callers want opposite things: a person wants an editor, a script wants
/// none. The file shape pairs with `dark view <name> --raw`, which prints exactly what this
/// accepts. Both land through `dark module`, which validates every declaration before saving any.

/// $EDITOR, then $VISUAL, then `vi`, so a per-invocation `EDITOR=` beats a shell-wide `VISUAL`.
let editorCommand () : String =
  match Stdlib.Env.get "EDITOR" with
  | Some e when e != "" -> e
  | _ ->
    match Stdlib.Env.get "VISUAL" with
    | Some v when v != "" -> v
    | _ -> "vi"


/// The `/Owner.Mod` form `dark module` takes.
let moduleArgFor (owner: String) (modules: List<String>) : String =
  "/" + (Stdlib.String.join (Stdlib.List.append [ owner ] modules) ".")


/// Every declaration directly under <param modulePath>, rendered, with the names it rendered.
/// Types, then values, then functions, each alphabetical: the order the module listing uses, and
/// deterministic so a render-edit-save round trip does not churn the file.
let moduleSource
  (branchId: Uuid)
  (modulePath: List<String>)
  : (String * List<String>) =
  let results = Packages.Query.allDirectDescendants branchId modulePath

  let render (wrap: LanguageTools.ProgramTypes.PackageLocation -> Packages.PackageLocation) (items: List<'a>) : List<(String * String)> =
    items
    |> Stdlib.List.map (fun i -> i.location)
    |> Stdlib.List.sortBy (fun loc -> loc.name)
    |> Stdlib.List.filterMap (fun loc ->
      match Packages.View.rawSource branchId (wrap loc) with
      | Ok src -> Stdlib.Option.Option.Some((loc.name, src))
      | Error _ -> Stdlib.Option.Option.None)

  let rendered =
    Stdlib.List.append
      (render (fun l -> Packages.PackageLocation.Type l) results.types)
      (Stdlib.List.append
        (render (fun l -> Packages.PackageLocation.Value l) results.values)
        (render (fun l -> Packages.PackageLocation.Function l) results.fns))

  let names = rendered |> Stdlib.List.map (fun r -> let (n, _) = r in n)
  let body = rendered |> Stdlib.List.map (fun r -> let (_, s) = r in s)

  (Stdlib.String.join body "\n\n", names)


/// The editor round trip: <param before> into a temp file, $EDITOR, then <param apply> on the
/// result. Whether anything landed is asked by comparing <param current> against `before`, not
/// against what you typed, since the store pretty-prints. The temp file is the only copy of the
/// edit, so it survives a rejection and its path is printed; on success it goes.
let editInteractively
  (state: AppState)
  (label: String)
  (fileStem: String)
  (before: String)
  (apply: String -> AppState)
  (current: Unit -> String)
  : AppState =
  // An editor without a terminal paints control sequences into whatever it was piped to.
  match Stdlib.Cli.Tui.TerminalSupport.current () with
  | Unavailable reason ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Cannot open an editor: {reason}.")

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        $"  `dark edit {label} <file>` applies a file instead, with no terminal.")

    state
  | Available ->

  match Stdlib.Cli.Dir.createTemp () with
  | Error e ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error $"Cannot edit {label}: no temp directory ({e.message})")

    state
  | Ok dir ->
    let path = $"{dir}/{fileStem}.dark"

    match Stdlib.Cli.File.writeText path before with
    | Error e ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.error
          $"Cannot edit {label}: could not write {path} ({e.message})")

      state
    | Ok _ ->
      let editor = editorCommand ()

      match Stdlib.Cli.Process.runInteractive editor [ path ] with
      | Error e ->
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.error $"Could not run `{editor}`: {e.message}")

        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.dimText
            $"  Set $EDITOR, or edit {path} and run `dark edit {label} {path}`.")

        state
      // A non-zero exit is how most editors say "forget it": nothing applied, file kept.
      | Ok code when code != 0 ->
        Stdlib.printLine
          $"`{editor}` exited {Stdlib.toString code}; nothing applied."

        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.dimText $"  Your edit is still at {path}.")

        state
      | Ok _ ->
        match Stdlib.Cli.File.readText path with
        | Error e ->
          Stdlib.printLine
            (Stdlib.Cli.UI.Colors.error $"Could not read back {path}: {e.message}")

          state
        | Ok after ->
          if (Stdlib.String.trim after) == (Stdlib.String.trim before) then
            let _ = Stdlib.Cli.Dir.deleteRecursive dir
            Stdlib.printLine (Stdlib.Cli.UI.Colors.success "no change.")
            state
          else
            let result = apply path

            if (Stdlib.String.trim (current ())) != (Stdlib.String.trim before) then
              let _ = Stdlib.Cli.Dir.deleteRecursive dir
              result
            else
              Stdlib.printLine
                (Stdlib.Cli.UI.Colors.dimText
                  $"  nothing landed; your edit is still at {path}")

              result


/// `dark edit <module>`. Applies through `dark module`, which adds and updates but never unbinds:
/// a declaration left out of the file is reported and left alone, because guessing the other way
/// would let one mis-parse quietly end a name. `dark remove` is how a name ends.
let editModule
  (state: AppState)
  (modulePath: List<String>)
  (fileArg: Stdlib.Option.Option<String>)
  : AppState =
  let branchId = state.currentBranchId
  let dotted = Stdlib.String.join modulePath "."
  let moduleArg = "/" + dotted
  let (before, namesBefore) = moduleSource branchId modulePath

  // Only after an apply that landed: a parse error lands nothing, and "left alone" would read
  // as though the rest went in.
  let applyReportingOmissions (path: String) (source: String) : AppState =
    let result = Packages.ModuleCommand.execute state [ moduleArg, path ]

    let gone =
      namesBefore
      |> Stdlib.List.filter (fun n -> Stdlib.Bool.not (Stdlib.String.contains source n))

    if (result.exitCode == 0) && (gone != []) then
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.dimText
          $"  left alone, not in your file: {Stdlib.String.join gone ", "}")

      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.dimText
          "  editing a module does not end a name. `dark remove <name>` does, explicitly.")

      result
    else
      result

  match fileArg with
  | Some file ->
    match Stdlib.Cli.File.readText file with
    | Error e ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Cannot read {file}: {e.message}")
      state
    | Ok source -> applyReportingOmissions file source
  | None ->

  if namesBefore == [] then
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error $"{dotted} has no declarations directly under it.")

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  `dark ls` shows what is there; a module of submodules is edited one level down.")

    state
  else
    editInteractively
      state
      dotted
      dotted
      before
      (fun path ->
        match Stdlib.Cli.File.readText path with
        | Ok source -> applyReportingOmissions path source
        | Error _ -> applyReportingOmissions path "")
      (fun () -> let (now, _) = moduleSource branchId modulePath in now)


let execute (state: AppState) (args: List<String>) : AppState =
  let branchId = state.currentBranchId

  let named =
    match args with
    | [ name ] -> Stdlib.Result.Result.Ok((name, Stdlib.Option.Option.None))
    | [ name, file ] ->
      Stdlib.Result.Result.Ok((name, Stdlib.Option.Option.Some file))
    | _ -> Stdlib.Result.Result.Error "usage: dark edit <name> [file]"

  match named with
  | Error e ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  `dark edit <name>` opens $EDITOR; with a <file> it applies that.")

    state
  | Ok((name, fileArg)) ->

  match Traversal.traverse branchId state.packageData.currentLocation name with
  | Error e ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Cannot edit {name}: {e}")
    state
  | Ok location ->

  let itemLoc =
    match location with
    | Module _ -> Stdlib.Option.Option.None
    | Type loc -> Stdlib.Option.Option.Some loc
    | Value loc -> Stdlib.Option.Option.Some loc
    | Function loc -> Stdlib.Option.Option.Some loc
    | Trait loc -> Stdlib.Option.Option.Some loc
    | Impl loc -> Stdlib.Option.Option.Some loc

  match (location, itemLoc) with
  | (Module modulePath, _) -> editModule state modulePath fileArg
  | (_, None) ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Cannot edit {name}.")
    state
  | (_, Some loc) ->

  let apply (path: String) : AppState =
    Packages.ModuleCommand.execute state [ moduleArgFor loc.owner loc.modules, path ]

  match fileArg with
  | Some file -> apply file
  | None ->

  match Packages.View.rawSource branchId location with
  | Error e ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Cannot edit {name}: {e}")
    state
  | Ok before ->
    editInteractively
      state
      name
      loc.name
      before
      apply
      (fun () ->
        match Packages.View.rawSource branchId location with
        | Ok now -> now
        | Error _ -> before)


let help (_state: AppState) : String =
  [ ""
    "  dark edit <name>           open $EDITOR on the declaration, apply on save"
    "  dark edit <name> <file>    apply that file instead (no editor, for scripts)"
    "  dark edit <module>         the whole module at once, same two shapes"
    ""
    "  A MODULE opens every declaration directly under it, and applies them in one"
    "  batch: all of them are validated first, so a half-finished edit lands nothing"
    "  rather than half. Leaving a declaration OUT does not end it -- the ones you"
    "  omitted are named back to you and left alone. `dark remove <name>` ends a"
    "  name, explicitly and in one op."
    ""
    "  The file holds one declaration, the same form `dark module` takes."
    "  `dark view <name> --raw` prints exactly that form, so reading an item,"
    "  changing it and writing it back is a pipe:"
    ""
    "    dark view Foo.bar --raw > /tmp/bar.dark"
    "    ...edit it..."
    "    dark edit Foo.bar /tmp/bar.dark"
    ""
    "  Editing is live: the change takes effect immediately and shows up in"
    "  `dark status` as a draft item, like any other edit."
    ""
    "  The first form needs a terminal on both ends, since it hands one to your"
    "  editor. Without one, use the second." ]
  |> Stdlib.String.join "\n"


let complete
  (state: AppState)
  (args: List<String>)
  : List<Completion.CompletionItem> =
  Packages.View.complete state args
