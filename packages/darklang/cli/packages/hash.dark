module Darklang.Cli.Packages.Hash

// `dark hash <name>` -- the content hash of what a name currently holds.
//
// It resolves its argument with `Traversal.traverse`, the same walk `view`, `ls` and `tree` use,
// rather than parsing the string into a location itself. Parsing it here read the first segment as
// the OWNER, so `hash Stdlib.List.head` looked for an owner called Stdlib and reported "Not found"
// on a name that `view Stdlib.List.head` printed happily. One name, two answers, and the failing one
// is the command you reach for when you want to be precise.

let formatHash(hash: LanguageTools.ProgramTypes.Hash, long: Bool): String =
  if long then
    LanguageTools.ProgramTypes.hashToString(hash)
  else
    LanguageTools.ProgramTypes.hashToShort(hash)


/// What `hash --json` prints. <param hash> is always the full hash.
type HashJson =
  { item: String
    kind: String
    hash: String }


let execute(state: AppState, args: List<String>): AppState =
  let long = Stdlib.List.any(args, fun a -> a == "--long" || a == "--full")
  let json = Stdlib.List.contains(args, "--json")
  let filteredArgs =
    args |> Stdlib.List.filter(fun a -> a != "--long" && a != "--full" && a != "--json")
  match filteredArgs with
  | [] ->
    Stdlib.printLine("Usage: hash [--long] [--json] <location>")
    state
  | [locationStr, ...] ->
    let branchId = state.currentBranchId
    match Traversal.traverse(branchId, state.packageData.currentLocation, locationStr) with
    | Error(e) ->
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error(e))
      { state with exitCode = 1 }
    | Ok(location) ->
      let found =
        match location with
        | Module(_) -> Option.None
        | Type(loc) ->
          LanguageTools.PackageManager.Type.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("type", Deps.fqnOf(loc), h))
        | Function(loc) ->
          LanguageTools.PackageManager.Function.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("fn", Deps.fqnOf(loc), h))
        | Value(loc) ->
          LanguageTools.PackageManager.Value.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("value", Deps.fqnOf(loc), h))
        | Trait(loc) ->
          LanguageTools.PackageManager.Trait.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("trait", Deps.fqnOf(loc), h))
        | Impl(loc) ->
          LanguageTools.PackageManager.TraitImpl.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("impl", Deps.fqnOf(loc), h))
        | Test(loc) ->
          LanguageTools.PackageManager.Test.find(branchId, loc)
          |> Stdlib.Option.map(fun h -> ("test", Deps.fqnOf(loc), h))

      match found with
      | Some((kindStr, name, hash)) ->
        if json then
          let printed =
            printJson(
              Stdlib.Json.checkedSerialize<HashJson>(
                HashJson
                  { item = name
                    kind = kindStr
                    hash = formatHash(hash, true) }))

          exitWith(state, printed)
        else
          Stdlib.printLine($"{kindStr} {formatHash(hash, long)}")
          state
      | None ->
        // A module resolves fine and simply has nothing to hash: it is a path, not content.
        match location with
        | Module(path) ->
          let dotted = Stdlib.String.join(path, ".")
          Stdlib.printErrorLine(
            Stdlib.Cli.UI.Colors.error($"{dotted} is a module, and a module has no hash."))

          Stdlib.printErrorLine("  `dark ls` lists what is in it; each item has its own.")
          { state with exitCode = 1 }
        | _ ->
          Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Not found: {locationStr}"))
          { state with exitCode = 1 }


let help(_state: AppState): String =
  [ "Usage: hash [--long] [--json] <location>"
    "Show the hash of a package type, function, value, or test."
    "By default shows a short (8-char) hash; use --long or --full for the full hash."
    "--json prints one object, {\"item\", \"kind\", \"hash\"}, with the full hash."
    ""
    "The name is resolved the way `view` resolves it, so anything you can view,"
    "you can hash: relative to where you are, or absolute with a leading `/`."
    ""
    "Examples:"
    "  hash MyType          -- short hash of type at current location"
    "  hash --long MyType   -- full hash"
    "  hash --json MyType   -- {\"item\":\"Owner.M.MyType\",\"kind\":\"type\",\"hash\":\"...\"}"
    "  hash Module.myFn     -- hash of fn in submodule"
    "  hash /Owner.M.x      -- hash at absolute path" ]
  |> Stdlib.String.join("\n")


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let branchId = state.currentBranchId
  match Stdlib.List.last(args) with
  | Some(lastArg) ->
    Traversal.completePartialPath(branchId, state.packageData.currentLocation, lastArg)
  | None -> Traversal.completePartialPath(branchId, state.packageData.currentLocation, "")
