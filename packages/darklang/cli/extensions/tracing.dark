/// Tracing: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Tracing

val extension: Extension =
  Extension
    { name = "tracing"
      title = "Tracing"
      blurb = "Keep a record of every run, and read it back"
      under = ""
      needs = []
      commands = [ "traces", "ps" ]
      adds = []
      asks = []
      settings = [ ("trace.record", "on") ]
      installs = ""
      guide = [ "dark traces    dark traces show <id>    dark ps" ]
      pane = "Darklang.Cli.Extensions.Tracing.pane"
      handlers = "Darklang.Cli.Extensions.Tracing.commands"
      tour =
        [ Step
            { say = "Every run is kept now: its input, what it called, what it returned."
              run = [ "traces" ]
              expect = "" }

          Step
            { say = "`traces show <id>` opens one. `ps` lists what is running right now."
              run = [ "ps" ]
              expect = "this instance" } ]
      peeks =
        [ Peek { label = "processes and traces", command = [ "docs", "traces" ] }
          Peek { label = "traces", command = [ "help", "traces" ] } ]
      fake = "" }


let acceptsTraces(): Accepts.Accepts =
  Accepts.everywhere(
    [ "-y", "--yes", "--json", "--inspect", "--full" ],
    [ "--iteration" ],
    Accepts.subcommands(
      [ ("list", Accepts.withValues([ "--fn", "--route" ], Accepts.upTo(1, [])))
        ("follow", Accepts.withValues([ "--route" ], Accepts.nothing()))
        ("stats", Accepts.upTo(1, []))
        ("tail", Accepts.withValues([ "--route" ], Accepts.upTo(1, [])))
        ("find", Accepts.text(1))
        ("fns", Accepts.upTo(1, [ "--all" ]))
        ("hotspots", Accepts.upTo(1, []))
        ("view", Accepts.between(1, 2, [ "--watch" ]))
        (
          "details",
          Accepts.withValues(
            [ "--filter", "--exclude", "--slow-ms", "--depth" ],
            Accepts.between(1, 1, [ "--all", "--slow", "-d", "--no-builtins", "--no-stdlib" ])))

        ("log", Accepts.text(0))
        ("record", Accepts.upTo(1, []))
        (
          "inspect",
          Accepts.withValues(
            [ "--filter", "--exclude", "--slow-ms", "--depth" ],
            Accepts.between(1, 1, [ "--all", "--slow", "-d", "--no-builtins", "--no-stdlib" ])))

        ("resume", Accepts.between(1, 1, []))
        ("fork", Accepts.withValues([ "--at" ], Accepts.between(1, 1, [])))
        ("pin", Accepts.between(1, 1, []))
        ("unpin", Accepts.between(1, 1, []))
        ("calls", Accepts.between(1, 1, []))
        ("show", Accepts.between(1, 2, [ "--watch" ]))
        ("values", Accepts.text(0))
        ("rerun", Accepts.between(1, 1, []))
        ("delete", Accepts.withValues([ "--keep", "--before" ], Accepts.upTo(1, [ "--all" ]))) ],
      Accepts.nothing()))


let acceptsPs(): Accepts.Accepts =
  Accepts.everywhere(
    [ "--json" ],
    [],
    Accepts.subcommands(
      [ ("show", Accepts.between(1, 1, [ "--full" ]))
        ("cancel", Accepts.between(1, 1, []))
        ("kill", Accepts.between(1, 1, [])) ],
      Accepts.flagsOnly([ "--watch" ])))


let commands(): List<Registry.CommandHandler> =
  [ (
      "traces",
      "The runs this instance has kept: what ran, what it did, and resuming one",
      [ "trace", "exec", "runs" ],
      acceptsTraces,
      Tracing.execute,
      Tracing.help,
      Tracing.complete)

    (
      "ps",
      "What is running: this instance's processes, then other Darks on this machine",
      [ "processes" ],
      acceptsPs,
      Ps.execute,
      Ps.help,
      Ps.complete) ]
  |> Stdlib.List.map(Registry.handler)


let pane(input: PaneInput): Pane =
  let recording =
    if setting(input, "trace.record") == "on" then
      "Every run is recorded."
    else
      "Runs are not recorded. Turning tracing off and on starts again."

  Pane
    { lines = [ recording ]
      actions =
        [ Action { key = "t", label = "the newest runs", command = [ "traces" ] }
          Action
            { key = "d"
              label = "keep only the newest 20"
              command = [ "traces", "delete", "--keep", "20" ] } ] }
