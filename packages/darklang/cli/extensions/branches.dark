/// Branches: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Branches

val extension: Extension =
  Extension
    { name = "branches"
      title = "Branches"
      blurb = "Try an idea on a line of its own, then merge it"
      under = "history"
      needs = []
      commands =
        [ "branch", "branches", "switch", "merge", "rebase", "diff", "log", "resolve", "conflicts" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = ""
      handlers = "Darklang.Cli.Extensions.Branches.commands"
      tour =
        [ Step
            { say = "A branch is a line of work of its own: main can't see it until you merge."
              run = [ "branches" ]
              expect = "" }

          Step
            { say =
                "`switch -c idea` starts one and moves you onto it; `merge idea` brings it back."
              run = []
              expect = "" } ]
      peeks =
        [ Peek { label = "branches, merging, conflicts", command = [ "docs", "scm" ] }
          Peek { label = "what merge takes", command = [ "help", "merge" ] } ]
      fake = "" }


let acceptsBranch(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("list", Accepts.flagsOnly([ "--all" ]))
      ("current", Accepts.nothing())
      ("switch", Accepts.between(1, 1, []))
      ("new", Accepts.between(1, 1, []))
      ("create", Accepts.between(1, 1, []))
      ("archive", Accepts.between(1, 1, [ "-y", "--yes" ]))
      ("rename", Accepts.between(2, 2, []))
      ("diff", Accepts.between(1, 1, [ "--source" ]))
      ("log", Accepts.between(1, 1, []))
      ("merge", Accepts.between(1, 1, [ "-y", "--yes", "--allow-type-errors", "--dry-run" ]))
      ("rebase", Accepts.between(1, 1, []))
      ("resolve", Accepts.between(3, 3, [])) ],
    Accepts.upTo(1, []))


let acceptsRebase(): Accepts.Accepts =
  Accepts.upTo(1, [ "--dry-run" ])


let acceptsMerge(): Accepts.Accepts =
  Accepts.upTo(1, [ "-y", "--yes", "--allow-type-errors", "--dry-run" ])


let acceptsBranches(): Accepts.Accepts = Accepts.flagsOnly([ "--all", "--json" ])

let acceptsSwitch(): Accepts.Accepts = Accepts.upTo(1, [ "-c", "--create" ])

let acceptsDiff(): Accepts.Accepts = Accepts.upTo(1, [ "--source", "--json" ])

let acceptsLog(): Accepts.Accepts = Accepts.upTo(1, [ "--json" ])

let acceptsResolve(): Accepts.Accepts = Accepts.between(3, 3, [])


let acceptsConflicts(): Accepts.Accepts =
  Accepts.everywhere(
    [ "--json" ],
    [],
    Accepts.subcommands(
      [ ("list", Accepts.nothing())
        ("walk", Accepts.nothing())
        ("show", Accepts.between(1, 1, []))
        ("ack", Accepts.freeText(1, []))
        ("override", Accepts.between(2, 2, []))
        ("branch", Accepts.between(1, 1, [])) ],
      Accepts.nothing()))


let commands(): List<Registry.CommandHandler> =
  [ (
      "branch",
      "Work on an isolated line of work (create / switch / inspect)",
      [ "br" ],
      acceptsBranch,
      Branch.execute,
      Branch.help,
      Branch.complete)

    (
      "rebase",
      "Accept the parent's changes into a branch",
      [],
      acceptsRebase,
      Branch.executeRebaseCmd,
      Branch.help,
      Branch.complete)

    (
      "merge",
      "Merge a branch into its parent",
      [],
      acceptsMerge,
      Branch.executeMergeCmd,
      Branch.mergeHelp,
      Branch.complete)

    (
      "branches",
      "List your branches",
      [],
      acceptsBranches,
      Branch.executeBranchesCmd,
      Branch.help,
      Branch.complete)

    (
      "switch",
      "Move onto a branch (`switch main` returns)",
      [ "checkout" ],
      acceptsSwitch,
      Branch.executeSwitchCmd,
      Branch.help,
      Branch.complete)

    (
      "diff",
      "What a branch changes vs its parent",
      [],
      acceptsDiff,
      Branch.executeDiffCmd,
      Branch.help,
      Branch.complete)

    (
      "log",
      "History: commits on main, a branch's ops on a branch",
      [],
      acceptsLog,
      Branch.executeLogCmd,
      Branch.help,
      Branch.complete)

    (
      "resolve",
      "Settle one conflicted name on a branch",
      [],
      acceptsResolve,
      Branch.executeResolveCmd,
      Branch.help,
      Branch.complete)

    (
      "conflicts",
      "Review what a merge or rebase auto-resolved",
      [],
      acceptsConflicts,
      Conflicts.execute,
      Conflicts.help,
      Conflicts.complete) ]
  |> Stdlib.List.map(Registry.handler)
