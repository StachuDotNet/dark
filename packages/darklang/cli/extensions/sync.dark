/// Sync: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Sync


val extension: Darklang.Cli.Extensions.Extension =
  { Darklang.Cli.Extensions.named("sync", "Sync", "Your code and drafts on every machine, through one hub") with
      under = "account"
      needs = [ "history" ]
      asks = [ "http https://darklang.com/*" ]
      fake = "sync is in later/; turning it on only records it" }
