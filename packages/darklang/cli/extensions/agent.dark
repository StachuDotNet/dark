/// Agent: the set an agent usually needs. Nothing in it asks for a permission, so an agent can
/// turn it on itself, and never widens what it may do by doing so.
module Darklang.Cli.Extensions.Agent

val extension: Extension =
  Extension
    { name = "agent"
      title = "For an agent"
      blurb = "History, tests and the store tools: what an agent working in the store needs"
      under = ""
      needs = [ "history", "tests", "tools" ]
      commands = []
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = ""
      handlers = ""
      tour = []
      peeks = []
      fake = "" }
