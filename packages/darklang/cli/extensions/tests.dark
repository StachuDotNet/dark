/// Testing: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Testing

val extension: Extension =
  Extension
    { name = "tests"
      title = "Tests"
      blurb = "Tests saved beside your code, run by name"
      under = ""
      needs = []
      commands = [ "test" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide =
        [ "dark test add Me.Hi.greets 'Me.Hi.greet(\"Ada\") |> Stdlib.Test.equal(\"hi Ada\")'"
          "dark test run Me" ]
      pane = "Darklang.Cli.Extensions.Testing.pane"
      handlers = "Darklang.Cli.Extensions.Testing.commands"
      tour =
        [ Step
            { say =
                "A test is saved beside your code, like a fn: `test add Me.Hi.greets '<expression>'`."
              run = []
              expect = "" }

          Step
            { say = "`test run Me` runs yours. A rerun skips what didn't change."
              run = [ "test", "count" ]
              expect = "" } ]
      peeks =
        [ Peek
            { label = "what a test can check", command = [ "docs", "signatures", "Stdlib.Test" ] }

          Peek { label = "test", command = [ "help", "test" ] } ]
      fake = "" }


let acceptsTest(): Accepts.Accepts =
  Accepts.subcommands(
    [ (
        "run",
        Accepts.withValues(
          [ "--jobs", "--seed" ],
          Accepts.freeText(0, [ "--force", "--brief", "--verbose", "--json" ])))

      ("count", Accepts.withValues([ "--for" ], Accepts.freeText(0, [])))
      ("add", Accepts.text(2)) ],
    Accepts.nothing())


let commands(): List<Registry.CommandHandler> =
  [ (
      "test",
      "Run package tests",
      [ "tests" ],
      acceptsTest,
      Packages.Test.execute,
      Packages.Test.help,
      Packages.Test.complete) ]
  |> Stdlib.List.map(Registry.handler)


let pane(_input: PaneInput): Pane =
  Pane
    { lines = [ "Tests live beside your code; a change reruns only what it touches." ]
      actions = [ Action { key = "r", label = "run yours", command = [ "test", "run", "Me" ] } ] }
