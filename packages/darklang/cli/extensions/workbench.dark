/// Workbench: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Workbench

val extension: Extension =
  Extension
    { name = "workbench"
      title = "Workbench"
      blurb = "A full-screen home: browse, edit and run in one place"
      under = ""
      needs = []
      commands = [ "workbench", "clear", "quit" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = ""
      handlers = "Darklang.Cli.Extensions.Workbench.commands"
      tour =
        [ Step
            { say =
                "Bare `dark` opens the workbench now: the store as a tree, with a prompt under it."
              run = []
              expect = "" }

          Step { say = "Type any command at its prompt. esc goes back.", run = [], expect = "" } ]
      peeks = [ Peek { label = "workbench", command = [ "help", "workbench" ] } ]
      fake = "" }


let acceptsQuit(): Accepts.Accepts =
  Accepts.nothing()


let acceptsClear(): Accepts.Accepts =
  Accepts.nothing()


let acceptsWorkbench(): Accepts.Accepts =
  Accepts.flagsOnly([ "--live" ])


let commands(): List<Registry.CommandHandler> =
  [ ("quit", "Exit the CLI", [ "exit", "q" ], acceptsQuit, Quit.execute, Quit.help, Quit.complete)
    (
      "clear",
      "Clear the screen",
      [ "cls" ],
      acceptsClear,
      Clear.execute,
      Clear.help,
      Clear.complete)

    (
      "workbench",
      "Open the workbench -- a framed, navigable package tree",
      [ "wb" ],
      acceptsWorkbench,
      Workbench.execute,
      Workbench.help,
      Workbench.complete) ]
  |> Stdlib.List.map(Registry.handler)
