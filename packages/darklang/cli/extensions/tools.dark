/// Tools: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.Tools

val extension: Extension =
  Extension
    { name = "tools"
      title = "More store tools"
      blurb = "Navigate, refactor, deprecate, check types, back up"
      under = ""
      needs = []
      commands =
        [ "nav"
          "back"
          "tree"
          "find-values"
          "deps"
          "typecheck"
          "impls"
          "edit"
          "rename"
          "hash"
          "deprecate"
          "delete"
          "undeprecate"
          "format"
          "builtins"
          "backups"
          "config"
          "effects" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = ""
      handlers = "Darklang.Cli.Extensions.Tools.commands"
      tour =
        [ Step
            { say = "`deps` says what uses a name, before you change it."
              run = [ "deps", "usedby", "Stdlib.Option.map" ]
              expect = "Stdlib" }

          Step
            { say =
                "`rename` moves a name and updates its callers; `deprecate` retires one without breaking them."
              run = []
              expect = "" } ]
      peeks =
        [ Peek { label = "rename", command = [ "help", "rename" ] }
          Peek { label = "deprecate", command = [ "help", "deprecate" ] } ]
      fake = "" }


let acceptsConfig(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("get", Accepts.between(1, 1, []))
      ("set", Accepts.textBetween(2, 2))
      ("unset", Accepts.between(1, 1, []))
      ("list", Accepts.flagsOnly([ "--json" ])) ],
    Accepts.flagsOnly([ "--json" ]))


let acceptsNav(): Accepts.Accepts = Accepts.upTo(1, [])

let acceptsBack(): Accepts.Accepts = Accepts.nothing()

let acceptsFormat(): Accepts.Accepts = Accepts.freeText(1, [ "--check", "--as-written" ])


let acceptsTree(): Accepts.Accepts =
  Accepts.withValues(
    [ "--depth" ],
    Accepts.upTo(1, [ "--toc", "--include-deprecated", "--include-internal", "--json" ]))


let acceptsTypecheck(): Accepts.Accepts =
  Accepts.upTo(1, [ "--failed", "--incomplete", "--all", "--json" ])


let acceptsDeps(): Accepts.Accepts =
  Accepts.everywhere(
    [ "--json", "--deep", "--all" ],
    [],
    Accepts.subcommands(
      [ ("uses", Accepts.between(1, 1, [])), ("usedby", Accepts.between(1, 1, [])) ],
      Accepts.between(1, 1, [])))


let acceptsEdit(): Accepts.Accepts = Accepts.between(1, 2, [ "--patch" ])

let acceptsRename(): Accepts.Accepts = Accepts.between(2, 2, [])

let acceptsHash(): Accepts.Accepts = Accepts.between(1, 1, [ "--long", "--full" ])


let acceptsUndeprecate(): Accepts.Accepts =
  Accepts.between(1, 1, [ "-y", "--yes" ])


let acceptsBackups(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("list", Accepts.nothing())
      ("now", Accepts.nothing())
      ("prune", Accepts.between(1, 1, [ "-y", "--yes" ]))
      ("restore", Accepts.between(1, 1, [ "-y", "--yes" ])) ],
    Accepts.nothing())


let acceptsBuiltins(): Accepts.Accepts = Accepts.upTo(1, [ "--with-sigs", "--with-purity" ])

let acceptsFindValues(): Accepts.Accepts = Accepts.between(1, 2, [])

let acceptsImpls(): Accepts.Accepts = Accepts.between(1, 1, [ "--json" ])


let acceptsDeprecate(): Accepts.Accepts =
  Accepts.withValues(
    [ "--replacement", "--reason", "-m" ],
    Accepts.between(1, 2, [ "--block-execution", "-y", "--yes", "--dry-run", "--json" ]))


let acceptsDelete(): Accepts.Accepts =
  Accepts.withValues(
    [ "--reason", "-m" ],
    Accepts.between(
      1,
      2,
      [ "-y", "--yes", "--ignore-dependents", "--force", "--dry-run", "--json" ]))


let acceptsEffects(): Accepts.Accepts =
  Accepts.between(1, 1, [])


let commands(): List<Registry.CommandHandler> =
  [ (
      "config",
      "Manage CLI configuration",
      [],
      acceptsConfig,
      Config.execute,
      Config.help,
      Config.complete)

    (
      "nav",
      "Navigate between owners, modules, and items",
      [ "cd" ],
      acceptsNav,
      Packages.Nav.execute,
      Packages.Nav.help,
      Packages.Nav.complete)

    (
      "back",
      "Go back to previous location",
      [],
      acceptsBack,
      Packages.Back.execute,
      Packages.Back.help,
      Packages.Back.complete)

    (
      "format",
      "Format .dark files",
      [ "fmt" ],
      acceptsFormat,
      Format.execute,
      Format.help,
      Format.complete)

    (
      "tree",
      "Display package hierarchy in tree format",
      [ "packages" ],
      acceptsTree,
      Packages.Tree.execute,
      Packages.Tree.help,
      Packages.Tree.complete)

    (
      "typecheck",
      "Audit package declarations without changing them",
      [],
      acceptsTypecheck,
      Packages.Typecheck.execute,
      Packages.Typecheck.help,
      Packages.Typecheck.complete)

    (
      "deps",
      "Show dependencies and dependents",
      [ "dependencies" ],
      acceptsDeps,
      Deps.execute,
      Deps.help,
      Deps.complete)

    (
      "edit",
      "Change an item without retyping it",
      [],
      acceptsEdit,
      Packages.Edit.execute,
      Packages.Edit.help,
      Packages.Edit.complete)

    (
      "rename",
      "Give an item a different name (its content and callers are untouched)",
      [],
      acceptsRename,
      Packages.Rename.execute,
      Packages.Rename.help,
      Packages.Rename.complete)

    (
      "hash",
      "Show hash of a package item",
      [],
      acceptsHash,
      Packages.Hash.execute,
      Packages.Hash.help,
      Packages.Hash.complete)

    (
      "undeprecate",
      "Put a deprecated fn/type/value/trait/impl/test back on the shelf",
      [ "restore" ],
      acceptsUndeprecate,
      Packages.Deprecate.executeUndeprecate,
      Packages.Deprecate.undeprecateHelp,
      (fun(_, args) -> Packages.Deprecate.completeItemTypes(args)))

    (
      "backups",
      "Copies of the store: what exists, take one, prune",
      [],
      acceptsBackups,
      Backups.execute,
      Backups.help,
      Backups.complete)

    (
      "builtins",
      "List all builtin functions and values",
      [],
      acceptsBuiltins,
      Builtins.execute,
      Builtins.help,
      Builtins.complete)

    (
      "find-values",
      "Find values of a given type",
      [],
      acceptsFindValues,
      Packages.FindValues.execute,
      Packages.FindValues.help,
      Packages.FindValues.complete)

    (
      "impls",
      "List the implementations of a trait on this branch",
      [],
      acceptsImpls,
      Packages.Impls.execute,
      Packages.Impls.help,
      Packages.Impls.complete)

    (
      "deprecate",
      "Mark a fn/type/value/trait/impl/test as deprecated",
      [],
      acceptsDeprecate,
      Packages.Deprecate.execute,
      Packages.Deprecate.help,
      Packages.Deprecate.complete)

    (
      "delete",
      "Deprecate items with a live-dependents check",
      [],
      acceptsDelete,
      Packages.Delete.execute,
      Packages.Delete.help,
      Packages.Delete.complete)

    (
      "effects",
      "See what code might do and why",
      [],
      acceptsEffects,
      Effects.execute,
      Effects.help,
      Effects.complete) ]
  |> Stdlib.List.map(Registry.handler)
