/// HttpServer: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.HttpServer

val extension: Extension =
  Extension
    { name = "http-server"
      title = "HTTP server"
      blurb = "Serve your functions on a local port"
      under = ""
      needs = []
      commands = [ "serve" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = ""
      handlers = "Darklang.Cli.Extensions.HttpServer.commands"
      tour =
        [ Step
            { say =
                "`serve <router> --port 8080` serves a fn of yours. The command line is the consent for the port."
              run = []
              expect = "" }

          Step { say = "A router turns a request into a response.", run = [], expect = "" } ]
      peeks =
        [ Peek { label = "serving", command = [ "docs", "http-server" ] }
          Peek { label = "serve", command = [ "help", "serve" ] } ]
      fake = "" }


let acceptsServe(): Accepts.Accepts =
  Accepts.withValues(
    [ "--bind", "--port", "--max-body-bytes" ],
    Accepts.between(1, 1, [ "--live", "--no-live", "--dev" ]))


let commands(): List<Registry.CommandHandler> =
  [ (
      "serve",
      "Start an HTTP server",
      [ "http-server" ],
      acceptsServe,
      Http.Serve.execute,
      Http.Serve.help,
      Http.Serve.complete) ]
  |> Stdlib.List.map(Registry.handler)
