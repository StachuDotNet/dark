/// History: one extension, built the way a user would build theirs.
module Darklang.Cli.Extensions.History

val extension: Extension =
  Extension
    { name = "history"
      title = "History"
      blurb = "Commit what you saved, see what changed, undo"
      under = ""
      needs = []
      commands =
        [ "status", "commit", "commits", "show", "discard", "undo", "ops", "constraints", "ack" ]
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = [ "dark status    dark commit \"what changed\"    dark commits    dark undo <name>" ]
      pane = "Darklang.Cli.Extensions.History.pane"
      handlers = "Darklang.Cli.Extensions.History.commands"
      tour =
        [ Step
            { say = "What you save persists at once, as a draft. `status` says what is in it."
              run = [ "status" ]
              expect = "main" }

          Step
            { say =
                "`commit` turns the draft into a commit, after showing what changed; `commits` lists them."
              run = [ "commits" ]
              expect = "" }

          Step
            { say =
                "Changed your mind? `undo <name>` puts one name back; `discard` drops the whole draft."
              run = []
              expect = "" } ]
      peeks =
        [ Peek { label = "how source control works", command = [ "docs", "scm" ] }
          Peek { label = "what status reports", command = [ "help", "status" ] } ]
      fake = "" }


let acceptsStatus(): Accepts.Accepts =
  Accepts.flagsOnly([ "--json" ])


let acceptsCommits(): Accepts.Accepts =
  Accepts.upTo(1, [ "--json", "--detailed", "--all" ])


let acceptsCommit(): Accepts.Accepts =
  Accepts.withValues(
    [ "--include" ],
    Accepts.freeText(
      0,
      [ "-y", "--yes", "-m", "--message", "--allow-unresolved", "--allow-type-errors", "--json" ]))


let acceptsDiscard(): Accepts.Accepts =
  Accepts.upTo(1, [ "-y", "--yes" ])


let acceptsShow(): Accepts.Accepts =
  Accepts.between(1, 1, [])


let acceptsConstraints(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("resolve", Accepts.withValues([ "--as" ], Accepts.freeText(0, [ "--all", "--why" ])))
      ("ack", Accepts.freeText(0, [ "--all", "--why" ])) ],
    Accepts.withValues([ "--kind" ], Accepts.flagsOnly([ "--json" ])))


let acceptsAck(): Accepts.Accepts =
  Accepts.freeText(0, [ "--all", "--why" ])


let acceptsUndo(): Accepts.Accepts =
  Accepts.between(1, 1, [])


let acceptsOps(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("list", Accepts.upTo(1, [])), ("show", Accepts.between(1, 1, [])) ],
    Accepts.upTo(1, []))


let commands(): List<Registry.CommandHandler> =
  [ (
      "status",
      "What's in your draft, in one line",
      [ "wip", "changes" ],
      acceptsStatus,
      Status.execute,
      Status.help,
      Status.complete)

    (
      "commits",
      "Your commits, newest first",
      [ "history" ],
      acceptsCommits,
      Commits.execute,
      Commits.help,
      Commits.complete)

    (
      "commit",
      "Review your draft, propagate, and commit it",
      [],
      acceptsCommit,
      Commit.execute,
      Commit.help,
      Commit.complete)

    (
      "discard",
      "Drop your draft: everything authored since the last commit",
      [ "reset" ],
      acceptsDiscard,
      Discard.execute,
      Discard.help,
      Discard.complete)

    (
      "show",
      "Show what a commit contains, or what one op does",
      [],
      acceptsShow,
      Commits.executeShow,
      Commits.helpShow,
      Commits.complete)

    (
      "constraints",
      "Standing findings: stale usages, kind changes, rival impls",
      [],
      acceptsConstraints,
      ConstraintsCmd.execute,
      ConstraintsCmd.help,
      ConstraintsCmd.complete)

    (
      "ack",
      "Leave a constraint finding for now (`dark ack --all`)",
      [],
      acceptsAck,
      ConstraintsCmd.executeAckCmd,
      ConstraintsCmd.help,
      ConstraintsCmd.complete)

    (
      "undo",
      "Step an item back to its previous version",
      [],
      acceptsUndo,
      Undo.execute,
      Undo.help,
      Undo.complete)

    ("ops", "Read this instance's op log", [], acceptsOps, Ops.execute, Ops.help, Ops.complete) ]
  |> Stdlib.List.map(Registry.handler)


let pane(_input: PaneInput): Pane =
  let draft = SCM.Draft.read()
  let n = Stdlib.List.length(draft.bindings)
  let line =
    match n with
    | 0 -> "Everything you saved is committed."
    | 1 -> "1 item saved and not committed."
    | _ -> $"{n} items saved and not committed."

  Pane
    { lines = [ line ]
      actions =
        [ Action { key = "s", label = "what changed", command = [ "status" ] }
          Action { key = "l", label = "the last commits", command = [ "commits" ] } ] }
