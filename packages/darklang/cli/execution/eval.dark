/// Eval command - evaluate Dark expressions
module Darklang.Cli.Eval

/// Whether code marked harmful (deprecated as harmful) may run, or halts with an error.
type Harmful =
  | Allow
  | Halt


/// Evaluate an expression and hand back the value it produced, not its printed text. A fn's name
/// evaluates to the fn.
let evaluateValue(
  accountID: Option<Uuid>,
  branchId: Uuid,
  expr: String,
  harmful: Harmful)
  : Result<'a, ExecutionError.ExecutionError> =
  evaluateValueUnder(accountID, branchId, expr, harmful, noGrants())


/// <fn evaluateValue> with <param grants> allowed for this evaluation only (`eval --allow`).
let evaluateValueUnder(
  accountID: Option<Uuid>,
  branchId: Uuid,
  expr: String,
  harmful: Harmful,
  grants: LanguageTools.Permissions.Policy)
  : Result<'a, ExecutionError.ExecutionError> =
  let allowHarmful =
    match harmful with
    | Allow -> true
    | Halt -> false

  Builtin.cliEvaluateExpression(accountID, branchId, expr, allowHarmful, grants)


let noGrants(): LanguageTools.Permissions.Policy =
  LanguageTools.Permissions.Policy { allow = [], deny = [] }


/// Evaluate an expression, keeping errors structured for the caller.
let evaluateRaw(
  accountID: Option<Uuid>,
  branchId: Uuid,
  expr: String,
  currentModule: List<String>,
  harmful: Harmful)
  : Result<Option<String>, ExecutionError.ExecutionError> =
  evaluateRawUnder(accountID, branchId, expr, currentModule, harmful, noGrants())


/// <fn evaluateRaw> with <param grants> allowed for this evaluation only.
let evaluateRawUnder(
  accountID: Option<Uuid>,
  branchId: Uuid,
  expr: String,
  currentModule: List<String>,
  harmful: Harmful,
  grants: LanguageTools.Permissions.Policy)
  : Result<Option<String>, ExecutionError.ExecutionError> =
  match evaluateValueUnder(accountID, branchId, expr, harmful, grants) with
  | Ok(value) ->
    // Unit has no output, and a string prints without its quotes.
    match LanguageTools.RuntimeTypes.reflect(value) with
    | DUnit -> Result.Ok(Option.None)
    | DString(text) -> Result.Ok(Option.Some(text))
    | dv ->
      let (width, _rows) = Terminal.getSize()
      let color = Stdlib.Cli.Sys.isTerminal(1)
      Result.Ok(Option.Some(Terminal.renderValue(branchId, width, color, currentModule, dv)))
  | Error(error) ->
    match error with
    | Runtime(_, _, _) -> ExecutionError.printCallStack(branchId, "expression", error)
    | _ -> ()

    Result.Error(error)


/// Evaluate `expr` and hand back what it produced: `Ok (Some printed)` for a value, `Ok None` for something
/// that printed nothing, `Error message` for a failure. What the `eval`/REPL path uses - `execute` prints
/// what this returns, and the workbench REPL keeps it as state. Takes the whole expression as one string,
/// so a multi-line let-chain survives.
let evaluate(state: AppState, expr: String, harmful: Harmful): Result<Option<String>, String> =
  evaluateUnder(state, expr, harmful, noGrants())


let evaluateUnder(
  state: AppState,
  expr: String,
  harmful: Harmful,
  grants: LanguageTools.Permissions.Policy)
  : Result<Option<String>, String> =
  // Where the user is standing, so the printed value spells names the way they would.
  let currentModule = Packages.Traversal.getCurrentModulePath(state.packageData.currentLocation)
  match evaluateRawUnder(
          state.accountID,
          state.currentBranchId,
          expr,
          currentModule,
          harmful,
          grants) with
  | Ok(result) -> Result.Ok(result)
  | Error(err) ->
    Result.Error(ExecutionError.formatForTerminal(state.accountID, state.currentBranchId, err))


let execute(state: AppState, args: List<String>): AppState =
  let harmful =
    if Stdlib.List.contains(args, "--allow-harmful") then
      Harmful.Allow
    else
      Harmful.Halt

  let args = args |> Stdlib.List.filter(fun a -> a != "--allow-harmful")
  let (rules, args) = allowRules([], args)
  match Permissions.Command.replacePolicy([ Stdlib.String.join(rules, ";") ]) with
  | Error(message) ->
    printErr(message)
    failed(state)
  | Ok(grants) when Stdlib.Bool.not(Stdlib.List.isEmpty(grants.deny)) ->
    printErr("--allow takes allow rules only")
    failed(state)
  | Ok(grants) -> executeUnder(state, args, harmful, grants)


/// The `--allow <rules>` at the front of <param args>, and what follows them.
let allowRules(rules: List<String>, args: List<String>): (List<String> * List<String>) =
  match args with
  | ["--allow", rule, ...rest] -> allowRules(Stdlib.List.append(rules, rule), rest)
  | _ -> (rules, args)


let executeUnder(
  state: AppState,
  args: List<String>,
  harmful: Harmful,
  grants: LanguageTools.Permissions.Policy)
  : AppState =
  match args with
  | [] ->
    Stdlib.printLine(help(state))
    state
  | _ ->
    // Special case: a single "-" arg means "read expression from stdin" so
    // callers can pipe multi-line expressions via heredoc without quoting.
    let expr =
      match args with
      | ["-"] -> Stdlib.Cli.Stdin.readAll()
      | parts -> Result.Ok(Stdlib.String.join(parts, " "))

    match expr with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(expr) ->
      match evaluateUnder(state, expr, harmful, grants) with
      | Ok(Some(s)) ->
        Stdlib.printLine(s)
        state
      | Ok(None) -> state
      | Error(message) ->
        Stdlib.printErrorLine($"Error: {message}")
        { state with exitCode = 1 }


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: eval [--allow <rules>] <expression>"
    "       eval -    (read expression from stdin, for multi-line input)"
    "Evaluate a Dark expression and display the result."
    ""
    "  --allow   allow resources for this evaluation only, as `run --allow` does"
    ""
    "Examples:"
    "  eval 1 + 2                     - Arithmetic operations"
    "  eval \"hello\" + \"world\"         - String concatenation"
    "  eval [1, 2, 3] |> Stdlib.List.length  - List operations"
    "  eval Stdlib.String.length(\"test\") - Function calls"
    ""
    "  # Multi-line expression via stdin (run from shell, not the REPL):"
    "  dark eval - <<'EOF'"
    "  let xs = [1, 2, 3]"
    "  Stdlib.List.length(xs)"
    "  EOF" ]
  |> Stdlib.String.join("\n")
