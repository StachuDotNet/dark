/// Run a command or start the interactive CLI.
/// Startup has already handled global options.
///
/// Part of `Darklang.Cli`.
module Darklang.Cli

let executeCliCommand(args: List<String>): Int64 =
  let initialState = initState()
  // `dark --plain ls` is `dark ls --plain`.
  let leading = args |> Stdlib.List.takeWhile(fun a -> Stdlib.List.contains(Output.flags, a))
  let args = Stdlib.List.concat(Stdlib.List.drop(args, Stdlib.List.length(leading)), leading)
  match args with
  | [] ->
    if initialState.telemetryEnabled then
      Telemetry.logSessionStart()
      let _ = LanguageTools.InterpreterStats.reset()
      ()

    let watch = Stdlib.Host.begin()

    // `dark` with no args opens the workbench. The workbench owns the alternate screen through
    // its own terminal session, so there is no screen clear or scroll region here.
    let workbenchState = Workbench.execute(initialState, [])

    // Exiting before the loop starts means the workbench refused to open; the loop's own exit is 0.
    if workbenchState.isExiting then
      workbenchState.exitCode
    else
      runInteractiveLoop(workbenchState, watch)
  // Otherwise, execute command directly (shell already split args correctly)
  // `dark @s1` runs a batch in a session; `dark @` in the current one.
  | [commandName, ...commandArgs] when Stdlib.String.startsWith(commandName, "@") ->
    let nonInteractiveState = { initialState with nonInteractive = true }
    let resultState =
      Sessions.Batch.executeCli(
        nonInteractiveState,
        Stdlib.String.dropFirst(commandName, 1),
        commandArgs)

    resultState.exitCode
  | [commandName, ...commandArgs] ->
    let nonInteractiveState = { initialState with nonInteractive = true }
    let resultState = Registry.executeCommand(commandName, nonInteractiveState, commandArgs)

    // If the command launched a full-screen SubApp (a TUI like the workbench), hand off to the
    // interactive loop so it actually runs, instead of exiting the instant the command returns.
    match resultState.currentPage with
    | SubApp(_) -> runInteractiveLoop(resultState, Stdlib.Host.begin())
    | _ -> resultState.exitCode
