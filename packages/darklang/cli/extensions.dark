/// Everything past the kernel is an extension: a package value of type `Extension`, found in the
/// store by its type. The ones below and one a user saves under `Me` are found the same way.
module Darklang.Cli.Extensions

/// A command an extension adds. `run` names a fn that takes the words after the command and
/// returns the exit code; it runs the way `dark run <fn> <words>` does, under the same policy.
type Command =
  { name: String
    description: String
    run: String }


type Extension =
  { /// What you type: `dark ext on <name>`.
    name: String
    title: String
    blurb: String
    /// The extension it sits under in the tree, and so needs; "" at the top.
    under: String
    /// Other extensions it needs.
    needs: List<String>
    /// Commands the CLI already has, which `dark help` lists while it is on.
    commands: List<String>
    /// Commands it adds.
    adds: List<Command>
    /// Permission rules it asks for, in `--allow` form.
    asks: List<String>
    /// Config it sets while on, and unsets when turned off.
    settings: List<(String * String)>
    /// What turning it on downloads or builds; "" for nothing.
    installs: String
    /// Lines `dark help` shows under it while it is on: how its commands go together.
    guide: List<String>
    /// A fn `(PaneInput) -> Pane` the extensions app shows for it; "" for none.
    pane: String
    /// A fn `() -> List<Registry.CommandHandler>`: commands with their own flags, help and
    /// completion, for an extension that needs more than `adds`. "" for none.
    handlers: String
    /// What `explain` walks through: a few steps, each a line or two and a command to try.
    tour: List<Step>
    /// Docs, signatures and examples worth a look while learning it: commands, run with one key.
    peeks: List<Peek>
    /// What this prototype does not do for it yet; "" when it is all real.
    fake: String }


/// One step of a tour: what to know, a command to try (run for you, so you see it), and words
/// its output says, which the tour test checks so a tour can't drift from what the command does.
type Step =
  { say: String
    run: List<String>
    expect: String }


/// Something to look at: a docs page, a signature, an example. A command, so a test can run it.
type Peek =
  { label: String
    command: List<String> }


/// What the kernel hands a pane. A pane is ordinary code: it reads what it is given, and what any
/// code may read by default (the store, traces), never config or the policy.
type PaneInput =
  { on: Bool
    /// The value each config key it sets has now, "" when unset.
    settings: List<(String * String)>
    /// What it was allowed.
    granted: List<String> }


/// A key the person can press on a pane, and the command it runs: the same as typing it. A pane
/// does nothing itself; it proposes, and the person's key press is the yes.
type Action =
  { key: String
    label: String
    command: List<String> }


type Pane =
  { lines: List<String>
    actions: List<Action> }


// --- finding them ---

let found(
  branchId: Uuid,
  hash: LanguageTools.ProgramTypes.Hash)
  : List<LanguageTools.PackageManager.Value.Found<Extension>> =
  LanguageTools.PackageManager.Value.findByType(branchId, "", hash)


/// Every extension in the store, ours and yours, one per name.
let all(branchId: Uuid): List<Extension> =
  match Packages.FindValues.resolveTypeHash(
          branchId,
          Packages.PackageLocation.Module([]),
          "Darklang.Cli.Extensions.Extension") with
  | Ok(hash) ->
    found(branchId, hash)
    |> Stdlib.List.map(fun f -> f.value)
    |> Stdlib.List.sortBy(fun e -> e.name)
    |> Stdlib.List.fold([], fun(kept, e) ->
      if Stdlib.List.any(kept, fun k -> k.name == e.name) then
        kept
      else
        Stdlib.List.append(kept, e))
  | Error(_) -> []


/// The fn bound at <param name> now, by a store lookup: no eval, so no trace, on every start.
let fnNamed(branchId: Uuid, name: String): Result<'a -> 'b, String> =
  match LanguageTools.Live.locationOfName(name) with
  | None -> Result.Error($"Not a package function name: {name}")
  | Some(loc) ->
    match LanguageTools.PackageManager.Function.find(branchId, loc) with
    | None -> Result.Error($"No function named {name}")
    | Some(hash) -> Builtin.applicableByHash(LanguageTools.ProgramTypes.hashToString(hash), name)


/// Every command the extensions in the store bring, on or off: dispatch refuses the ones that are
/// off by name, and help for them still shows.
let handlers(branchId: Uuid): List<Registry.CommandHandler> =
  all(branchId)
  |> Stdlib.List.filter(fun e -> e.handlers != "")
  |> Stdlib.List.map(fun e -> handlersOf(branchId, e))
  |> Stdlib.List.flatten


/// Ours are CLI code, as every command was before extensions, so they are called directly and
/// keep the CLI's access. Anyone else's go through `Live.apply`, which makes the fn the root of
/// the call: its commands run as that code, under the policy, and a broken one fails alone.
let handlersOf(branchId: Uuid, e: Extension): List<Registry.CommandHandler> =
  match fnNamed(branchId, e.handlers) with
  | Ok(f) ->
    if Stdlib.String.startsWith(e.handlers, "Darklang.") then
      f()
    else
      LanguageTools.Live.apply(f, ()) |> Stdlib.Result.withDefault([])
  | Error(_) -> []


let find(exts: List<Extension>, name: String): Option<Extension> =
  Stdlib.List.findFirst(exts, fun e -> e.name == name)


/// A set: an extension that only turns others on.
let isSet(e: Extension): Bool =
  Stdlib.List.isEmpty(e.commands) && Stdlib.List.isEmpty(e.adds) && e.fake == "" && e.needs != []


// --- what is on, and what each was allowed ---
// Both keys are the person's (`personOnly` in LibDB/Config.fs): code Dark runs can't change them.

val onSetting = "extensions.on"

val grantsKey = "extensions.granted"


/// What config says is on. `*` is every extension, found or still to be: the dev store and the
/// test instances start that way.
let chosen(): List<String> =
  match LanguageTools.LocalStore.configGet(onSetting) with
  | Some(s) -> Stdlib.String.split(s, ",") |> Stdlib.List.filter(fun n -> n != "")
  | None -> []


let everythingOn(): Bool =
  chosen() == [ "*" ]


let onNames(exts: List<Extension>): List<String> =
  if everythingOn() then Stdlib.List.map(exts, fun e -> e.name) else chosen()


let saveOn(names: List<String>): Unit =
  let _ =
    if Stdlib.List.isEmpty(names) then
      LanguageTools.LocalStore.configUnset(onSetting)
    else
      LanguageTools.LocalStore.configSet(onSetting, Stdlib.String.join(names, ","))

  ()


/// The code an extension's grants are for: its command fns as they are bound now. When this
/// moves, what it was allowed no longer applies, and turning it on asks again.
let codeVersion(e: Extension): String =
  let branchId = resolveStartingBranch()
  e.adds
  |> Stdlib.List.map(fun c ->
    match LanguageTools.Live.locationOfName(c.run) with
    | Some(loc) ->
      match LanguageTools.PackageManager.Function.find(branchId, loc) with
      | Some(h) -> Stdlib.String.first(LanguageTools.ProgramTypes.hashToString(h), 12)
      | None -> "-"
    | None -> "-")
  |> Stdlib.String.join(",")


/// Every rule an extension was allowed, as `(extension, rule, code version)`.
let grantRows(): List<(String * String * String)> =
  match LanguageTools.LocalStore.configGet(grantsKey) with
  | None -> []
  | Some(s) ->
    Stdlib.String.splitOnNewline(s)
    |> Stdlib.List.filterMap(fun line ->
      match Stdlib.String.split(line, "\t") with
      | [name, rule, version] -> Option.Some((name, rule, version))
      | _ -> Option.None)


let saveGrants(rows: List<(String * String * String)>): Unit =
  let _ =
    if Stdlib.List.isEmpty(rows) then
      LanguageTools.LocalStore.configUnset(grantsKey)
    else
      let value =
        rows
        |> Stdlib.List.map(fun((name, rule, version)) -> name + "\t" + rule + "\t" + version)
        |> Stdlib.String.join("\n")

      LanguageTools.LocalStore.configSet(grantsKey, value)

  ()


/// What <param e> was allowed, for the code it has now.
let granted(e: Extension): List<String> =
  let version = codeVersion(e)
  grantRows()
  |> Stdlib.List.filter(fun((n, _, v)) -> n == e.name && v == version)
  |> Stdlib.List.map(fun((_, rule, _)) -> rule)


/// What <param e> was allowed for code it no longer has.
let staleGrants(e: Extension): List<String> =
  let version = codeVersion(e)
  grantRows()
  |> Stdlib.List.filter(fun((n, _, v)) -> n == e.name && v != version)
  |> Stdlib.List.map(fun((_, rule, _)) -> rule)


/// What <param e> asks for and has not been allowed. Nothing for one that is not built yet:
/// there is nothing to allow it for.
let ungranted(e: Extension): List<String> =
  let given = granted(e)
  if e.fake != "" then
    []
  else
    e.asks |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.List.contains(given, a)))


let grant(e: Extension, rules: List<String>): Unit =
  let version = codeVersion(e)
  let others = grantRows() |> Stdlib.List.filter(fun((n, _, v)) -> n != e.name || v == version)
  saveGrants(Stdlib.List.concat(others, Stdlib.List.map(rules, fun r -> (e.name, r, version))))


let revoke(name: String): List<String> =
  let rows = grantRows()
  saveGrants(rows |> Stdlib.List.filter(fun((n, _, _)) -> n != name))
  rows
  |> Stdlib.List.filter(fun((n, _, _)) -> n == name)
  |> Stdlib.List.map(fun((_, rule, _)) -> rule)


/// The run grants an extension's own commands run with: what it was allowed, for this code.
let grantsFor(e: Extension): LanguageTools.Permissions.Policy =
  let rules =
    granted(e)
    |> Stdlib.List.filterMap(fun r -> LanguageTools.Permissions.parseRuleText(r))
    |> Stdlib.List.flatten

  LanguageTools.Permissions.Policy { allow = rules, deny = [] }


// --- which ones were explained ---

val explainedKey = "extensions.explained"


let explained(): List<String> =
  match LanguageTools.LocalStore.configGet(explainedKey) with
  | Some(s) -> Stdlib.String.split(s, ",") |> Stdlib.List.filter(fun n -> n != "")
  | None -> []


let markExplained(name: String): Unit =
  let seen = explained()
  if Stdlib.List.contains(seen, name) then
    ()
  else
    let _ =
      LanguageTools.LocalStore.configSet(explainedKey, Stdlib.String.join([ name, ...seen ], ","))

    ()


/// <param name> and everything it needs, the needed ones first.
let withNeeds(exts: List<Extension>, name: String, seen: List<String>): List<String> =
  if Stdlib.List.contains(seen, name) then
    seen
  else
    match find(exts, name) with
    | None -> seen
    | Some(e) ->
      let direct = if e.under == "" then e.needs else [ e.under, ...e.needs ]
      let before = Stdlib.List.fold(direct, seen, fun(acc, d) -> withNeeds(exts, d, acc))
      Stdlib.List.append(before, name)


/// The extensions that are on and need <param name>, directly or not.
let neededBy(exts: List<Extension>, on: List<String>, name: String): List<String> =
  on |> Stdlib.List.filter(fun n -> n != name && Stdlib.List.contains(withNeeds(exts, n, []), name))


let commandNames(e: Extension): List<String> =
  Stdlib.List.concat(e.commands, Stdlib.List.map(e.adds, fun c -> c.name))


// --- where a command lives ---

type Home =
  /// The kernel's, or nobody's: dispatch goes on as usual.
  | Free
  /// A command an extension that is on adds.
  | Runs(Extension, Command)
  /// A command of an extension that is off.
  | Off(Extension)


/// Where <param name> lives. <param known> is whether the CLI has a command by that name; one an
/// extension adds never shadows it.
let home(branchId: Uuid, name: String, known: Bool): Home =
  if known && (Stdlib.List.contains(kernel, name) || everythingOn()) then
    Home.Free
  else
    let exts = all(branchId)
    let on = onNames(exts)
    let claims = exts |> Stdlib.List.filter(fun e -> Stdlib.List.contains(commandNames(e), name))
    match Stdlib.List.findFirst(claims, fun e -> Stdlib.List.contains(on, e.name)) with
    | Some(e) ->
      match Stdlib.List.findFirst(e.adds, fun c -> c.name == name) with
      | Some(c) when Stdlib.Bool.not(known) -> Home.Runs(e, c)
      | _ -> Home.Free
    | None ->
      match Stdlib.List.head(claims) with
      | Some(e) -> Home.Off(e)
      | None -> Home.Free


/// Whether the extension that brings <param command> is off.
let isOff(branchId: Uuid, command: String): Bool =
  match home(branchId, command, true) with
  | Off(_) -> true
  | _ -> false


let refuseOff(state: AppState, command: String, e: Extension): AppState =
  printErr($"`{command}` comes with {e.name}, which is off.")
  printHint($"  dark ext on {e.name}")
  failed(state)


/// What `dark <command> --help` adds for a command whose extension is off.
let offNote(branchId: Uuid, command: String): String =
  match home(branchId, command, true) with
  | Off(e) -> $"\n\nComes with {e.name}, which is off: `dark ext on {e.name}`."
  | _ -> ""


/// Run a command an extension adds, the way `dark run <fn>` runs one, with that extension's grants.
let runAdded(state: AppState, e: Extension, c: Command, args: List<String>): AppState =
  let stale = staleGrants(e)
  let _ =
    if Stdlib.List.isEmpty(stale) || Stdlib.Bool.not(Stdlib.List.isEmpty(granted(e))) then
      ()
    else
      printHint(
        $"  {e.name} changed since you allowed {Stdlib.String.join(stale, "; ")}, so it runs without. `dark ext on {e.name}` at a terminal asks again.")

  Run.executeOptions(
    state,
    [],
    [ c.run, ...args ],
    Run.Options { allowHarmful = false, sandbox = false, grants = grantsFor(e) },
    false)


// --- turning on and off ---

let describe(e: Extension): List<String> =
  let names = commandNames(e)
  let given = granted(e)
  let asks =
    e.asks
    |> Stdlib.List.map(fun a -> if Stdlib.List.contains(given, a) then a + " (allowed)" else a)

  [ if Stdlib.List.isEmpty(names) then
      ""
    else
      "adds " + Stdlib.String.join(names, ", ")

    if Stdlib.List.isEmpty(asks) then
      ""
    else
      "asks for " + Stdlib.String.join(asks, "; ")

    if e.installs == "" then "" else "installs " + e.installs

    if e.fake == "" then "" else "prototype: " + e.fake ]
  |> Stdlib.List.filter(fun s -> s != "")


let applySettings(e: Extension, turningOn: Bool): Unit =
  e.settings
  |> Stdlib.List.iter(fun pair ->
    let (key, value) = pair
    let _ =
      if turningOn then
        LanguageTools.LocalStore.configSet(key, value)
      else
        LanguageTools.LocalStore.configUnset(key)

    ())


/// Turn <param name> on, with what it needs: the ones that were off, in the order they went on.
/// What they ask for is not allowed here; see <fn allowAsked>.
let turnOn(exts: List<Extension>, name: String): Result<List<Extension>, String> =
  match find(exts, name) with
  | None -> Result.Error($"No extension called `{name}`.")
  | Some(_) ->
    let on = onNames(exts)
    let turning =
      withNeeds(exts, name, [])
      |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(on, n)))
      |> Stdlib.List.filterMap(fun n -> find(exts, n))

    turning |> Stdlib.List.iter(fun e -> applySettings(e, true))
    saveOn(Stdlib.List.concat(on, Stdlib.List.map(turning, fun e -> e.name)))
    Result.Ok(turning)


let onLines(turned: List<Extension>): List<String> =
  turned
  |> Stdlib.List.map(fun e ->
    let details = describe(e) |> Stdlib.List.map(fun d -> "    " + d)
    [ $"  {e.name} on", ...details ])
  |> Stdlib.List.flatten


/// Turn <param name> off, with what needs it, and forget what each was allowed. Nothing they made
/// is deleted.
let turnOff(exts: List<Extension>, name: String): Result<List<String>, String> =
  let on = onNames(exts)
  if Stdlib.Bool.not(Stdlib.List.contains(on, name)) then
    match find(exts, name) with
    | None -> Result.Error($"No extension called `{name}`.")
    | Some(_) -> Result.Ok([ $"{name} is already off." ])
  else
    let turning = [ name, ...neededBy(exts, on, name) ]
    turning
    |> Stdlib.List.filterMap(fun n -> find(exts, n))
    |> Stdlib.List.iter(fun e -> applySettings(e, false))

    saveOn(on |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(turning, n))))
    let lines =
      turning
      |> Stdlib.List.map(fun n ->
        let taken = revoke(n) |> Stdlib.List.map(fun rule -> $"    no longer allowed: {rule}")
        [ $"  {n} off", ...taken ])
      |> Stdlib.List.flatten

    Result.Ok(lines)


/// Ask the person to allow what <param e> asks for and was not given. Only a person at a terminal
/// can say yes, so an agent turning an extension on never widens what it may do.
let allowAsked(e: Extension): Unit =
  let missing = ungranted(e)
  if Stdlib.List.isEmpty(missing) then
    ()
  else if Stdlib.Cli.UI.Prompt.canAsk() then
    Stdlib.printLine($"  {e.name} asks for:")
    missing |> Stdlib.List.iter(fun r -> Stdlib.printLine("    " + r))
    if Prompt.confirmExplicit(Confirm.Ask, "  Allow it? [y/N]: ") then
      grant(e, missing)
      Stdlib.printLine("  allowed, for its own commands only")
    else
      Stdlib.printLine($"  not allowed. `dark ext on {e.name}` asks again.")
  else
    Stdlib.printLine(
      $"  {e.name} asks for {Stdlib.String.join(missing, "; ")}: not allowed, since only a person at a terminal can allow it.")

    Stdlib.printLine($"  At a terminal: dark ext on {e.name}")


/// `dark ext on <name>`: what went on and what it adds, then the question about what
/// each one asks for.
let enable(exts: List<Extension>, name: String): Result<Unit, String> =
  match turnOn(exts, name) with
  | Error(e) -> Result.Error(e)
  | Ok(turned) ->
    if Stdlib.List.isEmpty(turned) then
      Stdlib.printLine($"{name} is already on.")
    else
      Stdlib.printLines(onLines(turned))

    let asking =
      match find(exts, name) with
      | Some(e) when Stdlib.List.isEmpty(turned) -> [ e ]
      | _ -> turned

    asking |> Stdlib.List.iter(fun e -> allowAsked(e))
    Result.Ok()


// --- tours and peeks ---

/// The steps `explain` walks through. A set has none of its own: it shows the first step of each
/// extension it turns on.
let tourOf(exts: List<Extension>, e: Extension): List<Step> =
  if isSet(e) then
    e.needs
    |> Stdlib.List.filterMap(fun n -> find(exts, n))
    |> Stdlib.List.filterMap(fun m -> Stdlib.List.head(m.tour))
  else
    e.tour


let peeksOf(exts: List<Extension>, e: Extension): List<Peek> =
  if isSet(e) then
    e.needs
    |> Stdlib.List.filterMap(fun n -> find(exts, n))
    |> Stdlib.List.filterMap(fun m -> Stdlib.List.head(m.peeks))
  else
    e.peeks


/// Run a command as typed and keep what it printed, as lines: what a tour step or a peek shows.
let captured(app: AppState, command: List<String>): List<String> =
  match command with
  | [] -> []
  | [name, ...args] ->
    let owned = Builtin.stdoutCaptureStart()
    let _ = Registry.executeCommand(name, app, args)
    let out = if owned then Builtin.stdoutCaptureStop() else ""
    Stdlib.String.splitOnNewline(out)
    |> Stdlib.List.map(fun l -> Stdlib.String.trimEnd(Stdlib.Cli.Tui.Text.stripSgr(l)))
    |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "")
    |> Stdlib.List.take(10)


let typed(command: List<String>): String =
  "$ dark " + Stdlib.String.join(command, " ")


let peekLines(peeks: List<Peek>): List<String> =
  peeks
  |> Stdlib.List.indexedMap(fun(i, p) ->
    let n = Stdlib.display(i + 1)
    let cmd = Stdlib.String.join(p.command, " ")
    $"  {n}  {p.label}  (dark {cmd})")


/// `dark ext explain <name>`: every step, its command run so you see what it does, then
/// what to peek at. Where nothing can be pressed (a pipe, an agent), this is the whole tour.
let explain(app: AppState, exts: List<Extension>, e: Extension): Unit =
  let steps = tourOf(exts, e)
  let total = Stdlib.display(Stdlib.List.length(steps))
  Stdlib.printLine($"{e.title}: {e.blurb}")
  steps
  |> Stdlib.List.indexedMap(fun(i, s) -> (i, s))
  |> Stdlib.List.iter(fun((i, s)) ->
    Stdlib.printLine("")
    Stdlib.printLine($"{Stdlib.display(i + 1)}/{total}  " + s.say)
    if Stdlib.List.isEmpty(s.run) then
      ()
    else
      Stdlib.printLine("  " + typed(s.run))
      captured(app, s.run) |> Stdlib.List.iter(fun l -> Stdlib.printLine("    " + l)))

  match peeksOf(exts, e) with
  | [] -> ()
  | peeks ->
    Stdlib.printLine("")
    Stdlib.printLine("Peek at")
    peeks
    |> Stdlib.List.indexedMap(fun(i, p) -> (i, p))
    |> Stdlib.List.iter(fun((i, p)) ->
      Stdlib.printLine(
        $"  {Stdlib.display(i + 1)}  dark "
        + Stdlib.String.join(p.command, " ")
        + "    "
        + p.label))

  markExplained(e.name)


// --- panes ---

let settingNow(key: String): String =
  LanguageTools.LocalStore.configGet(key) |> Stdlib.Option.withDefault("")


let paneInput(e: Extension, on: List<String>): PaneInput =
  PaneInput
    { on = Stdlib.List.contains(on, e.name)
      settings = e.settings |> Stdlib.List.map(fun((key, _)) -> (key, settingNow(key)))
      granted = granted(e) }


/// Run <param e>'s pane by name, as any code is called: ours and yours alike. A pane that fails
/// says why, in its place.
let runPane(branchId: Uuid, e: Extension, input: PaneInput): Result<Pane, String> =
  match fnNamed(branchId, e.pane) with
  | Error(msg) -> Result.Error(msg)
  | Ok(f) -> LanguageTools.Live.apply(f, input)


let paneOf(branchId: Uuid, e: Extension, on: List<String>): Option<Pane> =
  if e.pane == "" then
    Option.None
  else
    match runPane(branchId, e, paneInput(e, on)) with
    | Ok(p) -> Option.Some(p)
    | Error(msg) -> Option.Some(Pane { lines = [ $"its pane failed: {msg}" ], actions = [] })


let paneLines(p: Pane): List<String> =
  let actions =
    p.actions
    |> Stdlib.List.map(fun a ->
      let cmd = Stdlib.String.join(a.command, " ")
      $"{a.key}  {a.label}  (dark {cmd})")

  Stdlib.List.concat(p.lines, actions)


/// What a pane's key runs: the command it names, as if the person typed it. What it printed comes
/// back as lines, since the extensions app owns the screen.
let runAction(app: AppState, a: Action): List<String> =
  ran(app, a.command)


let ran(app: AppState, command: List<String>): List<String> =
  match command with
  | [] -> []
  | [name, ...args] ->
    let owned = Builtin.stdoutCaptureStart()
    let _ = Registry.executeCommand(name, app, args)
    let out = if owned then Builtin.stdoutCaptureStop() else ""
    let printed =
      Stdlib.String.splitOnNewline(out)
      |> Stdlib.List.map(fun l -> Stdlib.String.trimEnd(Stdlib.Cli.Tui.Text.stripSgr(l)))
      |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "")
      |> Stdlib.List.take(24)

    [ "$ dark " + Stdlib.String.join(command, " "), ...printed ]


/// The value of <param key> a pane was handed, "" when it was not.
let setting(input: PaneInput, key: String): String =
  input.settings
  |> Stdlib.List.findFirst(fun((k, _)) -> k == key)
  |> Stdlib.Option.map(fun((_, v)) -> v)
  |> Stdlib.Option.withDefault("")


// --- the tree ---

type Row =
  { ext: Extension
    depth: Int64 }


let rowsBelow(exts: List<Extension>, parent: String, depth: Int64): List<Row> =
  exts
  |> Stdlib.List.filter(fun e -> e.under == parent)
  |> Stdlib.List.sortBy(fun e -> (if isSet(e) then "0" else "1") + e.name)
  |> Stdlib.List.map(fun e ->
    [ Row { ext = e, depth = depth }, ...rowsBelow(exts, e.name, depth + 1) ])
  |> Stdlib.List.flatten


/// Sets first, then the rest by name, each followed by what sits under it.
let rows(exts: List<Extension>): List<Row> =
  rowsBelow(exts, "", 0)


/// The word at the end of a row: what to know before turning it on.
let tag(e: Extension): String =
  if e.fake != "" then
    "not built"
  else if Stdlib.List.isEmpty(e.asks) then
    ""
  else if Stdlib.List.isEmpty(ungranted(e)) then
    "allowed"
  else
    "asks"


let rowLine(r: Row, on: List<String>, width: Int64): String =
  let mark = if Stdlib.List.contains(on, r.ext.name) then "[x]" else "[ ]"
  let indent = Stdlib.String.repeat("  ", r.depth)
  let name = Stdlib.String.padEnd(indent + r.ext.name, ' ', 16)
  let blurb =
    if isSet(r.ext) then
      "turns on " + Stdlib.String.join(r.ext.needs, ", ")
    else
      r.ext.blurb

  let t = tag(r.ext)
  let prefix = $"{mark} {name} "
  let room =
    width - Stdlib.String.length(prefix) - (if t == "" then 0 else Stdlib.String.length(t) + 2)

  let fitted =
    if Stdlib.String.length(blurb) <= room then
      blurb
    else
      let cut =
        Stdlib.String.slice(blurb, 0, Stdlib.max(0, room - 1)) |> Stdlib.Result.withDefault(blurb)

      cut + "…"

  if t == "" then
    prefix + fitted
  else
    Stdlib.String.padEnd(prefix + fitted, ' ', width - Stdlib.String.length(t)) + t


/// How a line of the picture is drawn. The same lines print through a pipe without the styles.
type Ink =
  | Plain
  | Dim
  | Bold
  | Cursor


/// What one extension adds, needs, asks for and sets, and how to undo it, as label and value.
let facts(exts: List<Extension>, e: Extension): List<(String * String)> =
  let needs = withNeeds(exts, e.name, []) |> Stdlib.List.filter(fun n -> n != e.name)
  let given = granted(e)
  let asks =
    e.asks
    |> Stdlib.List.map(fun a -> if Stdlib.List.contains(given, a) then a + " (allowed)" else a)

  let sets = e.settings |> Stdlib.List.map(fun((k, v)) -> $"{k} {v}")
  [ ("adds", Stdlib.String.join(commandNames(e), " "))
    ("needs", Stdlib.String.join(needs, ", "))
    ("asks for", Stdlib.String.join(asks, "; "))
    ("sets", Stdlib.String.join(sets, ", "))
    ("installs", e.installs)
    (
      "tour",
      if Stdlib.List.isEmpty(e.tour) then
        ""
      else
        $"dark ext explain {e.name}"
        + (if Stdlib.List.contains(explained(), e.name) then " (seen)" else ""))

    ("not built", e.fake) ]
  |> Stdlib.List.filter(fun((_, v)) -> v != "")


let factLines(exts: List<Extension>, e: Extension, isOn: Bool): List<String> =
  let undo =
    if isOn then
      [ ("undo", $"dark ext off {e.name}; nothing it made is deleted") ]
    else
      []

  Stdlib.List.concat(facts(exts, e), undo)
  |> Stdlib.List.map(fun((label, value)) -> "  " + Stdlib.String.padEnd(label, ' ', 11) + value)


let header(exts: List<Extension>, on: List<String>): List<(Ink * String)> =
  let count =
    exts
    |> Stdlib.List.filter(fun e -> Stdlib.List.contains(on, e.name))
    |> Stdlib.List.length

  let total = Stdlib.List.length(exts)
  [ (Ink.Bold, $"Turn on what you want ({count} of {total} on)")
    (Ink.Dim, "Each one adds commands to `dark help`. Turning one off deletes nothing.")
    (Ink.Plain, "") ]


/// The tree without a cursor: what `dark extensions` prints when there is no screen to draw on.
let listing(exts: List<Extension>): List<String> =
  let on = onNames(exts)
  let lines = rows(exts) |> Stdlib.List.map(fun r -> "  " + rowLine(r, on, 78))
  Stdlib.List.flatten(
    [ header(exts, on) |> Stdlib.List.map(fun((_, l)) -> l)
      lines
      [ ""
        "`dark ext show <name>` says what one adds."
        "`dark ext on <name>` turns it on; `off` turns it off." ] ])


let plainRows(exts: List<Extension>): List<String> =
  let on = onNames(exts)
  rows(exts)
  |> Stdlib.List.map(fun r ->
    let state = if Stdlib.List.contains(on, r.ext.name) then "on" else "off"
    let parent = if r.ext.under == "" then "-" else r.ext.under
    let t = if tag(r.ext) == "" then "-" else tag(r.ext)
    $"{r.ext.name}\t{state}\t{parent}\t{t}\t{r.ext.blurb}")


/// The tree at a terminal. It runs as CLI code, as the workbench does: it writes config and asks for
/// grants. What each extension shows of itself is its pane, which runs as that extension's code.
module Tree =
  type Msg =
    | Nothing


  type Model =
    { app: AppState
      exts: List<Extension>
      on: List<String>
      cursor: Int64
      note: List<String>
      /// An extension that was just turned on and asks for something, waiting for y or n.
      asking: Option<Extension>
      /// What was on before each change here, newest first, for `u`.
      past: List<List<String>>
      /// The extension whose walk-through is showing: its peeks run on 1-4.
      explaining: Option<Extension> }


  let init(app: AppState, exts: List<Extension>): Model =
    Model
      { app = app
        exts = exts
        on = onNames(exts)
        // The usual set is where a newcomer starts: enter on it turns it on and explains it.
        cursor =
          rows(exts)
          |> Stdlib.List.indexedMap(fun(i, r) -> (i, r.ext.name))
          |> Stdlib.List.findFirst(fun ((_, n)) -> n == "recommended")
          |> Stdlib.Option.map(fun ((i, _)) -> i)
          |> Stdlib.Option.withDefault(0)
        note = []
        asking = Option.None
        past = []
        explaining = Option.None }


  /// The walk-through, as `dark ext explain <name>` prints it: the tree runs that command
  /// and shows what it said, so the same words are there without a screen.
  let explainHere(m: Model, e: Extension): Model =
    let said = ran(m.app, [ "ext", "explain", e.name ])
    { m with note = said, explaining = Option.Some(e) }


  let runPeek(m: Model, e: Extension, k: String): Model =
    match Stdlib.Int64.parse(k) with
    | Ok(n) ->
      match Stdlib.List.getAt(peeksOf(m.exts, e), n - 1) with
      | Some(p) -> { m with note = ran(m.app, p.command) }
      | None -> m
    | Error(_) -> m


  let selected(m: Model): Option<Extension> =
    Stdlib.List.getAt(rows(m.exts), m.cursor) |> Stdlib.Option.map(fun r -> r.ext)


  let turnOffRow(m: Model, e: Extension): Model =
    let note =
      match turnOff(m.exts, e.name) with
      | Ok(lines) -> lines
      | Error(msg) -> [ msg ]

    { m with on = onNames(m.exts), note = note, past = [ m.on, ...m.past ] }


  /// Turn the selected row on; <param explainIt> walks through it after, once any question about
  /// grants is answered.
  let turnOnRow(m: Model, e: Extension, explainIt: Bool): Model =
    if Stdlib.List.contains(m.on, e.name) then
      if explainIt then explainHere(m, e) else m
    else
      match turnOn(m.exts, e.name) with
      | Error(msg) -> { m with note = [ msg ] }
      | Ok(turned) ->
        let asking = [ e, ...turned ] |> Stdlib.List.findFirst(fun t -> ungranted(t) != [])
        let next =
          { m with
              on = onNames(m.exts)
              note = onLines(turned)
              asking = asking
              past = [ m.on, ...m.past ] }

        if explainIt then explainHere(next, e) else next


  let toggle(m: Model): Model =
    match selected(m) with
    | None -> m
    | Some(e) ->
      if Stdlib.List.contains(m.on, e.name) then
        turnOffRow(m, e)
      else
        turnOnRow(m, e, false)


  /// Back to what was on before the last change: what went on goes off, and what went off comes
  /// back on. A grant that went with it is asked for again.
  let undo(m: Model): Model =
    match m.past with
    | [] -> { m with note = [ "Nothing to undo." ] }
    | [before, ...older] ->
      let offNow =
        m.on |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(before, n)))

      let onNow =
        before |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(m.on, n)))

      let offLines =
        offNow
        |> Stdlib.List.map(fun n -> turnOff(m.exts, n) |> Stdlib.Result.withDefault([]))
        |> Stdlib.List.flatten

      let onLines =
        onNow
        |> Stdlib.List.map(fun n ->
          match turnOn(m.exts, n) with
          | Ok(turned) -> Stdlib.List.map(turned, fun t -> $"  {t.name} on")
          | Error(msg) -> [ msg ])
        |> Stdlib.List.flatten

      { m with
          on = onNames(m.exts)
          note = [ "Undone:", ...Stdlib.List.concat(offLines, onLines) ]
          past = older }


  let answer(m: Model, yes: Bool): Model =
    match m.asking with
    | None -> m
    | Some(e) ->
      let note =
        if yes then
          grant(e, ungranted(e))
          [ $"  {e.name}: allowed, for its own commands only" ]
        else
          [ $"  {e.name}: not allowed. Space twice on it asks again." ]

      { m with asking = Option.None, note = note }


  let move(m: Model, by: Int64): Model =
    let last = Stdlib.List.length(rows(m.exts)) - 1
    { m with
        cursor = Stdlib.max(0, Stdlib.min(last, m.cursor + by))
        note = []
        explaining = Option.None }


  let paneHere(m: Model, e: Extension): Option<Pane> =
    if Stdlib.List.contains(m.on, e.name) then
      paneOf(m.app.currentBranchId, e, m.on)
    else
      Option.None


  /// The whole screen as lines, at <param width> columns: the tree, a rule, then the selected row.
  let picture(m: Model, width: Int64): List<(Ink * String)> =
    let tree =
      rows(m.exts)
      |> Stdlib.List.indexedMap(fun(i, r) ->
        let line = rowLine(r, m.on, width - 4)
        if i == m.cursor then (Ink.Cursor, "> " + line) else (Ink.Plain, "  " + line))

    let rule = (Ink.Dim, Stdlib.String.repeat("─", width))
    let detail =
      match m.asking, selected(m) with
      | Some(e), _ ->
        Stdlib.List.flatten(
          [ [ (Ink.Bold, $"{e.title} asks for") ]
            ungranted(e) |> Stdlib.List.map(fun r -> (Ink.Plain, "  " + r))
            [ (Ink.Plain, "")
              (Ink.Plain, "Allow it, for its own commands only?   y yes   n not now") ] ])
      | None, None -> []
      | None, Some(e) ->
        let isOn = Stdlib.List.contains(m.on, e.name)
        let state = if isOn then "on" else "off"

        let body =
          if Stdlib.List.isEmpty(m.note) then
            factLines(m.exts, e, isOn) |> Stdlib.List.map(fun l -> (Ink.Plain, l))
          else
            m.note |> Stdlib.List.map(fun l -> (Ink.Plain, l))

        let pane =
          match paneHere(m, e) with
          | Some(p) ->
            [ (Ink.Plain, ""), ...Stdlib.List.map(paneLines(p), fun l -> (Ink.Plain, "  " + l)) ]
          | None -> []

        Stdlib.List.flatten(
          [ [ (Ink.Bold, $"{e.title} · {state}"), (Ink.Dim, "  " + e.blurb) ], body, pane ])

    Stdlib.List.flatten([ header(m.exts, m.on), tree, [ rule ], detail ])


  let body(m: Model, width: Int64): Stdlib.Cli.UI.Node.Node<Msg> =
    picture(m, width)
    |> Stdlib.List.map(fun((ink, line)) ->
      match ink with
      | Plain -> Stdlib.Cli.UI.Node.text(line)
      | Dim -> Stdlib.Cli.UI.Node.dim(line)
      | Bold -> Stdlib.Cli.UI.Node.bold(line)
      | Cursor ->
        Stdlib.Cli.UI.Node.styled(
          Stdlib.Cli.UI.Node.Style.Highlight,
          Stdlib.Cli.UI.Node.text(line)))
    |> Stdlib.Cli.UI.Node.column


  let view(m: Model, size: Stdlib.Cli.Tui.Size): Stdlib.Cli.Tui.View =
    let frame =
      Stdlib.Cli.UI.Chrome.frame(
        "extensions",
        "",
        "↑↓ move   e explain   f familiar   n no   space on/off   u undo   q done")

    Stdlib.Cli.UI.Chrome.view(frame, size, fun region ->
      Stdlib.Cli.UI.Node.toRows(body(m, region.cols), region.cols, "")
      |> Stdlib.List.take(region.rows)
      |> Stdlib.List.indexedMap(fun(i, row) -> Stdlib.Cli.UI.Layout.at(region, i, 0, row))
      |> Stdlib.List.flatten)


  /// A key a pane of the selected row offers runs its command; any other does nothing.
  let press(m: Model, k: String): Model =
    match selected(m) with
    | Some(e) ->
      match paneHere(m, e) with
      | Some(p) ->
        match Stdlib.List.findFirst(p.actions, fun a -> a.key == k) with
        | Some(a) -> { m with note = runAction(m.app, a) }
        | None -> m
      | None -> m
    | None -> m


  /// The selected row's answer to "no | explain | familiar".
  let choose(m: Model, answer: String): Model =
    match selected(m) with
    | None -> m
    | Some(e) ->
      match answer with
      | "e" -> turnOnRow(m, e, true)
      | "f" -> turnOnRow(m, e, false)
      | _ -> if Stdlib.List.contains(m.on, e.name) then turnOffRow(m, e) else m


  /// One key per decision. On a row: e explain (turn on, then walk through it), f familiar (turn
  /// on, quietly), n no (turn off); space flips it, enter is e on a row that is off. In a tour any
  /// key moves on, and a number runs that peek. A question about grants takes only y as yes.
  let onKey(
    m: Model,
    key: Stdlib.Cli.Stdin.Key.Key,
    _modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers,
    keyChar: Option<String>)
    : Component.Step<Model> =
    match m.asking with
    | Some(_) ->
      match keyChar with
      | Some("y") -> Component.Step.Stay(answer(m, true))
      | _ -> Component.Step.Stay(answer(m, false))
    | None ->
      match key with
      | UpArrow -> Component.Step.Stay(move(m, -1))
      | DownArrow -> Component.Step.Stay(move(m, 1))
      | Spacebar -> Component.Step.Stay(toggle(m))
      | Enter -> Component.Step.Stay(choose(m, "e"))
      | Escape -> Component.Step.Exit(m)
      | _ ->
        match keyChar with
        | Some("q") -> Component.Step.Exit(m)
        | Some("u") -> Component.Step.Stay(undo(m))
        | Some("k") -> Component.Step.Stay(move(m, -1))
        | Some("j") -> Component.Step.Stay(move(m, 1))
        | Some("e") -> Component.Step.Stay(choose(m, "e"))
        | Some("f") -> Component.Step.Stay(choose(m, "f"))
        | Some("n") -> Component.Step.Stay(choose(m, "n"))
        | Some(k) when Stdlib.List.contains([ "1", "2", "3", "4" ], k) ->
          match m.explaining with
          | Some(e) -> Component.Step.Stay(runPeek(m, e, k))
          | None -> Component.Step.Stay(m)
        | Some(k) -> Component.Step.Stay(press(m, k))
        | None -> Component.Step.Stay(m)


  let component(): Component.Component<Model> =
    Component.simple(view, onKey, Component.noSave)


// --- the command ---

let execute(state: AppState, args: List<String>): AppState =
  let exts = all(state.currentBranchId)
  match args with
  | [] ->
    match Stdlib.Cli.Tui.TerminalSupport.current() with
    | Available when Stdlib.Bool.not(state.output == Output.Mode.Plain) ->
      Component.launch(state, Tree.component(), Tree.init(state, exts))
    | _ -> execute(state, [ "list" ])
  | ["list"] ->
    let lines = if state.output == Output.Mode.Plain then plainRows(exts) else listing(exts)
    Stdlib.printLines(lines)
    state
  | ["show", name] ->
    match find(exts, name) with
    | None ->
      printErr($"No extension called `{name}`.")
      failed(state)
    | Some(e) ->
      let on = onNames(exts)
      let onOff = if Stdlib.List.contains(on, e.name) then "on" else "off"
      let isOn = Stdlib.List.contains(on, e.name)
      let pane =
        match paneOf(state.currentBranchId, e, on) with
        | Some(p) when isOn -> [ "", ...Stdlib.List.map(paneLines(p), fun l -> "  " + l) ]
        | _ -> []

      Stdlib.printLines(
        Stdlib.List.flatten(
          [ [ $"{e.title} · {onOff}", "  " + e.blurb ], factLines(exts, e, isOn), pane ]))

      state
  | ["explain", name] ->
    match find(exts, name) with
    | None ->
      printErr($"No extension called `{name}`.")
      failed(state)
    | Some(e) ->
      explain(state, exts, e)
      state
  | ["on", ...names] | ["enable", ...names] ->
    names
    |> Stdlib.List.fold(state, fun(st, name) ->
      match enable(exts, name) with
      | Ok(_) -> st
      | Error(e) ->
        printErr(e)
        printHint("  `dark ext` lists them.")
        failed(st))
  | ["off", ...names] | ["disable", ...names] ->
    names
    |> Stdlib.List.fold(state, fun(st, name) ->
      match turnOff(exts, name) with
      | Ok(lines) ->
        Stdlib.printLines(lines)
        st
      | Error(e) ->
        printErr(e)
        failed(st))
  | _ ->
    printErr("Usage: ext [list | show <name> | on <name>... | off <name>... | explain <name>]")

    failed(state)


let help(_state: AppState): String =
  [ "Usage: ext [list | show <name> | on <name>... | off <name>... | explain <name>]"
    "Everything past running and keeping code is an extension: turn on what you want."
    "At a terminal, bare `ext` opens the tree; space turns the row on or off."
    ""
    "  list               every extension, on or off, in its tree"
    "  show <name>        what it adds, asks for and installs"
    "  on <name>...       turn it on, and what it needs; at a terminal, allow what it asks for"
    "  off <name>...      turn it off, and what needs it; nothing it made is deleted"
    "  explain <name>     walk through it: a few steps, each command run, then what to peek at"
    ""
    "What an extension asks for is allowed for its own commands only, and only by a person at a"
    "terminal. `dark permissions list` shows what each was allowed."
    ""
    "An extension is a value of type Darklang.Cli.Extensions.Extension anywhere in the store."
    "Save one under Me and it shows up here." ]
  |> Stdlib.String.join("\n")


/// What `docs for-ai` says about extensions in this install: what is on, with how its commands
/// go together, and the one line that turns on the rest.
let forAI(): String =
  let exts = all(resolveStartingBranch())
  let on = onNames(exts)
  let names(keep: Extension -> Bool): String =
    exts
    |> Stdlib.List.filter(keep)
    |> Stdlib.List.map(fun e -> e.name)
    |> Stdlib.String.join(", ")

  let onCount =
    exts
    |> Stdlib.List.filter(fun e -> Stdlib.List.contains(on, e.name) && commandNames(e) != [])
    |> Stdlib.List.length

  let onHere = if onCount == 0 then "" else Stdlib.display(onCount)
  let offHere = names(fun e -> Stdlib.Bool.not(Stdlib.List.contains(on, e.name)) && e.fake == "")
  [ "## Extensions: more commands"
    "  on: " + (if onHere == "" then "none" else onHere + "; `help` has their commands")
    "  off: " + (if offHere == "" then "none" else offHere)
    "  ext on agent   history, tests, tools; asks for nothing" ]
  |> Stdlib.String.join("\n")
  |> Stdlib.String.append("\n")


/// What `permissions list` adds: each extension's grants, which apply to its own commands only.
let grantLines(): List<String> =
  match grantRows() with
  | [] -> []
  | rows ->
    [ "Allowed to extensions, for their own commands:"
      ...Stdlib.List.map(rows, fun((name, rule, version)) ->
        $"  {name}: {rule}  (its code {version})") ]


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] | [_] ->
    [ "list", "show", "on", "off", "explain" ]
    |> Stdlib.List.map(fun s -> Completion.simple(s))
  | [_, ...] -> all(state.currentBranchId) |> Stdlib.List.map(fun e -> Completion.simple(e.name))


// --- `dark help` ---

val kernel =
  [ "run-script"
    "eval"
    "fn"
    "val"
    "type"
    "trait"
    "impl"
    "module"
    "view"
    "ls"
    "search"
    "docs"
    "help"
    "extensions"
    "permissions"
    "install"
    "update"
    "uninstall"
    "version"
    "install-status" ]


let helpText(state: AppState): String =
  let exts = all(state.currentBranchId)
  let on = onNames(exts)
  let onExts = exts |> Stdlib.List.filter(fun e -> Stdlib.List.contains(on, e.name))
  let onCount = Stdlib.List.length(onExts)
  let total = Stdlib.List.length(exts)
  let intro =
    [ "Darklang: a small language that keeps your code in one store, on this machine."
      "Write a script, or save functions and run them by name. Everything else is an"
      "extension you turn on when you want it."
      ""
      "Run code"
      "  dark run hello.dark                  a script file"
      "  dark eval '1 + 2'                    one expression"
      "Keep code"
      "  dark fn Me.Hi.greet '(name: String): String = \"hi \" + name'"
      "  dark eval 'Me.Hi.greet(\"Ada\")'       call what you saved"
      "  dark module Me.Hi - < hi.dark        save a whole module"
      "  dark val, type, trait, impl          save one item of another kind, like fn"
      "  dark ls Me    dark view Me.Hi.greet    dark search \"split a string\""
      "Learn"
      "  dark docs syntax    dark docs for-ai    dark help <command>"
      "  peek: dark docs signatures Stdlib.String    dark view Stdlib.List.map"
      "Grow"
      $"  dark ext                             what you can turn on ({onCount} of {total} on)"
      "This install"
      "  dark permissions    dark update    dark uninstall    dark version" ]

  let added =
    onExts
    |> Stdlib.List.filter(fun e -> Stdlib.Bool.not(Stdlib.List.isEmpty(commandNames(e))))
    |> Stdlib.List.map(fun e ->
      let guide = e.guide |> Stdlib.List.map(fun g -> "                " + g)
      [ "  " + Stdlib.String.padEnd(e.name, ' ', 14) + Stdlib.String.join(commandNames(e), " ")
        ...guide ])
    |> Stdlib.List.flatten

  let addedBlock =
    if Stdlib.List.isEmpty(added) then
      []
    else
      [ "", "From your extensions", ...added ]

  let offNames =
    exts
    |> Stdlib.List.filter(fun e ->
      Stdlib.Bool.not(Stdlib.List.contains(on, e.name)) && e.under == "")
    |> Stdlib.List.map(fun e -> e.name)

  let offBlock =
    if Stdlib.List.isEmpty(offNames) then
      []
    else
      [ ""
        "Off: " + Stdlib.String.join(offNames, ", ")
        "`dark ext show <name>` says what one adds." ]

  Stdlib.String.join(Stdlib.List.flatten([ intro, addedBlock, offBlock ]), "\n")
