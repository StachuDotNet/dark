/// Everything past the kernel is an extension: a package value of type `Extension`, found in the
/// store by its type. The ones below and one a user saves under `Me` are found the same way.
module Darklang.Cli.Extensions

/// A command an extension adds. `run` names a fn that takes the words after the command and
/// returns the exit code; it runs the way `dark run <fn> <words>` does, under the same policy.
type Command =
  { name: String
    description: String
    run: String }


type Extension =
  { /// What you type: `dark extensions enable <name>`.
    name: String
    title: String
    blurb: String
    /// The extension it sits under in the tree, and so needs; "" at the top.
    under: String
    /// Other extensions it needs.
    needs: List<String>
    /// Commands the CLI already has, which `dark help` lists while it is on.
    commands: List<String>
    /// Commands it adds.
    adds: List<Command>
    /// Permission rules it asks for, in `--allow` form.
    asks: List<String>
    /// Config it sets while on, and unsets when turned off.
    settings: List<(String * String)>
    /// What turning it on downloads or builds; "" for nothing.
    installs: String
    /// What this prototype does not do for it yet; "" when it is all real.
    fake: String }


/// An extension that adds commands and nothing else: the usual shape for your own.
let simple(name: String, title: String, adds: List<Command>): Extension =
  Extension
    { name = name
      title = title
      blurb = title
      under = ""
      needs = []
      commands = []
      adds = adds
      asks = []
      settings = []
      installs = ""
      fake = "" }


/// An extension with nothing yet but its name and what it is for.
let named(name: String, title: String, blurb: String): Extension =
  { simple(name, title, []) with blurb = blurb }


let command(name: String, description: String, run: String): Command =
  Command { name = name, description = description, run = run }


