// --- finding them ---

let found(
  branchId: Uuid,
  hash: LanguageTools.ProgramTypes.Hash)
  : List<LanguageTools.PackageManager.Value.Found<Extension>> =
  LanguageTools.PackageManager.Value.findByType(branchId, "", hash)


/// Every extension in the store, ours and yours, one per name.
let all(branchId: Uuid): List<Extension> =
  match Packages.FindValues.resolveTypeHash(
          branchId,
          Packages.PackageLocation.Module([]),
          "Darklang.Cli.Extensions.Extension") with
  | Ok(hash) ->
    found(branchId, hash)
    |> Stdlib.List.map(fun f -> f.value)
    |> Stdlib.List.sortBy(fun e -> e.name)
    |> Stdlib.List.fold([], fun(kept, e) ->
      if Stdlib.List.any(kept, fun k -> k.name == e.name) then
        kept
      else
        Stdlib.List.append(kept, e))
  | Error(_) -> []


let find(exts: List<Extension>, name: String): Option<Extension> =
  Stdlib.List.findFirst(exts, fun e -> e.name == name)


/// A set: an extension that only turns others on.
let isSet(e: Extension): Bool =
  Stdlib.List.isEmpty(e.commands) && Stdlib.List.isEmpty(e.adds) && e.needs != []


// --- what is on, and what each was allowed ---
// Both keys are the person's (`personOnly` in LibDB/Config.fs): code Dark runs can't change them.

val onKey = "extensions.on"

val grantsKey = "extensions.granted"


/// What config says is on. `*` is every extension, found or still to be: the dev store and the
/// test instances start that way.
let chosen(): List<String> =
  match LanguageTools.LocalStore.configGet(onKey) with
  | Some(s) -> Stdlib.String.split(s, ",") |> Stdlib.List.filter(fun n -> n != "")
  | None -> []


let everythingOn(): Bool =
  chosen() == [ "*" ]


let onNames(exts: List<Extension>): List<String> =
  if everythingOn() then Stdlib.List.map(exts, fun e -> e.name) else chosen()


let saveOn(names: List<String>): Unit =
  let _ =
    if Stdlib.List.isEmpty(names) then
      LanguageTools.LocalStore.configUnset(onKey)
    else
      LanguageTools.LocalStore.configSet(onKey, Stdlib.String.join(names, ","))

  ()


/// Every rule an extension was allowed when it was turned on, as `(extension, rule)`.
let grantRows(): List<(String * String)> =
  match LanguageTools.LocalStore.configGet(grantsKey) with
  | None -> []
  | Some(s) ->
    Stdlib.String.splitOnNewline(s)
    |> Stdlib.List.filterMap(fun line ->
      match Stdlib.String.split(line, "\t") with
      | [name, rule] -> Option.Some((name, rule))
      | _ -> Option.None)


let saveGrants(rows: List<(String * String)>): Unit =
  let _ =
    if Stdlib.List.isEmpty(rows) then
      LanguageTools.LocalStore.configUnset(grantsKey)
    else
      let value =
        rows
        |> Stdlib.List.map(fun ((name, rule)) -> name + "\t" + rule)
        |> Stdlib.String.join("\n")

      LanguageTools.LocalStore.configSet(grantsKey, value)

  ()


let granted(name: String): List<String> =
  grantRows()
  |> Stdlib.List.filter(fun ((n, _)) -> n == name)
  |> Stdlib.List.map(fun ((_, rule)) -> rule)


/// What <param e> asks for and has not been allowed.
let ungranted(e: Extension): List<String> =
  let given = granted(e.name)
  e.asks |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.List.contains(given, a)))


let grant(e: Extension, rules: List<String>): Unit =
  saveGrants(Stdlib.List.concat(grantRows(), Stdlib.List.map(rules, fun r -> (e.name, r))))


let revoke(name: String): List<String> =
  let rows = grantRows()
  saveGrants(rows |> Stdlib.List.filter(fun ((n, _)) -> n != name))
  rows
  |> Stdlib.List.filter(fun ((n, _)) -> n == name)
  |> Stdlib.List.map(fun ((_, rule)) -> rule)


/// The run grants an extension's own commands run with: what it was allowed, and nothing else.
let grantsFor(name: String): LanguageTools.Permissions.Policy =
  let rules =
    granted(name)
    |> Stdlib.List.filterMap(fun r -> LanguageTools.Permissions.parseRuleText(r))
    |> Stdlib.List.flatten

  LanguageTools.Permissions.Policy { allow = rules, deny = [] }


/// <param name> and everything it needs, the needed ones first.
let withNeeds(exts: List<Extension>, name: String, seen: List<String>): List<String> =
  if Stdlib.List.contains(seen, name) then
    seen
  else
    match find(exts, name) with
    | None -> seen
    | Some(e) ->
      let direct = if e.under == "" then e.needs else [ e.under, ...e.needs ]
      let before = Stdlib.List.fold(direct, seen, fun(acc, d) -> withNeeds(exts, d, acc))
      Stdlib.List.append(before, name)


/// The extensions that are on and need <param name>, directly or not.
let neededBy(exts: List<Extension>, on: List<String>, name: String): List<String> =
  on |> Stdlib.List.filter(fun n -> n != name && Stdlib.List.contains(withNeeds(exts, n, []), name))


let commandNames(e: Extension): List<String> =
  Stdlib.List.concat(e.commands, Stdlib.List.map(e.adds, fun c -> c.name))


// --- where a command lives ---

type Home =
  /// The kernel's, or nobody's: dispatch goes on as usual.
  | Free
  /// A command an extension that is on adds.
  | Runs(Extension, Command)
  /// A command of an extension that is off.
  | Off(Extension)


/// Where <param name> lives. <param known> is whether the CLI has a command by that name; one an
/// extension adds never shadows it.
let home(branchId: Uuid, name: String, known: Bool): Home =
  if known && (Stdlib.List.contains(kernel, name) || everythingOn()) then
    Home.Free
  else
    let exts = all(branchId)
    let on = onNames(exts)
    let claims = exts |> Stdlib.List.filter(fun e -> Stdlib.List.contains(commandNames(e), name))
    match Stdlib.List.findFirst(claims, fun e -> Stdlib.List.contains(on, e.name)) with
    | Some(e) ->
      match Stdlib.List.findFirst(e.adds, fun c -> c.name == name) with
      | Some(c) when Stdlib.Bool.not(known) -> Home.Runs(e, c)
      | _ -> Home.Free
    | None ->
      match Stdlib.List.head(claims) with
      | Some(e) -> Home.Off(e)
      | None -> Home.Free


let refuseOff(state: AppState, command: String, e: Extension): AppState =
  printErr($"`{command}` comes with {e.name}, which is off.")
  printHint($"  dark extensions enable {e.name}")
  failed(state)


/// What `dark <command> --help` adds for a command whose extension is off.
let offNote(branchId: Uuid, command: String): String =
  match home(branchId, command, true) with
  | Off(e) -> $"\n\nComes with {e.name}, which is off: `dark extensions enable {e.name}`."
  | _ -> ""


/// Run a command an extension adds, the way `dark run <fn>` runs one, with that extension's grants.
let runAdded(state: AppState, e: Extension, c: Command, args: List<String>): AppState =
  Run.executeOptions(
    state,
    [],
    [ c.run, ...args ],
    Run.Options { allowHarmful = false, sandbox = false, grants = grantsFor(e.name) },
    false)


// --- turning on and off ---

let describe(e: Extension): List<String> =
  let names = commandNames(e)
  let given = granted(e.name)
  let asks =
    e.asks
    |> Stdlib.List.map(fun a ->
      if Stdlib.List.contains(given, a) then a + " (allowed)" else a)

  [ if Stdlib.List.isEmpty(names) then
      ""
    else
      "adds " + Stdlib.String.join(names, ", ")

    if Stdlib.List.isEmpty(asks) then
      ""
    else
      "asks for " + Stdlib.String.join(asks, "; ")

    if e.installs == "" then "" else "installs " + e.installs

    if e.fake == "" then "" else "prototype: " + e.fake ]
  |> Stdlib.List.filter(fun s -> s != "")


let applySettings(e: Extension, turningOn: Bool): Unit =
  e.settings
  |> Stdlib.List.iter(fun pair ->
    let (key, value) = pair
    let _ =
      if turningOn then
        LanguageTools.LocalStore.configSet(key, value)
      else
        LanguageTools.LocalStore.configUnset(key)

    ())


/// Turn <param name> on, with what it needs: the ones that were off, in the order they went on.
/// What they ask for is not allowed here; see <fn allowAsked>.
let turnOn(exts: List<Extension>, name: String): Result<List<Extension>, String> =
  match find(exts, name) with
  | None -> Result.Error($"No extension called `{name}`.")
  | Some(_) ->
    let on = onNames(exts)
    let turning =
      withNeeds(exts, name, [])
      |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(on, n)))
      |> Stdlib.List.filterMap(fun n -> find(exts, n))

    turning |> Stdlib.List.iter(fun e -> applySettings(e, true))
    saveOn(Stdlib.List.concat(on, Stdlib.List.map(turning, fun e -> e.name)))
    Result.Ok(turning)


let onLines(turned: List<Extension>): List<String> =
  turned
  |> Stdlib.List.map(fun e ->
    let details = describe(e) |> Stdlib.List.map(fun d -> "    " + d)
    [ $"  {e.name} on", ...details ])
  |> Stdlib.List.flatten


/// Turn <param name> off, with what needs it, and forget what each was allowed. Nothing they made
/// is deleted.
let turnOff(exts: List<Extension>, name: String): Result<List<String>, String> =
  let on = onNames(exts)
  if Stdlib.Bool.not(Stdlib.List.contains(on, name)) then
    match find(exts, name) with
    | None -> Result.Error($"No extension called `{name}`.")
    | Some(_) -> Result.Ok([ $"{name} is already off." ])
  else
    let turning = [ name, ...neededBy(exts, on, name) ]
    turning
    |> Stdlib.List.filterMap(fun n -> find(exts, n))
    |> Stdlib.List.iter(fun e -> applySettings(e, false))

    saveOn(on |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(turning, n))))
    let lines =
      turning
      |> Stdlib.List.map(fun n ->
        let taken =
          revoke(n) |> Stdlib.List.map(fun rule -> $"    no longer allowed: {rule}")

        [ $"  {n} off", ...taken ])
      |> Stdlib.List.flatten

    Result.Ok(lines)


/// Ask the person to allow what <param e> asks for and was not given. Only a person at a terminal
/// can say yes, so an agent turning an extension on never widens what it may do.
let allowAsked(e: Extension): Unit =
  let missing = ungranted(e)
  if Stdlib.List.isEmpty(missing) then
    ()
  else if Stdlib.Cli.UI.Prompt.canAsk() then
    Stdlib.printLine($"  {e.name} asks for:")
    missing |> Stdlib.List.iter(fun r -> Stdlib.printLine("    " + r))
    if Prompt.confirmExplicit(Confirm.Ask, "  Allow it? [y/N]: ") then
      grant(e, missing)
      Stdlib.printLine("  allowed, for its own commands only")
    else
      Stdlib.printLine($"  not allowed. `dark extensions enable {e.name}` asks again.")
  else
    Stdlib.printLine(
      $"  {e.name} asks for {Stdlib.String.join(missing, "; ")}: not allowed, since only a person at a terminal can allow it.")
    Stdlib.printLine($"  At a terminal: dark extensions enable {e.name}")


/// `dark extensions enable <name>`: what went on and what it adds, then the question about what
/// each one asks for.
let enable(exts: List<Extension>, name: String): Result<Unit, String> =
  match turnOn(exts, name) with
  | Error(e) -> Result.Error(e)
  | Ok(turned) ->
    if Stdlib.List.isEmpty(turned) then
      Stdlib.printLine($"{name} is already on.")
    else
      Stdlib.printLines(onLines(turned))

    let asking =
      match find(exts, name) with
      | Some(e) when Stdlib.List.isEmpty(turned) -> [ e ]
      | _ -> turned

    asking |> Stdlib.List.iter(fun e -> allowAsked(e))
    Result.Ok(())


// --- panes ---

let settingNow(key: String): String =
  LanguageTools.LocalStore.configGet(key) |> Stdlib.Option.withDefault("")


let paneInput(e: Extension, on: List<String>): PaneInput =
  PaneInput
    { on = Stdlib.List.contains(on, e.name)
      settings = e.settings |> Stdlib.List.map(fun ((key, _)) -> (key, settingNow(key)))
      granted = granted(e.name) }


/// Run <param e>'s pane by name, as any code is called: ours and yours alike. A pane that fails
/// says why, in its place.
let runPane(branchId: Uuid, e: Extension, input: PaneInput): Result<Pane, String> =
  match LanguageTools.Live.applicableByName(branchId, e.pane) with
  | Error(msg) -> Result.Error(msg)
  | Ok(f) -> LanguageTools.Live.apply(f, input)


let paneOf(branchId: Uuid, e: Extension, on: List<String>): Option<Pane> =
  if e.pane == "" then
    Option.None
  else
    match runPane(branchId, e, paneInput(e, on)) with
    | Ok(p) -> Option.Some(p)
    | Error(msg) -> Option.Some(Pane { lines = [ $"its pane failed: {msg}" ], actions = [] })


let paneLines(p: Pane): List<String> =
  let actions =
    p.actions
    |> Stdlib.List.map(fun a ->
      let cmd = Stdlib.String.join(a.command, " ")
      $"{a.key}  {a.label}  (dark {cmd})")

  Stdlib.List.concat(p.lines, actions)


/// What a pane's key runs: the command it names, as if the person typed it. What it printed comes
/// back as lines, since the extensions app owns the screen.
let runAction(app: AppState, a: Action): List<String> =
  match a.command with
  | [] -> []
  | [name, ...args] ->
    let owned = Builtin.stdoutCaptureStart()
    let _ = Registry.executeCommand(name, app, args)
    let out = if owned then Builtin.stdoutCaptureStop() else ""
    let printed =
      Stdlib.String.splitOnNewline(Stdlib.Cli.Tui.Text.stripSgr(out))
      |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "")
      |> Stdlib.List.take(12)

    [ "$ dark " + Stdlib.String.join(a.command, " "), ...printed ]


/// The panes of the extensions we ship. Each is what a user's would be: a fn of its input.
module Panes =
  let setting(input: PaneInput, key: String): String =
    input.settings
    |> Stdlib.List.findFirst(fun ((k, _)) -> k == key)
    |> Stdlib.Option.map(fun ((_, v)) -> v)
    |> Stdlib.Option.withDefault("")


  let tracing(input: PaneInput): Pane =
    let recording =
      if setting(input, "trace.record") == "on" then
        "Every run is recorded."
      else
        "Runs are not recorded. Turning tracing off and on starts again."

    Pane
      { lines = [ recording ]
        actions =
          [ action("t", "the newest runs", [ "traces" ])
            action("d", "keep only the newest 20", [ "traces", "delete", "--keep", "20" ]) ] }


  let history(_input: PaneInput): Pane =
    let draft = SCM.Draft.read()
    let n = Stdlib.List.length(draft.bindings)
    let line =
      match n with
      | 0 -> "Everything you saved is committed."
      | 1 -> "1 item saved and not committed."
      | _ -> $"{n} items saved and not committed."

    Pane
      { lines = [ line ]
        actions =
          [ action("s", "what changed", [ "status" ])
            action("l", "the last commits", [ "commits" ]) ] }


  let tests(_input: PaneInput): Pane =
    Pane
      { lines = [ "Tests live beside your code; a change reruns only what it touches." ]
        actions = [ action("r", "run yours", [ "test", "run", "Me" ]) ] }


// --- the tree ---

type Row =
  { ext: Extension
    depth: Int64 }


let rowsBelow(exts: List<Extension>, parent: String, depth: Int64): List<Row> =
  exts
  |> Stdlib.List.filter(fun e -> e.under == parent)
  |> Stdlib.List.sortBy(fun e -> (if isSet(e) then "0" else "1") + e.name)
  |> Stdlib.List.map(fun e ->
    [ Row { ext = e, depth = depth }, ...rowsBelow(exts, e.name, depth + 1) ])
  |> Stdlib.List.flatten


/// Sets first, then the rest by name, each followed by what sits under it.
let rows(exts: List<Extension>): List<Row> =
  rowsBelow(exts, "", 0)


let mark(on: Bool): String =
  if on then "[x]" else "[ ]"


let rowLine(r: Row, on: List<String>): String =
  let indent = Stdlib.String.repeat("  ", r.depth)
  let name = Stdlib.String.padEnd(indent + r.ext.name, ' ', 16)
  $"{mark(Stdlib.List.contains(on, r.ext.name))} {name} {r.ext.blurb}"


let listing(exts: List<Extension>): List<String> =
  let on = onNames(exts)
  let count =
    Stdlib.List.length(Stdlib.List.filter(exts, fun e -> Stdlib.List.contains(on, e.name)))

  let total = Stdlib.List.length(exts)
  let tree = rows(exts) |> Stdlib.List.map(fun r -> "  " + rowLine(r, on))
  [ $"Extensions: {count} of {total} on"
    ""
    ...tree
    ""
    "`dark extensions enable <name>` turns one on; `disable` turns it off." ]


let plainRows(exts: List<Extension>): List<String> =
  let on = onNames(exts)
  rows(exts)
  |> Stdlib.List.map(fun r ->
    let state = if Stdlib.List.contains(on, r.ext.name) then "on" else "off"
    let parent = if r.ext.under == "" then "-" else r.ext.under
    $"{r.ext.name}\t{state}\t{parent}\t{r.ext.blurb}")


/// The tree at a terminal. It runs as CLI code, as the workbench does: it reads the store and
/// writes config, which a live view's guest code may not.
module Tree =
  type Msg =
    | Nothing


  type Model =
    { app: AppState
      exts: List<Extension>
      on: List<String>
      cursor: Int64
      note: List<String>
      /// An extension that was just turned on and asks for something, waiting for y or n.
      asking: Option<Extension> }


  let init(app: AppState, exts: List<Extension>): Model =
    Model
      { app = app
        exts = exts
        on = onNames(exts)
        cursor = 0
        note = []
        asking = Option.None }


  let selected(m: Model): Option<Extension> =
    Stdlib.List.getAt(rows(m.exts), m.cursor) |> Stdlib.Option.map(fun r -> r.ext)


  let toggle(m: Model): Model =
    match selected(m) with
    | None -> m
    | Some(e) ->
      if Stdlib.List.contains(m.on, e.name) then
        let note =
          match turnOff(m.exts, e.name) with
          | Ok(lines) -> lines
          | Error(msg) -> [ msg ]

        { m with on = onNames(m.exts), note = note }
      else
        match turnOn(m.exts, e.name) with
        | Error(msg) -> { m with note = [ msg ] }
        | Ok(turned) ->
          let asking =
            [ e, ...turned ] |> Stdlib.List.findFirst(fun t -> ungranted(t) != [])

          { m with on = onNames(m.exts), note = onLines(turned), asking = asking }


  let answer(m: Model, yes: Bool): Model =
    match m.asking with
    | None -> m
    | Some(e) ->
      let note =
        if yes then
          grant(e, ungranted(e))
          [ $"  {e.name}: allowed, for its own commands only" ]
        else
          [ $"  {e.name}: not allowed. Space twice on it asks again." ]

      { m with asking = Option.None, note = note }


  let move(m: Model, by: Int64): Model =
    let last = Stdlib.List.length(rows(m.exts)) - 1
    { m with cursor = Stdlib.max(0, Stdlib.min(last, m.cursor + by)), note = [] }


  let body(m: Model): Stdlib.Cli.UI.Node.Node<Msg> =
    let lines =
      rows(m.exts)
      |> Stdlib.List.indexedMap(fun(i, r) ->
        let line = rowLine(r, m.on)
        if i == m.cursor then
          Stdlib.Cli.UI.Node.styled(
            Stdlib.Cli.UI.Node.Style.Highlight,
            Stdlib.Cli.UI.Node.text("> " + line))
        else
          Stdlib.Cli.UI.Node.text("  " + line))

    let detail =
      match (m.asking, selected(m)) with
      | (Some(e), _) ->
        [ Stdlib.Cli.UI.Node.bold($"  {e.title} asks for")
          ...Stdlib.List.map(ungranted(e), fun r -> Stdlib.Cli.UI.Node.text("    " + r))
          Stdlib.Cli.UI.Node.text("  Allow it, for its own commands only?  y yes   n not now") ]
      | (None, None) -> []
      | (None, Some(e)) ->
        let words = if Stdlib.List.isEmpty(m.note) then describe(e) else m.note
        let pane =
          match paneOf(m.app.currentBranchId, e, m.on) with
          | Some(p) when Stdlib.List.contains(m.on, e.name) ->
            [ Stdlib.Cli.UI.Node.text(""), ...Stdlib.List.map(paneLines(p), fun l -> Stdlib.Cli.UI.Node.text("  " + l)) ]
          | _ -> []

        Stdlib.List.concat(
          [ Stdlib.Cli.UI.Node.bold("  " + e.title)
            ...Stdlib.List.map(words, fun d -> Stdlib.Cli.UI.Node.dim("  " + d)) ],
          pane)

    let count = Stdlib.List.length(m.on)
    let head = $"  {count} on. Each one adds to `dark help`."
    Stdlib.Cli.UI.Node.column(
      Stdlib.List.flatten(
        [ [ Stdlib.Cli.UI.Node.dim(head), Stdlib.Cli.UI.Node.text("") ]
          lines
          [ Stdlib.Cli.UI.Node.text("") ]
          detail ]))


  let view(m: Model, size: Stdlib.Cli.Tui.Size): Stdlib.Cli.Tui.View =
    let frame =
      Stdlib.Cli.UI.Chrome.frame(
        "extensions",
        "",
        "up/down move  |  space turn on/off  |  esc done")

    Stdlib.Cli.UI.Chrome.view(frame, size, fun region ->
      Stdlib.Cli.UI.Node.toRows(body(m), region.cols, "")
      |> Stdlib.List.take(region.rows)
      |> Stdlib.List.indexedMap(fun(i, row) -> Stdlib.Cli.UI.Layout.at(region, i, 0, row))
      |> Stdlib.List.flatten)


  let onKey(
    m: Model,
    key: Stdlib.Cli.Stdin.Key.Key,
    _modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers,
    keyChar: Option<String>)
    : Component.Step<Model> =
    match m.asking with
    | Some(_) ->
      match keyChar with
      | Some("y") -> Component.Step.Stay(answer(m, true))
      | Some("n") -> Component.Step.Stay(answer(m, false))
      | _ ->
        match key with
        | Escape -> Component.Step.Stay(answer(m, false))
        | _ -> Component.Step.Stay(m)
    | None ->
      match key with
      | UpArrow -> Component.Step.Stay(move(m, -1))
      | DownArrow -> Component.Step.Stay(move(m, 1))
      | Spacebar -> Component.Step.Stay(toggle(m))
      | Enter -> Component.Step.Stay(toggle(m))
      | Escape -> Component.Step.Exit(m)
      | _ ->
        match keyChar with
        | Some("q") -> Component.Step.Exit(m)
        | Some(k) -> Component.Step.Stay(press(m, k))
        | None -> Component.Step.Stay(m)


  /// A key a pane of the selected row offers runs its command; any other does nothing.
  let press(m: Model, k: String): Model =
    match selected(m) with
    | Some(e) when Stdlib.List.contains(m.on, e.name) ->
      match paneOf(m.app.currentBranchId, e, m.on) with
      | Some(p) ->
        match Stdlib.List.findFirst(p.actions, fun a -> a.key == k) with
        | Some(a) -> { m with note = runAction(m.app, a) }
        | None -> m
      | None -> m
    | _ -> m


  let component(): Component.Component<Model> =
    Component.simple(view, onKey, Component.noSave)


// --- the command ---

let execute(state: AppState, args: List<String>): AppState =
  let exts = all(state.currentBranchId)
  match args with
  | [] ->
    match Stdlib.Cli.Tui.TerminalSupport.current() with
    | Available when Stdlib.Bool.not(state.output == Output.Mode.Plain) ->
      Component.launch(state, Tree.component(), Tree.init(state, exts))
    | _ -> execute(state, [ "list" ])
  | ["list"] ->
    let lines = if state.output == Output.Mode.Plain then plainRows(exts) else listing(exts)
    Stdlib.printLines(lines)
    state
  | ["show", name] ->
    match find(exts, name) with
    | None ->
      printErr($"No extension called `{name}`.")
      failed(state)
    | Some(e) ->
      let on = onNames(exts)
      let onOff = if Stdlib.List.contains(on, e.name) then "on" else "off"
      let pane =
        match paneOf(state.currentBranchId, e, on) with
        | Some(p) when Stdlib.List.contains(on, e.name) -> [ "", ...paneLines(p) ]
        | _ -> []

      Stdlib.printLines(
        Stdlib.List.flatten([ [ $"{e.title} ({e.name}, {onOff})", e.blurb ], describe(e), pane ]))

      state
  | ["enable", ...names] ->
    names
    |> Stdlib.List.fold(state, fun(st, name) ->
      match enable(exts, name) with
      | Ok(_) -> st
      | Error(e) ->
        printErr(e)
        printHint("  `dark extensions` lists them.")
        failed(st))
  | ["disable", ...names] ->
    names
    |> Stdlib.List.fold(state, fun(st, name) ->
      match turnOff(exts, name) with
      | Ok(lines) ->
        Stdlib.printLines(lines)
        st
      | Error(e) ->
        printErr(e)
        failed(st))
  | _ ->
    printErr("Usage: extensions [list | show <name> | enable <name>... | disable <name>...]")
    failed(state)


let help(_state: AppState): String =
  [ "Usage: extensions [list | show <name> | enable <name>... | disable <name>...]"
    "Everything past running and keeping code is an extension: turn on what you want."
    "At a terminal, bare `extensions` opens the tree; space turns the row on or off."
    ""
    "  list               every extension, on or off, in its tree"
    "  show <name>        what it adds, asks for and installs"
    "  enable <name>...   turn it on, and what it needs; at a terminal, allow what it asks for"
    "  disable <name>...  turn it off, and what needs it; nothing it made is deleted"
    ""
    "What an extension asks for is allowed for its own commands only, and only by a person at a"
    "terminal. `dark permissions list` shows what each was allowed."
    ""
    "An extension is a value of type Darklang.Cli.Extensions.Extension anywhere in the store."
    "Save one under Me and it shows up here." ]
  |> Stdlib.String.join("\n")


/// What `permissions list` adds: each extension's grants, which apply to its own commands only.
let grantLines(): List<String> =
  match grantRows() with
  | [] -> []
  | rows ->
    [ "Allowed to extensions, for their own commands:"
      ...Stdlib.List.map(rows, fun ((name, rule)) -> $"  {name}: {rule}") ]


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] | [_] ->
    [ "list", "show", "enable", "disable" ] |> Stdlib.List.map(fun s -> Completion.simple(s))
  | [_, ...] -> all(state.currentBranchId) |> Stdlib.List.map(fun e -> Completion.simple(e.name))


// --- `dark help` ---

val kernel =
  [ "run-script"
    "eval"
    "fn"
    "val"
    "type"
    "trait"
    "impl"
    "module"
    "view"
    "ls"
    "search"
    "docs"
    "help"
    "extensions"
    "permissions"
    "install"
    "update"
    "uninstall"
    "version"
    "install-status" ]


let helpText(state: AppState): String =
  let exts = all(state.currentBranchId)
  let on = onNames(exts)
  let onExts = exts |> Stdlib.List.filter(fun e -> Stdlib.List.contains(on, e.name))
  let onCount = Stdlib.List.length(onExts)
  let total = Stdlib.List.length(exts)
  let intro =
    [ "Darklang: a small language that keeps your code in one store, on this machine."
      "Write a script, or save functions and run them by name. Everything else is an"
      "extension you turn on when you want it."
      ""
      "Run code"
      "  dark run hello.dark                  a script file"
      "  dark eval '1 + 2'                    one expression"
      "Keep code"
      "  dark fn Me.Hi.greet '(name: String): String = \"hi \" + name'"
      "  dark eval 'Me.Hi.greet(\"Ada\")'       call what you saved"
      "  dark module Me.Hi - < hi.dark        save a whole module"
      "  dark val, type, trait, impl          save one item of another kind, like fn"
      "  dark ls Me    dark view Me.Hi.greet    dark search \"split a string\""
      "Learn"
      "  dark docs syntax    dark docs for-ai    dark help <command>"
      "Grow"
      $"  dark extensions                      what you can turn on ({onCount} of {total} on)"
      "This install"
      "  dark permissions    dark update    dark uninstall    dark version" ]

  let added =
    onExts
    |> Stdlib.List.filter(fun e -> Stdlib.Bool.not(Stdlib.List.isEmpty(commandNames(e))))
    |> Stdlib.List.map(fun e ->
      let guide = e.guide |> Stdlib.List.map(fun g -> "                " + g)
      [ "  " + Stdlib.String.padEnd(e.name, ' ', 14) + Stdlib.String.join(commandNames(e), " ")
        ...guide ])
    |> Stdlib.List.flatten

  let addedBlock =
    if Stdlib.List.isEmpty(added) then
      []
    else
      [ "", "From your extensions", ...added ]

  let offNames =
    exts
    |> Stdlib.List.filter(fun e ->
      Stdlib.Bool.not(Stdlib.List.contains(on, e.name)) && e.under == "")
    |> Stdlib.List.map(fun e -> e.name)

  let offBlock =
    if Stdlib.List.isEmpty(offNames) then
      []
    else
      [ ""
        "Off: " + Stdlib.String.join(offNames, ", ")
        "`dark extensions show <name>` says what one adds." ]

  Stdlib.String.join(Stdlib.List.flatten([ intro, addedBlock, offBlock ]), "\n")
