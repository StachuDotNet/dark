module Darklang.Cli.Backups

// `dark backups`: see, make, and prune the copies of the store.
//
// The upgrade path writes one aside before it changes the store (one per build it upgrades to, kept
// next to the store), and nothing else prunes them. So the answer to "if this goes wrong, what can I
// go back to?" lives here rather than in `ls`, and so does the pruning.
//
// `export` and `import` are the other thing: a copy meant to leave the machine, written to a directory
// the caller names rather than into `backups/`, so no retention rule here ever touches one.

/// Where the upgrade path puts them: a `backups` directory beside the store.
let backupDir () : String =
  let db = Stdlib.LocalStore.path ()

  match Stdlib.List.dropLast (Stdlib.String.split db "/") with
  | [] -> "backups"
  | parts -> $"""{Stdlib.String.join parts "/"}/backups"""

/// The backups, newest first BY STAMP, not by name. Three prefixes share this directory
/// (`before-upgrade-`, `manual-`, `pre-restore-`), and a name sort groups by prefix before it looks
/// at the stamp -- which made `prune` keep a January backup over this week's. Every name ends in
/// its stamp (both stamp shapes sort correctly as text), so ordering by the digits alone is right.
let list () : List<String> =
  let stampOf (n: String) : String =
    n |> Stdlib.String.toList |> Stdlib.List.filter Stdlib.Char.isDigit |> Stdlib.String.fromList

  match Stdlib.Cli.Dir.list (backupDir ()) with
  | Ok names ->
    names
    |> Stdlib.List.filter (fun n -> Stdlib.String.contains n "data.db")
    |> Stdlib.List.sortBy stampOf
    |> Stdlib.List.reverse
  | Error _ -> []

let sizeOf (name: String) : String =
  match Stdlib.Cli.File.size $"{backupDir ()}/{name}" with
  | Ok bytes -> Cli.Text.bytes bytes
  | Error _ -> "?"

/// `dark backups`
let executeList (state: AppState) : AppState =
  match list () with
  | [] ->
    Cli.printOk "no backups yet."
    Cli.printHint "  One is taken automatically before an upgrade folds a new seed."
    Cli.printHint "  `dark backups now` takes one on demand."
    state
  | names ->
    Cli.printOk
      $"""{Cli.Text.plural (Stdlib.List.length names) "backup"} in {backupDir ()}"""

    names
    |> Stdlib.List.iter (fun name ->
      Stdlib.printLine $"  {name}  ({sizeOf name})")

    Stdlib.printLine ""
    Cli.printHint "  dark backups now             take one now"
    Cli.printHint "  dark backups restore <name>  put one in place of the store"
    Cli.printHint "  dark backups prune <n>       keep the newest n, delete the rest"
    state

/// `dark backups now`. Named for the moment rather than the day, so an on-demand copy never collides
/// with the upgrade path's daily one.
let executeNow (state: AppState) : AppState =
  let dir = backupDir ()
  let _ = Stdlib.Cli.Dir.createRecursive dir
  let stamp = Stdlib.DateTime.toStringISO8601BasicDateTime (Stdlib.DateTime.now ())
  let target = $"{dir}/data.db.manual-{stamp}"

  // `LocalStore.backupTo`, not a file copy: the store path is guarded, so the file builtins refuse
  // it, and the denial is an uncaught error rather than a `false`. Even asking whether the store
  // EXISTS goes through that same guard.
  match Stdlib.LocalStore.backupTo target with
  | Ok _ ->
    Cli.printOk $"copied the store to {target}"
    state
  | Error e ->
    Cli.printErr $"couldn't write {target}: {e}"
    { state with exitCode = 1 }

/// `dark backups restore <name> [-y]`. Puts the named backup in place of the store. The store as it is
/// now is copied aside first (`data.db.pre-restore-<stamp>`), so a restore is itself undoable.
let executeRestore (state: AppState) (name: String) (autoConfirm: Bool) : AppState =
  let source = $"{backupDir ()}/{name}"

  if Stdlib.Bool.not (Stdlib.List.``member`` (list ()) name) then
    Cli.printErr $"no backup named \"{name}\"."
    Cli.printHint "  `dark backups` lists them."
    Cli.exitWith state false
  else

  // Warning like DISCARDING: green on "replaces the store" reads as "already fine".
  Cli.Stderr.line (Stdlib.Cli.UI.Colors.warning $"  RESTORING {name} replaces the store.")
  Cli.Stderr.hint "  the store as it is now is copied aside first, so this is undoable."

  // Credentials are deliberately not in a backup: it is a file people copy around. The cost is
  // this sentence, because a restore onto a fresh machine cannot bring the secret back.
  Cli.Stderr.hint "  a backup holds no credentials; re-set a relay secret with `dark connect <url> --secret ...`"

  let confirmed =
    Cli.Prompt.confirmExplicit autoConfirm (Stdlib.Cli.UI.Colors.warning "\n  Restore it? [y/N]: ")

  if Stdlib.Bool.not confirmed then
    Cli.Stderr.ok "  kept. (`dark backups restore <name> -y` if you mean it -- a piped stdin can't answer this.)"
    Cli.exitWith state false
  else
    let stamp = Stdlib.DateTime.toStringISO8601BasicDateTime (Stdlib.DateTime.now ())
    let aside = $"{backupDir ()}/data.db.pre-restore-{stamp}"

    match Stdlib.LocalStore.backupTo aside with
    | Error e ->
      Cli.printErr
        $"couldn't copy the current store aside to {aside} ({e}); nothing restored."

      { state with exitCode = 1 }
    | Ok _ ->
      // Contents in, rather than the file swapped underneath the open store: see
      // `Stdlib.LocalStore.restoreFrom`. What it cannot do is refresh what this process has
      // already read, hence the restart.
      match Stdlib.LocalStore.restoreFrom source with
      | Ok _ ->
        Cli.printOk $"restored {name}. The store as it was is at {aside}."
        Cli.printHint "  start `dark` again: this process is still holding the old store."
        state
      | Error e ->
        Cli.printErr
          $"couldn't restore {source} ({e}). The store is unchanged; a copy is at {aside}."

        { state with exitCode = 1 }

/// `dark backups prune <keep> [-y]`. Deletes the oldest, keeping the newest <keep>. Shows what would go
/// and takes an explicit yes, like every other verb that destroys something: a backup is the thing you
/// reach for AFTER a mistake, and the one command that must not make one.
let executePrune (state: AppState) (keepArg: String) (autoConfirm: Bool) : AppState =
  match Stdlib.Int.parse keepArg with
  | Error _ ->
    Cli.printErr $"\"{keepArg}\" isn't a number of backups to keep."
    Cli.exitWith state false
  | Ok keep ->
    if keep < 0 then
      Cli.printErr "keep a non-negative number of backups."
      Cli.exitWith state false
    else
      let all = list ()
      let doomed = Stdlib.List.drop all keep

      if Stdlib.List.isEmpty doomed then
        Cli.printOk
          $"""nothing to prune: {Cli.Text.plural (Stdlib.List.length all) "backup"}, keeping {keepArg}."""
        state
      else

      Cli.Stderr.line (
        Stdlib.Cli.UI.Colors.warning
          $"""  PRUNING deletes {Cli.Text.plural (Stdlib.List.length doomed) "backup"}:"""
      )
      doomed |> Stdlib.List.iter (fun name -> Cli.Stderr.line (Stdlib.Cli.UI.Colors.dimText $"    - {name}"))

      let confirmed =
        Cli.Prompt.confirmExplicit autoConfirm (Stdlib.Cli.UI.Colors.warning "\n  Delete them? [y/N]: ")

      if Stdlib.Bool.not confirmed then
        Cli.Stderr.ok "  kept. (`dark backups prune <n> -y` if you mean it -- a piped stdin can't answer this.)"
        Cli.exitWith state false
      else
        let deleted =
          doomed
          |> Stdlib.List.filterMap (fun name ->
            match Stdlib.Cli.File.delete $"{backupDir ()}/{name}" with
            | Ok _ -> Stdlib.Option.Option.Some name
            | Error _ ->
              Cli.printErr $"  couldn't delete {name}"
              Stdlib.Option.Option.None)

        Cli.printOk
          $"""deleted {Cli.Text.plural (Stdlib.List.length deleted) "backup"}, kept {keepArg}."""
        Cli.exitWith state (Stdlib.List.length deleted == Stdlib.List.length doomed)


/// `dark backups export <dir>`. The store and its stored secrets, into an existing directory, for
/// copying off the machine. A copy that holds a secret is one: it can push to that relay.
let executeExport (state: AppState) (dir: String) : AppState =
  match Stdlib.LocalStore.backupTo $"{dir}/data.db" with
  | Error e ->
    Cli.printErr $"couldn't write {dir}/data.db: {e}"
    { state with exitCode = 1 }
  | Ok _ ->
    match Stdlib.LocalStore.credentialsBackupTo $"{dir}/credentials.db" with
    | Error e ->
      Cli.printErr $"copied the store, but not its secrets ({e}); don't rely on {dir} alone."
      { state with exitCode = 1 }
    | Ok n when n == 0 ->
      Cli.printOk $"exported the store to {dir}. It holds no secrets."
      state
    | Ok n ->
      Cli.printOk $"""exported the store and {Cli.Text.plural n "write secret"} to {dir}."""
      Cli.Stderr.line (
        Stdlib.Cli.UI.Colors.warning
          "  THIS COPY IS A SECRET: whoever holds it can push to that relay. Keep it like a key."
      )
      state

/// `dark backups import <dir> [-y]`. Puts an export back: the store, and its secrets if it carried
/// any. Both are copied aside first, like `restore`, so an import is undoable.
let executeImport (state: AppState) (dir: String) (autoConfirm: Bool) : AppState =
  Cli.Stderr.line (Stdlib.Cli.UI.Colors.warning $"  IMPORTING {dir} replaces the store.")

  let confirmed =
    Cli.Prompt.confirmExplicit autoConfirm (Stdlib.Cli.UI.Colors.warning "\n  Import it? [y/N]: ")

  if Stdlib.Bool.not confirmed then
    Cli.Stderr.ok "  kept. (`dark backups import <dir> -y` if you mean it -- a piped stdin can't answer this.)"
    Cli.exitWith state false
  else
    let stamp = Stdlib.DateTime.toStringISO8601BasicDateTime (Stdlib.DateTime.now ())
    let _ = Stdlib.Cli.Dir.createRecursive (backupDir ())
    let aside = $"{backupDir ()}/data.db.pre-restore-{stamp}"
    let secretsAside = $"{backupDir ()}/credentials.db.pre-restore-{stamp}"

    // Both copies before anything is replaced: an import that overwrote the store and then could not
    // keep what it replaced would lose the thing a backup exists to protect.
    match (Stdlib.LocalStore.backupTo aside, Stdlib.LocalStore.credentialsBackupTo secretsAside) with
    | (Error e, _) ->
      Cli.printErr $"couldn't copy the current store aside to {aside} ({e}); nothing imported."
      { state with exitCode = 1 }
    | (_, Error e) ->
      Cli.printErr $"couldn't copy the current secrets aside to {secretsAside} ({e}); nothing imported."
      { state with exitCode = 1 }
    | (Ok _, Ok _) ->
      match Stdlib.LocalStore.restoreFrom $"{dir}/data.db" with
      | Error e ->
        Cli.printErr $"couldn't import {dir}/data.db ({e}). The store is unchanged; a copy is at {aside}."
        { state with exitCode = 1 }
      | Ok _ ->
        match Stdlib.LocalStore.credentialsRestoreFrom $"{dir}/credentials.db" with
        | Error e ->
          Cli.printErr $"imported the store, but not the secrets ({e}). The store as it was is at {aside}."
          { state with exitCode = 1 }
        | Ok n ->
          if n == 0 then
            Cli.printOk
              $"imported {dir}: the store. It carried no secrets, so this instance's are unchanged. The store as it was is at {aside}."
          else
            Cli.printOk
              $"""imported {dir}: the store, and {Cli.Text.plural n "write secret"}. The store as it was is at {aside}."""
          Cli.printHint "  start `dark` again: this process is still holding the old store."
          state


let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] -> executeList state
  | [ "list" ] -> executeList state
  | [ "now" ] -> executeNow state
  | [ "prune", keep ] -> executePrune state keep false
  | [ "prune", keep, "-y" ]
  | [ "prune", keep, "--yes" ] -> executePrune state keep true
  | [ "restore", name ] -> executeRestore state name false
  | [ "restore", name, "-y" ]
  | [ "restore", name, "--yes" ] -> executeRestore state name true
  | [ "export", dir ] -> executeExport state dir
  | [ "import", dir ] -> executeImport state dir false
  | [ "import", dir, "-y" ]
  | [ "import", dir, "--yes" ] -> executeImport state dir true
  | [ "restore" ] ->
    Cli.printErr "restore needs a backup's name: `dark backups restore <name>`."
    Cli.printHint "  `dark backups` lists them."
    Cli.exitWith state false
  | [ "prune" ] ->
    Cli.printErr "prune needs how many to keep: `dark backups prune 3`."
    Cli.exitWith state false
  | _ ->
    Cli.printErr $"""`dark backups {Stdlib.String.join args " "}` isn't a form of this command."""
    Cli.printHint "  dark backups | now | restore <name> | prune <n> | export <dir> | import <dir>"
    Cli.exitWith state false


let help (_state: AppState) : String =
  [ ""
    "  dark backups                      what copies of the store exist"
    "  dark backups now                  take one now"
    "  dark backups restore <name> [-y]  put one in place of the store (asks first)"
    "  dark backups prune <n> [-y]       keep the newest n, delete the rest (asks first)"
    "  dark backups export <dir>         the store and its secrets, into <dir>, to copy elsewhere"
    "  dark backups import <dir> [-y]    put an export back (asks first)"
    ""
    "  A backup is taken automatically before an upgrade changes the store:"
    "  one per build it upgrades to, kept next to the store. Nothing prunes them"
    "  for you, which is why `prune` is here. A backup holds no secrets; an"
    "  export holds them when the store has any, and is then a secret itself."
    "" ]
  |> Stdlib.String.join "\n"


let complete
  (_state: AppState)
  (args: List<String>)
  : List<Completion.CompletionItem> =
  match args with
  | [] ->
    [ "list", "now", "prune", "restore", "export", "import" ]
    |> Stdlib.List.map Completion.simple
  | _ -> []
