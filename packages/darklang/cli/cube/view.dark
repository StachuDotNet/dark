/// The three looks, each a list of quads for `Raster` to fill.
///
/// - Qsim: the default, after qsim/qCube (snk.digibase.ca, 2010). U and F as flat faces, U stacked
///   on F, with a one-sticker strip of L and of R down each side: the row of L or R that touches U
///   next to U, the column that touches F next to F, and the shared corner as one tall cell across
///   the seam. Everything you look at while solving and nothing you don't.
/// - Isometric: JFly's angle (his curses sim turns the cube 45 degrees and tips it
///   about 37): U as a diamond on top, a face down each side, no perspective to distort it.
/// - Perspective: the same camera with perspective, for a more solid-looking cube.
/// - Net: all six faces unfolded, U over L F R B over D. For checking a scramble.
module Darklang.Cli.Cube.View

type Style =
  | Qsim
  | Isometric
  | Perspective
  | Net

type Camera = { yaw: Int; pitch: Int }

/// JFly's angle.
val defaultCamera = Camera { yaw = 0 - 45; pitch = 37 }

let styleName (s: Style) : String =
  match s with
  | Qsim -> "qsim"
  | Perspective -> "3D"
  | Isometric -> "iso"
  | Net -> "net"

let nextStyle (s: Style) : Style =
  match s with
  | Qsim -> Style.Isometric
  | Isometric -> Style.Perspective
  | Perspective -> Style.Net
  | Net -> Style.Qsim

type F3 = { x: Float; y: Float; z: Float }

let f3 (x: Float) (y: Float) (z: Float) : F3 = F3 { x = x; y = y; z = z }

let toF3 (v: Model.V3) : F3 =
  f3 (Stdlib.Int.toFloat v.x) (Stdlib.Int.toFloat v.y) (Stdlib.Int.toFloat v.z)

let add (a: F3) (b: F3) : F3 = f3 (a.x + b.x) (a.y + b.y) (a.z + b.z)
let scale (a: F3) (k: Float) : F3 = f3 (a.x * k) (a.y * k) (a.z * k)

/// The two in-plane directions of a face with this normal.
let planeAxes (normal: Model.V3) : (F3 * F3) =
  if normal.x != 0 then (f3 0.0 1.0 0.0, f3 0.0 0.0 1.0)
  else if normal.y != 0 then (f3 1.0 0.0 0.0, f3 0.0 0.0 1.0)
  else (f3 1.0 0.0 0.0, f3 0.0 1.0 0.0)

/// Corners of a square of half-size `half` centred at `c`, in order around the edge.
let square (c: F3) (u: F3) (v: F3) (half: Float) : List<F3> =
  let hu = scale u half
  let hv = scale v half
  let nu = scale u (0.0 - half)
  let nv = scale v (0.0 - half)
  [ add (add c hu) hv, add (add c hu) nv, add (add c nu) nv, add (add c nu) hv ]

val faceNormals =
  [ Model.v3 0 1 0
    Model.v3 1 0 0
    Model.v3 0 0 1
    Model.v3 0 (0 - 1) 0
    Model.v3 (0 - 1) 0 0
    Model.v3 0 0 (0 - 1) ]

/// How much of each sticker's cell is sticker; the rest shows the body.
val inset = 0.84


// 3D: rotate the world into camera space (yaw about Y, then pitch about X), then project.

type Lens =
  { sinYaw: Float
    cosYaw: Float
    sinPitch: Float
    cosPitch: Float
    /// Camera distance along +z; 0 means orthographic.
    distance: Float }

let lensFor (cam: Camera) (distance: Float) : Lens =
  Lens
    { sinYaw = Raster.sinDeg cam.yaw
      cosYaw = Raster.cosDeg cam.yaw
      sinPitch = Raster.sinDeg cam.pitch
      cosPitch = Raster.cosDeg cam.pitch
      distance = distance }

let toCamera (l: Lens) (p: F3) : F3 =
  let x1 = p.x * l.cosYaw + p.z * l.sinYaw
  let z1 = p.z * l.cosYaw - p.x * l.sinYaw
  let y2 = p.y * l.cosPitch - z1 * l.sinPitch
  let z2 = p.y * l.sinPitch + z1 * l.cosPitch
  f3 x1 y2 z2

/// Camera space to the unit screen: x right, y DOWN, before fitting to the terminal.
let project (l: Lens) (p: F3) : Raster.Point =
  let c = toCamera l p

  if l.distance == 0.0 then
    Raster.Point { x = c.x; y = 0.0 - c.y }
  else
    let k = l.distance / (l.distance - c.z)
    Raster.Point { x = c.x * k; y = 0.0 - c.y * k }

/// Faces turned towards the camera. With perspective that's stricter than "normal points at
/// +z": a face has to point at the eye, which sits a finite distance away.
let faceVisible (l: Lens) (n: Int) (normal: Model.V3) : Bool =
  let rn = toCamera l (toF3 normal)
  let nf = Stdlib.Int.toFloat n

  if l.distance == 0.0 then rn.z > 0.001 else rn.z * l.distance - nf > 0.001

let cubeQuads (n: Int) (l: Lens) : List<Raster.Quad> =
  let nf = Stdlib.Int.toFloat n
  let nn = n * n

  Stdlib.List.range 0 5
  |> Stdlib.List.filter (fun face ->
    faceVisible l n (Stdlib.Option.withDefault (Stdlib.List.getAt faceNormals face) (Model.v3 0 1 0)))
  |> Stdlib.List.map (fun face ->
    let normal = Stdlib.Option.withDefault (Stdlib.List.getAt faceNormals face) (Model.v3 0 1 0)
    let (u, v) = planeAxes normal
    let centre = scale (toF3 normal) nf

    let bodyQuad =
      Raster.Quad
        { idx = Raster.body
          pts = square centre u v nf |> Stdlib.List.map (fun p -> project l p) }

    let stickers =
      Stdlib.List.range (face * nn) (face * nn + nn - 1)
      |> Stdlib.List.map (fun i ->
        let s = Model.sticker n i
        let c = add (toF3 s.pos) (toF3 s.normal)

        Raster.Quad
          { idx = i
            pts = square c u v inset |> Stdlib.List.map (fun p -> project l p) })

    Stdlib.List.push stickers bodyQuad)
  |> Stdlib.List.flatten


// The flat views, laid out straight in pixels.
//
// Scaling unit-square layouts and letting the scanline round them left the gaps uneven at 5x5: some
// rows bunched up, and the side strips drifted off the rows they belong to. So these are built on
// whole cells instead. `u` is one sticker's pitch in pixels and `g` the gap; both are even, so every
// edge lands on a cell boundary (a cell is two pixel rows) and every gap is the same width.

val gap = 2

let even (x: Int) : Int = Stdlib.Int.max 2 ((x / 2) * 2)

let rectQuad (idx: Int) (x0: Int) (y0: Int) (x1: Int) (y1: Int) : Raster.Quad =
  let fx0 = Stdlib.Int.toFloat x0
  let fy0 = Stdlib.Int.toFloat y0
  let fx1 = Stdlib.Int.toFloat x1
  let fy1 = Stdlib.Int.toFloat y1

  Raster.Quad
    { idx = idx
      pts =
        [ Raster.Point { x = fx0; y = fy0 }
          Raster.Point { x = fx1; y = fy0 }
          Raster.Point { x = fx1; y = fy1 }
          Raster.Point { x = fx0; y = fy1 } ] }

/// A face's body and stickers with its top-left corner at (x, y). The body is n pitches plus one
/// gap each way, so the stickers get a border of `gap` all round.
let flatFace (n: Int) (u: Int) (face: Int) (x: Int) (y: Int) : List<Raster.Quad> =
  let nn = n * n
  let span = n * u + gap

  let stickers =
    Stdlib.List.range 0 (nn - 1)
    |> Stdlib.List.map (fun k ->
      let sx = x + gap + (k % n) * u
      let sy = y + gap + (k / n) * u
      rectQuad (face * nn + k) sx sy (sx + u - gap) (sy + u - gap))

  Stdlib.List.push stickers (rectQuad Raster.body x y (x + span) (y + span))

/// The biggest even pitch whose layout fits, given how many pitches and fixed pixels each axis takes.
let pitchFor
  (width: Int)
  (heightPx: Int)
  (unitsX: Float)
  (fixedX: Int)
  (unitsY: Float)
  (fixedY: Int)
  : Int =
  let byW = Stdlib.Float.floor ((Stdlib.Int.toFloat (width - 2 - fixedX)) / unitsX)
  let byH = Stdlib.Float.floor ((Stdlib.Int.toFloat (heightPx - 2 - fixedY)) / unitsY)
  even (Stdlib.Int.min byW byH)

/// Shift quads so a `w` x `h` layout sits in the middle, on an even row.
let centre (quads: List<Raster.Quad>) (w: Int) (h: Int) (width: Int) (heightPx: Int) : List<Raster.Quad> =
  let dx = Stdlib.Int.toFloat ((width - w) / 2)
  // Rounded down to an even pixel row, so cell boundaries stay where the layout put them.
  let dy = Stdlib.Int.toFloat (((heightPx - h) / 4) * 2)

  quads
  |> Stdlib.List.map (fun q ->
    Raster.Quad
      { idx = q.idx
        pts = q.pts |> Stdlib.List.map (fun p -> Raster.Point { x = p.x + dx; y = p.y + dy }) })


// Qsim: flat U over F, with the L and R stickers that touch them down the sides.

let qsimQuads (n: Int) (width: Int) (heightPx: Int) : List<Raster.Quad> =
  let nn = n * n
  // As in qCube, the strips sit flush against U and F (they share a border, so the gap between a
  // strip and a face is the same as between two stickers), and the U/F seam is only a little wider.
  let nf = Stdlib.Int.toFloat n
  let u = pitchFor width heightPx (nf + 2.0) gap (2.0 * nf + 0.2) (2 * gap)
  let seam = even (u / 5)
  let span = n * u + gap
  let stripW = u + gap
  let faceX = stripW - gap
  let rightX = faceX + span - gap
  let fTop = span + seam
  let bottom = fTop + span

  let cell (idx: Int) (x: Int) (top: Int) (bottomEdge: Int) : Raster.Quad =
    rectQuad idx (x + gap) top (x + u) bottomEdge

  // One side strip: the sticker beside each U row, the shared corner as one tall cell across the
  // seam, then the sticker beside each F row.
  let strip (x: Int) (besideU: Int -> Int) (corner: Int) (besideF: Int -> Int) : List<Raster.Quad> =
    let upper =
      if n < 2 then []
      else
        Stdlib.List.range 0 (n - 2)
        |> Stdlib.List.map (fun r -> cell (besideU r) x (gap + r * u) (r * u + u))

    let lower =
      if n < 2 then []
      else
        Stdlib.List.range 1 (n - 1)
        |> Stdlib.List.map (fun r -> cell (besideF r) x (fTop + gap + r * u) (fTop + r * u + u))

    let tall = cell corner x (gap + (n - 1) * u) (fTop + u)

    Stdlib.List.flatten [ [ rectQuad Raster.body x 0 (x + stripW) bottom ], upper, [ tall ], lower ]

  // L is face 4: its top row runs back to front, its last column is the one against F.
  let left =
    strip 0 (fun r -> 4 * nn + r) (4 * nn + n - 1) (fun r -> 4 * nn + r * n + n - 1)

  // R is face 1: its top row runs front to back, so read it backwards; column 0 is against F.
  let right = strip rightX (fun r -> nn + n - 1 - r) nn (fun r -> nn + r * n)

  // Fill the seam with body grey too: bare terminal background there reads as a row of black
  // stickers.
  let seamFill = rectQuad Raster.body faceX span (faceX + span) fTop

  let quads =
    Stdlib.List.flatten
      [ [ seamFill ], flatFace n u 0 faceX 0, flatFace n u 2 faceX fTop, left, right ]

  centre quads (rightX + stripW) bottom width heightPx


// Net: U over L F R B over D.

let netQuads (n: Int) (width: Int) (heightPx: Int) : List<Raster.Quad> =
  let nf = Stdlib.Int.toFloat n
  let u = pitchFor width heightPx (4.0 * nf + 1.0) (4 * gap) (3.0 * nf + 0.7) (3 * gap)
  let span = n * u + gap
  let between = even (u / 3)
  let step = span + between
  // (column, row) of each face in the U R F D L B order
  let slots = [ (1, 0), (2, 1), (1, 1), (1, 2), (0, 1), (3, 1) ]

  let quads =
    Stdlib.List.range 0 5
    |> Stdlib.List.map (fun face ->
      let (col, row) = Stdlib.Option.withDefault (Stdlib.List.getAt slots face) (0, 0)
      flatFace n u face (col * step) (row * step))
    |> Stdlib.List.flatten

  centre quads (4 * step - between) (3 * step - between) width heightPx


// Fitting unit-screen quads into the terminal.

/// Map points from a box of the given extent (centred on `centre`) into `width` x `heightPx`
/// pixels, uniformly, with a pixel of margin.
let fit
  (quads: List<Raster.Quad>)
  (centre: Raster.Point)
  (extentX: Float)
  (extentY: Float)
  (width: Int)
  (heightPx: Int)
  : List<Raster.Quad> =
  let w = Stdlib.Int.toFloat (width - 2)
  let h = Stdlib.Int.toFloat (heightPx - 2)
  let k = Stdlib.Float.min (w / extentX) (h / extentY)
  let mx = (Stdlib.Int.toFloat width) / 2.0
  let my = (Stdlib.Int.toFloat heightPx) / 2.0

  quads
  |> Stdlib.List.map (fun q ->
    Raster.Quad
      { idx = q.idx
        pts =
          q.pts
          |> Stdlib.List.map (fun p ->
            Raster.Point { x = mx + (p.x - centre.x) * k; y = my + (p.y - centre.y) * k }) })

/// The raster for a style, at a terminal area of `width` columns by `height` rows.
let layout (n: Int) (style: Style) (cam: Camera) (width: Int) (height: Int) : Raster.Raster =
  let heightPx = height * 2
  let nf = Stdlib.Int.toFloat n
  // The cube's circumscribed radius: the fit that never changes size as you orbit.
  let radius = nf * 1.7320508

  let quads =
    match style with
    | Qsim -> qsimQuads n width heightPx
    | Perspective ->
      let distance = radius * 4.5
      let extent = 2.0 * radius * distance / (distance - radius)
      fit (cubeQuads n (lensFor cam distance)) (Raster.Point { x = 0.0; y = 0.0 }) extent extent width heightPx
    | Isometric ->
      let extent = 2.0 * radius
      fit (cubeQuads n (lensFor cam 0.0)) (Raster.Point { x = 0.0; y = 0.0 }) extent extent width heightPx
    | Net -> netQuads n width heightPx

  Raster.rasterize width height quads
