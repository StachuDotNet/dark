/// `dark` at a terminal: a REPL for Dark expressions and commands. Each answer prints under what you
/// typed and scrolls up like any terminal program's. A line is exactly what you would type after `dark`.
module Darklang.Cli.Home

type Session =
  { on: Bool
    /// What enter runs on an empty line, shown dim after the prompt. One that ends in `(` is a
    /// start: enter puts it on the line to finish.
    suggestion: String
    /// A line refused because its extension was off, offered again once that is on.
    refused: String
    /// The first session's lines still to come, on a store with nothing of yours in it yet.
    steps: List<String>
    /// The full-screen command that has the terminal, for its line in the scrollback when it closes.
    screen: String
    /// The last answer's text, as `it`.
    it: String }


let off(): Session =
  Session { on = false, suggestion = "", refused = "", steps = [], screen = "", it = "" }


/// A first session, one line at a time.
val firstSteps =
  [ "1 + 2"
    "fn Me.Hi.greet '(name: String): String = \"hi \" + name'"
    "Me.Hi.greet(\"Ada\")"
    "commit -y"
    "ext" ]


let start(app: AppState): AppState =
  let app = Registry.withAll(app)
  let steps = if nothingYours(app) then firstSteps else []
  Stdlib.printLine(styled(Extensions.helpText(app)))

  Stdlib.printLine(
    Stdlib.Cli.UI.Colors.dimText(
      "\nType an expression or a command. Enter on an empty line runs the dim suggestion; tab takes it to edit; esc leaves."))

  { app with
      home =
        { off() with
            on = true
            steps = steps
            suggestion = Stdlib.List.head(steps) |> Stdlib.Option.withDefault("") } }


/// The intro with its headings in bold: at a terminal only, so a pipe still gets plain text.
let styled(text: String): String =
  let headings =
    [ "Run code", "Keep code", "Learn", "Grow", "This install", "From your extensions" ]

  Stdlib.String.splitOnNewline(text)
  |> Stdlib.List.map(fun l ->
    if Stdlib.List.contains(headings, l) then
      Stdlib.Cli.UI.Colors.boldText(l)
    else
      l)
  |> Stdlib.String.join("\n")


/// Where the prompt says you are: nothing at the root, which is where a REPL starts.
let location(app: AppState): String =
  if app.packageData.currentLocation == Packages.PackageLocation.Module([]) then
    ""
  else
    locationStr(app)


let nothingYours(app: AppState): Bool =
  let (modules, types, values, fns, traits, impls, tests) =
    Packages.Query.allDirectDescendantNamesAndHashes(app.currentBranchId, [ "Me" ])

  [ Stdlib.List.isEmpty(modules)
    Stdlib.List.isEmpty(types)
    Stdlib.List.isEmpty(values)
    Stdlib.List.isEmpty(fns)
    Stdlib.List.isEmpty(traits)
    Stdlib.List.isEmpty(impls)
    Stdlib.List.isEmpty(tests) ]
  |> Stdlib.List.all(fun b -> b)


/// A line split the way a shell splits it: spaces separate words, and quotes keep them together.
let words(line: String): List<String> =
  let step(
    acc: (List<String> * String * String * Bool),
    c: String)
    : (List<String> * String * String * Bool) =
    let (done_, word, quote, started) = acc
    if quote != "" then
      if c == quote then (done_, word, "", true) else (done_, word + c, quote, true)
    else if c == "'" || c == "\"" then
      (done_, word, c, true)
    else if c == " " then
      if started then (Stdlib.List.append(done_, word), "", "", false) else acc
    else
      (done_, word + c, "", true)

  let (done_, word, _, started) =
    Stdlib.String.toList(line)
    |> Stdlib.List.map(fun ch -> Stdlib.String.fromChar(ch))
    |> Stdlib.List.fold(([], "", "", false), step)

  if started then Stdlib.List.append(done_, word) else done_


/// `it` is the last answer, as its text: `it |> Stdlib.String.length`.
let withIt(h: Session, line: String): String =
  let names =
    Stdlib.String.toList(line)
    |> Stdlib.List.map(fun ch ->
      let c = Stdlib.String.fromChar(ch)
      if Stdlib.String.contains("()[],+-*/|>=<{}; ", c) then " " else c)
    |> Stdlib.String.join("")
    |> Stdlib.String.split(" ")

  if h.it != "" && Stdlib.List.contains(names, "it") then
    "let it = " + Stdlib.Json.serialize<String>(h.it) + "\n" + line
  else
    line


let isCommand(app: AppState, name: String): Bool =
  Stdlib.List.any(app.allCommandsCache, fun c ->
    c.name == name || Stdlib.List.contains(c.aliases, name))


/// Run one line: a command when its first word is one, an expression otherwise.
let run(app: AppState, line: String): AppState =
  match words(line) with
  | [] -> app
  | [cmd, ...args] ->
    if Stdlib.List.contains([ "quit", "exit" ], cmd) then
      { app with isExiting = true }
    else if isCommand(app, cmd) then
      let after = Registry.executeCommand(cmd, app, args)
      let screen =
        match after.currentPage with
        | SubApp(_) -> cmd
        | _ -> ""

      next(after, line, cmd, after.exitCode != 0, screen, "")
    else
      let owned = Builtin.stdoutCaptureStart()
      let after = Registry.executeCommand("eval", app, [ withIt(app.home, line) ])
      let out = if owned then Builtin.stdoutCaptureStop() else ""
      let said = Stdlib.String.trimEnd(Stdlib.Cli.Tui.Text.stripSgr(out))
      let failed = after.exitCode != 0
      let names = Stdlib.List.map(app.allCommandsCache, fun c -> c.name)
      let command =
        if failed && Stdlib.String.contains(said, "There is no variable named: " + cmd) then
          meant(Accepts.didYouMean(cmd, names))
        else
          ""

      if command != "" then
        // A mistyped command reads as an unknown name; say it as the command it nearly was.
        printErr($"`{cmd}` is not a command or a name. Did you mean `{command}`?")
        let fixed = Stdlib.String.join([ command, ...args ], " ")
        next({ after with exitCode = 0 }, line, "eval", true, "", fixed)
      else
        Stdlib.print(out)
        let it = if failed then app.home.it else said
        let fix = if failed then fixed(line, said) else ""
        next({ after with home = { after.home with it = it } }, line, "eval", failed, "", fix)


/// The name inside the first "Did you mean `<name>`?" of <param said>, or "".
let meant(said: String): String =
  match Stdlib.String.split(said, "Did you mean `") with
  | [_, rest, ...] ->
    match Stdlib.String.split(rest, "`") with
    | [name, ...] -> name
    | _ -> ""
  | _ -> ""


/// <param line> with the name an error says was not found replaced by the one it meant, or "".
let fixed(line: String, said: String): String =
  let wanted = meant(said)
  let missing =
    match Stdlib.String.split(said, "Error: ") with
    | [_, rest, ...] ->
      match Stdlib.String.split(rest, " not found.") with
      | [name, _, ...] -> name
      | _ -> ""
    | _ -> ""

  if wanted == "" || missing == "" || Stdlib.Bool.not(Stdlib.String.contains(line, missing)) then
    ""
  else
    Stdlib.String.replaceAll(line, missing, wanted)


/// What to offer after <param line>: the command a refusal named, the line that was refused once its
/// extension is on, the next first step, a call of the fn just saved, then a commit of what was saved.
let next(
  app: AppState,
  line: String,
  cmd: String,
  failed: Bool,
  screen: String,
  fix: String)
  : AppState =
  let h = app.home
  let steps = h.steps |> Stdlib.List.filter(fun s -> s != line)
  let offIn =
    match Extensions.home(app.currentBranchId, cmd, true) with
    | Off(e) -> e.name
    | _ -> ""

  let (suggestion, refused) =
    if fix != "" then
      (fix, h.refused)
    else if offIn != "" then
      ($"ext on {offIn}", line)
    else if turnsOn(line) && h.refused != "" && Stdlib.Bool.not(failed) then
      (h.refused, "")
    else
      match Stdlib.List.head(steps) with
      | Some(s) -> (s, h.refused)
      | None -> (afterSave(app, line, cmd, failed), h.refused)

  { app with
      exitCode = 0
      home = { h with suggestion = suggestion, refused = refused, steps = steps, screen = screen } }


let turnsOn(line: String): Bool =
  match words(line) with
  | ["ext", "on", ...] -> true
  | _ -> false


/// After a fn is saved, its name and `(`, to finish and call; after any other save, a commit, once
/// history is on.
let afterSave(app: AppState, line: String, cmd: String, failed: Bool): String =
  if failed then
    ""
  else
    match cmd, words(line) with
    | "fn", [_, name, ...] -> name + "("
    | _ when Stdlib.List.contains([ "val", "type", "trait", "impl", "module" ], cmd) ->
      if Extensions.isOff(app.currentBranchId, "commit") then "" else "commit -y"
    | "eval", _ when Stdlib.String.contains(line, "(") ->
      if Extensions.isOff(app.currentBranchId, "commit") then "" else "commit -y"
    | _ -> ""


/// A full-screen command closed: one line for the scrollback, and the prompt again.
let closed(app: AppState): AppState =
  let line =
    match app.home.screen with
    | "ext" -> Extensions.summaryLine(app.currentBranchId)
    | "" -> ""
    | other -> $"{other} closed"

  if line != "" then
    Stdlib.printLine(Stdlib.Cli.UI.Colors.dimText("  " + line))
  else
    ()

  { app with currentPage = Page.MainPrompt, home = { app.home with screen = "" } }
