/// The command table: every CLI command, its aliases, help, and completion.
///
/// Part of `Darklang.Cli`.
module Darklang.Cli

module Registry =
  type CommandHandler =
    { name: String
      description: String
      aliases: List<String>
      /// What it takes on the command line, checked before `execute` is called (see `Accepts`). A
      /// function, not a value: every start builds this table, and only the command being run should
      /// pay for building its declaration.
      accepts: Unit -> Accepts.Accepts
      execute: (AppState, List<String>) -> AppState
      /// Pure: returns the help text; callers decide where it goes.
      help: AppState -> String
      complete: (AppState, List<String>) -> List<Completion.CompletionItem> }


  // What each command takes on the command line, one function per command, referenced by its row in
  // `allCommands` the way `execute`, `help` and `complete` are. Functions rather than values, because
  // every start builds the table and only the command being run should pay for its declaration.
  let acceptsHelp(): Accepts.Accepts =
    Accepts.textBetween(0, 1)


  let acceptsExtensions(): Accepts.Accepts =
    Accepts.subcommands(
      [ ("list", Accepts.nothing())
        ("show", Accepts.between(1, 1, []))
        ("enable", Accepts.between(1, 99, []))
        ("disable", Accepts.between(1, 99, []))
        ("explain", Accepts.between(1, 1, [])) ],
      Accepts.nothing())


  let acceptsInstall(): Accepts.Accepts =
    Accepts.flagsOnly([ "-y", "--yes" ])


  let acceptsUpdate(): Accepts.Accepts =
    Accepts.withValues([ "--to" ], Accepts.flagsOnly([ "-y", "--yes" ]))


  let acceptsUninstall(): Accepts.Accepts = Accepts.flagsOnly([ "-y", "--yes" ])

  let acceptsInstallStatus(): Accepts.Accepts = Accepts.nothing()

  let acceptsVersion(): Accepts.Accepts = Accepts.flagsOnly([ "--local" ])


  let acceptsLs(): Accepts.Accepts =
    Accepts.upTo(1, [ "--include-deprecated", "--include-internal", "--versions", "--json" ])


  let acceptsRunScript(): Accepts.Accepts =
    Accepts.text(1)


  let acceptsEval(): Accepts.Accepts =
    Accepts.text(1)


  let acceptsView(): Accepts.Accepts =
    Accepts.freeText(0, [ "--raw", "--ast", "--instructions", "--instrs", "--include-tests" ])


  let acceptsSearch(): Accepts.Accepts =
    Accepts.withValues(
      [ "--limit" ],
      Accepts.freeText(
        0,
        [ "--type"
          "--fn"
          "--function"
          "--val"
          "--value"
          "--trait"
          "--impl"
          "--test"
          "--include-tests"
          "--batch"
          "--exact"
          "--shallow"
          "--with-docs"
          "--brief"
          "--include-deprecated"
          "--include-internal"
          "--json" ]))


  let acceptsVal(): Accepts.Accepts = Accepts.text(2)

  let acceptsFn(): Accepts.Accepts = Accepts.text(2)

  let acceptsType(): Accepts.Accepts = Accepts.text(2)

  let acceptsTrait(): Accepts.Accepts = Accepts.text(2)

  let acceptsImpl(): Accepts.Accepts = Accepts.text(2)

  let acceptsModule(): Accepts.Accepts = Accepts.between(2, 2, [])


  let acceptsDocs(): Accepts.Accepts =
    Accepts.subcommands(
      [ (
          "signatures",
          Accepts.withValues(
            [ "--module" ],
            Accepts.freeText(
              0,
              [ "--types"
                "--include-deprecated"
                "--include-internal"
                "--include-tests"
                "--all" ])))

        (
          "sigs",
          Accepts.withValues(
            [ "--module" ],
            Accepts.freeText(
              0,
              [ "--types"
                "--include-deprecated"
                "--include-internal"
                "--include-tests"
                "--all" ])))

        (
          "api",
          Accepts.withValues(
            [ "--module" ],
            Accepts.freeText(
              0,
              [ "--types"
                "--include-deprecated"
                "--include-internal"
                "--include-tests"
                "--all" ])))

        ("stdlib", Accepts.nothing())
        ("lib", Accepts.nothing())
        ("for-ai", Accepts.freeText(0, []))
        ("ai", Accepts.freeText(0, []))
        ("agent", Accepts.freeText(0, [])) ],
      Accepts.freeText(0, []))


  let acceptsPermissions(): Accepts.Accepts =
    Accepts.subcommands(
      [ ("list", Accepts.nothing())
        ("profile", Accepts.upTo(2, [ "-y", "--yes" ]))
        ("allow", Accepts.text(1))
        ("deny", Accepts.text(1))
        ("remove", Accepts.withValues([ "--for" ], Accepts.freeText(0, [ "--all" ])))
        ("clear", Accepts.nothing())
        ("set", Accepts.text(1))
        ("approve", Accepts.withValues([ "--for" ], Accepts.freeText(0, [ "-y", "--yes" ])))
        ("update", Accepts.text(1))
        ("unapprove", Accepts.between(1, 1, []))
        ("requirements", Accepts.between(1, 1, []))
        ("show", Accepts.between(1, 1, []))
        ("revoke-package", Accepts.between(1, 1, []))
        ("approved", Accepts.nothing())
        ("approvals", Accepts.nothing()) ],
      Accepts.nothing())


