/// `dark agent -p "build me X"`: the print-mode runner around the pure loop in `Darklang.Agent`.
///
/// The agent works in a session (`Sessions`) on a branch of its own, and keeps its conversation
/// there, so `dark @s1` works in what it built, and `--resume`/`--fork` pick it up again.
module Darklang.Cli.Agent

type Provider =
  | Live(Agent.Anthropic.Config)
  /// recorded SSE responses, answered in order
  | Replay(List<String>)
  /// an earlier session's replies, answered in order (`--rerun`)
  | Recorded(List<Agent.Reply>)


/// When the model's text reaches the person: as it streams (a conversation at a terminal), or
/// once, at the end.
type TextShown =
  | AtTheEnd
  | AsItStreams


type Format =
  | PlainText
  | StreamJson


/// Which tools the agent has: the store's, or only files and the shell (the comparison arm).
type Toolset =
  | StoreTools
  | Generic


type Options =
  { prompt: String
    model: String
    allowed: List<LanguageTools.Permissions.Effect>
    resume: Option<String>
    fork: Option<String>
    branch: Option<String>
    format: Format
    maxTurns: Int64
    replay: Option<String>
    baseUrl: String
    effort: String
    toolset: Toolset
    /// how many times a failed done-check sends the model back; 0 turns the check off
    checks: Int64
    /// compact once a call's input passes this many tokens; 0 never
    compactAt: Int64
    showPrompt: Bool
    /// attempts, each on a fresh branch, until one passes the done-check
    attempts: Int64
    /// run an earlier session's model turns again, against today's code and tools
    rerun: Option<String>
    /// at the end, merge the kept session's branch into the branch `dark` started on
    merge: Bool
    /// write only under the working directory and the store; bash in bwrap with no network
    sandbox: Bool
    /// under the sandbox, the hosts code may reach besides loopback
    hosts: List<String> }


type Run =
  { loop: Agent.State
    queue: List<Agent.Command>
    ctx: Tools.Context
    conversation: Sessions.Conversation
    provider: Provider
    system: String
    tools: List<Tools.Tool>
    format: Format
    ending: Option<Agent.Ending>
    text: TextShown }


val defaultModel = "claude-opus-5-5"


/// What a session may do without being asked: read files, read and write packages on its own
/// branch (the branch is the sandbox; nothing reaches main until it is merged).
val defaultAllowed =
  [ LanguageTools.Permissions.Effect.FileRead
    LanguageTools.Permissions.Effect.PackageRead
    LanguageTools.Permissions.Effect.PackageWrite ]


let conversationOf(id: String): Option<Sessions.Conversation> =
  Sessions.load(id) |> Stdlib.Option.andThen(fun s -> s.conversation)


let withMessages(c: Sessions.Conversation, messages: List<Agent.Message>): Sessions.Conversation =
  { c with messages = Stdlib.AltJson.format(Agent.Anthropic.messagesToJson(messages)) }


/// AGENTS.md or CLAUDE.md from the working directory up, nearest last, at most 8,000 characters.
let projectContext(cwd: String): String =
  let dirs =
    Stdlib.List.checkedRange(0, 20)
    |> Stdlib.Result.withDefault([])
    |> Stdlib.List.fold([ cwd ], fun(acc, _i) ->
      match Stdlib.List.last(acc) with
      | Some(d) when d != "/" && d != "" ->
        let up = Stdlib.Cli.Path.parent(d)
        if up == d then acc else Stdlib.List.append(acc, up)
      | _ -> acc)

  let found =
    dirs
    |> Stdlib.List.reverse
    |> Stdlib.List.filterMap(fun d ->
      [ "AGENTS.md", "CLAUDE.md" ]
      |> Stdlib.List.filterMap(fun f ->
        match Stdlib.Cli.File.readText(d + "/" + f) with
        | Ok(text) -> Option.Some($"({d}/{f})\n{text}")
        | Error(_) -> Option.None)
      |> Stdlib.List.head)

  Stdlib.String.first(Stdlib.String.join(found, "\n\n"), 8000)


/// The skills in the project (`SKILL.md` under `.claude/skills/<name>/` or `.agents/skills/<name>/`,
/// the format Claude Code and Pi read): one line each, name, description and path. The model reads
/// a skill's file when one applies, so only the index costs context.
let skillsIndex(cwd: String): String =
  let field(lines: List<String>, key: String): String =
    lines
    |> Stdlib.List.findFirst(fun l -> Stdlib.String.startsWith(l, key + ":"))
    |> Stdlib.Option.map(fun l ->
      Stdlib.String.trim(Stdlib.String.dropFirst(l, Stdlib.String.length(key) + 1)))
    |> Stdlib.Option.withDefault("")

  let entries =
    [ cwd + "/.claude/skills", cwd + "/.agents/skills" ]
    |> Stdlib.List.filter(fun dir -> Stdlib.Cli.FileSystem.isDirectory(dir))
    |> Stdlib.List.map(fun dir ->
      Stdlib.Cli.FileSystem.listDirectory(dir)
      |> Stdlib.Result.withDefault([])
      |> Stdlib.List.filterMap(fun entry ->
        let name = Stdlib.Cli.Path.basename(entry)
        let path = $"{entry}/SKILL.md"
        match Stdlib.Cli.File.readText(path) with
        | Ok(text) ->
          let lines = Stdlib.String.splitOnNewline(text) |> Stdlib.List.take(20)
          let title = field(lines, "name")
          let title = if title == "" then name else title
          Option.Some($"- {title}: {field(lines, "description")} ({path})")
        | Error(_) -> Option.None))
    |> Stdlib.List.flatten

  if Stdlib.List.isEmpty(entries) then
    ""
  else
    "Skills (read a skill's file when it applies):\n" + Stdlib.String.join(entries, "\n")


let keyPath(): String =
  Stdlib.Cli.Path.parent(LanguageTools.LocalStore.path()) + "/secrets/anthropic.key"


let readKey(): Result<String, String> =
  match Stdlib.Cli.File.readText(keyPath()) with
  | Ok(text) when Stdlib.String.trim(text) != "" -> Result.Ok(Stdlib.String.trim(text))
  | _ -> Result.Error($"no Anthropic API key: put one in {keyPath()}")


// ---- output

let usageJson(u: Agent.Usage): Stdlib.AltJson.Json =
  Stdlib.AltJson.Json.Object(
    [ ("input_tokens", Stdlib.AltJson.Json.Integer(u.input))
      ("output_tokens", Stdlib.AltJson.Json.Integer(u.output))
      ("cache_read_input_tokens", Stdlib.AltJson.Json.Integer(u.cacheRead))
      ("cache_creation_input_tokens", Stdlib.AltJson.Json.Integer(u.cacheWrite)) ])


let emitJson(fields: List<(String * Stdlib.AltJson.Json)>): Unit =
  Stdlib.printLine(Stdlib.AltJson.format(Stdlib.AltJson.Json.Object(fields)))


let str(s: String): Stdlib.AltJson.Json =
  Stdlib.AltJson.Json.String(s)


/// One line on stderr per tool call, so a person sees progress while stdout stays the answer.
let describeCall(name: String, input: Stdlib.AltJson.Json): String =
  let first =
    match Tools.fields(input) |> Stdlib.List.head with
    | Some((_k, String(v))) -> v
    | _ -> ""

  let line =
    Stdlib.String.splitOnNewline(first)
    |> Stdlib.List.head
    |> Stdlib.Option.withDefault("")

  let line =
    if Stdlib.String.length(line) > 100 then
      Stdlib.String.first(line, 100) + "..."
    else
      line

  $"· {name} {line}"


let show(run: Run, m: Agent.Message): Unit =
  match run.format with
  | StreamJson ->
    let kind =
      match m.role with
      | Assistant -> "assistant"
      | User -> "user"

    // an id per message, which is how a stream-json reader counts model calls
    let id = $"msg_{run.ctx.session.id}_{Stdlib.display(Stdlib.List.length(run.loop.messages))}"
    let message =
      match Agent.Anthropic.messageToJson(m, Agent.Anthropic.Breakpoint.NoBreakpoint) with
      | Object(fields) -> Stdlib.AltJson.Json.Object(Stdlib.List.prepend(fields, ("id", str(id))))
      | other -> other

    emitJson([ ("type", str(kind)), ("message", message), ("session_id", str(run.ctx.session.id)) ])
  | PlainText ->
    // streamed text ends without a newline; the tool lines start on their own
    let _ =
      if run.text == TextShown.AsItStreams && Agent.textOf(m.content) != "" then
        Stdlib.printLine("")
      else
        ()

    m.content
    |> Stdlib.List.iter(fun b ->
      match b with
      | ToolUse(_id, name, input) -> Stdlib.printErrorLine(describeCall(name, input))
      | ToolResult(_id, _content, true) -> Stdlib.printErrorLine("  (failed)")
      | _ -> ())


// ---- the runner

/// An answer worth asking again: overloaded, rate-limited, or the server's own failure.
let retryable(why: String): Bool =
  [ "answered 429"
    "answered 500"
    "answered 502"
    "answered 503"
    "answered 529"
    "Overloaded"
    "overloaded" ]
  |> Stdlib.List.any(fun s -> Stdlib.String.contains(why, s))


let callModel(run: Run, messages: List<Agent.Message>): (Run * Agent.Event) =
  let onText(t: String): Unit = if run.text == TextShown.AsItStreams then Stdlib.print(t) else ()
  match run.provider with
  | Live(config) ->
    let specs = run.tools |> Stdlib.List.map(fun t -> t.spec)
    // overloaded and rate-limited answers are worth waiting out: 2, 4, then 8 seconds
    let result =
      [ 2000, 4000, 8000, 0 ]
      |> Stdlib.List.fold(Result.Error("not called"), fun(acc, wait) ->
        match acc with
        | Ok(reply) -> Result.Ok(reply)
        | Error(why) when why != "not called" && Stdlib.Bool.not(retryable(why)) ->
          Result.Error(why)
        | Error(_) ->
          match Agent.Anthropic.call(config, run.system, specs, messages, onText) with
          | Ok(reply) -> Result.Ok(reply)
          | Error(why) ->
            let _ =
              if retryable(why) && wait > 0 then
                Stdlib.Cli.Posix.sleep(Stdlib.Int64.toFloat64(wait))
              else
                ()

            Result.Error(why))

    match result with
    | Ok(reply) -> (run, Agent.Event.ModelReplied(reply))
    | Error(why) -> (run, Agent.Event.ModelFailed(why))
  | Recorded(replies) ->
    match replies with
    | [] -> (run, Agent.Event.ModelFailed("the earlier session has no more replies"))
    | [next, ...rest] ->
      ({ run with provider = Provider.Recorded(rest) }, Agent.Event.ModelReplied(next))
  | Replay(recorded) ->
    match recorded with
    | [] -> (run, Agent.Event.ModelFailed("the recording has no more responses"))
    | [next, ...rest] ->
      let run = { run with provider = Provider.Replay(rest) }
      match Agent.Anthropic.fromSseText(next, onText) with
      | Ok(reply) -> (run, Agent.Event.ModelReplied(reply))
      | Error(why) -> (run, Agent.Event.ModelFailed(why))


/// The first prompt of a conversation: the task the person gave.
let taskOf(messages: List<Agent.Message>): String =
  messages
  |> Stdlib.List.findFirst(fun m -> m.role == Agent.Role.User && Agent.textOf(m.content) != "")
  |> Stdlib.Option.map(fun m -> Agent.textOf(m.content))
  |> Stdlib.Option.withDefault("")


/// A shorter conversation in place of <param messages>: the task, what the store says now, and the
/// model's own note on what it tried and what is next. If the note can't be had, the conversation
/// stays as it was.
let compact(run: Run, messages: List<Agent.Message>): (Run * List<Agent.Message>) =
  let ask = Stdlib.List.append(messages, Agent.userText(Agent.Prompt.compaction))
  let (r, event) = callModel({ run with text = TextShown.AtTheEnd }, ask)
  let r = { r with text = run.text }
  match event with
  | ModelReplied(reply) ->
    let note = Agent.textOf(reply.content)
    let loop = { r.loop with usage = Agent.addUsage(r.loop.usage, reply.usage) }
    let first =
      [ "The conversation so far was compacted. The task, as the person gave it:"
        taskOf(messages)
        Store.stateBlock(r.ctx)
        "Your own note from before the compaction:"
        note
        "Carry on from here." ]
      |> Stdlib.String.join("\n\n")

    ({ r with loop = loop }, [ Agent.userText(first) ])
  | _ -> (r, messages)


let save(run: Run): Run =
  let conversation =
    { withMessages(run.conversation, run.loop.messages) with usage = run.loop.usage }

  let session =
    { run.ctx.session with
        branchId = Stdlib.display(run.ctx.app.currentBranchId)
        conversation = Option.Some(conversation) }

  let _ = Sessions.save(session)
  { run with conversation = conversation, ctx = { run.ctx with session = session } }


/// What people said with `dark session say` since the last look, fed to the loop.
let listen(run: Run): Run =
  Sessions.takeInbox(run.ctx.session.id)
  |> Stdlib.List.fold(run, fun(r, note) ->
    let (loop, more) = Agent.step(r.loop, Agent.Event.Heard(note))
    { r with loop = loop, queue = Stdlib.List.concat(r.queue, more) })


/// Carry out one command; what it produced goes back through `step`.
let perform(run: Run, command: Agent.Command): Run =
  let feed(r: Run, e: Agent.Event): Run =
    let (loop, more) = Agent.step(r.loop, e)
    { r with loop = loop, queue = Stdlib.List.concat(r.queue, more) }

  match command with
  | CallModel(messages) ->
    let (r, e) = callModel(run, messages)
    feed(listen(r), e)
  | RunTool(id, name, input) ->
    let (ctx, output) = Tools.runTool(run.ctx, run.tools, name, input)
    feed(listen({ run with ctx = ctx }), Agent.Event.ToolFinished(id, output))
  | Show(m) ->
    let _ = show(run, m)
    let said = Agent.textOf(m.content)
    let _ =
      if m.role == Agent.Role.Assistant && said != "" then
        Sessions.addToLog(run.ctx.session.id, "agent", said, [])
      else
        ()

    run
  | Save -> save(run)
  | Check(_answer) -> feed(run, Agent.Event.Checked(Store.doneCheck(run.ctx)))
  | Compact(messages) ->
    let (r, compacted) = compact(run, messages)
    feed(r, Agent.Event.Compacted(compacted))
  | Finish(ending) -> { run with ending = Option.Some(ending) }


/// Drain the queue. A fold over a bounded range rather than recursion: there are no tail calls,
/// and a runaway loop stops here instead of blowing the stack.
let drain(run: Run): Run =
  Stdlib.List.checkedRange(1, 20000)
  |> Stdlib.Result.withDefault([])
  |> Stdlib.List.fold(run, fun(r, _i) ->
    match r.queue with
    | [] -> r
    | [next, ...rest] -> perform({ r with queue = rest }, next))


// ---- arguments

let parseArgs(args: List<String>, o: Options): Result<Options, String> =
  match args with
  | [] -> Result.Ok(o)
  | ["-p", ...rest] -> parseArgs(rest, o)
  | ["--print", ...rest] -> parseArgs(rest, o)
  | ["--model", m, ...rest] -> parseArgs(rest, { o with model = m })
  | ["--resume", id, ...rest] -> parseArgs(rest, { o with resume = Option.Some(id) })
  | ["--continue", ...rest] ->
    match Sessions.current() with
    | Some(id) -> parseArgs(rest, { o with resume = Option.Some(id) })
    | None -> Result.Error("no current session to continue; `dark session ls` lists them")
  | ["--fork", id, ...rest] -> parseArgs(rest, { o with fork = Option.Some(id) })
  | ["--branch", b, ...rest] -> parseArgs(rest, { o with branch = Option.Some(b) })
  | ["--max-turns", n, ...rest] ->
    match Stdlib.Int64.parse(n) with
    | Ok(v) when v > 0 -> parseArgs(rest, { o with maxTurns = v })
    | _ -> Result.Error($"--max-turns takes a positive number, not {n}")
  | ["--output-format", "text", ...rest] -> parseArgs(rest, { o with format = Format.PlainText })
  | ["--output-format", "stream-json", ...rest] ->
    parseArgs(rest, { o with format = Format.StreamJson })
  | ["--output-format", f, ..._rest] ->
    Result.Error($"--output-format is text or stream-json, not {f}")
  | ["--replay", path, ...rest] -> parseArgs(rest, { o with replay = Option.Some(path) })
  | ["--base-url", url, ...rest] -> parseArgs(rest, { o with baseUrl = url })
  | ["--effort", e, ...rest] ->
    if Stdlib.List.contains([ "low", "medium", "high", "xhigh", "max" ], e) then
      parseArgs(rest, { o with effort = e })
    else
      Result.Error($"--effort is low, medium, high, xhigh or max, not {e}")
  | ["--tools", "store", ...rest] -> parseArgs(rest, { o with toolset = Toolset.StoreTools })
  | ["--tools", "generic", ...rest] ->
    parseArgs(rest, { o with toolset = Toolset.Generic, checks = 0 })
  | ["--tools", t, ..._rest] -> Result.Error($"--tools is store or generic, not {t}")
  | ["--checks", n, ...rest] ->
    match Stdlib.Int64.parse(n) with
    | Ok(v) when v >= 0 -> parseArgs(rest, { o with checks = v })
    | _ -> Result.Error($"--checks takes a number, not {n}")
  | ["--compact-at", n, ...rest] ->
    match Stdlib.Int64.parse(n) with
    | Ok(v) when v >= 0 -> parseArgs(rest, { o with compactAt = v })
    | _ -> Result.Error($"--compact-at takes a number of tokens, not {n}")
  | ["--show-prompt", ...rest] -> parseArgs(rest, { o with showPrompt = true })
  | ["--attempts", n, ...rest] ->
    match Stdlib.Int64.parse(n) with
    | Ok(v) when v > 0 && v <= 8 -> parseArgs(rest, { o with attempts = v })
    | _ -> Result.Error($"--attempts takes a number from 1 to 8, not {n}")
  | ["--rerun", id, ...rest] -> parseArgs(rest, { o with rerun = Option.Some(id) })
  | ["--merge", ...rest] -> parseArgs(rest, { o with merge = true })
  | ["--sandbox", ...rest] -> parseArgs(rest, { o with sandbox = true })
  | ["--hosts", names, ...rest] ->
    let hosts =
      Stdlib.String.split(names, ",")
      |> Stdlib.List.map(fun h -> Stdlib.String.trim(h))
      |> Stdlib.List.filter(fun h -> h != "")

    parseArgs(rest, { o with hosts = hosts })
  | ["--allow", names, ...rest] ->
    let wanted = Stdlib.String.split(names, ",") |> Stdlib.List.map(fun n -> Stdlib.String.trim(n))
    let expanded =
      wanted
      |> Stdlib.List.map(fun n ->
        if n == "all" then
          LanguageTools.Permissions.effectCases
          |> Stdlib.List.map(fun((e, _c, _n)) -> Option.Some(e))
        else
          [ LanguageTools.Permissions.effectOfName(n) ])
      |> Stdlib.List.flatten

    if Stdlib.List.any(expanded, fun e -> e == Option.None) then
      Result.Error(
        $"--allow takes effect names (file-write, process, http, ...) or all, not {names}")
    else
      let effects = expanded |> Stdlib.List.filterMap(fun e -> e)
      parseArgs(rest, { o with allowed = Stdlib.List.concat(o.allowed, effects) })
  | [word, ...rest] ->
    if Stdlib.String.startsWith(word, "--") then
      Result.Error($"agent does not take {word}; `dark agent --help` lists what it does")
    else
      let prompt = if o.prompt == "" then word else o.prompt + " " + word
      parseArgs(rest, { o with prompt = prompt })


let defaultOptions(): Options =
  Options
    { prompt = ""
      model = defaultModel
      allowed = defaultAllowed
      resume = Option.None
      fork = Option.None
      branch = Option.None
      format = Format.PlainText
      maxTurns = 200
      replay = Option.None
      baseUrl = "https://api.anthropic.com"
      effort = "high"
      toolset = Toolset.StoreTools
      checks = 2
      compactAt = 120000
      showPrompt = false
      attempts = 1
      rerun = Option.None
      merge = false
      sandbox = false
      hosts = [] }


/// The session to run in and its conversation: a resumed session, a fork of one, or a new one on
/// its own new branch. A session no agent has driven yet starts a conversation.
let openSession(
  state: AppState,
  o: Options,
  cwd: String)
  : Result<(Sessions.Session * Sessions.Conversation), String> =
  let started =
    Sessions.Conversation
      { parent = "", cwd = cwd, model = o.model, messages = "[]", usage = Agent.noUsage() }

  match o.resume, o.fork with
  | Some(id), _ ->
    match Sessions.load(id) with
    | Some(s) -> Result.Ok((s, s.conversation |> Stdlib.Option.withDefault(started)))
    | None -> Result.Error($"no session {id}")
  | None, Some(id) ->
    match Sessions.load(id) with
    | Some(s) ->
      Sessions.fork(state, s)
      |> Stdlib.Result.map(fun f ->
        let c = s.conversation |> Stdlib.Option.withDefault(started)
        (f, { c with parent = id, model = o.model, usage = Agent.noUsage() }))
    | None -> Result.Error($"no session {id}")
  | None, None ->
    let id = Sessions.nextId()
    let branch =
      match o.branch with
      | Some(name) ->
        match SCM.PackageOps.resolveBranchRef(name) with
        | Found(b) -> Result.Ok(b)
        | _ -> Result.Error($"no branch {name}")
      | None ->
        SCM.PackageOps.resolveBranch($"session-{id}", state.currentBranchId)
        |> Stdlib.Result.map(fun((b, _created)) -> b)
        |> Stdlib.Result.mapError(fun _ -> $"could not start a branch for session {id}")

    branch |> Stdlib.Result.map(fun b -> (Sessions.fresh(id, b, []), started))


let providerFor(o: Options): Result<Provider, String> =
  match o.rerun with
  | Some(id) ->
    match conversationOf(id) with
    | Some(c) -> Result.Ok(Provider.Recorded(repliesOf(Sessions.messagesOf(c))))
    | None -> Result.Error($"no session {id}")
  | None -> replayOrLive(o)


/// An earlier session's model turns, as the replies that produced them.
let repliesOf(messages: List<Agent.Message>): List<Agent.Reply> =
  messages
  |> Stdlib.List.filter(fun m -> m.role == Agent.Role.Assistant)
  |> Stdlib.List.map(fun m ->
    let stop =
      if Stdlib.List.isEmpty(Agent.toolUses(m.content)) then
        Agent.StopReason.EndTurn
      else
        Agent.StopReason.ToolUseStop

    Agent.Reply { content = m.content, stop = stop, usage = Agent.noUsage() })


/// What each tool call answered, in order, with the tool's name.
let toolResultsOf(messages: List<Agent.Message>): List<(String * String)> =
  let names =
    messages
    |> Stdlib.List.map(fun m -> Agent.toolUses(m.content))
    |> Stdlib.List.flatten
    |> Stdlib.List.map(fun((id, name, _input)) -> (id, name))

  messages
  |> Stdlib.List.map(fun m -> m.content)
  |> Stdlib.List.flatten
  |> Stdlib.List.filterMap(fun b ->
    match b with
    | ToolResult(id, content, _isError) ->
      let name =
        names
        |> Stdlib.List.findFirst(fun((i, _n)) -> i == id)
        |> Stdlib.Option.map(fun((_i, n)) -> n)
        |> Stdlib.Option.withDefault("?")

      Option.Some((name, content))
    | _ -> Option.None)


/// A tool result without what changes on every run: timings and trace ids.
let comparable(text: String): String =
  Stdlib.String.splitOnNewline(text)
  |> Stdlib.List.map(fun l ->
    if Stdlib.String.startsWith(l, "-- ") && Stdlib.String.contains(l, " skipped, ") then
      "-- (summary)"
    else if
      Stdlib.String.contains(l, "trace ") && Stdlib.String.contains(l, "dark traces show")
    then
      "(trace)"
    else if Stdlib.String.startsWith(l, "the values in run ") then
      "the values in run (trace)"
    else
      l)
  |> Stdlib.String.join("\n")


/// Which tool results changed between an earlier session and its rerun.
let rerunDiff(before: List<Agent.Message>, after: List<Agent.Message>): (Int64 * List<String>) =
  let was = toolResultsOf(before)
  let now = toolResultsOf(after)
  let rows =
    Stdlib.List.zipShortest(was, now)
    |> Stdlib.List.indexedMap(fun(i, pair) -> (i + 1, pair))
    |> Stdlib.List.filterMap(fun numbered ->
      let (i, ((name, a), (_n, b))) = numbered
      if comparable(a) == comparable(b) then
        Option.None
      else
        Option.Some(
          $"  #{Stdlib.display(i)} {name}\n    was {Stdlib.String.first(a, 200)}\n    now {Stdlib.String.first(b, 200)}"))

  let missing = Stdlib.List.length(was) - Stdlib.List.length(now)
  let rows =
    if missing > 0 then
      Stdlib.List.append(rows, $"  the rerun stopped {Stdlib.display(missing)} tool calls early")
    else
      rows

  (Stdlib.List.length(was), rows)


let replayOrLive(o: Options): Result<Provider, String> =
  match o.replay with
  | Some(path) ->
    match Stdlib.Cli.File.readText(path) with
    | Ok(text) ->
      let responses =
        Stdlib.String.split(text, "\n=====\n")
        |> Stdlib.List.filter(fun r -> Stdlib.String.trim(r) != "")

      Result.Ok(Provider.Replay(responses))
    | Error(e) -> Result.Error($"could not read {path}: {Stdlib.display(e)}")
  | None ->
    readKey()
    |> Stdlib.Result.map(fun key ->
      Provider.Live(
        Agent.Anthropic.Config
          { baseUrl = o.baseUrl
            apiKey = key
            model = o.model
            maxTokens = 64000
            effort = o.effort }))


let endingText(e: Agent.Ending): (String * Bool) =
  match e with
  | Answered(text) -> (text, false)
  | TurnLimit(n) -> ($"stopped after {Stdlib.display(n)} model calls (--max-turns)", true)
  | Failed(why) -> (why, true)


let execute(state: AppState, args: List<String>): AppState =
  run(state, args)


let run(state: AppState, args: List<String>): AppState =
  match parseArgs(args, defaultOptions()) with
  | Error(why) ->
    printErr(why)
    { state with exitCode = 2 }
  | Ok(o) when o.showPrompt -> showPrompt(state, o)
  | Ok(o) when o.prompt == "" && Stdlib.Option.isSome(o.rerun) ->
    match o.rerun |> Stdlib.Option.andThen(fun id -> conversationOf(id)) with
    | Some(c) -> runWith(state, { o with prompt = taskOf(Sessions.messagesOf(c)) })
    | None ->
      printErr("no such session to rerun; `dark session ls` shows them")
      { state with exitCode = 2 }
  | Ok(o) when o.prompt == "" && Stdlib.Cli.Sys.isTerminal(0) -> chat(state, o)
  | Ok(o) when o.prompt == "" ->
    match Stdlib.Cli.Stdin.readAll() with
    | Ok(text) when Stdlib.String.trim(text) != "" ->
      runWith(state, { o with prompt = Stdlib.String.trim(text) })
    | _ ->
      printErr("agent needs a prompt: dark agent -p \"build me ...\", or on stdin")
      { state with exitCode = 2 }
  | Ok(o) -> runWith(state, o)


/// The prompt's sections: `Me.Agent.Prompt.sections` when that value exists where `dark` was
/// started (main, usually), so the prompt is changed by editing a package value; the built-in
/// `Darklang.Agent.Prompt.sections` otherwise. A change the agent makes on its own branch takes
/// effect once it is merged.
let promptSections(state: AppState): List<Agent.Prompt.PromptSection> =
  let (found, _printed) =
    Workbench.captureOutputAnd(fun () ->
      Eval.evaluateValue(
        state.accountID,
        state.currentBranchId,
        "Me.Agent.Prompt.sections",
        Eval.Harmful.Halt))

  match found with
  | Ok(sections) -> sections
  | Error(_) -> Agent.Prompt.sections


/// What a sandboxed session may write to: the working directory, the store's folder, .NET's lock
/// folder, and the temporary folder the environment names.
let sandboxFolders(cwd: String): List<String> =
  let store = Stdlib.Cli.Path.parent(LanguageTools.LocalStore.path())
  let extra =
    [ "TMPDIR", "DOTNET_BUNDLE_EXTRACT_BASE_DIR" ]
    |> Stdlib.List.filterMap(fun k -> Stdlib.Env.get(k))
    |> Stdlib.List.filter(fun d -> d != "" && d != "/" && d != "/tmp")

  Stdlib.List.flatten([ [ cwd, store, "/tmp/.dotnet" ], extra ])


let toolsFor(o: Options): List<Tools.Tool> =
  match o.toolset with
  | StoreTools -> Tools.all()
  | Generic -> Tools.generic()


/// The `docs for-ai` page, as `dark docs for-ai` prints it, or "".
let forAiPage(state: AppState): String =
  let (after, text) =
    Workbench.captureOutputAnd(fun () ->
      Registry.executeCommand("docs", { state with exitCode = 0 }, [ "for-ai" ]))

  if after.exitCode == 0 then
    Stdlib.String.trim(Sessions.Batch.stripAnsi(text))
  else
    ""


/// The system prompt for a session at <param cwd> on <param branch>.
let systemPrompt(state: AppState, o: Options, cwd: String, branch: String): String =
  let sections =
    match o.toolset with
    | StoreTools -> Agent.Prompt.withReference(promptSections(state), forAiPage(state))
    | Generic -> Agent.Prompt.genericSections

  let sections =
    if o.sandbox then
      Stdlib.List.append(sections, Agent.Prompt.sandbox)
    else
      sections

  Agent.Prompt.compose(
    sections,
    Agent.Prompt.Tier.Frontier,
    [ projectContext(cwd), skillsIndex(cwd) ]
    |> Stdlib.List.filter(fun t -> t != "")
    |> Stdlib.String.join("\n\n"),
    cwd,
    branch,
    // the day, not the time: the prompt stays the same, and cached, for a day
    Stdlib.String.first(Stdlib.display(Stdlib.DateTime.now()), 10),
    Stdlib.Cli.Sys.currentExecutablePath())


/// Everything sent to the model before the conversation, as it would be sent: the system prompt
/// and each tool's description and parameters.
let showPrompt(state: AppState, o: Options): AppState =
  let cwd = Stdlib.Cli.Posix.getCwd() |> Stdlib.Result.withDefault(".")
  let _ = Stdlib.printLine("=== system prompt")
  let _ = Stdlib.printLine(systemPrompt(state, o, cwd, "session-s1"))
  let _ =
    toolsFor(o)
    |> Stdlib.List.iter(fun t ->
      let _ = Stdlib.printLine($"\n=== tool {t.spec.name}")
      Stdlib.printLine(
        Stdlib.AltJson.format(
          Agent.Anthropic.toolToJson(t.spec, Agent.Anthropic.Breakpoint.NoBreakpoint))))

  let _ = Stdlib.printLine("\n=== compaction request")
  let _ = Stdlib.printLine(Agent.Prompt.compaction)
  state


/// Everything a run needs, before the first prompt: the session (new, resumed or forked), the tools
/// and the system prompt.
let prepare(state: AppState, o: Options, text: TextShown): Result<Run, String> =
  let cwd = Stdlib.Cli.Posix.getCwd() |> Stdlib.Result.withDefault(".")
  match openSession(state, o, cwd), providerFor(o) with
  | Error(why), _ -> Result.Error(why)
  | _, Error(why) -> Result.Error(why)
  | Ok((session, conversation)), Ok(provider) ->
    let session = { session with conversation = Option.Some(conversation) }
    let _ = Sessions.add(session)
    let branch = Sessions.branchText(Sessions.branchOf(session))
    let system = systemPrompt(state, o, cwd, branch)
    let ctx =
      Tools.Context
        { app = Sessions.enter(state, session)
          session = session
          cwd = cwd
          seen = []
          allowed = o.allowed
          ask =
            o.format == Format.PlainText
            && Stdlib.Cli.Sys.isTerminal(0)
            && Stdlib.Cli.Sys.isTerminal(2)
          store = o.toolset == Toolset.StoreTools
          touched = []
          probes = []
          writable = if o.sandbox then sandboxFolders(cwd) else []
          hosts = o.hosts }

    let loop = Agent.start(Sessions.messagesOf(conversation), o.maxTurns)
    Result.Ok(
      Run
        { loop = { loop with checksLeft = o.checks, compactAt = o.compactAt }
          queue = []
          ctx = ctx
          conversation = conversation
          provider = provider
          system = system
          tools = toolsFor(o)
          format = o.format
          ending = Option.None
          text = text })


/// One prompt, run until the model answers or the run stops.
let turn(run: Run, prompt: String): Run =
  let fresh = { run.loop with turns = 0 }
  let (loop, commands) = Agent.step(fresh, Agent.Event.Prompt(prompt))
  drain({ run with loop = loop, queue = commands, ending = Option.None })


let branchOfRun(run: Run): String =
  Sessions.branchText(run.ctx.app.currentBranchId)


/// The session's draft in a line or two, for the person reading stderr.
let draftLines(run: Run): List<String> =
  let (_app, _record, status) =
    Sessions.Batch.run(run.ctx.app, run.ctx.session, "status", Sessions.Batch.OnFailure.Stop)

  status.replies
  |> Stdlib.List.map(fun r -> r.lines)
  |> Stdlib.List.flatten
  |> Stdlib.List.filter(fun l ->
    Stdlib.String.contains(l, "draft:") || Stdlib.String.contains(l, "clean:"))
  |> Stdlib.List.map(fun l -> $"{branchOfRun(run)} {Stdlib.String.trim(l)}")


let usageLine(run: Run, ms: Int64): String =
  let u = run.loop.usage
  let dollars =
    match Agent.Anthropic.costNanos(run.conversation.model, u) with
    | Some(n) ->
      let cents = n / 10000000
      let rest = Stdlib.String.padStart(Stdlib.display(cents % 100), '0', 2)
      $", about ${Stdlib.display(cents / 100)}.{rest}"
    | None -> ""

  $"session {run.ctx.session.id}: {Stdlib.display(run.loop.turns)} model calls, {Stdlib.display(u.input + u.cacheRead + u.cacheWrite)} tokens in ({Stdlib.display(u.cacheRead)} cached), {Stdlib.display(u.output)} out{dollars}, {Stdlib.display(ms)} ms; `dark @{run.ctx.session.id}` works in it"


let runWith(state: AppState, o: Options): AppState =
  match prepare(state, o, TextShown.AtTheEnd) with
  | Error(why) ->
    printErr(why)
    { state with exitCode = 1 }
  | Ok(run) ->
    let started = Stdlib.DateTime.now()
    let _ =
      match o.format with
      | StreamJson ->
        emitJson(
          [ ("type", str("system"))
            ("subtype", str("init"))
            ("session_id", str(run.ctx.session.id))
            ("model", str(o.model))
            ("cwd", str(run.ctx.cwd))
            (
              "tools",
              Stdlib.AltJson.Json.Array(run.tools |> Stdlib.List.map(fun t -> str(t.spec.name)))) ])
      | PlainText ->
        Stdlib.printErrorLine($"session {run.ctx.session.id} on branch {branchOfRun(run)}")

    let (finished, usage, turns) = attempts(state, o, run)
    let run = finished
    let _ = if o.merge then mergeKept(state, finished) else ()
    let ending =
      finished.ending
      |> Stdlib.Option.withDefault(Agent.Ending.Failed("the run stopped without an answer"))

    let _ =
      match o.rerun with
      | Some(id) ->
        match conversationOf(id) with
        | Some(old) ->
          let (total, rows) = rerunDiff(Sessions.messagesOf(old), finished.loop.messages)
          let head =
            $"rerun of {id} as {finished.ctx.session.id}: {Stdlib.display(total)} tool results, {Stdlib.display(Stdlib.List.length(rows))} differ"

          match o.format with
          | StreamJson ->
            emitJson(
              [ ("type", str("rerun"))
                ("of", str(id))
                ("summary", str(head))
                ("changed", Stdlib.AltJson.Json.Array(rows |> Stdlib.List.map(fun r -> str(r)))) ])
          | PlainText ->
            Stdlib.printErrorLine(Stdlib.String.join(Stdlib.List.prepend(rows, head), "\n"))
        | None -> ()
      | None -> ()

    let (text, isError) = endingText(ending)
    let ms = Stdlib.DateTime.subtractMs(Stdlib.DateTime.now(), started)
    let _ =
      match o.format with
      | StreamJson ->
        let subtype =
          match ending with
          | Answered(_) -> "success"
          | TurnLimit(_) -> "error_max_turns"
          | Failed(_) -> "error_during_execution"

        emitJson(
          [ ("type", str("result"))
            ("subtype", str(subtype))
            ("is_error", Stdlib.AltJson.Json.Bool(isError))
            ("result", str(text))
            ("num_turns", Stdlib.AltJson.Json.Integer(turns))
            ("duration_ms", Stdlib.AltJson.Json.Integer(ms))
            ("session_id", str(run.ctx.session.id))
            (
              "total_cost_usd",
              match Agent.Anthropic.cost(o.model, usage) with
              | Some(c) -> Stdlib.AltJson.Json.Float(c)
              | None -> Stdlib.AltJson.Json.Null)

            ("usage", usageJson(usage)) ])
      | PlainText ->
        if isError then printErr(text) else Stdlib.printLine(text)
        draftLines(finished) |> Stdlib.List.iter(fun l -> Stdlib.printErrorLine(l))
        Stdlib.printErrorLine(
          usageLine(
            { finished with loop = { finished.loop with usage = usage, turns = turns } },
            ms))

    { state with exitCode = if isError then 1 else 0 }


/// Commit the kept session's draft on its branch, and merge the branch into the one `dark`
/// started on.
let mergeKept(state: AppState, run: Run): Unit =
  let branch = branchOfRun(run)
  let (_s, _r, committed) =
    Sessions.Batch.run(
      run.ctx.app,
      run.ctx.session,
      $"commit \"agent session {run.ctx.session.id}\" -y",
      Sessions.Batch.OnFailure.Stop)

  let (after, out) =
    Workbench.captureOutputAnd(fun () ->
      Registry.executeCommand(
        "merge",
        { state with exitCode = 0 },
        [ branch, "-y", "--allow-type-errors" ]))

  let said =
    if after.exitCode == 0 then
      $"merged {branch} into {Sessions.branchText(state.currentBranchId)}"
    else
      $"could not merge {branch}: {Stdlib.String.trim(Sessions.Batch.stripAnsi(out))}"

  let _ = Sessions.Batch.count(committed, "error")
  Stdlib.printErrorLine(said)


/// How far a finished attempt is from done: 0 when the done-check passes, else the number of
/// problems it found; an attempt that stopped without an answer is furthest.
let distance(run: Run): (Int64 * String) =
  match run.ending with
  | Some(Answered(_)) ->
    match Store.doneCheck(run.ctx) with
    | None -> (0, "")
    | Some(problems) ->
      let n =
        Stdlib.String.splitOnNewline(problems)
        |> Stdlib.List.filter(fun l -> Stdlib.String.startsWith(l, "- "))
        |> Stdlib.List.length

      (if n > 0 then n else 1, problems)
  | Some(ending) -> (1000, Stdlib.Tuple2.first(endingText(ending)))
  | None -> (1000, "the run stopped without an answer")


/// The prompt for a later attempt: the task, and what the earlier ones ended with.
let retryPrompt(prompt: String, failures: List<String>): String =
  let notes =
    failures
    |> Stdlib.List.indexedMap(fun(i, f) ->
      $"Attempt {Stdlib.display(i + 1)}, on another branch, ended with:\n{Stdlib.String.first(f, 1500)}")

  prompt
  + "\n\n"
  + Stdlib.String.join(notes, "\n\n")
  + "\n\nThis is a fresh attempt on a new branch: nothing from the earlier ones is here. Avoid what went wrong."


/// Up to `o.attempts` attempts, each on a fresh branch of its own, until one passes the done-check.
/// The attempt closest to done is kept (the first, on a tie); the others' branches are left
/// unmerged. The usage and turns are those of every attempt.
let attempts(state: AppState, o: Options, first: Run): (Run * Agent.Usage * Int64) =
  let one = turn(first, o.prompt)
  let (d1, why1) = if o.attempts > 1 then distance(one) else (0, "")
  let start = (one, d1, one, [ why1 ], one.loop.usage, one.loop.turns)
  let (best, _bestD, _last, _failures, usage, turns) =
    Stdlib.List.checkedRange(2, o.attempts)
    |> Stdlib.Result.withDefault([])
    |> Stdlib.List.fold(start, fun(acc, i) ->
      let (best, bestD, last, failures, usage, turns) = acc
      if bestD == 0 then
        acc
      else
        let _ =
          Stdlib.printErrorLine(
            $"attempt {Stdlib.display(i - 1)} ({last.ctx.session.id}) is not done; attempt {Stdlib.display(i)} on a fresh branch")

        match prepare(state, { o with prompt = "" }, first.text) with
        | Error(why) -> (best, bestD, last, Stdlib.List.append(failures, why), usage, turns)
        | Ok(next) ->
          let next = { next with provider = last.provider }
          let done = turn(next, retryPrompt(o.prompt, failures))
          let (d, why) = distance(done)
          let usage = Agent.addUsage(usage, done.loop.usage)
          let turns = turns + done.loop.turns
          if d < bestD then
            (done, d, done, Stdlib.List.append(failures, why), usage, turns)
          else
            (best, bestD, done, Stdlib.List.append(failures, why), usage, turns))

  (best, usage, turns)


/// `dark agent` at a terminal with no prompt: a conversation, one prompt per line, the answer
/// streamed as it arrives. An empty line or the end of input stops it; the session stays, so
/// `dark agent --continue` picks it up again.
let chat(state: AppState, o: Options): AppState =
  match prepare(state, o, TextShown.AsItStreams) with
  | Error(why) ->
    printErr(why)
    { state with exitCode = 1 }
  | Ok(run) ->
    let _ =
      Stdlib.printErrorLine(
        $"session {run.ctx.session.id} on branch {branchOfRun(run)}; an empty line ends it")

    let (last, _done) =
      Stdlib.List.checkedRange(1, 100000)
      |> Stdlib.Result.withDefault([])
      |> Stdlib.List.fold((run, false), fun(acc, _i) ->
        let (r, finished) = acc
        if finished then
          acc
        else
          let _ = Stdlib.printError("› ")
          match Stdlib.Cli.Stdin.checkedReadLine() with
          | Ok(Some(line)) when Stdlib.String.trim(line) != "" ->
            let started = Stdlib.DateTime.now()
            let r2 = turn(r, Stdlib.String.trim(line))
            let _ =
              match r2.ending with
              | Some(Failed(why)) -> printErr(why)
              | Some(TurnLimit(n)) -> printErr($"stopped after {Stdlib.display(n)} model calls")
              | _ -> ()

            let _ =
              Stdlib.printErrorLine(
                usageLine(r2, Stdlib.DateTime.subtractMs(Stdlib.DateTime.now(), started)))

            (r2, false)
          | _ -> (r, true))

    draftLines(last) |> Stdlib.List.iter(fun l -> Stdlib.printErrorLine(l))
    state


let accepts(): Accepts.Accepts =
  Accepts.withValues(
    [ "--model"
      "--resume"
      "--fork"
      "--branch"
      "--max-turns"
      "--output-format"
      "--replay"
      "--base-url"
      "--allow"
      "--effort"
      "--tools"
      "--checks"
      "--compact-at"
      "--attempts"
      "--rerun"
      "--hosts" ],
    Accepts.freeText(0, [ "-p", "--print", "--continue", "--show-prompt", "--merge", "--sandbox" ]))


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: agent -p <prompt> [options]     (-p and --print are the same; the prompt may come on stdin)"
    ""
    "Build what the prompt asks for, in Dark, and print the answer. It works in a session on a branch"
    "of its own (session-s1, ...): `dark @s1` works in what it built, `dark merge` takes it."
    ""
    "  --model <id>               default claude-opus-5-5"
    "  --effort <level>           how hard it thinks: low, medium, high (default), xhigh, max"
    "  --allow <effects>          also allow these, comma-separated: file-write, process, http, all."
    "                             Without it the agent reads files and reads and writes packages on"
    "                             its branch. Any other tool call is put to you at a terminal,"
    "                             and refused otherwise; the model is told why"
    "  (no prompt, at a terminal)   a conversation: one prompt per line, answers streamed"
    "  --continue                 continue the current session (`dark session ls`)"
    "  --resume <id>              continue session <id>"
    "  --fork <id>                a new session from <id>'s conversation, on a branch off its branch"
    "  --branch <name>            work on this existing branch instead of a new one"
    "  --max-turns <n>            stop after n model calls (default 200)"
    "  --output-format <f>        text (default) or stream-json, one JSON event per line"
    "  --replay <file>            answer from recorded SSE responses (separated by =====), not the API"
    "  --tools <set>              store (default): the store's tools and checks; generic: files and bash only"
    "  --checks <n>               when the model says it is done, check the modules it wrote typecheck and"
    "                             have passing tests, and send it back up to n times (default 2; 0 off)"
    "  --compact-at <tokens>      compact the conversation once a call's input passes this (default 120000)"
    "  --show-prompt              print everything sent to the model before the conversation, and stop"
    "  --attempts <n>             if an attempt is not done (the done-check), start again on a fresh branch,"
    "                             told what went wrong, up to n in all; the closest to done is kept"
    "  --merge                    at the end, commit the kept session's branch and merge it into the branch"
    "                             dark started on, type errors and all, so its work is where a run looks"
    "  --sandbox                  write only under the working directory and the store; bash runs in bwrap"
    "                             with no network; code may reach loopback and --hosts only"
    "  --hosts <a,b>              under --sandbox, the hosts code may reach"
    "  --rerun <id>               run session <id>'s model turns again on a new branch, against today's code"
    "                             and tools, and say which tool results changed"
    "  --base-url <url>           the Messages API's address (default https://api.anthropic.com)"
    ""
    "The API key is read from secrets/anthropic.key beside the store." ]
  |> Stdlib.String.join("\n")
