/// The agent's tools. Each declares the effects it has, and runs only when the session's policy
/// allows every one of them; a refusal goes back to the model as a failed tool call.
///
/// The Dark tools run batches in the session's repl, in this process, and answer with the repl's
/// numbered replies and report: what typechecks and which callers broke come back with the edit.
module Darklang.Cli.Agent.Tools

type Context =
  { app: AppState
    repl: Repls.Record
    cwd: String
    /// Files read this session: `edit` and `write` refuse to change a file the model has not seen.
    seen: List<String>
    allowed: List<LanguageTools.Permissions.Effect>
    /// A person is at the terminal to approve what the policy does not allow.
    ask: Bool
    /// The checks only the store can do: slips fixed at save, earlier evals run again after a save,
    /// a failed run's values, effects before a run. Off for the generic comparison arm.
    store: Bool
    /// The modules this session wrote to.
    touched: List<String>
    /// Earlier evals and their answers, run again after each save.
    probes: List<(String * String)>
    /// Under `--sandbox`, the folders anything the session does may write to; empty otherwise.
    writable: List<String>
    /// Under `--sandbox`, the hosts code the session runs may reach, besides loopback.
    hosts: List<String> }


type Tool =
  { spec: Agent.Anthropic.ToolSpec
    effects: List<LanguageTools.Permissions.Effect>
    run: (Context, Stdlib.AltJson.Json) -> (Context * Agent.ToolOutput) }


val outputCap = 30000

val lineCap = 2000


let ok(text: String): Agent.ToolOutput =
  Agent.ToolOutput { text = text, isError = false }


let fail(text: String): Agent.ToolOutput =
  Agent.ToolOutput { text = text, isError = true }


/// Keep the head and the tail of a long output: the end of a build log is where the error is.
let truncate(text: String): String =
  let n = Stdlib.String.length(text)
  if n <= outputCap then
    text
  else
    let half = outputCap / 2
    Stdlib.String.first(text, half)
    + $"\n... [{Stdlib.display(n - outputCap)} characters cut] ...\n"
    + Stdlib.String.last(text, half)


type Param =
  { name: String
    kind: String
    description: String
    required: Bool }


let param(name: String, kind: String, description: String): Param =
  Param { name = name, kind = kind, description = description, required = true }


let optional(name: String, kind: String, description: String): Param =
  Param { name = name, kind = kind, description = description, required = false }


let schema(params: List<Param>): Stdlib.AltJson.Json =
  let props =
    params
    |> Stdlib.List.map(fun p ->
      (
        p.name,
        Stdlib.AltJson.Json.Object(
          [ ("type", Stdlib.AltJson.Json.String(p.kind))
            ("description", Stdlib.AltJson.Json.String(p.description)) ])))

  let required =
    params
    |> Stdlib.List.filter(fun p -> p.required)
    |> Stdlib.List.map(fun p -> Stdlib.AltJson.Json.String(p.name))

  Stdlib.AltJson.Json.Object(
    [ ("type", Stdlib.AltJson.Json.String("object"))
      ("properties", Stdlib.AltJson.Json.Object(props))
      ("required", Stdlib.AltJson.Json.Array(required)) ])


let spec(name: String, description: String, params: List<Param>): Agent.Anthropic.ToolSpec =
  Agent.Anthropic.ToolSpec { name = name, description = description, schema = schema(params) }


let fields(input: Stdlib.AltJson.Json): List<(String * Stdlib.AltJson.Json)> =
  match input with
  | Object(fs) -> fs
  | _ -> []


let getText(input: Stdlib.AltJson.Json, key: String): Option<String> =
  Stdlib.AltJson.Helpers.getString(key, fields(input))


let getInt(input: Stdlib.AltJson.Json, key: String): Option<Int64> =
  Stdlib.AltJson.Helpers.getInt64Option(key, fields(input))


let getBool(input: Stdlib.AltJson.Json, key: String): Bool =
  Stdlib.AltJson.Helpers.getBool(key, fields(input)) |> Stdlib.Option.withDefault(false)


/// Whether <param path> may be written: anywhere without a sandbox; inside one of its folders
/// with one. A path with `..` in it is refused rather than resolved.
let mayWrite(ctx: Context, path: String): Bool =
  match ctx.writable with
  | [] -> true
  | dirs ->
    Stdlib.Bool.not(Stdlib.String.contains(path, "/../"))
    && Stdlib.Bool.not(Stdlib.String.endsWith(path, "/.."))
    && Stdlib.List.any(dirs, fun d -> path == d || Stdlib.String.startsWith(path, d + "/"))


let outsideSandbox(path: String): Agent.ToolOutput =
  fail($"{path} is outside this session's sandbox; write under the working directory")


let absolute(ctx: Context, path: String): String =
  if Stdlib.String.startsWith(path, "/") then path else ctx.cwd + "/" + path


/// Run <param f> with the text argument <param key>, or say it is missing.
let needing(
  ctx: Context,
  input: Stdlib.AltJson.Json,
  key: String,
  f: String -> (Context * Agent.ToolOutput))
  : (Context * Agent.ToolOutput) =
  match getText(input, key) with
  | Some(v) -> f(v)
  | None -> (ctx, fail($"missing `{key}`"))


let numbered(lines: List<String>, from: Int64): String =
  lines
  |> Stdlib.List.indexedMap(fun(i, l) ->
    Stdlib.String.padStart(Stdlib.display(from + i), ' ', 6) + "\t" + l)
  |> Stdlib.String.join("\n")


let readFile(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "path", fun path ->
    let full = absolute(ctx, path)
    if Stdlib.Cli.FileSystem.isDirectory(full) then
      (ctx, fail($"{path} is a directory; use ls"))
    else
      match Stdlib.Cli.File.readText(full) with
      | Error(e) -> (ctx, fail($"could not read {path}: {Stdlib.display(e)}"))
      | Ok(text) ->
        let lines = Stdlib.String.splitOnNewline(text)
        let offset = getInt(input, "offset") |> Stdlib.Option.withDefault(1)
        let offset = if offset < 1 then 1 else offset
        let limit = getInt(input, "limit") |> Stdlib.Option.withDefault(lineCap)
        let shown =
          lines
          |> Stdlib.List.drop(offset - 1)
          |> Stdlib.List.take(limit)

        let total = Stdlib.List.length(lines)
        let last = offset - 1 + Stdlib.List.length(shown)
        let more =
          if last < total then
            $"\n... {Stdlib.display(total - last)} more lines; read with offset {Stdlib.display(last + 1)}"
          else
            ""

        let seen =
          if Stdlib.List.contains(ctx.seen, full) then
            ctx.seen
          else
            Stdlib.List.append(ctx.seen, full)

        ({ ctx with seen = seen }, ok(truncate(numbered(shown, offset) + more))))


let writeFile(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "path", fun path ->
    needing(ctx, input, "content", fun content ->
      let full = absolute(ctx, path)
      if Stdlib.Bool.not(mayWrite(ctx, full)) then
        (ctx, outsideSandbox(path))
      else if
        Stdlib.Cli.File.exists(full) && Stdlib.Bool.not(Stdlib.List.contains(ctx.seen, full))
      then
        (ctx, fail($"{path} exists and has not been read this session; read it first"))
      else
        match Stdlib.Cli.File.writeText(full, content) with
        | Error(e) -> (ctx, fail($"could not write {path}: {Stdlib.display(e)}"))
        | Ok(_) ->
          let seen =
            if Stdlib.List.contains(ctx.seen, full) then
              ctx.seen
            else
              Stdlib.List.append(ctx.seen, full)

          let n = Stdlib.List.length(Stdlib.String.splitOnNewline(content))
          ({ ctx with seen = seen }, ok($"wrote {path} ({Stdlib.display(n)} lines)"))))


/// Replace the one place whose lines match <param old> ignoring leading and trailing whitespace.
/// None when there is no such place, or more than one.
let fuzzyReplace(content: String, old: String, replacement: String): Option<String> =
  let fileLines = Stdlib.String.split(content, "\n")
  let oldLines =
    Stdlib.String.split(Stdlib.String.trim(old), "\n")
    |> Stdlib.List.map(fun l -> Stdlib.String.trim(l))

  let k = Stdlib.List.length(oldLines)
  let n = Stdlib.List.length(fileLines)
  if k == 0 || k > n then
    Option.None
  else
    let matches =
      Stdlib.List.checkedRange(0, n - k)
      |> Stdlib.Result.withDefault([])
      |> Stdlib.List.filter(fun i ->
        (fileLines
         |> Stdlib.List.drop(i)
         |> Stdlib.List.take(k)
         |> Stdlib.List.map(fun l -> Stdlib.String.trim(l)))
        == oldLines)

    match matches with
    | [i] ->
      let replaced =
        Stdlib.List.flatten(
          [ Stdlib.List.take(fileLines, i)
            Stdlib.String.split(replacement, "\n")
            Stdlib.List.drop(fileLines, i + k) ])

      Option.Some(Stdlib.String.join(replaced, "\n"))
    | _ -> Option.None


/// Exact first; then the same lines with whitespace ignored. An exact match that occurs more than
/// once needs `replace_all`.
type Occurrences =
  | One
  | Every


let editText(
  content: String,
  old: String,
  replacement: String,
  occurrences: Occurrences)
  : Result<String, String> =
  let count = Stdlib.List.length(Stdlib.String.split(content, old)) - 1
  if old == "" then
    Result.Error("old_string is empty")
  else if count == 1 || count > 1 && occurrences == Occurrences.Every then
    Result.Ok(Stdlib.String.replaceAll(content, old, replacement))
  else if count > 1 then
    Result.Error(
      $"old_string occurs {Stdlib.display(count)} times; add context to make it unique, or set replace_all")
  else
    match fuzzyReplace(content, old, replacement) with
    | Some(text) -> Result.Ok(text)
    | None ->
      Result.Error("old_string is not in the file (even ignoring indentation); read the file again")


let editFile(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "path", fun path ->
    needing(ctx, input, "old_string", fun old ->
      needing(ctx, input, "new_string", fun replacement ->
        let full = absolute(ctx, path)
        if Stdlib.Bool.not(mayWrite(ctx, full)) then
          (ctx, outsideSandbox(path))
        else if Stdlib.Bool.not(Stdlib.List.contains(ctx.seen, full)) then
          (ctx, fail($"read {path} before editing it"))
        else
          match Stdlib.Cli.File.readText(full) with
          | Error(e) -> (ctx, fail($"could not read {path}: {Stdlib.display(e)}"))
          | Ok(content) ->
            let occurrences =
              if getBool(input, "replace_all") then Occurrences.Every else Occurrences.One

            match editText(content, old, replacement, occurrences) with
            | Error(why) -> (ctx, fail(why))
            | Ok(updated) ->
              match Stdlib.Cli.File.writeText(full, updated) with
              | Error(e) -> (ctx, fail($"could not write {path}: {Stdlib.display(e)}"))
              | Ok(_) -> (ctx, ok($"edited {path}")))))


/// Run <param command> in bash. Without the `http` effect it runs in a network namespace of its
/// own (`unshare -rn`), so a command cannot reach the network the session was not given.
let shell(
  ctx: Context,
  command: String,
  timeoutMs: Int64)
  : Result<Stdlib.Cli.Process.Output, String> =
  let script = $"cd {Stdlib.Cli.Process.shellQuote(ctx.cwd)} && {command}"
  if Stdlib.Bool.not(Stdlib.List.isEmpty(ctx.writable)) then
    // the sandbox: the filesystem read-only but for the session's folders, and a network of its
    // own with only loopback
    let binds =
      ctx.writable
      |> Stdlib.List.filter(fun d -> Stdlib.Cli.FileSystem.isDirectory(d))
      |> Stdlib.List.map(fun d -> [ "--bind", d, d ])
      |> Stdlib.List.flatten

    Stdlib.Cli.Process.runWithTimeout(
      timeoutMs,
      "/usr/bin/bwrap",
      Stdlib.List.flatten(
        [ [ "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc" ]
          binds
          [ "--unshare-net", "--die-with-parent", "/bin/bash", "-c", script ] ]))
  else if Stdlib.List.contains(ctx.allowed, LanguageTools.Permissions.Effect.Http) then
    Stdlib.Cli.Process.runWithTimeout(timeoutMs, "/bin/bash", [ "-c", script ])
  else
    // loopback stays usable, so a server started in the call can be tried from the same call
    let local = "command -v ip >/dev/null && ip link set lo up 2>/dev/null; " + script
    Stdlib.Cli.Process.runWithTimeout(
      timeoutMs,
      "/usr/bin/unshare",
      [ "-rn", "/bin/bash", "-c", local ])


let bash(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "command", fun command ->
    let timeoutMs = getInt(input, "timeout_ms") |> Stdlib.Option.withDefault(120000)
    match shell(ctx, command, timeoutMs) with
    | Error(why) -> (ctx, fail(why))
    | Ok(out) ->
      let both =
        [ out.stdout, out.stderr ]
        |> Stdlib.List.filter(fun s -> Stdlib.String.trim(s) != "")
        |> Stdlib.String.join("\n")

      let text = truncate(both) + $"\n[exit {Stdlib.display(out.exitCode)}]"
      (ctx, Agent.ToolOutput { text = text, isError = out.exitCode != 0 }))


let grep(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "pattern", fun pattern ->
    let path = getText(input, "path") |> Stdlib.Option.withDefault(".")
    let command =
      $"grep -rnI --exclude-dir=.git -E {Stdlib.Cli.Process.shellQuote(pattern)} {Stdlib.Cli.Process.shellQuote(path)} | head -200"

    match shell(ctx, command, 30000) with
    | Error(why) -> (ctx, fail(why))
    | Ok(out) ->
      (
        ctx,
        ok(
          if Stdlib.String.trim(out.stdout) == "" then
            "no matches"
          else
            truncate(out.stdout))))


let find(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "pattern", fun pattern ->
    let path = getText(input, "path") |> Stdlib.Option.withDefault(".")
    let command =
      $"find {Stdlib.Cli.Process.shellQuote(path)} -name .git -prune -o -name {Stdlib.Cli.Process.shellQuote(pattern)} -print | head -200"

    match shell(ctx, command, 30000) with
    | Error(why) -> (ctx, fail(why))
    | Ok(out) ->
      (
        ctx,
        ok(
          if Stdlib.String.trim(out.stdout) == "" then
            "nothing found"
          else
            truncate(out.stdout))))


let ls(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  let path = getText(input, "path") |> Stdlib.Option.withDefault(".")
  let full = absolute(ctx, path)
  match Stdlib.Cli.FileSystem.listDirectory(full) with
  | Error(e) -> (ctx, fail($"could not list {path}: {Stdlib.display(e)}"))
  | Ok(names) ->
    let shown =
      names
      |> Stdlib.List.sort
      |> Stdlib.List.map(fun entry ->
        let n = Stdlib.Cli.Path.basename(entry)
        if Stdlib.Cli.FileSystem.isDirectory(entry) then n + "/" else n)

    (
      ctx,
      ok(
        if Stdlib.List.isEmpty(shown) then
          "(empty)"
        else
          truncate(Stdlib.String.join(shown, "\n"))))


/// Commands a session never runs: they change this instance (its policy, its config, what is
/// installed) or move work off the session's branch. The person runs those.
val personOnly =
  [ "permissions"
    "config"
    "install"
    "uninstall"
    "update"
    "backups"
    "merge"
    "switch"
    "checkout"
    "rebase"
    "serve" ]


/// The effect a `--allow` rule grants, by its first words.
let ruleEffect(rule: String): Option<LanguageTools.Permissions.Effect> =
  let words =
    Stdlib.String.split(Stdlib.String.trim(rule), " ") |> Stdlib.List.filter(fun w -> w != "")

  match words with
  | ["file", "read", ...] -> Option.Some(LanguageTools.Permissions.Effect.FileRead)
  | ["file", "write", ...] -> Option.Some(LanguageTools.Permissions.Effect.FileWrite)
  | ["file", ...] -> Option.Some(LanguageTools.Permissions.Effect.FileWrite)
  | ["http-server", ...] -> Option.Some(LanguageTools.Permissions.Effect.HttpServer)
  | ["http", ...] -> Option.Some(LanguageTools.Permissions.Effect.Http)
  | ["process", ...] -> Option.Some(LanguageTools.Permissions.Effect.Process)
  | ["process-exact", ...] -> Option.Some(LanguageTools.Permissions.Effect.Process)
  | ["env", ...] -> Option.Some(LanguageTools.Permissions.Effect.EnvRead)
  | _ -> Option.None


let sandboxHosts(ctx: Context): String =
  match ctx.hosts with
  | [] -> "none"
  | hs -> Stdlib.String.join(hs, ", ")


/// Whether a `run --allow` rule stays inside the sandbox: file writes under its folders, network
/// to loopback or its hosts, no processes (they would run outside it).
let sandboxAllows(ctx: Context, rule: String): Bool =
  let words =
    Stdlib.String.split(Stdlib.String.trim(rule), " ") |> Stdlib.List.filter(fun w -> w != "")

  let local = [ "127.0.0.1", "localhost", "[::1]" ]
  let names = fun w ->
    Stdlib.List.any(Stdlib.List.concat(local, ctx.hosts), fun h -> Stdlib.String.contains(w, h))

  match words with
  | ["file", "read", ...] -> true
  | ["file", "write", ...paths] ->
    Stdlib.Bool.not(Stdlib.List.isEmpty(paths))
    && Stdlib.List.all(paths, fun p -> mayWrite(ctx, absolute(ctx, p)))
  | ["file", ...] -> false
  | ["http-server", ...rest] -> Stdlib.List.any(rest, fun w -> Stdlib.List.contains(local, w))
  | ["http", ...rest] ->
    // the words that say where: a host, a URL, or `*`; each must be loopback or a listed host
    let wheres =
      rest
      |> Stdlib.List.filter(fun w ->
        w == "*"
        || Stdlib.String.contains(w, ".")
        || Stdlib.String.contains(w, "/")
        || Stdlib.String.contains(w, ":"))

    Stdlib.Bool.not(Stdlib.List.isEmpty(wheres)) && Stdlib.List.all(wheres, fun w -> names(w))
  | ["env", ...] -> true
  | _ -> false


/// Why a batch may not run in this session, or None. A grant in the batch (`run --allow ...`)
/// must be one the session itself has: code the agent writes gets no more than the agent.
let batchRefusal(ctx: Context, text: String): Option<String> =
  let statements = Repls.Batch.splitStatements(text)
  let words =
    statements
    |> Stdlib.List.map(fun st ->
      LanguageTools.Permissions.tokens(
        Stdlib.String.split(st, "\n")
        |> Stdlib.List.head
        |> Stdlib.Option.withDefault(""))
      |> Stdlib.Option.withDefault([]))

  let forbidden =
    words
    |> Stdlib.List.filterMap(fun ws ->
      match ws with
      | [first, ...] when Stdlib.List.contains(personOnly, first) -> Option.Some(first)
      | _ -> Option.None)

  let grants =
    words
    |> Stdlib.List.map(fun ws ->
      ws
      |> Stdlib.List.indexedMap(fun(i, w) -> (i, w))
      |> Stdlib.List.filterMap(fun((i, w)) ->
        if w == "--allow" then Stdlib.List.getAt(ws, i + 1) else Option.None))
    |> Stdlib.List.flatten
    |> Stdlib.List.map(fun g -> Stdlib.String.split(g, ";"))
    |> Stdlib.List.flatten

  let outside =
    if Stdlib.List.isEmpty(ctx.writable) then
      []
    else
      grants |> Stdlib.List.filter(fun g -> Stdlib.Bool.not(sandboxAllows(ctx, g)))

  let ungranted =
    grants
    |> Stdlib.List.filter(fun g ->
      match ruleEffect(g) with
      | Some(e) -> Stdlib.Bool.not(Stdlib.List.contains(ctx.allowed, e))
      | None -> true)

  match forbidden, outside, ungranted with
  | [first, ...], _, _ ->
    Option.Some($"`{first}` changes more than this session's branch; the person runs it")
  | [], [first, ...], _ ->
    Option.Some(
      $"denied: `--allow {Stdlib.String.trim(first)}` reaches outside this session's sandbox: files under the working directory, loopback, and these hosts only: {sandboxHosts(ctx)}")
  | [], [], [first, ...] ->
    Option.Some(
      $"denied: `--allow {first}` grants what this session does not have (the person can rerun the agent with --allow)")
  | [], [], [] -> Option.None


/// Run a repl batch in the session's repl: its numbered replies and report, as `dark @r1` prints them.
let batch(ctx: Context, text: String): (Context * Agent.ToolOutput) =
  match batchRefusal(ctx, text) with
  | Some(why) -> (ctx, fail(why))
  | None ->
    let (ctx, _outcome, output) = runBatch(ctx, text)
    (ctx, output)


/// Run a batch: the session after it, the batch's outcome, and what the model is told. With the
/// store checks on, the reply also carries what each `run` may do, a failed run's values, and the
/// earlier evals that answer differently after a write.
let runBatch(ctx: Context, text: String): (Context * Repls.Batch.Outcome * Agent.ToolOutput) =
  let before = if ctx.store then Store.beforeRuns(ctx, text) else []
  let (app, record, outcome) = Repls.Batch.run(ctx.app, ctx.repl, text, Repls.Batch.OnFailure.Stop)
  let written = outcome.checks |> Stdlib.List.map(fun c -> c.name)
  let touched =
    Stdlib.List.concat(
      ctx.touched,
      written |> Stdlib.List.filter(fun m -> Stdlib.Bool.not(Stdlib.List.contains(ctx.touched, m))))

  let ctx = { ctx with app = app, repl = record, touched = touched }
  // the model cannot run `dark repl show`, so it gets whole replies; `truncate` bounds the total
  let caps = Repls.Batch.Caps { lines = 2000, chars = outputCap }
  let lines = Repls.Batch.renderText(ctx.repl.id, caps, outcome)
  let failed = Repls.Batch.count(outcome, "error") > 0
  let traces =
    if ctx.store then
      Store.failedTraces(outcome) |> Stdlib.List.map(fun id -> Store.traceValues(ctx, id))
    else
      []

  let (ctx, probes) =
    if ctx.store && Stdlib.Bool.not(failed) && Stdlib.Bool.not(Stdlib.List.isEmpty(written)) then
      match Store.rerunProbes(ctx) with
      | c, Some(line) -> (c, [ line ])
      | c, None -> (c, [])
    else
      (ctx, [])

  let text = Stdlib.List.flatten([ before, lines, traces, probes ]) |> Stdlib.String.join("\n")
  (ctx, outcome, Agent.ToolOutput { text = truncate(text), isError = failed })


/// Save <param source> through <param statement>; if the save fails on slips the fix table knows,
/// save the fixed source instead and say what changed.
let save(ctx: Context, statement: String -> String, source: String): (Context * Agent.ToolOutput) =
  let (ctx2, output) = batch(ctx, statement(source))
  if output.isError && ctx.store then
    match Agent.Fixes.apply(source) with
    | _, [] -> (ctx2, output)
    | fixedSource, changes ->
      let (ctx3, retried) = batch(ctx, statement(fixedSource))
      (ctx3, { retried with text = Agent.Fixes.describe(changes) + "\n" + retried.text })
  else
    (ctx2, output)


/// The lines come as `command`, the name shell-style tools use, so transcript readers that look for
/// commands find them; `batch` is still read.
let darkBatch(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  match getText(input, "command") with
  | Some(text) -> batch(ctx, text)
  | None -> needing(ctx, input, "batch", fun text -> batch(ctx, text))


/// One block statement: `<command> -` with <param body> indented under it.
let block(command: String, body: String): String =
  let indented =
    Stdlib.String.split(body, "\n")
    |> Stdlib.List.map(fun l -> "  " + l)
    |> Stdlib.String.join("\n")

  command + " -\n" + indented


let view(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "name", fun name -> batch(ctx, $"view {name} --raw"))


let search(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "query", fun query -> batch(ctx, $"search {query}"))


let typecheck(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "module", fun m -> batch(ctx, $"typecheck {m}"))


let eval(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "expression", fun expr ->
    let indented =
      Stdlib.String.split(Stdlib.String.trim(expr), "\n")
      |> Stdlib.List.indexedMap(fun(i, l) -> if i == 0 then l else "  " + l)
      |> Stdlib.String.join("\n")

    match batchRefusal(ctx, indented) with
    | Some(why) -> (ctx, fail(why))
    | None ->
      let (ctx, outcome, output) = runBatch(ctx, indented)
      if ctx.store then
        (Store.remember(ctx, indented, outcome), output)
      else
        (ctx, output))


let test(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "target", fun target -> batch(ctx, $"test run {target}"))


let defineFn(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "name", fun name ->
    needing(ctx, input, "source", fun source ->
      save(ctx, (fun src -> block($"fn {name}", src)), source)))


let defineModule(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "module", fun m ->
    needing(ctx, input, "source", fun source ->
      save(ctx, (fun src -> block($"module /{m}", src)), source)))


/// The item's source as `view --raw` shows it, or why not.
let rawSource(ctx: Context, name: String): Result<String, String> =
  // names resolve on the process's branch, so stand on the session's for the look
  let stored = SCM.PackageOps.currentBranch()
  let _ = SCM.PackageOps.selectBranch(ctx.app.currentBranchId)
  let (after, text) =
    Workbench.captureOutputAnd(fun () ->
      Registry.executeCommand("view", { ctx.app with exitCode = 0 }, [ name, "--raw" ]))

  let _ = SCM.PackageOps.selectBranch(stored)
  let out = Repls.Batch.stripAnsi(text)
  if after.exitCode == 0 then
    Result.Ok(out)
  else
    Result.Error(Stdlib.String.trim(out))


let editFn(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "name", fun name ->
    needing(ctx, input, "old_string", fun old ->
      needing(ctx, input, "new_string", fun replacement ->
        let app = Repls.enter(ctx.app, ctx.repl)
        match rawSource({ ctx with app = app }, name) with
        | Error(why) -> (ctx, fail(why))
        | Ok(source) ->
          match editText(source, old, replacement, Occurrences.One) with
          | Error(why) -> (ctx, fail(why + $"; `view {name}` shows the source"))
          | Ok(updated) ->
            save(ctx, (fun src -> block($"fn {name}", src)), Stdlib.String.trim(updated)))))


/// Put a question to the person at the terminal. In print mode nobody is there, and the model is
/// told to decide and say so, rather than stop.
let askPerson(ctx: Context, input: Stdlib.AltJson.Json): (Context * Agent.ToolOutput) =
  needing(ctx, input, "question", fun question ->
    if ctx.ask then
      let _ = Stdlib.printError($"\n? {question}\n  ")
      match Stdlib.Cli.Stdin.checkedReadLine() with
      | Ok(Some(answer)) when Stdlib.String.trim(answer) != "" ->
        (ctx, ok(Stdlib.String.trim(answer)))
      | _ ->
        (ctx, ok("No answer: choose what seems most reasonable, and say which in your summary."))
    else
      (
        ctx,
        ok(
          "No one is at the terminal: choose what seems most reasonable, say which in your summary, and go on.")))


let all(): List<Tool> =
  let fileRead = [ LanguageTools.Permissions.Effect.FileRead ]
  [ Tool
      { spec =
          spec(
            "read",
            "Read a text file, with line numbers. Long files come in pieces: pass offset (1-based) and limit.",
            [ param("path", "string", "the file, absolute or relative to the working directory")
              optional("offset", "integer", "first line to show, 1-based")
              optional("limit", "integer", "how many lines") ])
        effects = fileRead
        run = readFile }

    Tool
      { spec =
          spec(
            "write",
            "Create or overwrite a file. An existing file must be read first.",
            [ param("path", "string", "the file")
              param("content", "string", "the whole new content") ])
        effects = [ LanguageTools.Permissions.Effect.FileWrite ]
        run = writeFile }

    Tool
      { spec =
          spec(
            "edit",
            "Replace old_string with new_string in a file you have read. old_string must occur once (or set replace_all); a match ignoring indentation is tried when the exact text is not there.",
            [ param("path", "string", "the file")
              param("old_string", "string", "the text to replace")
              param("new_string", "string", "what replaces it")
              optional("replace_all", "boolean", "replace every occurrence") ])
        effects = [ LanguageTools.Permissions.Effect.FileWrite ]
        run = editFile }

    Tool
      { spec =
          spec(
            "bash",
            "Run a bash command in the working directory. Output is cut to the head and tail past 30,000 characters. It has no network unless the session allows http.",
            [ param("command", "string", "the command")
              optional("timeout_ms", "integer", "stop it after this long; default 120000") ])
        effects = [ LanguageTools.Permissions.Effect.Process ]
        run = bash }

    Tool
      { spec =
          spec(
            "grep",
            "Search file contents with an extended regex; up to 200 matching lines with file and line number.",
            [ param("pattern", "string", "the regex")
              optional("path", "string", "where to look; default .") ])
        effects = fileRead
        run = grep }

    Tool
      { spec =
          spec(
            "find",
            "Find files whose name matches a glob, e.g. *.dark; up to 200 paths.",
            [ param("pattern", "string", "the glob")
              optional("path", "string", "where to look; default .") ])
        effects = fileRead
        run = find }

    Tool
      { spec =
          spec(
            "ls",
            "List a directory; subdirectories end in /.",
            [ optional("path", "string", "default .") ])
        effects = fileRead
        run = ls }

    Tool
      { spec =
          spec(
            "dark",
            "Run a batch of lines in this session's Dark repl, on the session's branch. One statement per line: a CLI command (fn, module, view, search, typecheck, test run, status, nav, ...), `let x = <expr>`, `watch <expr>`, or a Dark expression. Indented lines continue the line above; a command ending in `-` takes its indented lines as stdin. Answers one numbered reply per statement, stops at the first failure, then reports the typecheck of every module written and watched values.",
            [ param("command", "string", "the lines") ])
        effects =
          [ LanguageTools.Permissions.Effect.PackageRead
            LanguageTools.Permissions.Effect.PackageWrite ]
        run = darkBatch }

    Tool
      { spec =
          spec(
            "view",
            "Show a package item's source (fn, type, value, module).",
            [ param("name", "string", "e.g. Stdlib.List.map or Me.Todo") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = view }

    Tool
      { spec =
          spec(
            "search",
            "Search the package tree by name, or by types: `bytes to string`, `String->Int64`. Flags work: --fn, --type, --with-docs.",
            [ param("query", "string", "what to look for") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = search }

    Tool
      { spec =
          spec(
            "define_fn",
            "Create or replace a Dark function: the source is `(a: Int64): Int64 = a * 2` or a whole `let name(...) = ...`. The reply names any caller that stopped typechecking.",
            [ param("name", "string", "e.g. Me.Todo.add")
              param("source", "string", "the definition") ])
        effects = [ LanguageTools.Permissions.Effect.PackageWrite ]
        run = defineFn }

    Tool
      { spec =
          spec(
            "define_module",
            "Save a whole Dark module: its types, vals, functions and tests, as one source.",
            [ param("module", "string", "e.g. Me.Todo")
              param("source", "string", "the module body") ])
        effects = [ LanguageTools.Permissions.Effect.PackageWrite ]
        run = defineModule }

    Tool
      { spec =
          spec(
            "edit_fn",
            "Change part of a Dark function: old_string in its source becomes new_string, then it is saved.",
            [ param("name", "string", "the function")
              param("old_string", "string", "text in its current source")
              param("new_string", "string", "the replacement") ])
        effects = [ LanguageTools.Permissions.Effect.PackageWrite ]
        run = editFn }

    Tool
      { spec =
          spec(
            "eval",
            "Evaluate a Dark expression on the session's branch; the value comes back as a Dark literal.",
            [ param("expression", "string", "e.g. Me.Todo.add(1, 2)") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = eval }

    Tool
      { spec =
          spec(
            "typecheck",
            "Typecheck a module and everything in it.",
            [ param("module", "string", "e.g. Me.Todo") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = typecheck }

    Tool
      { spec =
          spec(
            "test",
            "Run the package tests under a module.",
            [ param("target", "string", "e.g. Me.Todo") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = test }

    Tool
      { spec =
          spec(
            "ask",
            "Ask the person one short question, only when the request is ambiguous in a way that changes what you build. Offer the options you see.",
            [ param("question", "string", "the question, with the options") ])
        effects = []
        run = askPerson }

    Tool
      { spec =
          spec(
            "callers",
            "What uses a function, type or value, from the store's references: the callers an edit could break. Set deep for everything that depends on it, transitively.",
            [ param("name", "string", "e.g. Me.Todo.add")
              optional("deep", "boolean", "everything that depends on it, not only direct users") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = Store.callers }

    Tool
      { spec =
          spec(
            "calls",
            "What a function, type or value uses: the functions and types it refers to.",
            [ param("name", "string", "e.g. Me.Todo.add") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = Store.calls }

    Tool
      { spec =
          spec(
            "effects",
            "What a function may do when it runs (file-read, file-write, http, process, raise, ...) and which call causes each, worked out from its code without running it.",
            [ param("name", "string", "e.g. Me.Report.main") ])
        effects = [ LanguageTools.Permissions.Effect.PackageRead ]
        run = Store.effects } ]


/// The comparison arm's tools: files and the shell, as a generic agent has. Dark is reached
/// through `dark` in bash.
val genericNames = [ "read", "write", "edit", "bash", "grep", "find", "ls" ]


let generic(): List<Tool> =
  all() |> Stdlib.List.filter(fun t -> Stdlib.List.contains(genericNames, t.spec.name))


let named(tools: List<Tool>, name: String): Option<Tool> =
  tools |> Stdlib.List.findFirst(fun t -> t.spec.name == name)


/// The effects <param tool> has that the policy does not allow.
let denied(ctx: Context, tool: Tool): List<LanguageTools.Permissions.Effect> =
  tool.effects |> Stdlib.List.filter(fun e -> Stdlib.Bool.not(Stdlib.List.contains(ctx.allowed, e)))


type Approval =
  | Once
  | Always
  | Refuse


/// Ask the person at the terminal about one call the policy does not allow.
let approve(name: String, effects: List<String>, input: Stdlib.AltJson.Json): Approval =
  let detail =
    match fields(input) |> Stdlib.List.head with
    | Some((_k, String(v))) -> Stdlib.String.first(v, 200)
    | _ -> ""

  let _ =
    Stdlib.printError(
      $"allow {name} ({Stdlib.String.join(effects, ", ")}): {detail}\n  y once, a for the rest of this session, anything else refuses: ")

  match Stdlib.Cli.Stdin.checkedReadLine() with
  | Ok(Some(answer)) ->
    match Stdlib.String.toLowercase(Stdlib.String.trim(answer)) with
    | "y" -> Approval.Once
    | "a" -> Approval.Always
    | _ -> Approval.Refuse
  | _ -> Approval.Refuse


let runTool(
  ctx: Context,
  tools: List<Tool>,
  name: String,
  input: Stdlib.AltJson.Json)
  : (Context * Agent.ToolOutput) =
  match named(tools, name) with
  | None -> (ctx, fail($"no tool named {name}"))
  | Some(tool) ->
    match denied(ctx, tool) with
    | [] -> tool.run(ctx, input)
    | missing ->
      let names = missing |> Stdlib.List.map(LanguageTools.Permissions.effectName)
      let refused =
        (
          ctx,
          fail(
            $"denied: {name} needs {Stdlib.String.join(names, ", ")}, which this session does not allow (the person can rerun with --allow {Stdlib.String.join(names, ",")})"))

      if ctx.ask then
        match approve(name, names, input) with
        | Once -> tool.run(ctx, input)
        | Always -> tool.run({ ctx with allowed = Stdlib.List.concat(ctx.allowed, missing) }, input)
        | Refuse -> refused
      else
        refused
