/// Repls that outlive one `dark` call: a named record of a branch, a place in the tree, `let`
/// bindings and watched expressions, kept in this instance's config under `repl.<id>`. A batch
/// (`dark @r1`) loads the record, runs, and saves it back. `docs/repl.md` is the contract.
module Darklang.Cli.Repls

type Watch =
  { expr: String
    /// What it showed after the last batch, so the report can say "unchanged".
    last: String }


type Reply =
  { n: Int64
    /// binding, expression, command or watch
    kind: String
    /// ok, error or skipped
    status: String
    /// The reply as printed, without its number. Never empty.
    lines: List<String> }


type Record =
  { id: String
    branchId: String
    /// The module the repl stands in, by segment; empty for the root.
    location: List<String>
    bindings: List<Repl.Binding>
    watches: List<Watch>
    /// Every reply of the last batch in full, for `repl show`.
    lastReplies: List<Reply> }


let key(id: String): String =
  "repl." + id


let load(id: String): Option<Record> =
  match LanguageTools.LocalStore.configGet(key(id)) with
  | Some(text) ->
    match Stdlib.Json.parse<Record>(text) with
    | Ok(r) -> Option.Some(r)
    | Error(_) -> Option.None
  | None -> Option.None


let save(r: Record): Result<Unit, String> =
  match Stdlib.Json.checkedSerialize<Record>(r) with
  | Ok(text) -> LanguageTools.LocalStore.configSet(key(r.id), text)
  | Error(_) -> Result.Error($"could not save repl {r.id}")


let ids(): List<String> =
  match LanguageTools.LocalStore.configGet("repl.index") with
  | Some(text) ->
    match Stdlib.Json.parse<List<String>>(text) with
    | Ok(xs) -> xs
    | Error(_) -> []
  | None -> []


let setIds(xs: List<String>): Result<Unit, String> =
  match Stdlib.Json.checkedSerialize<List<String>>(xs) with
  | Ok(text) -> LanguageTools.LocalStore.configSet("repl.index", text)
  | Error(_) -> Result.Error("could not save the repl list")


let current(): Option<String> =
  match LanguageTools.LocalStore.configGet("repl.current") with
  | Some(id) when id != "" -> Option.Some(id)
  | _ -> Option.None


/// The first `r<n>` past every id in use.
let nextId(): String =
  let highest =
    ids()
    |> Stdlib.List.fold(0, fun(acc, id) ->
      match Stdlib.Int64.parse(Stdlib.String.dropFirst(id, 1)) with
      | Ok(n) when n > acc -> n
      | _ -> acc)

  "r" + Stdlib.display(highest + 1)


let branchOf(r: Record): Uuid =
  Stdlib.Uuid.parse(r.branchId) |> Stdlib.Result.withDefault(SCM.Branch.mainBranchId)


let modulePathOf(location: Packages.PackageLocation): List<String> =
  match location with
  | Module(path) -> path
  | Type(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Value(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Function(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Trait(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Impl(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)
  | Test(loc) -> Stdlib.List.prepend(loc.modules, loc.owner)


let locationText(path: List<String>): String =
  if Stdlib.List.isEmpty(path) then "/" else Stdlib.String.join(path, ".")


let branchText(branchId: Uuid): String =
  if SCM.Branch.isMain(branchId) then
    SCM.Branch.mainBranchName
  else
    SCM.PackageOps.branchName(branchId)


/// <param state> standing where <param r> stands.
let enter(state: AppState, r: Record): AppState =
  { state with
      currentBranchId = branchOf(r)
      packageData =
        { state.packageData with currentLocation = Packages.PackageLocation.Module(r.location) } }


let summaryLine(r: Record): String =
  let marker = if current() == Option.Some(r.id) then "  (current)" else ""
  let b = Stdlib.List.length(r.bindings)
  let w = Stdlib.List.length(r.watches)
  $"{r.id}  branch {branchText(branchOf(r))}  at {locationText(r.location)}  {Stdlib.display(b)} bindings  {Stdlib.display(w)} watches{marker}"


let addRecord(r: Record): Result<Unit, String> =
  save(r)
  |> Stdlib.Result.andThen(fun _ -> setIds(Stdlib.List.append(ids(), r.id)))
  |> Stdlib.Result.andThen(fun _ -> LanguageTools.LocalStore.configSet("repl.current", r.id))


let executeNew(state: AppState, branchRef: Option<String>): AppState =
  let branch =
    match branchRef with
    | Some(ref) -> Branch.resolveRef(ref)
    | None -> Option.Some(state.currentBranchId)

  match branch with
  | None -> failed(state)
  | Some(branchId) ->
    let r =
      Record
        { id = nextId()
          branchId = Stdlib.display(branchId)
          location = modulePathOf(state.packageData.currentLocation)
          bindings = []
          watches = []
          lastReplies = [] }

    match addRecord(r) with
    | Ok(_) ->
      Stdlib.printLine(r.id)
      state
    | Error(message) ->
      printErr(message)
      failed(state)


let unknown(state: AppState, id: String): AppState =
  printErr($"no repl {id}")
  printHint("  `dark repl list` lists them; `dark repl new` makes one.")
  { state with exitCode = 2 }


let executeFork(state: AppState, id: String): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(parent) ->
    let newId = nextId()
    let _ =
      if SCM.Branch.isMain(branchOf(parent)) then
        printHint($"{id} is on main, so {newId} starts from main's last commit, without its draft.")
      else
        let _ = Batch.commitForFork(state, parent, newId)
        ()

    match SCM.PackageOps.resolveBranch($"repl-{newId}", branchOf(parent)) with
    | Error(_) ->
      printErr($"could not start a branch for {newId}")
      failed(state)
    | Ok((branchId, _created)) ->
      let r = { parent with id = newId, branchId = Stdlib.display(branchId), lastReplies = [] }
      match addRecord(r) with
      | Ok(_) ->
        Stdlib.printLine(newId)
        state
      | Error(message) ->
        printErr(message)
        failed(state)


let executeKill(state: AppState, id: String): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(_) ->
    let _ = LanguageTools.LocalStore.configUnset(key(id))
    let _ = setIds(ids() |> Stdlib.List.filter(fun x -> x != id))
    let _ =
      if current() == Option.Some(id) then
        LanguageTools.LocalStore.configUnset("repl.current")
      else
        Result.Ok()

    state


let executeUse(state: AppState, id: String): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(_) ->
    match LanguageTools.LocalStore.configSet("repl.current", id) with
    | Ok(_) -> state
    | Error(message) ->
      printErr(message)
      failed(state)


let executeList(state: AppState): AppState =
  let records = ids() |> Stdlib.List.filterMap(fun id -> load(id))
  if Stdlib.List.isEmpty(records) then
    printHint("no repls; `dark repl new` makes one.")
    state
  else
    records |> Stdlib.List.iter(fun r -> Stdlib.printLine(summaryLine(r)))
    state


let replyLines(reply: Reply): List<String> =
  match reply.lines with
  | [first, ...rest] ->
    Stdlib.List.prepend(
      rest |> Stdlib.List.map(fun l -> "  " + l),
      Stdlib.display(reply.n) + " " + first)
  | [] -> [ Stdlib.display(reply.n) ]


let executeShow(state: AppState, id: String, which: Option<String>): AppState =
  match load(id) with
  | None -> unknown(state, id)
  | Some(r) ->
    let chosen =
      match which with
      | None -> Result.Ok(r.lastReplies)
      | Some(text) ->
        match Stdlib.Int64.parse(text) with
        | Ok(n) ->
          match r.lastReplies |> Stdlib.List.filter(fun x -> x.n == n) with
          | [] -> Result.Error($"the last batch in {id} has no reply {text}")
          | found -> Result.Ok(found)
        | Error(_) -> Result.Error($"{text} is not a reply number")

    match chosen with
    | Ok(replies) ->
      replies
      |> Stdlib.List.iter(fun reply ->
        replyLines(reply) |> Stdlib.List.iter(fun l -> Stdlib.printLine(l)))

      state
    | Error(message) ->
      printErr(message)
      failed(state)


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] -> executeList(state)
  | ["list"] -> executeList(state)
  | ["new"] -> executeNew(state, Option.None)
  | ["new", "--branch", b] -> executeNew(state, Option.Some(b))
  | ["use", id] -> executeUse(state, id)
  | ["fork", id] -> executeFork(state, id)
  | ["kill", id] -> executeKill(state, id)
  | ["show", id] -> executeShow(state, id, Option.None)
  | ["show", id, n] -> executeShow(state, id, Option.Some(n))
  | _ ->
    printErr(
      "Usage: repl new [--branch <name>] | list | use <id> | fork <id> | kill <id> | show <id> [<n>]")

    failed(state)


let accepts(): Accepts.Accepts =
  Accepts.subcommands(
    [ ("new", Accepts.withValues([ "--branch" ], Accepts.nothing()))
      ("list", Accepts.nothing())
      ("use", Accepts.between(1, 1, []))
      ("fork", Accepts.between(1, 1, []))
      ("kill", Accepts.between(1, 1, []))
      ("show", Accepts.between(1, 2, [])) ],
    Accepts.nothing())


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: repl new [--branch <name>]   make a repl, print its id, make it current"
    "       repl list                    the repls, one per line"
    "       repl use <id>                make <id> current"
    "       repl fork <id>               a new repl on a new branch off <id>'s, with its bindings"
    "       repl kill <id>               forget a repl; its branch and code stay"
    "       repl show <id> [<n>]         the last batch's replies in full"
    ""
    "Run a batch with `dark @<id>` (or `dark @` for the current repl), lines on stdin:"
    ""
    "  dark @r1 <<'EOF'"
    "  let xs = [1, 2, 3]"
    "  Stdlib.List.map(xs, fun x -> x * 2)"
    "  fn Me.Demo.double '(a: Int64): Int64 = a * 2'"
    "  watch Me.Demo.double(4)"
    "  EOF"
    ""
    "  --continue   run every line even after one fails"
    "  --json       the replies and report as one JSON object"
    ""
    "One numbered reply per line, then `-- ` lines: a summary, the typecheck of every module the"
    "batch wrote to, and the watched values. A line indented under another continues it; a command"
    "ending in `-` reads its indented lines as stdin. Branch and location stick to the repl." ]
  |> Stdlib.String.join("\n")
