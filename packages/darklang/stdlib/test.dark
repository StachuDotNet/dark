module Darklang.Stdlib.Test

/// What a test returns: `Pass`, or what went wrong. `Fail` holds the messages of one
/// check; `all` and `named` wrap the failing checks they hold, so the runner can say
/// which ones failed. The test still runs and caches as a whole.
type Result =
  | Pass
  | Fail(messages: List<String>)
  /// A failing check that `named` or `group` gave a name.
  | Named(name: String, result: Result)
  /// The failing checks of an `all` or `table`, each with its position in the list, from 1.
  | FailedChecks(checks: List<(Int64 * Result)>)


let pass(): Result =
  Result.Pass


let fail(message: String): Result =
  Result.Fail([ message ])


/// Inject an uncaught runtime exception to test propagation and rendering.
/// Available only inside a running package test; never returns a value.
let raiseRuntimeError(message: String): Int64 =
  Builtin.pmTestRaiseRuntimeError(message)


/// This test's counter, after adding one to it if <param increment>. Callers
/// use `incrementCounter` and `counterValue`.
let counter(increment: Bool): Int64 =
  Builtin.testCounter(increment)


/// Increment this test's counter and return the value unchanged. Use to check
/// how often a callback or expression runs. The counter starts at zero for each
/// test run and is shared with its helper calls. Only available in package tests.
let incrementCounter(value: 'a): 'a =
  let _ = counter(true)
  value


/// Return this test's counter, which starts at zero for each test run.
/// Tests using the counter rerun rather than reuse a cached pass.
/// Only available in package tests; no database or host permissions needed.
let counterValue(): Int64 =
  counter(false)


/// Run <param f> on the real clock. A package test runs on a virtual one, where
/// sleeps and timers finish at once; wrap a test whose waits must take real time,
/// such as one racing a timeout against real I/O. Only available in package tests.
let onRealClock(f: Unit -> 'a): 'a =
  Builtin.testOnRealClock(f)


let expect(condition: Bool, message: String): Result =
  if condition then Result.Pass else Result.Fail([ message ])


/// Compare two Dark values. Written value-first so pipeline style reads:
/// `actual |> Stdlib.Test.equal expected`.
let equal(actual: 'a, expected: 'a): Result =
  if actual == expected then
    Result.Pass
  else
    Result.Fail([ $"expected {inspect(expected)}, got {inspect(actual)}" ])


let notEqual(actual: 'a, unexpected: 'a): Result =
  if actual != unexpected then
    Result.Pass
  else
    Result.Fail([ $"did not expect {inspect(unexpected)}" ])


/// Combine checks without stopping at the first failure. A failing check is
/// reported by its position, with its source, unless it is `named`.
let all(checks: List<Result>): Result =
  let failed =
    checks
    |> List.indexedMap(fun(index, check) -> (index + 1, check))
    |> List.filter(fun((_, check)) -> check != Result.Pass)

  if List.isEmpty(failed) then Result.Pass else Result.FailedChecks(failed)


/// <param check>, reported under <param name> instead of its position and source
/// when it fails: `Stdlib.Test.named("emoji separator", split("a🙂b", "🙂") |> equal([ "a", "b" ]))`.
let named(name: String, check: Result): Result =
  match check with
  | Pass -> Result.Pass
  | _ -> Result.Named(name, check)


/// <param checks> as one check named <param name>, inside a test or another group.
/// A failure inside it reads `parsing > 2: ...`, and `dark test count` lists it.
let group(name: String, checks: List<Result>): Result =
  named(name, all(checks))


/// <param check> on each of <param rows>, one check per row, reported under the row's
/// value, as `("a", 1)`, or the name `row` gives it. Each row runs on its own, so a
/// row that raises fails only itself and the others still run.
let table(rows: List<'a>, check: 'a -> Result): Result =
  rows
  |> List.map(fun row ->
    let result =
      // A lambda, so the call runs under this test's policies rather than as an approval root.
      match LanguageTools.Live.apply(fun r -> check(r), row) with
      | Ok(result) -> result
      | Error(message) -> Result.Fail([ $"error: {message}" ])

    match result with
    | Pass -> result
    | _ -> named(rowName(row), result))
  |> all


/// <param args>, a row of a `table`'s list written out in place, reported under
/// <param name> instead of its value.
let row(name: String, args: 'a): 'a =
  args


/// How a `table` reports <param row>: its value, on one line and at most 60 characters.
let rowName(row: 'a): String =
  let shown =
    inspect(row)
    |> String.split("\n")
    |> List.map(String.trim)
    |> String.join(" ")

  if String.length(shown) > 60 then String.first(shown, 59) + "…" else shown
