module Darklang.Stdlib

// The traits the operators are. `a + b` is `Add.add a b`, `<` and friends are `Compare`.
// Every builtin numeric type implements them, next to its own fns (`Stdlib.Int64.Add`),
// and a type of your own joins by writing an impl:
//
//   impl Add for Vec =
//     let add (a: Vec) (b: Vec) : Vec = Vec { x = a.x + b.x; y = a.y + b.y }


/// `a + b`
trait Add<'a> =
  let add (a: 'a) (b: 'a) : 'a


/// `a - b`
trait Subtract<'a> =
  let subtract (a: 'a) (b: 'a) : 'a


/// `a * b`
trait Multiply<'a> =
  let multiply (a: 'a) (b: 'a) : 'a


/// `a / b`
trait Divide<'a> =
  let divide (a: 'a) (b: 'a) : 'a


/// `a % b`, wrapped so that `0 <= result < b`
trait Modulo<'a> =
  let modulo (a: 'a) (b: 'a) : 'a


/// `a ** b`
trait Power<'a> =
  let power (``base``: 'a) (exponent: 'a) : 'a


/// `-a`
trait Negate<'a> =
  let negate (a: 'a) : 'a


/// The identity for `+`, not only a number's: `Zero.zero<String> ()` is `""`. Dispatched from
/// a type arg or the caller's bound, there being no argument to read the type from.
trait Zero<'a> =
  let zero () : 'a


/// The multiplicative identity, `One.one<Int64> ()`
trait One<'a> =
  let one () : 'a


/// `a & b`
trait BitwiseAnd<'a> =
  let bitwiseAnd (a: 'a) (b: 'a) : 'a


/// `a | b`
trait BitwiseOr<'a> =
  let bitwiseOr (a: 'a) (b: 'a) : 'a


/// `a ^ b`, exclusive or
trait BitwiseXor<'a> =
  let bitwiseXor (a: 'a) (b: 'a) : 'a


/// `~a`, every bit flipped
trait BitwiseNot<'a> =
  let bitwiseNot (a: 'a) : 'a


/// `a << b`. The shift count is the same type as the value.
trait ShiftLeft<'a> =
  let shiftLeft (a: 'a) (b: 'a) : 'a


/// `a >> b`
trait ShiftRight<'a> =
  let shiftRight (a: 'a) (b: 'a) : 'a


/// `<`, `<=`, `>`, `>=`
trait Compare<'a> =
  let lessThan (a: 'a) (b: 'a) : Bool
  let lessThanOrEqualTo (a: 'a) (b: 'a) : Bool
  let greaterThan (a: 'a) (b: 'a) : Bool
  let greaterThanOrEqualTo (a: 'a) (b: 'a) : Bool


/// A value rendered as text for a person: `p.toString`, or `ToString.toString p`.
/// Every builtin type implements it, so `toString` works on any of them;
/// `Stdlib.toRepr` stays the structural debug form.
// CLEANUP if this splits, it splits into `ToString` for what a person reads and
// `ToDebugString` for the derived one. Nothing more elaborate.
trait ToString<'a> =
  let toString (v: 'a) : String
