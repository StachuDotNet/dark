/// A new user's first minutes, from a fresh install, as one transcript. A change to any of it shows
/// here as a diff: that is the point. Update the expected text when the change is meant.
module Darklang.Cli.Tests.FirstRun

val steps: List<List<String>> =
  [ []
    [ "eval", "1 + 2" ]
    [ "fn", "Me.Hi.greet", "(name: String): String = \"hi \" + name" ]
    [ "eval", "Me.Hi.greet(\"Ada\")" ]
    [ "commit", "my first function", "-y" ]
    [ "extensions", "enable", "history" ]
    [ "commit", "my first function", "-y" ]
    [ "extensions", "enable", "recommended" ]
    [ "extensions" ]
    [ "help" ] ]


/// A commit id differs every run.
let steady(line: String): String =
  if Stdlib.String.startsWith(line, "  commit ") then
    match Stdlib.String.split(line, " -- ") with
    | [_, rest] -> "  commit <id> -- " + rest
    | _ -> line
  else
    line


/// An argument as a person would type it at a shell.
let quoted(arg: String): String =
  if Stdlib.List.any([ " ", "(", "\"" ], fun c -> Stdlib.String.contains(arg, c)) then
    "'" + arg + "'"
  else
    arg


let transcript(i: Instance.T): String =
  steps
  |> Stdlib.List.map(fun args ->
    let (code, out) = Instance.ran(i, args)
    let shown =
      Stdlib.String.splitOnNewline(out)
      |> Stdlib.List.map(fun l -> steady(Stdlib.String.trimEnd(Stdlib.Cli.Tui.Text.stripSgr(l))))
      |> Stdlib.String.join("\n")
      |> Stdlib.String.trimEnd

    let typed = args |> Stdlib.List.map(quoted) |> Stdlib.String.join(" ")
    let prompt = Stdlib.String.trimEnd("$ dark " + typed)
    $"{prompt}\n{shown}\n[exit {Stdlib.display(code)}]")
  |> Stdlib.String.join("\n")


val expected =
  """$ dark 
Darklang: a small language that keeps your code in one store, on this machine.
Write a script, or save functions and run them by name. Everything else is an
extension you turn on when you want it.

Run code
  dark run hello.dark                  a script file
  dark eval '1 + 2'                    one expression
Keep code
  dark fn Me.Hi.greet '(name: String): String = "hi " + name'
  dark eval 'Me.Hi.greet("Ada")'       call what you saved
  dark module Me.Hi - < hi.dark        save a whole module
  dark val, type, trait, impl          save one item of another kind, like fn
  dark ls Me    dark view Me.Hi.greet    dark search "split a string"
Learn
  dark docs syntax    dark docs for-ai    dark help <command>
Grow
  dark extensions                      what you can turn on (0 of 14 on)
This install
  dark permissions    dark update    dark uninstall    dark version

Off: account, ai, compiler, history, http-server, recommended, tests, tools, tracing, workbench
`dark extensions show <name>` says what one adds.
[exit 0]
$ dark eval '1 + 2'
3
[exit 0]
$ dark fn Me.Hi.greet '(name: String): String = "hi " + name'
✓ Created function Me.Hi.greet
  effects: none
