test theFirstMinutes =
  Instance.withKernelOnly(fun i -> Stdlib.Test.equal(transcript(i), expected))


/// The keys typed for the whole first-minutes path. If this grows, the first run got slower to
/// type; change it only on purpose.
test theFirstMinutesAreFewKeys = Stdlib.Test.equal(keysTyped(steps), 254)


/// The same first minutes at a terminal: `dark`, then enter on each suggested next line (a sum,
/// a function, calling it, a commit that names the extension it needs, turning that on, the
/// commit again), then esc. Shell keys for `dark` are not counted here.
val homeKeys = [ "\\r", "\\r", "\\r", "\\r", "\\r", "\\r", "\\033" ]


test homeTakesTheFirstRunInFewKeys = Instance.withKernelOnly(fun i ->
  Cli.Tests.Extensions.pressing(i, [], homeKeys)
  let called = Instance.said(i, [ "eval", "Me.Hi.greet(\"Ada\")" ])
  let commits = Instance.said(i, [ "commits" ])
  Stdlib.Test.all(
    [ Stdlib.Test.equal(Stdlib.List.length(homeKeys), 7)
      Instance.says(called, "hi Ada", "the function was saved")

      Instance.says(
        commits,
        "Me.Hi.greet",
        "and committed, with history turned on on the way") ]))
