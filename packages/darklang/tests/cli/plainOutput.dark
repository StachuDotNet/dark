/// Read by a program, a command prints one record per line with no decoration: `--plain`, or a
/// stdout that isn't a terminal. `--json` prints the same answer as JSON.
module Darklang.Cli.Tests.PlainOutput

let authored(i: Instance.T): Unit =
  let _ = Instance.ran(i, [ "type", "Tests.Plain.T", "= { x: Int64 }" ])

  let _ = Instance.ran(i, [ "val", "Tests.Plain.v", "= 42" ])

  let _ = Instance.ran(i, [ "fn", "Tests.Plain.f", "(x: Int64): Int64 = x" ])

  let _ =
    Instance.ran(
      i,
      [ "fn", "Tests.Plain.Inner.g", "(x: Int64): Int64 = Tests.Plain.f(x)" ])

  let _ = Instance.ran(i, [ "commit", "plain", "-y" ])

  let _ = Instance.ran(i, [ "branch", "create", "feature" ])

  let _ =
    Instance.ran(i, [ "fn", "Tests.Plain.f", "(x: Int64): Int64 = x + 1" ])

  let _ = Instance.ran(i, [ "switch", "main" ])
  ()


/// What a program sees when it runs `args` with no flag: stdout is a pipe.
let piped(i: Instance.T, args: List<String>): (Int64 * String * String) =
  let out =
    Instance.call(
      i,
      { Instance.command(args) with env = [ ("DARK_OUTPUT", "") ] })

  (out.exitCode, Stdlib.String.trim(out.stdout), Stdlib.String.trim(out.stderr))


/// Both streams of `args` run at a terminal, which ends its lines with `\r\n`.
let atTerminal(i: Instance.T, args: List<String>): (Int64 * String) =
  let out =
    Instance.call(
      i,
      { Instance.command(args) with
          env =
            [ ("DARK_OUTPUT", ""), ("NO_COLOR", ""), ("CLICOLOR_FORCE", "") ]
          tty = true })

  (out.exitCode, Stdlib.String.replaceAll(out.stdout, "\r\n", "\n"))


/// Runs that answer through `Output` with something to show, on the store `authored` makes.
val answering: List<List<String>> =
  [ [ "ls", "Tests.Plain" ]
    [ "tree", "Tests.Plain" ]
    [ "status" ]
    [ "commits" ]
    [ "branches" ]
    [ "diff" ]
    [ "diff", "feature" ]
    [ "log" ]
    [ "log", "feature" ]
    [ "conflicts" ]
    [ "conflicts", "branch", "feature" ]
    [ "deps", "Tests.Plain.f" ]
    [ "deps", "usedby", "Tests.Plain.f", "--deep" ] ]


val decoration: List<String> =
  [ "\u001b"
    Cli.Glyphs.module_
    Cli.Glyphs.fn
    Cli.Glyphs.trait_
    Cli.Glyphs.impl_
    Cli.Glyphs.test
    "├"
    "└"
    "⚠" ]


test lsAndTreePrintRows = Instance.withInstance(fun i ->
  let _ = authored(i)
  let (_, ls, _) = piped(i, [ "ls", "Tests.Plain" ])
  let (_, tree, _) = piped(i, [ "tree", "Tests.Plain" ])
  Stdlib.Test.all(
    [ ls
      |> Stdlib.Test.equal(
        Stdlib.String.join(
          [ "module\tTests.Plain.Inner"
            "type\tTests.Plain.T"
            "fn\tTests.Plain.f"
            "val\tTests.Plain.v" ],
          "\n"))

      tree
      |> Stdlib.Test.equal(
        Stdlib.String.join(
          [ "module\tTests.Plain.Inner"
            "fn\tTests.Plain.Inner.g"
            "type\tTests.Plain.T"
            "val\tTests.Plain.v"
            "fn\tTests.Plain.f" ],
          "\n")) ]))


test statusPrintsItsFields = Instance.withInstance(fun i ->
  let (code, out, err) = piped(i, [ "status" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 0, "status")
      out |> Stdlib.Test.equal("branch\tmain\ndraftOps\t0\nconstraints\t0")
      err |> Stdlib.Test.equal("") ]))


test theFlagsGoAnywhere = Instance.withInstance(fun i ->
  let (_, after, _) = Instance.streams(i, [ "status", "--plain" ])
  let (_, before, _) = Instance.streams(i, [ "--plain", "status" ])
  let pretty =
    Instance.call(
      i,
      { Instance.command([ "--pretty", "status" ]) with
          env = [ ("DARK_OUTPUT", "plain") ] })

  Stdlib.Test.all(
    [ Instance.says(after, "branch\tmain", "--plain after the command")
      before |> Stdlib.Test.equal(after)
      Instance.says(
        pretty.stdout,
        "On branch main",
        "--pretty over DARK_OUTPUT=plain") ]))


/// Every (sub)command that declares `--json`, read from the registry, as the words that run it:
/// bare, or with a word that names nothing when it needs one, so it refuses. `traces follow` never
/// ends, and a bare `test run` runs every test (`JsonShapes.testRunAnswersWithEveryTest` runs it).
let declaringJson(): List<List<String>> =
  let swept = CommandSweeps.swept()
  let run(words: List<String>, s: Cli.Accepts.Shape): List<List<String>> =
    let line = Stdlib.String.join(words, " ")
    if
      Stdlib.List.contains(s.flags, "--json")
      && line != "traces follow"
      && line != "test run"
    then
      if s.atLeast > 0 then
        [ Stdlib.List.append(words, "zzz-no-such-thing-zzz") ]
      else
        [ words ]
    else
      []

  Cli.Registry.allCommands()
  |> Stdlib.List.filter(fun c -> Stdlib.List.contains(swept, c.name))
  |> Stdlib.List.map(fun c ->
    let accepts = c.accepts
    match accepts() with
    | Takes(s) -> run([ c.name ], s)
    | Subcommands(named, s) ->
      named
      |> Stdlib.List.map(fun((sub, a)) ->
        match a with
        | Takes(t) -> run([ c.name, sub ], t)
        | Subcommands(_, t) -> run([ c.name, sub ], t))
      |> Stdlib.List.prepend(run([ c.name ], s))
      |> Stdlib.List.flatten)
  |> Stdlib.List.flatten


/// What still prints its pretty view under `--plain`, because it doesn't answer through `Output`.
val plainIsPretty = [ "constraints", "conflicts walk", "ps" ]


/// Every command that declares `--json`, in all three modes, so one is covered the day it declares
/// the flag. `--json` prints one JSON value or nothing; plain has no decoration, answers whenever
/// JSON does, and is what a pipe gets; no mode prints a runtime error; and the `answering` runs
/// answer in every mode, at a terminal too.
test everyJsonCommandInThreeModes = Instance.withInstance(fun i ->
  let _ = authored(i)
  let commands = Stdlib.List.concat(answering, declaringJson())
  let failures =
    commands
    |> Stdlib.List.map(fun args ->
      let mustAnswer = Stdlib.List.contains(answering, args)
      let (jsonCode, json, jsonErr) =
        Instance.streams(i, Stdlib.List.append(args, "--json"))

      let (plainCode, plain, plainErr) =
        Instance.streams(i, Stdlib.List.append(args, "--plain"))

      let (prettyCode, pretty, prettyErr) =
        Instance.streams(i, Stdlib.List.append(args, "--pretty"))

      let answered =
        if mustAnswer then
          let (terminalCode, _) = atTerminal(i, args)
          let (pipedCode, pipedOut, _) = piped(i, args)
          [ if plain == pipedOut then
              ""
            else
              $"piped printed {pipedOut}, not {plain}" ]
          |> Stdlib.List.append(
            if
              [ jsonCode, plainCode, prettyCode, terminalCode, pipedCode ]
              == [ 0, 0, 0, 0, 0 ]
            then
              ""
            else
              "did not exit 0 in every mode")
        else
          []

      let jsonProblems =
        match json, Stdlib.AltJson.parse(json) with
        | ("", _) | (_, Ok(_)) -> []
        | _ -> [ $"--json is not one JSON value: {json}" ]

      let decorated =
        Stdlib.List.contains(plainIsPretty, Stdlib.String.join(args, " "))

      let plainProblems =
        decoration
        |> Stdlib.List.filter(fun d ->
          Stdlib.Bool.not(decorated) && Stdlib.String.contains(plain, d))
        |> Stdlib.List.map(fun d -> $"--plain printed {d}")
        |> Stdlib.List.append(
          if jsonCode == 0 && plainCode != 0 then
            $"--plain exited 1: {plainErr}"
          else
            "")
        |> Stdlib.List.filter(fun p -> p != "")

      let crashes =
        [ json + jsonErr, plain + plainErr, pretty + prettyErr ]
        |> Stdlib.List.filterMap(CommandSweeps.runtimeFailure)

      Stdlib.List.flatten([ jsonProblems, plainProblems, answered, crashes ])
      |> Stdlib.List.filter(fun p -> p != "")
      |> Stdlib.List.map(fun p ->
        $"  dark {Stdlib.String.join(args, " ")}: {p}"))
    |> Stdlib.List.flatten

  Stdlib.Test.all(
    [ Stdlib.Test.expect(
        Stdlib.List.length(commands) > 20,
        "the registry was read")

      CommandSweeps.noFailures(
        "commands that do not answer in all three modes",
        failures) ]))
