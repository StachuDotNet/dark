val paneSource =
  """let pane(input: Darklang.Cli.Extensions.PaneInput): Darklang.Cli.Extensions.Pane =
  Darklang.Cli.Extensions.Pane
    { lines = [ "on: " + Stdlib.display(input.on) ]
      actions =
        [ Darklang.Cli.Extensions.Action { key = "v", label = "the version", command = [ "version", "--local" ] } ] }

let sneaky(_input: Darklang.Cli.Extensions.PaneInput): Darklang.Cli.Extensions.Pane =
  let found = Darklang.Cli.Extensions.all(Darklang.SCM.Branches.current())
  Darklang.Cli.Extensions.Pane { lines = [ Stdlib.display(Stdlib.List.length(found)) ], actions = [] }

val extension: Darklang.Cli.Extensions.Extension =
  Darklang.Cli.Extensions.Extension
    { name = "paned"
      title = "Paned"
      blurb = "Has a pane"
      under = ""
      needs = []
      commands = []
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = "Me.Paned.pane"
      handlers = ""
      tour = []
      peeks = []
      fake = "" }

val sneakyExtension: Darklang.Cli.Extensions.Extension =
  Darklang.Cli.Extensions.Extension
    { name = "sneaky"
      title = "Sneaky"
      blurb = "Reads what it may not"
      under = ""
      needs = []
      commands = []
      adds = []
      asks = []
      settings = []
      installs = ""
      guide = []
      pane = "Me.Paned.sneaky"
      handlers = ""
      tour = []
      peeks = []
      fake = "" }
"""


/// A user's pane is called the same way as ours, and runs as ordinary code: one that tries to read
/// what only the CLI may is refused, in its place.
test yourPaneRunsAsYourCode = Instance.withKernelOnly(fun i ->
  let (code, saved) = Instance.runWithStdin(i, [ "module", "/Me.Paned", "-" ], paneSource)
  let _ = Instance.output(i, [ "extensions", "enable", "paned", "sneaky" ])
  let paned = Instance.said(i, [ "extensions", "show", "paned" ])
  let sneaky = Instance.said(i, [ "extensions", "show", "sneaky" ])
  Stdlib.Test.all(
    [ Stdlib.Test.equal((code, ""), (0, if code == 0 then "" else saved))
      Instance.says(paned, "on: true", "what it was given")
      Instance.says(paned, "v  the version  (dark version --local)", "its key")
      Instance.says(sneaky, "its pane failed", "the refused read") ]))


/// What an extension lists is what its `handlers` give: help and the tree can name its commands
/// without running any of its code.
test eachExtensionsCommandsAreItsHandlers =
  let branch = SCM.Branches.current()
  Cli.Extensions.all(branch)
  |> Stdlib.List.filter(fun e -> e.handlers != "")
  |> Stdlib.List.filter(fun e ->
    let names = Cli.Extensions.handlersOf(branch, e) |> Stdlib.List.map(fun h -> h.name)
    Stdlib.List.sort(names) != Stdlib.List.sort(e.commands))
  |> Stdlib.List.map(fun e -> e.name)
  |> Stdlib.Test.equal([])


test bareDarkIsTheIntroUntilTheWorkbenchIsOn = Instance.withKernelOnly(fun i ->
  let (code, out) = Instance.ran(i, [])
  Stdlib.Test.all(
    [ Stdlib.Test.equal(code, 0)
      Instance.says(out, "Darklang: a small language", "the intro")
      Instance.says(out, "dark extensions ", "and how to grow it") ]))


/// Every tour step and peek of the extensions we ship runs on a fresh install with them on, and
/// says what the tour promises. A renamed fn or a moved docs topic fails here.
test toursAndPeeksStillRun = Instance.withInstance(fun i ->
  let exts =
    Cli.Extensions.all(SCM.Branches.current())
    |> Stdlib.List.filter(fun e -> e.fake == "")

  let steps =
    exts
    |> Stdlib.List.map(fun e -> Stdlib.List.map(e.tour, fun s -> (e.name, s.run, s.expect)))
    |> Stdlib.List.flatten
    |> Stdlib.List.filter(fun ((_, run, _)) -> run != [])

  let peeks =
    exts
    |> Stdlib.List.map(fun e -> Stdlib.List.map(e.peeks, fun p -> (e.name, p.command, "")))
    |> Stdlib.List.flatten

  Stdlib.List.concat(steps, peeks)
  |> Stdlib.List.filterMap(fun ((name, run, expect)) ->
    let (code, out) = Instance.ran(i, run)
    if code == 0 && Stdlib.String.contains(out, expect) then
      Option.None
    else
      Option.Some($"{name}: `dark {Stdlib.String.join(run, " ")}` exited {Stdlib.display(code)}: {out}"))
  |> Stdlib.Test.equal([]))


test explainWalksThroughAndIsRemembered = Instance.withKernelOnly(fun i ->
  let _ = Instance.output(i, [ "extensions", "enable", "history" ])
  let walked = Instance.said(i, [ "extensions", "explain", "history" ])
  let shown = Instance.said(i, [ "extensions", "show", "history" ])
  Stdlib.Test.all(
    [ Instance.says(walked, "1/3  What you save persists", "the first step")
      Instance.says(walked, "$ dark status", "its command, run")
      Instance.says(walked, "Peek at", "then what to peek at")
      Instance.says(walked, "dark docs scm", "a peek, as a command")
      Instance.says(shown, "dark extensions explain history (seen)", "remembered") ]))


/// The fewest keys from a fresh tree to history on and explained: down to it, e, and q to leave.
/// If this grows, a choice got slower.
/// Each key as printf writes it: `\033[B` is the down arrow.
val keysToExplainHistory = [ "\\033[B", "\\033[B", "\\033[B", "\\033[B", "\\033[B", "e", "q" ]


/// <param args> at a terminal, the keys pressed once it is up, one after another.
let pressing(i: Instance.T, args: List<String>, keys: List<String>): Unit =
  let line =
    Stdlib.List.flatten(
      [ [ "/usr/bin/env", "TERM=xterm-256color" ]
        Instance.env(i) |> Stdlib.List.map(fun((k, v)) -> $"{k}={v}")
        [ i.cli ]
        args ])
    |> Stdlib.List.map(Stdlib.Cli.Process.shellQuote)
    |> Stdlib.String.join(" ")

  let shell =
    "(sleep 3; printf "
    + Stdlib.Cli.Process.shellQuote(Stdlib.String.join(keys, ""))
    + "; sleep 2) | script -qec "
    + Stdlib.Cli.Process.shellQuote("stty cols 100 rows 40; " + line)
    + " /dev/null"

  let _ = Stdlib.Cli.Process.runWithTimeout(Instance.commandTimeoutMs, "/bin/sh", [ "-c", shell ])
  ()


test historyOnAndExplainedInSevenKeys = Instance.withKernelOnly(fun i ->
  pressing(i, [ "extensions" ], keysToExplainHistory)
  let shown = Instance.said(i, [ "extensions", "show", "history" ])
  Stdlib.Test.all(
    [ Stdlib.Test.equal(Stdlib.List.length(keysToExplainHistory), 7)
      Instance.says(shown, "History · on", "it is on")
      Instance.says(shown, "(seen)", "and was explained") ]))
