// The agent's edit and truncation, and the session's statement reading: pure parts only.
module Darklang.Cli.Agent.Tools.Tests

test editReplacesTheOneExactMatch =
  Cli.Agent.Tools.editText(
    "a = 1\nb = 2\n",
    "b = 2",
    "b = 3",
    Cli.Agent.Tools.Occurrences.One)
  |> Stdlib.Test.equal(Result.Ok("a = 1\nb = 3\n"))


test editRefusesAnAmbiguousMatch =
  Cli.Agent.Tools.editText("x\nx\n", "x", "y", Cli.Agent.Tools.Occurrences.One)
  |> Stdlib.Test.equal(
    Result.Error(
      "old_string occurs 2 times; add context to make it unique, or set replace_all"))


test editReplacesEveryMatchWhenAsked =
  Cli.Agent.Tools.editText(
    "x\nx\n",
    "x",
    "y",
    Cli.Agent.Tools.Occurrences.Every)
  |> Stdlib.Test.equal(Result.Ok("y\ny\n"))


test editFallsBackToIgnoringIndentation =
  Cli.Agent.Tools.editText(
    "let f =\n    1 + 1\n",
    "let f =\n  1 + 1",
    "let f =\n    2",
    Cli.Agent.Tools.Occurrences.One)
  |> Stdlib.Test.equal(Result.Ok("let f =\n    2\n"))


test editSaysWhenNothingMatches =
  Cli.Agent.Tools.editText("abc", "zzz", "y", Cli.Agent.Tools.Occurrences.One)
  |> Stdlib.Test.equal(
    Result.Error(
      "old_string is not in the file (even ignoring indentation); read the file again"))


test truncateKeepsHeadAndTail =
  let long = Stdlib.String.repeat("a", 20000) + Stdlib.String.repeat("b", 20000)
  let cut = Cli.Agent.Tools.truncate(long)
  (
    Stdlib.String.startsWith(cut, "aaa"),
    Stdlib.String.endsWith(cut, "bbb"),
    Stdlib.String.length(cut) < 31000)
  |> Stdlib.Test.equal((true, true, true))


test dedentRemovesTheCommonIndent =
  Cli.Sessions.Batch.dedent([ "  let a = 1", "    a + 1", "" ])
  |> Stdlib.Test.equal("let a = 1\n  a + 1\n")


test aWriteNamesItsModule =
  Cli.Sessions.Batch.moduleOfWrite(
    [],
    "fn",
    [ "Me.Demo.double", "(a: Int64): Int64 = a" ])
  |> Stdlib.Test.equal(Option.Some("Me.Demo"))


test aModuleWriteNamesItself =
  Cli.Sessions.Batch.moduleOfWrite([], "module", [ "/Me.Greet", "-" ])
  |> Stdlib.Test.equal(Option.Some("Me.Greet"))


test aRelativeWriteResolvesAgainstTheLocation =
  Cli.Sessions.Batch.moduleOfWrite([ "Me", "Demo" ], "fn", [ "double", "x" ])
  |> Stdlib.Test.equal(Option.Some("Me.Demo"))


test aReadIsNotAWrite =
  Cli.Sessions.Batch.moduleOfWrite([], "view", [ "Me.Demo.double" ])
  |> Stdlib.Test.equal(Option.None)


test stripAnsiLeavesPlainText =
  Cli.Sessions.Batch.stripAnsi("\u001b[32mok\u001b[0m done")
  |> Stdlib.Test.equal("ok done")


test errorLinesSkipTheBindings =
  (
    Cli.Sessions.Batch.shiftLine("error[PARSE] at 3:5: oops", 2),
    Cli.Sessions.Batch.shiftLine("    3 | x y", 2))
  |> Stdlib.Test.equal(("error[PARSE] at 1:5: oops", "    1 | x y"))


let ctxAllowing(
  effects: List<LanguageTools.Permissions.Effect>)
  : Cli.Agent.Tools.Context =
  Cli.Agent.Tools.Context
    { app = Cli.initState()
      session = Cli.Sessions.fresh("t", SCM.Branch.mainBranchId, [])
      cwd = "/"
      seen = []
      allowed = effects
      ask = false
      store = true
      touched = []
      probes = []
      writable = []
      hosts = [] }


test aBatchCannotChangeThePolicy =
  Cli.Agent.Tools.batchRefusal(
    ctxAllowing([]),
    "fn Me.A.b '(): Int64 = 1'\npermissions allow file read /")
  |> Stdlib.Test.equal(
    Option.Some(
      "`permissions` changes more than this session's branch; the person runs it"))


test aBatchCannotGrantWhatTheSessionLacks =
  Cli.Agent.Tools.batchRefusal(
    ctxAllowing([]),
    "run Me.A.main --allow 'file write /tmp' x")
  |> Stdlib.Test.equal(
    Option.Some(
      "denied: `--allow file write /tmp` grants what this session does not have (the person can rerun the agent with --allow)"))


test aBatchMayPassOnWhatTheSessionHas =
  Cli.Agent.Tools.batchRefusal(
    ctxAllowing([ LanguageTools.Permissions.Effect.FileRead ]),
    "run Me.A.main --allow 'file read /data' x")
  |> Stdlib.Test.equal(Option.None)


test testRunIsNotAWrite =
  Cli.Sessions.Batch.moduleOfWrite(
    [ "Me", "Demo" ],
    "test",
    [ "run", "Me.Demo" ])
  |> Stdlib.Test.equal(Option.None)


test runTargetSkipsFlags =
  Cli.Sessions.Batch.read(
    Cli.initState(),
    "run --allow 'file read /d' Me.A.main x\nrun Me.A.main\nview Me.A.main")
  |> Stdlib.List.map(fun st -> Cli.Agent.Store.runTarget(st))
  |> Stdlib.Test.equal(
    [ Option.Some("Me.A.main"), Option.Some("Me.A.main"), Option.None ])


test oneReaderForEveryLine =
  Cli.Sessions.Batch.read(
    Cli.initState(),
    "let x = 1\ndark status\nwatch x + 1\nx * 2\nsession ls")
  |> Stdlib.Test.equal(
    [ Cli.Sessions.Batch.Statement.Bind("x", "1")
      Cli.Sessions.Batch.Statement.Command("status", [], Option.None)
      Cli.Sessions.Batch.Statement.WatchAdd("x + 1")
      Cli.Sessions.Batch.Statement.Expression("x * 2")
      Cli.Sessions.Batch.Statement.Refused(
        "`session` cannot run inside a batch") ])


test aBlankLineInsideABlockKeepsTheBlock =
  [ Cli.Sessions.Batch.splitStatements(
      "module /Me.A -\n  let f() = 1\n\n  test t = f() |> Stdlib.Test.equal(1)\nMe.A.f()")

    Cli.Sessions.Batch.splitStatements("1 + 1\n\n2") ]
  |> Stdlib.Test.equal(
    [ [ "module /Me.A -\n  let f() = 1\n\n  test t = f() |> Stdlib.Test.equal(1)"
        "Me.A.f()" ]

      [ "1 + 1", "2" ] ])


let sandboxed(): Cli.Agent.Tools.Context =
  { ctxAllowing(
      [ LanguageTools.Permissions.Effect.FileRead
        LanguageTools.Permissions.Effect.FileWrite
        LanguageTools.Permissions.Effect.Http
        LanguageTools.Permissions.Effect.HttpServer ]) with
      cwd = "/work"
      writable = [ "/work", "/store" ]
      hosts = [ "api.github.com" ] }


test theSandboxKeepsRulesInside =
  let ctx = sandboxed()
  [ "file write /work/out"
    "file write /etc/passwd"
    "file write /work/../etc"
    "file read /"
    "http GET https://api.github.com/repos"
    "http GET https://example.com/"
    "http *"
    "http-server 127.0.0.1 9000"
    "http-server 0.0.0.0 9000"
    "process ls" ]
  |> Stdlib.List.map(fun r -> Cli.Agent.Tools.sandboxAllows(ctx, r))
  |> Stdlib.Test.equal(
    [ true, false, false, true, true, false, false, true, false, false ])


test theSandboxRefusesWritesOutside =
  [ Cli.Agent.Tools.mayWrite(sandboxed(), "/work/a.txt")
    Cli.Agent.Tools.mayWrite(sandboxed(), "/workother/a.txt")
    Cli.Agent.Tools.mayWrite(ctxAllowing([]), "/anywhere") ]
  |> Stdlib.Test.equal([ true, false, true ])


test aHeredocInABatchIsABlock =
  [ Cli.Agent.Tools.heredocsToBlocks(
      "fn /Me.A.f - <<'EOF'\nlet f(): Int64 = 1\nEOF\nMe.A.f()")

    Cli.Agent.Tools.heredocsToBlocks(
      "module /Me.B <<EOF\nlet g() = 2\n\nlet h() = 3\nEOF")

    Cli.Agent.Tools.heredocsToBlocks("1 << 2") ]
  |> Stdlib.Test.equal(
    [ "fn /Me.A.f -\n  let f(): Int64 = 1\nMe.A.f()"
      "module /Me.B -\n  let g() = 2\n  \n  let h() = 3"
      "1 << 2" ])


test editingATestSavesItAsATest =
  [ Cli.Agent.Tools.saveStatement(
      "Me.T.works",
      "test works = 1 |> Stdlib.Test.equal(1)")

    Cli.Agent.Tools.saveStatement("Me.T.f", "let f(): Int64 = 1") ]
  |> Stdlib.Test.equal(
    [ "test add Me.T.works -\n  1 |> Stdlib.Test.equal(1)"
      "fn Me.T.f -\n  let f(): Int64 = 1" ])
