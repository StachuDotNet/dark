// Stdlib.Crypto — all hashes take and return Blob. Use
// `Stdlib.Blob.fromString` to build an input from a string and
// `Stdlib.Blob.toHex` to render the digest.
module Darklang.Stdlib.Crypto.Tests

test digests =
  let empty = Stdlib.Blob.fromString ""
  let longer = Stdlib.Blob.fromString "a longer string that's more interesting"
  Stdlib.Test.all
    [ empty |> Stdlib.Crypto.md5 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "D41D8CD98F00B204E9800998ECF8427E"
      empty |> Stdlib.Crypto.sha256 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
      empty |> Stdlib.Crypto.sha384 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "38B060A751AC96384CD9327EB1B1E36A21FDB71114BE07434C0CC7BF63F6E1DA274EDEBFE76F65FBD51AD2F14898B95B"
      longer |> Stdlib.Crypto.md5 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "D95E619F023B430CAAAEB6778A0B9BD1"
      longer |> Stdlib.Crypto.sha256 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "1316F78627BC453D44D27E3133902CF798859572E814EED4B5FB56BB1447F05F"
      longer |> Stdlib.Crypto.sha384 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "AD7273EF514770D80B516D067354CB300FE458C042CE084EC97125718678C3C21415FE224658839963F0B2D90137AA7B" ]

// sha256hmac
test sha256hmac =
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let data = Stdlib.Blob.fromString "20150830"
  Stdlib.Crypto.sha256hmac secret data
  |> Stdlib.Blob.toHex
  |> Stdlib.Test.equal "0138C7A6CBD60AA727B2F653A522567439DFB9F3E72B21F9B25941A42F04A7CD"

// sha1hmac
test sha1hmac =
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let data = Stdlib.Blob.fromString "20150830"
  Stdlib.Crypto.sha1hmac secret data
  |> Stdlib.Blob.toHex
  |> Stdlib.Test.equal "0932CB57FE685FEBC66657AA30C7568A4AB05CAF"

// Every test case in RFC 2202. Case 5 is the truncation case: the RFC
// publishes the full digest as well as the truncated one; this checks the full one.
test sha1hmacRfcVectors =
  let hex (s: String) : Blob = s |> Stdlib.Blob.fromHex |> Builtin.unwrap
  Stdlib.Test.all
    [ Stdlib.Crypto.sha1hmac (hex "0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B") (hex "4869205468657265") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "B617318655057264E28BC0B6FB378C8EF146BE00"
      Stdlib.Crypto.sha1hmac (hex "4A656665") (hex "7768617420646F2079612077616E7420666F72206E6F7468696E673F") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "EFFCDF6AE5EB2FA2D27416D5F184DF9C259A7C79"
      Stdlib.Crypto.sha1hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "125D7342B9AC11CD91A39AF48AA17B4F63F175D3"
      Stdlib.Crypto.sha1hmac (hex "0102030405060708090A0B0C0D0E0F10111213141516171819") (hex "CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "4C9007F4026250C6BC8414F9BF50C86C2D7235DA"
      Stdlib.Crypto.sha1hmac (hex "0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C") (hex "546573742057697468205472756E636174696F6E") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "4C1A03424B55E07FE7F27BE1D58BB9324A9A5A04"
      Stdlib.Crypto.sha1hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "AA4AE5E15272D00E95705637CE8A3B55ED402112"
      Stdlib.Crypto.sha1hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B657920616E64204C6172676572205468616E204F6E6520426C6F636B2D53697A652044617461") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "E8E99D0F45237D786D6BBAA7965C7808BBFF1A91" ]

// Every test case in RFC 4231. Case 5 is the truncation case: the RFC
// publishes only the first bytes there, so only those are compared.
test sha256hmacRfcVectors =
  let hex (s: String) : Blob = s |> Stdlib.Blob.fromHex |> Builtin.unwrap
  Stdlib.Test.all
    [ Stdlib.Crypto.sha256hmac (hex "0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B") (hex "4869205468657265") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "B0344C61D8DB38535CA8AFCEAF0BF12B881DC200C9833DA726E9376C2E32CFF7"
      Stdlib.Crypto.sha256hmac (hex "4A656665") (hex "7768617420646F2079612077616E7420666F72206E6F7468696E673F") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843"
      Stdlib.Crypto.sha256hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "773EA91E36800E46854DB8EBD09181A72959098B3EF8C122D9635514CED565FE"
      Stdlib.Crypto.sha256hmac (hex "0102030405060708090A0B0C0D0E0F10111213141516171819") (hex "CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "82558A389A443C0EA4CC819899F2083A85F0FAA3E578F8077A2E3FF46729665B"
      Stdlib.String.first (Stdlib.Crypto.sha256hmac (hex "0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C") (hex "546573742057697468205472756E636174696F6E") |> Stdlib.Blob.toHex) 32
      |> Stdlib.Test.equal "A3B6167473100EE06E0C796C2955552B"
      Stdlib.Crypto.sha256hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "60E431591EE0B67F0D8A26AACBF5B77F8E0BC6213728C5140546040F0EE37F54"
      Stdlib.Crypto.sha256hmac (hex "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") (hex "") |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "9B09FFA71B942FCB27635FBCD5B0E944BFDC63644F0713938A7F51535C3A35E2" ]

// aws
test awsSigningChain =
  let scope = "20150830/us-east-1/iam/aws4_request"
  let content = "f536975d06c0309214f805bb90ccff089219ecd68b2577efef23edd43b7e1a59"
  let strs = [ "AWS4-HMAC-SHA256", "20150830T123600Z", scope, content ]
  let strToSign = Stdlib.String.join strs Stdlib.String.newline
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let date = Stdlib.Crypto.sha256hmac secret (Stdlib.Blob.fromString "20150830")
  let region = Stdlib.Crypto.sha256hmac date (Stdlib.Blob.fromString "us-east-1")
  let service = Stdlib.Crypto.sha256hmac region (Stdlib.Blob.fromString "iam")
  let signing = Stdlib.Crypto.sha256hmac service (Stdlib.Blob.fromString "aws4_request")
  Stdlib.Crypto.sha256hmac signing (Stdlib.Blob.fromString strToSign)
  |> Stdlib.Blob.toHex
  |> Stdlib.String.toLowercase
  |> Stdlib.Test.equal "5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7"
