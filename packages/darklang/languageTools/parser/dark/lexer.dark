/// Source text to tokens, each with its range, the comments before it, and the `///` doc
/// comment it carries. Columns count UTF-16 units, as the F# lexer's do.
module Darklang.LanguageTools.Parser.Dark.Lexer

type Range = LanguageTools.Parser.Range
type Point = LanguageTools.Parser.Point


type TokenKind =
  | TBigInt(BigInt)
  | TInt64(Int64)
  | TInt128(Int128)
  | TInt8(Int8)
  | TInt16(Int16)
  | TInt32(Int32)
  | TUInt8(UInt8)
  | TUInt16(UInt16)
  | TUInt32(UInt32)
  | TUInt64(UInt64)
  | TUInt128(UInt128)
  | TFloat64
  | TFloat32
  | TDecimal(Decimal)
  | TStringLit(String)
  /// the unescaped text; one grapheme when the literal is well formed
  | TCharLit(String)
  | TInterpString
  | TTrue
  | TFalse
  | TPlus
  | TMinus
  | TStar
  | TStarStar
  | TSlash
  | TLParen
  | TRParen
  | TLet
  | TVal
  | TIn
  | TIf
  | TElif
  | TThen
  | TElse
  | TType
  | TTrait
  | TImpl
  | TColon
  | TComma
  | TSemicolon
  | TDot
  | TLBrace
  | TRBrace
  | TBar
  | TOf
  | TMatch
  | TWith
  | TFun
  | TArrow
  | TUnderscore
  | TWhen
  | TLBracket
  | TRBracket
  | TEquals
  | TEqEq
  | TNeq
  | TLt
  | TGt
  | TLte
  | TGte
  | TAnd
  | TOr
  | TQuestion
  | TNot
  | TPipe
  | TDotDotDot
  | TPercent
  | TShl
  | TShr
  | TBitAnd
  | TBitXor
  | TBitNot
  | TIdent(String)
  | TEOF


type TriviaKind =
  | LineComment
  | DocComment
  | BlockComment


type Trivia =
  { kind: TriviaKind
    text: String
    range: Range }


type Token =
  { kind: TokenKind
    text: String
    range: Range
    docComment: Option<String>
    leadingTrivia: List<Trivia>
    lexError: Bool }


type IntType =
  | Int8
  | UInt8
  | Int16
  | UInt16
  | Int32
  | UInt32
  | Int64
  | UInt64
  | Int128
  | UInt128


type Problem =
  | UnterminatedBlockComment
  | UnterminatedString
  | UnterminatedTripleQuotedString
  | UnterminatedChar
  | UnterminatedInterpolatedString
  /// `{f(xs, \", \")}`: an escaped quote inside the braces of an interpolated string
  | EscapedQuoteInInterpolation
  | UnterminatedBacktick
  /// a backtick name holding whitespace, with the words in it
  | SpacedName(words: List<String>)
  | IntOutOfRange(typ: IntType, written: String)
  | MalformedFloat(written: String)
  | DecimalWithExponent(body: String)
  | DecimalOutOfRange(body: String)
  /// a number with a suffix Dark doesn't have; `spelling` is (type, Dark form) when the
  /// suffix is another language's
  | InvalidNumber(written: String, spelling: Option<(String * String)>)
  /// `::`, `@` or `++`
  | RefusedOperator(written: String)
  | UnexpectedCharacter(written: String)


type Diagnostic =
  { range: Range
    problem: Problem }


type Lexed =
  { tokens: List<Token>
    diagnostics: List<Diagnostic> }


/// A reserved word's token, or a name. `___` is the blank name.
let keywordKind(word: String): TokenKind =
  match word with
  | "let" -> TokenKind.TLet
  | "val" -> TokenKind.TVal
  | "in" -> TokenKind.TIn
  | "if" -> TokenKind.TIf
  | "elif" -> TokenKind.TElif
  | "then" -> TokenKind.TThen
  | "else" -> TokenKind.TElse
  | "type" -> TokenKind.TType
  | "trait" -> TokenKind.TTrait
  | "impl" -> TokenKind.TImpl
  | "of" -> TokenKind.TOf
  | "match" -> TokenKind.TMatch
  | "with" -> TokenKind.TWith
  | "fun" -> TokenKind.TFun
  | "when" -> TokenKind.TWhen
  | "true" -> TokenKind.TTrue
  | "false" -> TokenKind.TFalse
  | "_" -> TokenKind.TUnderscore
  | "___" -> TokenKind.TIdent("")
  | _ -> TokenKind.TIdent(word)


/// The operator at <param i>, longest first: its length and token.
let operatorAt(src: Source, i: Int64, c: UInt32, c1: UInt32): Option<(Int64 * TokenKind)> =
  if c == cDot && c1 == cDot && at(src, i + 2) == cDot then Stdlib.Option.Option.Some((3, TokenKind.TDotDotDot))
  else if c == cStar && c1 == cStar then Stdlib.Option.Option.Some((2, TokenKind.TStarStar))
  else if c == cMinus && c1 == cGt then Stdlib.Option.Option.Some((2, TokenKind.TArrow))
  else if c == cEquals && c1 == cEquals then Stdlib.Option.Option.Some((2, TokenKind.TEqEq))
  else if c == 33u32 && c1 == cEquals then Stdlib.Option.Option.Some((2, TokenKind.TNeq))
  else if c == 60u32 && c1 == 60u32 then Stdlib.Option.Option.Some((2, TokenKind.TShl))
  else if c == 60u32 && c1 == cEquals then Stdlib.Option.Option.Some((2, TokenKind.TLte))
  else if c == cGt && c1 == cGt then Stdlib.Option.Option.Some((2, TokenKind.TShr))
  else if c == cGt && c1 == cEquals then Stdlib.Option.Option.Some((2, TokenKind.TGte))
  else if c == 38u32 && c1 == 38u32 then Stdlib.Option.Option.Some((2, TokenKind.TAnd))
  else if c == 124u32 && c1 == 124u32 then Stdlib.Option.Option.Some((2, TokenKind.TOr))
  else if c == 124u32 && c1 == cGt then Stdlib.Option.Option.Some((2, TokenKind.TPipe))
  else
    match c with
    | 43u32 -> Stdlib.Option.Option.Some((1, TokenKind.TPlus))
    | 45u32 -> Stdlib.Option.Option.Some((1, TokenKind.TMinus))
    | 42u32 -> Stdlib.Option.Option.Some((1, TokenKind.TStar))
    | 47u32 -> Stdlib.Option.Option.Some((1, TokenKind.TSlash))
    | 40u32 -> Stdlib.Option.Option.Some((1, TokenKind.TLParen))
    | 41u32 -> Stdlib.Option.Option.Some((1, TokenKind.TRParen))
    | 123u32 -> Stdlib.Option.Option.Some((1, TokenKind.TLBrace))
    | 125u32 -> Stdlib.Option.Option.Some((1, TokenKind.TRBrace))
    | 91u32 -> Stdlib.Option.Option.Some((1, TokenKind.TLBracket))
    | 93u32 -> Stdlib.Option.Option.Some((1, TokenKind.TRBracket))
    | 58u32 -> Stdlib.Option.Option.Some((1, TokenKind.TColon))
    | 44u32 -> Stdlib.Option.Option.Some((1, TokenKind.TComma))
    | 59u32 -> Stdlib.Option.Option.Some((1, TokenKind.TSemicolon))
    | 46u32 -> Stdlib.Option.Option.Some((1, TokenKind.TDot))
    | 61u32 -> Stdlib.Option.Option.Some((1, TokenKind.TEquals))
    | 63u32 -> Stdlib.Option.Option.Some((1, TokenKind.TQuestion))
    | 33u32 -> Stdlib.Option.Option.Some((1, TokenKind.TNot))
    | 60u32 -> Stdlib.Option.Option.Some((1, TokenKind.TLt))
    | 62u32 -> Stdlib.Option.Option.Some((1, TokenKind.TGt))
    | 38u32 -> Stdlib.Option.Option.Some((1, TokenKind.TBitAnd))
    | 94u32 -> Stdlib.Option.Option.Some((1, TokenKind.TBitXor))
    | 126u32 -> Stdlib.Option.Option.Some((1, TokenKind.TBitNot))
    | 37u32 -> Stdlib.Option.Option.Some((1, TokenKind.TPercent))
    | 124u32 -> Stdlib.Option.Option.Some((1, TokenKind.TBar))
    | _ -> Stdlib.Option.Option.None


// --- the source, as codepoints ---

type Source =
  { text: String
    cps: List<UInt32>
    length: Int64
    /// whether each character is one codepoint, so text can be cut from the string directly
    simple: Bool
    /// whether a codepoint takes two UTF-16 units, so a column isn't just a count
    astral: Bool
    /// where each line ends: the index of its line break, or the length for the last
    lineEnds: List<Int64>
    /// a simple text cut into pieces of `chunkSize` characters, so cutting a token's text
    /// costs the token, not its offset in the file
    chunks: List<String> }


val chunkSize = 128


let source(text: String): Source =
  let cps = Stdlib.String.toCodepoints(text)
  let length = Stdlib.List.length(cps)
  let lineLengths = Stdlib.List.map(Stdlib.String.split(text, "\n"), fun line -> Stdlib.String.codepointLength(line))
  let simple = Stdlib.String.length(text) == length
  let chunks =
    if simple then
      Stdlib.String.toList(text)
      |> Stdlib.List.chunkBySize(chunkSize)
      |> Stdlib.Result.withDefault([])
      |> Stdlib.List.map(fun cs -> Stdlib.String.fromList(cs))
    else
      []
  Source
    { text = text
      cps = cps
      length = length
      simple = simple
      astral = Stdlib.List.any(cps, fun c -> c > 65535u32)
      lineEnds = lineEndsFrom(lineLengths, 0, [])
      chunks = chunks }


let lineEndsFrom(lengths: List<Int64>, start: Int64, endsRev: List<Int64>): List<Int64> =
  match lengths with
  | [ n, ...rest ] -> lineEndsFrom(rest, start + n + 1, [ start + n, ...endsRev ])
  | [] -> Stdlib.List.reverse(endsRev)


/// The end of line <param row>, found without walking it: comments run to the end of a line.
let lineEndOnRow(src: Source, row: Int64): Int64 =
  match Builtin.listGetAt(src.lineEnds, row) with
  | Some(e) -> e
  | None -> src.length


/// The codepoint at <param i>, or 0 past the end.
let at(src: Source, i: Int64): UInt32 =
  match Builtin.listGetAt(src.cps, i) with
  | Some(c) -> c
  | None -> 0u32


let isChar(src: Source, i: Int64, c: Char): Bool =
  match Stdlib.Char.toCodepoint(c) with
  | Some(cp) -> at(src, i) == cp
  | None -> false


let code(c: Char): UInt32 =
  Stdlib.Char.toCodepoint(c) |> Stdlib.Option.withDefault(0u32)


val nl = 10u32
val quote = 34u32
val apostrophe = 39u32
val backslash = 92u32
val backtick = 96u32
val underscore = 95u32
val cLParen = 40u32
val cRParen = 41u32
val cStar = 42u32
val cPlus = 43u32
val cMinus = 45u32
val cDot = 46u32
val cSlash = 47u32
val cEquals = 61u32
val cGt = 62u32
val cLBrace = 123u32
val cRBrace = 125u32
val cDollar = 36u32
val cLowerE = 101u32
val cUpperE = 69u32


let isDigit(c: UInt32): Bool =
  c >= 48u32 && c <= 57u32


let isAsciiLetter(c: UInt32): Bool =
  (c >= 97u32 && c <= 122u32) || (c >= 65u32 && c <= 90u32)


let isLetter(c: UInt32): Bool =
  if c < 128u32 then isAsciiLetter(c) else Stdlib.Codepoint.isLetter(c)


let isIdentChar(c: UInt32): Bool =
  if c < 128u32 then
    isAsciiLetter(c) || isDigit(c) || c == underscore || c == apostrophe
  else
    Stdlib.Codepoint.isAlphanumeric(c)


let isTypeVarChar(c: UInt32): Bool =
  if c < 128u32 then
    isAsciiLetter(c) || isDigit(c) || c == underscore
  else
    Stdlib.Codepoint.isAlphanumeric(c)


/// Characters [<param from>, <param to>) of the text <param chunks> were cut from
/// (0 <= from <= to <= its length).
let chunkText(chunks: List<String>, from: Int64, to: Int64): String =
  if from >= to then
    ""
  else
    let first = from / chunkSize
    let last = (to - 1) / chunkSize
    let piece = fun k ->
      let chunk = Builtin.listGetAt(chunks, k) |> Stdlib.Option.withDefault("")
      let a = if k == first then from - k * chunkSize else 0
      let b = if k == last then to - k * chunkSize else chunkSize
      Builtin.stringSlice(chunk, a, b) |> Stdlib.Option.withDefault("")
    if first == last then
      piece(first)
    else
      Stdlib.String.join(Stdlib.List.map(Stdlib.List.range(first, last), piece), "")


/// The text of codepoints [<param from>, <param to>).
let text(src: Source, from: Int64, to: Int64): String =
  if src.simple then
    let a = minI(maxI(0, from), src.length)
    chunkText(src.chunks, a, minI(maxI(a, to), src.length))
  else
    src.cps
    |> Stdlib.List.drop(from)
    |> Stdlib.List.take(to - from)
    |> Stdlib.List.filterMap(fun c -> Stdlib.Char.fromCodepoint(c))
    |> Stdlib.String.fromList


let startsWith(src: Source, i: Int64, s: String): Bool =
  let cs = Stdlib.String.toCodepoints(s)
  Stdlib.List.take(Stdlib.List.drop(src.cps, i), Stdlib.List.length(cs)) == cs


/// Where <param pos> moves to over codepoints [<param from>, <param to>).
let advance(src: Source, pos: Point, from: Int64, to: Int64): Point =
  if from >= to then pos
  else advanceIn(Builtin.listDrop(src.cps, from), pos.row, pos.column, to - from)


// The scanners below walk the list from a position rather than index it: a step is then one
// pattern match, not a call and a lookup per character.
let advanceIn(rest: List<UInt32>, row: Int64, column: Int64, count: Int64): Point =
  if count <= 0 then
    Point { row = row, column = column }
  else
    match rest with
    | [ c, ...tail ] ->
      if c == 10u32 then advanceIn(tail, row + 1, 0, count - 1)
      else if c > 65535u32 then advanceIn(tail, row, column + 2, count - 1)
      else advanceIn(tail, row, column + 1, count - 1)
    | [] -> Point { row = row, column = column + count }


// --- scanners: each returns the index just past what it scanned ---

let scanWhile(src: Source, i: Int64, keep: UInt32 -> Bool): Int64 =
  scanWhileIn(Builtin.listDrop(src.cps, i), i, keep)


let scanWhileIn(rest: List<UInt32>, i: Int64, keep: UInt32 -> Bool): Int64 =
  match rest with
  | [ c, ...tail ] -> if keep(c) then scanWhileIn(tail, i + 1, keep) else i
  | [] -> i


let digitsEnd(src: Source, i: Int64): Int64 =
  digitsEndIn(Builtin.listDrop(src.cps, i), i)


let digitsEndIn(rest: List<UInt32>, i: Int64): Int64 =
  match rest with
  | [ c, ...tail ] -> if c >= 48u32 && c <= 57u32 then digitsEndIn(tail, i + 1) else i
  | [] -> i


/// Past the identifier characters from <param i>. The hot loop of lexing, so ASCII is
/// tested inline.
let identEnd(src: Source, i: Int64): Int64 =
  identEndIn(Builtin.listDrop(src.cps, i), i)


let identEndIn(rest: List<UInt32>, i: Int64): Int64 =
  match rest with
  | [ c, ...tail ] ->
    if (c >= 97u32 && c <= 122u32) || (c >= 65u32 && c <= 90u32) || (c >= 48u32 && c <= 57u32) || c == 95u32 || c == 39u32 then
      identEndIn(tail, i + 1)
    else if c >= 128u32 && Stdlib.Codepoint.isAlphanumeric(c) then
      identEndIn(tail, i + 1)
    else
      i
  | [] -> i


let lineEnd(src: Source, i: Int64): Int64 =
  lineEndIn(Builtin.listDrop(src.cps, i), i)


let lineEndIn(rest: List<UInt32>, i: Int64): Int64 =
  match rest with
  | [ c, ...tail ] -> if c == 10u32 then i else lineEndIn(tail, i + 1)
  | [] -> i


/// Past the closing <param close> at or after <param i>, skipping `\` escapes.
let scanQuoted(src: Source, i: Int64, close: UInt32): Option<Int64> =
  scanQuotedIn(Builtin.listDrop(src.cps, i), i, close)


let scanQuotedIn(rest: List<UInt32>, i: Int64, close: UInt32): Option<Int64> =
  match rest with
  | [ 92u32, _, ...tail ] -> scanQuotedIn(tail, i + 2, close)
  | [ c, ...tail ] -> if c == close then Stdlib.Option.Option.Some(i + 1) else scanQuotedIn(tail, i + 1, close)
  | [] -> Stdlib.Option.Option.None


let skipQuoted(src: Source, i: Int64, close: UInt32): Int64 =
  if i >= src.length then i
  else if at(src, i) == backslash then skipQuoted(src, i + 2, close)
  else if at(src, i) == close then i + 1
  else skipQuoted(src, i + 1, close)


let isTripleQuote(src: Source, i: Int64): Bool =
  i + 2 < src.length && at(src, i) == quote && at(src, i + 1) == quote && at(src, i + 2) == quote


let findTripleQuote(src: Source, i: Int64): Option<Int64> =
  if isTripleQuote(src, i) then Stdlib.Option.Option.Some(i + 3)
  else if i >= src.length then Stdlib.Option.Option.None
  else findTripleQuote(src, i + 1)


/// The end of a `(* … *)` comment whose `(*` is before <param i>, and whether it closed.
let blockCommentEnd(src: Source, i: Int64, depth: Int64): (Int64 * Bool) =
  if i + 1 < src.length && at(src, i) == cLParen && at(src, i + 1) == cStar then
    blockCommentEnd(src, i + 2, depth + 1)
  else if i + 1 < src.length && at(src, i) == cStar && at(src, i + 1) == cRParen then
    if depth == 0 then (i + 2, true) else blockCommentEnd(src, i + 2, depth - 1)
  else if i >= src.length then
    (i, false)
  else
    blockCommentEnd(src, i + 1, depth)


/// The `}` closing an interpolation whose body starts at <param i>, or None. Strings, chars
/// and comments inside the body are skipped, so their braces don't count.
let interpClose(src: Source, i: Int64, depth: Int64): Option<Int64> =
  if i >= src.length then
    Stdlib.Option.Option.None
  else if at(src, i) == cSlash && at(src, i + 1) == cSlash && i + 1 < src.length then
    interpClose(src, lineEnd(src, i + 2), depth)
  else if at(src, i) == cLParen && at(src, i + 1) == cStar && i + 1 < src.length then
    interpClose(src, Stdlib.Tuple2.first(blockCommentEnd(src, i + 2, 0)), depth)
  else if isTripleQuote(src, i) then
    let close =
      match findTripleQuote(src, i + 3) with
      | Some(e) -> e
      | None -> src.length
    interpClose(src, close, depth)
  else if at(src, i) == quote then
    interpClose(src, skipQuoted(src, i + 1, quote), depth)
  else if at(src, i) == apostrophe && at(src, i + 1) == backslash && i + 1 < src.length then
    interpClose(src, skipQuoted(src, i + 1, apostrophe), depth)
  else if at(src, i) == apostrophe && at(src, i + 2) == apostrophe && i + 2 < src.length then
    interpClose(src, i + 3, depth)
  else if at(src, i) == cLBrace then
    interpClose(src, i + 1, depth + 1)
  else if at(src, i) == cRBrace && depth == 0 then
    Stdlib.Option.Option.Some(i)
  else if at(src, i) == cRBrace then
    interpClose(src, i + 1, depth - 1)
  else
    interpClose(src, i + 1, depth)


/// Past the end of `$"…"` or `$"""…"""` starting at <param start>, or None if unterminated.
let interpEnd(src: Source, start: Int64): Option<Int64> =
  let triple = isTripleQuote(src, start + 1)
  let closeLength = if triple then 3 else 1
  interpEndFrom(src, triple, closeLength, if triple then start + 4 else start + 2)


let interpEndFrom(src: Source, triple: Bool, closeLength: Int64, i: Int64): Option<Int64> =
  if i >= src.length then
    Stdlib.Option.Option.None
  else if (triple && isTripleQuote(src, i)) || (Stdlib.Bool.not(triple) && at(src, i) == quote) then
    Stdlib.Option.Option.Some(i + closeLength)
  else if at(src, i) == backslash && i + 1 < src.length && Stdlib.Bool.not(triple) then
    interpEndFrom(src, triple, closeLength, i + 2)
  else if at(src, i) == cLBrace && at(src, i + 1) == cLBrace && i + 1 < src.length then
    interpEndFrom(src, triple, closeLength, i + 2)
  else if at(src, i) == cRBrace && at(src, i + 1) == cRBrace && i + 1 < src.length then
    interpEndFrom(src, triple, closeLength, i + 2)
  else if at(src, i) == cLBrace then
    match interpClose(src, i + 1, 0) with
    | Some(close) -> interpEndFrom(src, triple, closeLength, close + 1)
    | None -> Stdlib.Option.Option.None
  else
    interpEndFrom(src, triple, closeLength, i + 1)


// --- escapes ---

let hexValue(src: Source, from: Int64, count: Int64): Option<Int64> =
  if from + count > src.length then
    Stdlib.Option.Option.None
  else
    let digits = text(src, from, from + count)
    if Stdlib.String.length(digits) != count then
      Stdlib.Option.Option.None
    else
      Stdlib.String.toList(digits)
      |> Stdlib.List.fold(Stdlib.Option.Option.Some(0), fun(acc, c) ->
        match acc with
        | Some(n) ->
          match hexDigit(c) with
          | Some(d) -> Stdlib.Option.Option.Some(n * 16 + d)
          | None -> Stdlib.Option.Option.None
        | None -> Stdlib.Option.Option.None)


let hexDigit(c: Char): Option<Int64> =
  let cp = Stdlib.UInt32.toInt64(code(c))
  if cp >= 48 && cp <= 57 then Stdlib.Option.Option.Some(cp - 48)
  else if cp >= 97 && cp <= 102 then Stdlib.Option.Option.Some(cp - 87)
  else if cp >= 65 && cp <= 70 then Stdlib.Option.Option.Some(cp - 55)
  else Stdlib.Option.Option.None


let scalarText(value: Int64): Option<String> =
  match Stdlib.Codepoint.fromInt64(value) with
  | Some(cp) -> Stdlib.Char.fromCodepoint(cp) |> Stdlib.Option.map(fun c -> Stdlib.String.fromChar(c))
  | None -> Stdlib.Option.Option.None


/// The escape starting at the `\` at <param i>: how many codepoints it takes, and its text.
let decodeEscape(src: Source, i: Int64): Option<(Int64 * String)> =
  if i + 1 >= src.length then
    Stdlib.Option.Option.None
  else
    let simple = fun s -> Stdlib.Option.Option.Some((2, s))
    match text(src, i + 1, i + 2) with
    | "n" -> simple("\n")
    | "t" -> simple("\t")
    | "r" -> simple("\r")
    | "a" -> simple("\a")
    | "b" -> simple("\b")
    | "v" -> simple("\v")
    | "f" -> simple("\f")
    | "\\" -> simple("\\")
    | "\"" -> simple("\"")
    | "'" -> simple("'")
    | "/" -> simple("/")
    | "0" -> simple("\0")
    | "{" -> simple("{")
    | "}" -> simple("}")
    | "x" ->
      hexValue(src, i + 2, 2)
      |> Stdlib.Option.andThen(fun v -> scalarText(v))
      |> Stdlib.Option.map(fun s -> (4, s))
    | "X" ->
      hexValue(src, i + 2, 4)
      |> Stdlib.Option.andThen(fun v -> scalarText(v))
      |> Stdlib.Option.map(fun s -> (6, s))
    | "u" ->
      hexValue(src, i + 2, 4)
      |> Stdlib.Option.andThen(fun v -> scalarText(v))
      |> Stdlib.Option.map(fun s -> (6, s))
    | "U" ->
      hexValue(src, i + 2, 8)
      |> Stdlib.Option.andThen(fun v -> scalarText(v))
      |> Stdlib.Option.map(fun s -> (10, s))
    | _ -> Stdlib.Option.Option.None


/// The text of [<param from>, <param to>) with escapes decoded; a bad escape keeps its `\`.
let unescape(src: Source, from: Int64, to: Int64): String =
  unescapeFrom(src, from, to, from, [])


let unescapeFrom(src: Source, from: Int64, to: Int64, i: Int64, partsRev: List<String>): String =
  match findBackslash(src, i, to) with
  | None -> Stdlib.String.join(Stdlib.List.reverse([ text(src, i, to), ...partsRev ]), "")
  | Some(b) ->
    let before = text(src, i, b)
    match decodeEscape(src, b) with
    | Some((count, decoded)) ->
      unescapeFrom(src, from, to, minI(b + count, to), [ decoded, before, ...partsRev ])
    | None -> unescapeFrom(src, from, to, b + 1, [ "\\", before, ...partsRev ])


let findBackslash(src: Source, i: Int64, to: Int64): Option<Int64> =
  if i >= to then Stdlib.Option.Option.None
  else if at(src, i) == backslash then Stdlib.Option.Option.Some(i)
  else findBackslash(src, i + 1, to)


// --- numbers ---

let intToken(digits: String, suffix: String): Option<Result<TokenKind, IntType>> =
  let sized =
    fun(typ, minMagnitude, parsed, minValue) ->
      match parsed with
      | Some(token) -> Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok(token))
      | None ->
        if digits == minMagnitude then
          Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok(minValue))
        else
          Stdlib.Option.Option.Some(Stdlib.Result.Result.Error(typ))

  match suffix with
  | "" | "s" | "s64" ->
    sized(
      IntType.Int64,
      "9223372036854775808",
      Stdlib.Int64.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TInt64(v)),
      TokenKind.TInt64(Stdlib.Int64.minValue))
  | "u" | "u64" ->
    sized(
      IntType.UInt64,
      "",
      Stdlib.UInt64.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TUInt64(v)),
      TokenKind.TUInt64(0u64))
  | "s8" ->
    sized(
      IntType.Int8,
      "128",
      Stdlib.Int8.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TInt8(v)),
      TokenKind.TInt8(Stdlib.Int8.minValue))
  | "u8" ->
    sized(
      IntType.UInt8,
      "",
      Stdlib.UInt8.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TUInt8(v)),
      TokenKind.TUInt8(0u8))
  | "s16" ->
    sized(
      IntType.Int16,
      "32768",
      Stdlib.Int16.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TInt16(v)),
      TokenKind.TInt16(Stdlib.Int16.minValue))
  | "u16" ->
    sized(
      IntType.UInt16,
      "",
      Stdlib.UInt16.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TUInt16(v)),
      TokenKind.TUInt16(0u16))
  | "s32" ->
    sized(
      IntType.Int32,
      "2147483648",
      Stdlib.Int32.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TInt32(v)),
      TokenKind.TInt32(Stdlib.Int32.minValue))
  | "u32" ->
    sized(
      IntType.UInt32,
      "",
      Stdlib.UInt32.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TUInt32(v)),
      TokenKind.TUInt32(0u32))
  | "s128" ->
    sized(
      IntType.Int128,
      "170141183460469231731687303715884105728",
      Stdlib.Int128.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TInt128(v)),
      TokenKind.TInt128(Stdlib.Int128.minValue))
  | "u128" ->
    sized(
      IntType.UInt128,
      "",
      Stdlib.UInt128.parse(digits) |> Stdlib.Result.toOption |> Stdlib.Option.map(fun v -> TokenKind.TUInt128(v)),
      TokenKind.TUInt128(0u128))
  | "z" ->
    match Stdlib.BigInt.parse(digits) with
    | Ok(v) -> Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok(TokenKind.TBigInt(v)))
    | Error(_) -> Stdlib.Option.Option.None
  | _ -> Stdlib.Option.Option.None


/// Another language's suffix, as (the type, the Dark spelling).
let foreignSuffix(body: String, suffix: String, fraction: Bool, exponent: Bool): Option<(String * String)> =
  let some = fun(typ, dark) -> Stdlib.Option.Option.Some((typ, dark))
  if Stdlib.Bool.not(fraction) then
    match suffix with
    | "L" | "l" -> some("an Int64", body)
    | "UL" | "ul" | "uL" | "Ul" -> some("a UInt64", body + "u")
    | "y" -> some("an Int8", body + "s8")
    | "uy" -> some("a UInt8", body + "u8")
    | "us" -> some("a UInt16", body + "u16")
    | "I" -> some("a BigInt", body + "z")
    | "m" | "M" -> some("a Decimal", body + "dec")
    | _ -> Stdlib.Option.Option.None
  else
    match suffix with
    | "m" | "M" -> if exponent then Stdlib.Option.Option.None else some("a Decimal", body + "dec")
    | "f" | "F" -> some("a Float32", body + "f32")
    | _ -> Stdlib.Option.Option.None


/// The token for a number from <param i> to <param endIndex>, and its problem if any.
let numberToken(src: Source, i: Int64): (TokenKind * Int64 * Option<Problem>) =
  let digitEnd = digitsEnd(src, i + 1)
  let hasFraction =
    digitEnd + 1 < src.length && at(src, digitEnd) == cDot && isDigit(at(src, digitEnd + 1))
  let fractionEnd = if hasFraction then digitsEnd(src, digitEnd + 1) else digitEnd
  let signIndex = fractionEnd + 1
  let digitsIndex =
    if signIndex < src.length && (at(src, signIndex) == cPlus || at(src, signIndex) == cMinus) then
      signIndex + 1
    else
      signIndex
  let exponentEnd =
    if fractionEnd < src.length
       && (at(src, fractionEnd) == cLowerE || at(src, fractionEnd) == cUpperE)
       && digitsIndex < src.length
       && isDigit(at(src, digitsIndex)) then
      digitsEnd(src, digitsIndex)
    else
      fractionEnd
  let hasExponent = exponentEnd > fractionEnd
  let endIndex = scanWhile(src, exponentEnd, isIdentChar)
  let suffix = text(src, exponentEnd, endIndex)
  let body = text(src, i, exponentEnd)
  let written = body + suffix
  let isFloat = hasFraction || hasExponent
  let ok = fun kind -> (kind, endIndex, Stdlib.Option.Option.None)
  let bad = fun(kind, problem) -> (kind, endIndex, Stdlib.Option.Option.Some(problem))
  let invalid =
    fun kind -> bad(kind, Problem.InvalidNumber(written, foreignSuffix(body, suffix, isFloat, hasExponent)))
  let float64 =
    fun () ->
      match Stdlib.Float64.parse(body) with
      | Ok(_) -> ok(TokenKind.TFloat64)
      | Error(_) -> bad(TokenKind.TFloat64, Problem.MalformedFloat(written))

  match suffix with
  | "dec" ->
    if hasExponent then
      bad(TokenKind.TDecimal(0dec), Problem.DecimalWithExponent(body))
    else
      match decimalLiteral(body) with
      | Some(v) -> ok(TokenKind.TDecimal(v))
      | None -> bad(TokenKind.TDecimal(0dec), Problem.DecimalOutOfRange(body))
  | "f32" ->
    match Stdlib.Float32.parse(body) with
    | Ok(_) -> ok(TokenKind.TFloat32)
    | Error(_) -> bad(TokenKind.TFloat32, Problem.MalformedFloat(written))
  | "f64" -> float64(())
  | _ ->
    if isFloat then
      if suffix == "" then float64(()) else invalid(TokenKind.TFloat64)
    else
      match intToken(body, suffix) with
      | Some(Ok(kind)) -> ok(kind)
      | Some(Error(typ)) -> bad(TokenKind.TInt64(0), Problem.IntOutOfRange(typ, written))
      | None -> invalid(TokenKind.TInt64(0))


/// A Decimal literal's value.
let decimalLiteral(body: String): Option<Decimal> =
  Stdlib.Decimal.parse(body) |> Stdlib.Result.toOption


let minI(a: Int64, b: Int64): Int64 =
  if a < b then a else b


let maxI(a: Int64, b: Int64): Int64 =
  if a > b then a else b


// --- the lexer proper ---

type State =
  { index: Int64
    pos: Point
    tokensRev: List<Token>
    triviaRev: List<Trivia>
    doc: Option<String>
    diagnosticsRev: List<Diagnostic> }


let lex(input: String): Lexed =
  let src = source(input)
  let start =
    State
      { index = 0
        pos = Point { row = 0, column = 0 }
        tokensRev = []
        triviaRev = []
        doc = Stdlib.Option.Option.None
        diagnosticsRev = [] }

  let final = go(src, start)
  let diagnostics = Stdlib.List.reverse(final.diagnosticsRev)
  let flagged = Stdlib.List.map(diagnostics, fun d -> d.range)
  let tokens =
    if Stdlib.List.isEmpty(flagged) then
      Stdlib.List.reverse(final.tokensRev)
    else
      Stdlib.List.reverse(final.tokensRev)
      |> Stdlib.List.map(fun t ->
        if Stdlib.List.contains(flagged, t.range) then { t with lexError = true } else t)

  Lexed { tokens = tokens, diagnostics = diagnostics }


let problem(st: State, range: Range, p: Problem): State =
  { st with diagnosticsRev = [ Diagnostic { range = range, problem = p }, ...st.diagnosticsRev ] }


/// Emit a token over [st.index, <param endIndex>), taking the pending trivia and doc comment.
let emit(src: Source, st: State, kind: TokenKind, endIndex: Int64): State =
  emitEndingAt(src, st, kind, endIndex, advance(src, st.pos, st.index, endIndex))


/// `emit` for a token that can't hold a line break.
let emitInLine(src: Source, st: State, kind: TokenKind, endIndex: Int64): State =
  emitEndingAt(src, st, kind, endIndex, sameLineEnd(src, st.pos, st.index, endIndex))


let sameLineEnd(src: Source, pos: Point, from: Int64, to: Int64): Point =
  if src.astral then advance(src, pos, from, to) else Point { row = pos.row, column = pos.column + to - from }


let emitEndingAt(src: Source, st: State, kind: TokenKind, endIndex: Int64, endPos: Point): State =
  let token =
    Token
      { kind = kind
        text = text(src, st.index, endIndex)
        range = Range { start = st.pos, end_ = endPos }
        docComment = st.doc
        leadingTrivia =
          match st.triviaRev with
          | [] -> []
          | [ one ] -> [ one ]
          | many -> Builtin.listReverse(many)
        lexError = false }

  { st with
      index = endIndex
      pos = endPos
      tokensRev = [ token, ...st.tokensRev ]
      triviaRev = []
      doc = Stdlib.Option.Option.None }


/// Emit, and record <param p> at the token's range.
let emitBad(src: Source, st: State, kind: TokenKind, endIndex: Int64, p: Problem): State =
  let range = Range { start = st.pos, end_ = advance(src, st.pos, st.index, endIndex) }
  problem(emit(src, st, kind, endIndex), range, p)


let lastRange(st: State): Range =
  match st.tokensRev with
  | [ t, ... ] -> t.range
  | [] -> Range { start = st.pos, end_ = st.pos }


/// Past the spaces, tabs and line breaks from <param i>, and the position there.
let skipSpacesIn(rest: List<UInt32>, i: Int64, row: Int64, column: Int64): (Int64 * Point) =
  match rest with
  | [ c, ...tail ] ->
    if c == 10u32 then skipSpacesIn(tail, i + 1, row + 1, 0)
    else if c == 32u32 || c == 9u32 || c == 13u32 then skipSpacesIn(tail, i + 1, row, column + 1)
    else (i, Point { row = row, column = column })
  | [] -> (i, Point { row = row, column = column })


let skipTrivia(src: Source, st: State): State =
  let i = st.index
  let rest = Builtin.listDrop(src.cps, i)
  match rest with
  | [] -> st
  | [ c, ... ] ->
    if c == 32u32 || c == 9u32 || c == 13u32 || c == 10u32 then
      let (e, pos) = skipSpacesIn(rest, i, st.pos.row, st.pos.column)
      skipTrivia(src, { st with index = e, pos = pos })
    else if c == cSlash && at(src, i + 1) == cSlash then
      let e = lineEndOnRow(src, st.pos.row)
      let isDoc = at(src, i + 2) == cSlash && Stdlib.Bool.not(at(src, i + 3) == cSlash)
      let endPos = sameLineEnd(src, st.pos, i, e)
      let trivia =
        Trivia
          { kind = if isDoc then TriviaKind.DocComment else TriviaKind.LineComment
            text = text(src, i, e)
            range = Range { start = st.pos, end_ = endPos } }
      let doc =
        if isDoc then
          let raw = Stdlib.String.trimEnd(text(src, i + 3, e))
          let line = if Stdlib.String.startsWith(raw, " ") then Stdlib.String.dropFirst(raw, 1) else raw
          match st.doc with
          | Some(existing) -> Stdlib.Option.Option.Some(existing + "\n" + line)
          | None -> Stdlib.Option.Option.Some(line)
        else
          st.doc
      skipTrivia(src, { st with index = e, pos = endPos, triviaRev = [ trivia, ...st.triviaRev ], doc = doc })
    else if c == cLParen
            && at(src, i + 1) == cStar
            && Stdlib.Bool.not(at(src, i + 2) == cRParen)
            && Stdlib.Bool.not(at(src, i + 2) == cStar && at(src, i + 3) == cRParen) then
      let (e, closed) = blockCommentEnd(src, i + 2, 0)
      let endPos = advance(src, st.pos, i, e)
      let range = Range { start = st.pos, end_ = endPos }
      let trivia = Trivia { kind = TriviaKind.BlockComment, text = text(src, i, e), range = range }
      let st2 = { st with index = e, pos = endPos, triviaRev = [ trivia, ...st.triviaRev ] }
      let st3 = if closed then st2 else problem(st2, range, Problem.UnterminatedBlockComment)
      skipTrivia(src, st3)
    else
      st


/// Whether a `'` here starts a type variable rather than a char, by the token before it.
let inTypeContext(st: State): Bool =
  match st.tokensRev with
  | [ t, ... ] ->
    match t.kind with
    | TLParen | TStar | TLt | TComma | TColon | TArrow | TEquals | TOf -> true
    | _ -> false
  | [] -> false


/// The end of the grapheme starting at <param i>.
let graphemeEnd(src: Source, i: Int64): Int64 =
  // a grapheme is a base and the combining marks after it; a combining mark is neither a
  // letter, a digit nor anything printable on its own, so a base and what isn't a new base
  let rest = Stdlib.String.toList(text(src, i, minI(src.length, i + 16)))
  match rest with
  | [ first, ... ] -> i + Stdlib.List.length(Stdlib.String.toCodepoints(Stdlib.String.fromChar(first)))
  | [] -> i


let charLiteral(src: Source, st: State, from: Int64): State =
  match scanQuoted(src, from, apostrophe) with
  | Some(e) -> emit(src, st, TokenKind.TCharLit(unescape(src, from, e - 1)), e)
  | None ->
    let e = lineEnd(src, from)
    emitBad(src, st, TokenKind.TCharLit(unescape(src, from, e)), e, Problem.UnterminatedChar)


let go(src: Source, st0: State): State =
  let st = skipTrivia(src, st0)
  let i = st.index
  if i >= src.length then
    emit(src, st, TokenKind.TEOF, i)
  else
    go(src, step(src, st, i))


let step(src: Source, st: State, i: Int64): State =
  let (c, c1) =
    match Builtin.listDrop(src.cps, i) with
    | [ a, b, ... ] -> (a, b)
    | [ a ] -> (a, 0u32)
    | [] -> (0u32, 0u32)
  if c == cEquals && c1 == cGt then
    // `=>` lexes as `=` then `>`, for the parser to refuse
    emit(src, st, TokenKind.TEquals, i + 1)
  else if c == backtick then
    let close = scanWhile(src, i + 1, fun x -> x != backtick && x != nl)
    if close < src.length && at(src, close) == backtick then
      let name = text(src, i + 1, close)
      let words =
        Stdlib.String.split(name, " ")
        |> Stdlib.List.filter(fun w -> Stdlib.Bool.not(Stdlib.String.isEmpty(w)))
      if Stdlib.String.contains(name, " ") || Stdlib.String.contains(name, "\t") then
        emitBad(src, st, TokenKind.TIdent(name), close + 1, Problem.SpacedName(words))
      else
        emitInLine(src, st, TokenKind.TIdent(name), close + 1)
    else
      let e = lineEnd(src, i + 1)
      emitBad(src, st, TokenKind.TIdent(text(src, i + 1, e)), e, Problem.UnterminatedBacktick)
  else if isLetter(c) || c == underscore then
    let e = identEnd(src, i + 1)
    let word = text(src, i, e)
    let kind =
      keywordKind(word)
    emitInLine(src, st, kind, e)
  else if isDigit(c) then
    let (kind, e, p) = numberToken(src, i)
    match p with
    | Some(p) -> emitBad(src, st, kind, e, p)
    | None -> emitInLine(src, st, kind, e)
  else if c == quote && isTripleQuote(src, i) then
    match findTripleQuote(src, i + 3) with
    | Some(e) -> emit(src, st, TokenKind.TStringLit(text(src, i + 3, e - 3)), e)
    | None ->
      emitBad(
        src,
        st,
        TokenKind.TStringLit(text(src, i + 3, src.length)),
        src.length,
        Problem.UnterminatedTripleQuotedString)
  else if c == quote then
    match scanQuoted(src, i + 1, quote) with
    | Some(e) -> emit(src, st, TokenKind.TStringLit(unescape(src, i + 1, e - 1)), e)
    | None ->
      let e = lineEnd(src, i + 1)
      emitBad(src, st, TokenKind.TStringLit(unescape(src, i + 1, e)), e, Problem.UnterminatedString)
  else if c == apostrophe then
    if inTypeContext(st) && i + 1 < src.length && (isLetter(c1) || c1 == underscore) then
      let varEnd = scanWhile(src, i + 1, isTypeVarChar)
      let gEnd = graphemeEnd(src, i + 1)
      if (varEnd < src.length && at(src, varEnd) == apostrophe)
         || (gEnd < src.length && at(src, gEnd) == apostrophe) then
        charLiteral(src, st, i + 1)
      else
        emitInLine(src, st, TokenKind.TIdent(text(src, i + 1, varEnd)), varEnd)
    else if i + 1 < src.length && c1 == backslash then
      charLiteral(src, st, i + 1)
    else
      let contentEnd = if i + 1 < src.length then graphemeEnd(src, i + 1) else i + 1
      if contentEnd < src.length && at(src, contentEnd) == apostrophe then
        emit(src, st, TokenKind.TCharLit(unescape(src, i + 1, contentEnd)), contentEnd + 1)
      else
        let e = minI(src.length, maxI(i + 1, contentEnd))
        emitBad(src, st, TokenKind.TCharLit(unescape(src, i + 1, e)), e, Problem.UnterminatedChar)
  else if c == cDollar && c1 == quote then
    match interpEnd(src, i) with
    | Some(e) -> emit(src, st, TokenKind.TInterpString, e)
    | None ->
      let e = lineEnd(src, i + 2)
      let line = text(src, i, e)
      let p =
        match Stdlib.String.indexOf(line, "{") with
        | Some(brace) ->
          if Stdlib.String.contains(Stdlib.String.dropFirst(line, brace), "\\\"") then
            Problem.EscapedQuoteInInterpolation
          else
            Problem.UnterminatedInterpolatedString
        | None -> Problem.UnterminatedInterpolatedString
      emitBad(src, st, TokenKind.TInterpString, e, p)
  else
    let refused =
      if c == 58u32 && c1 == 58u32 then Stdlib.Option.Option.Some("::")
      else if c == 64u32 then Stdlib.Option.Option.Some("@")
      else if c == cPlus && c1 == cPlus then Stdlib.Option.Option.Some("++")
      else Stdlib.Option.Option.None
    match refused with
    | Some(s) ->
      emitBad(src, st, TokenKind.TPlus, i + Stdlib.String.length(s), Problem.RefusedOperator(s))
    | None ->
      match operatorAt(src, i, c, c1) with
      | Some((length, kind)) -> emitInLine(src, st, kind, i + length)
      | None ->
        let endPos = advance(src, st.pos, i, i + 1)
        let range = Range { start = st.pos, end_ = endPos }
        let st2 = problem(st, range, Problem.UnexpectedCharacter(text(src, i, i + 1)))
        { st2 with index = i + 1, pos = endPos }


let intTypeName(t: IntType): String =
  match t with
  | Int8 -> "Int8"
  | UInt8 -> "UInt8"
  | Int16 -> "Int16"
  | UInt16 -> "UInt16"
  | Int32 -> "Int32"
  | UInt32 -> "UInt32"
  | Int64 -> "Int64"
  | UInt64 -> "UInt64"
  | Int128 -> "Int128"
  | UInt128 -> "UInt128"


let capitalize(w: String): String =
  match Stdlib.String.head(w) with
  | Some(c) -> Stdlib.String.fromChar(Stdlib.Char.toUppercase(c)) + Stdlib.String.dropFirst(w, 1)
  | None -> w


let problemMessage(p: Problem): String =
  match p with
  | UnterminatedBlockComment -> "unterminated block comment"
  | UnterminatedString -> "unterminated string literal"
  | UnterminatedTripleQuotedString -> "unterminated triple-quoted string literal"
  | UnterminatedChar -> "unterminated char literal"
  | UnterminatedInterpolatedString -> "unterminated interpolated string"
  | EscapedQuoteInInterpolation ->
    "inside `{…}` in an interpolated string, write a string as plain \"…\", not \\\"…\\\""
  | UnterminatedBacktick -> "unterminated backtick identifier"
  | SpacedName(words) ->
    let message = "a name can't hold spaces"
    match words with
    | [] -> message
    | [ word ] -> $"{message}; use {word}"
    | [ first, ...rest ] ->
      let camel = first + Stdlib.String.join(Stdlib.List.map(rest, capitalize), "")
      $"{message}; use {Stdlib.String.join(words, "_")} or {camel}"
  | IntOutOfRange(typ, written) -> $"out of range for {intTypeName(typ)}: {written}"
  | MalformedFloat(written) -> $"malformed float literal: {written}"
  | DecimalWithExponent(body) -> $"a Decimal literal is written without an exponent: {body}dec"
  | DecimalOutOfRange(body) -> $"decimal literal out of range or past 28 digits: {body}dec"
  | InvalidNumber(written, spelling) ->
    match spelling with
    | Some((typeName, dark)) -> $"invalid number literal: {written}; {typeName} is written `{dark}`"
    | None -> $"invalid number literal: {written}"
  | RefusedOperator(op) ->
    match op with
    | "::" -> "'::' is not Dark; a list is `[head, ...tail]`"
    | "@" -> "'@' is not Dark; join lists with `[...a, ...b]`"
    | _ -> "'++' is not Dark; join Strings with `+`"
  | UnexpectedCharacter(c) -> $"unexpected character: '{c}'"


// --- literal checks, over a literal's raw inner text ---

/// Is there an invalid escape in <param src> from <param i>?
let badEscapeFrom(src: Source, i: Int64): Bool =
  match findBackslash(src, i, src.length) with
  | None -> false
  | Some(b) ->
    match decodeEscape(src, b) with
    | Some((count, _)) -> badEscapeFrom(src, b + count)
    | None -> true


let hasInvalidEscape(content: String): Bool =
  if Stdlib.String.contains(content, "\\") then badEscapeFrom(source(content), 0) else false


/// Like `badEscapeFrom` for `$"…"` text: `{{`/`}}` are literal and `{…}` is code.
let badEscapeInterpFrom(src: Source, i: Int64): Bool =
  let n = src.length
  if i >= n then false
  else if at(src, i) == cLBrace && at(src, i + 1) == cLBrace && i + 1 < n then badEscapeInterpFrom(src, i + 2)
  else if at(src, i) == cRBrace && at(src, i + 1) == cRBrace && i + 1 < n then badEscapeInterpFrom(src, i + 2)
  else if at(src, i) == cLBrace then
    match interpClose(src, i + 1, 0) with
    | Some(close) -> badEscapeInterpFrom(src, close + 1)
    | None -> false
  else if at(src, i) == backslash then
    match decodeEscape(src, i) with
    | Some((count, _)) -> badEscapeInterpFrom(src, i + count)
    | None -> true
  else
    badEscapeInterpFrom(src, i + 1)


let hasInvalidEscapeInterp(inner: String): Bool =
  badEscapeInterpFrom(source(inner), 0)


/// A single `}` in interpolated-string text, outside any `{…}`.
let singleCloseBraceFrom(src: Source, raw: Bool, i: Int64): Bool =
  let n = src.length
  if i >= n then false
  else if at(src, i) == cLBrace && at(src, i + 1) == cLBrace && i + 1 < n then singleCloseBraceFrom(src, raw, i + 2)
  else if at(src, i) == cRBrace && at(src, i + 1) == cRBrace && i + 1 < n then singleCloseBraceFrom(src, raw, i + 2)
  else if at(src, i) == cLBrace then
    match interpClose(src, i + 1, 0) with
    | Some(close) -> singleCloseBraceFrom(src, raw, close + 1)
    | None -> false
  else if at(src, i) == cRBrace then true
  else if at(src, i) == backslash && Stdlib.Bool.not(raw) && i + 1 < n then singleCloseBraceFrom(src, raw, i + 2)
  else singleCloseBraceFrom(src, raw, i + 1)


let hasSingleCloseBraceInterp(inner: String, raw: Bool): Bool =
  singleCloseBraceFrom(source(inner), raw, 0)


/// <param raw> without <param lead> at the start and <param close> at the end.
let stripDelims(raw: String, lead: String, close: String): String =
  let a = if Stdlib.String.startsWith(raw, lead) then Stdlib.String.length(lead) else 0
  let n = Stdlib.String.length(raw)
  let b = if n > a && Stdlib.String.endsWith(raw, close) then n - Stdlib.String.length(close) else n
  if b > a then Stdlib.String.slice(raw, a, b) |> Stdlib.Result.withDefault("") else ""
