/// Shared `Range`/`Point` types for source positions. Structured parsing lives
/// in the F# `LibParser`.
module Darklang.LanguageTools.Parser


// TODO: these should be UInts of some size
// (UInt8 might even be enough - how many lines are over 255chars?)
type Point = { row: Int, column: Int }

type Range = { start: Point, end_: Point }

/// What `Builtin.parserParse` parses for. `Editor` is the tooling parse: a best-effort tree
/// with diagnostics alongside. The other three validate for one kind of file, and give a tree
/// only when there's nothing to report.
type ParseMode =
  | Editor
  /// Declarations at the file root, no top-level expressions.
  | Package
  /// Declarations and top-level expressions, as `dark run` and `dark eval` take them. Named
  /// tests and `actual = expected` assertions are refused.
  | Script
  /// A test file. Its tree loses the difference between an assertion and an expression, so
  /// this mode is for validating one rather than lowering it.
  | Test
