/// `textDocument/hover` and `textDocument/definition`.
module Darklang.LanguageTools.Lsp.Hover

type Json = Stdlib.AltJson.Json


/// A doc comment's markup, as Markdown: `<param x>`, `<fn X>`, `{{Some}}` become code.
let markdownOfDoc(doc: String): String =
  let asCode = fun m ->
    match Stdlib.List.head(m.captures) with
    | Some(Some(c)) -> "`" + c.text + "`"
    | _ -> m.text

  let tagged =
    Stdlib.Regex.replaceAllWith(doc, "<(?:param|fn|type|typeParam|var|value|trait) ([^>]+)>", asCode)
    |> Stdlib.Result.withDefault(doc)

  Stdlib.Regex.replaceAllWith(tagged, "\\{\\{([^}]+)\\}\\}", asCode)
  |> Stdlib.Result.withDefault(tagged)


let locationName(loc: ProgramTypes.PackageLocation): String =
  Stdlib.String.join(Stdlib.List.flatten([ [ loc.owner ], loc.modules, [ loc.name ] ]), ".")


/// What a function does to the world, from its calls: "effect-free", or each effect and the
/// call path that reaches it.
let effectsLine(hash: ProgramTypes.Hash): String =
  let (complete, reasons) = Permissions.effectReasons(ProgramTypes.hashToString(hash))
  match reasons with
  | [] -> if complete then "**effect-free**" else "no known effects (some calls could not be resolved)"
  | _ ->
    let names =
      reasons
      |> Stdlib.List.map(fun((effect, _)) -> Permissions.effectName(effect))
      |> Stdlib.List.unique
      |> Stdlib.String.join(", ")

    let suffix = if complete then "" else " (and maybe more: some calls could not be resolved)"
    $"**effects:** {names}{suffix}"


let codeBlock(code: String): String =
  "```darklang\n" + code + "\n```"


/// The hover text for <param item>.
let describe(branchId: Uuid, item: Names.Item): String =
  match item with
  | Fn(found) ->
    let ctx = PrettyPrinter.ProgramTypes.Context.forModule(branchId, [])
    let fn = found.entity
    let params =
      fn.parameters
      |> Stdlib.List.map(fun p -> p.name + ": " + PrettyPrinter.ProgramTypes.typeReference(ctx, p.typ))
      |> Stdlib.String.join(", ")

    let signature =
      locationName(found.location) + "(" + params + "): " + PrettyPrinter.ProgramTypes.typeReference(ctx, fn.returnType)

    Stdlib.String.join(
      [ codeBlock(signature), markdownOfDoc(fn.description), effectsLine(fn.hash) ]
      |> Stdlib.List.filter(fun s -> s != ""),
      "\n\n")
  | Type(found) ->
    let ctx = PrettyPrinter.ProgramTypes.Context.forModule(branchId, Stdlib.List.prepend(found.location.modules, found.location.owner))
    let printed = PrettyPrinter.ProgramTypes.packageType(ctx, found.entity)
    Stdlib.String.join([ codeBlock(printed), markdownOfDoc(found.entity.description) ] |> Stdlib.List.filter(fun s -> s != ""), "\n\n")
  | Value(found) ->
    let ctx = PrettyPrinter.ProgramTypes.Context.forModule(branchId, Stdlib.List.prepend(found.location.modules, found.location.owner))
    let printed = PrettyPrinter.ProgramTypes.packageValue(ctx, found.entity)
    Stdlib.String.join([ codeBlock(printed), markdownOfDoc(found.entity.description) ] |> Stdlib.List.filter(fun s -> s != ""), "\n\n")


let nameRange(name: Names.NameAt): Json =
  Analysis.range(
    Parser.Range
      { start = Parser.Point { row = name.line, column = name.start }
        end_ = Parser.Point { row = name.line, column = name.end } })


let hover(ctx: NameResolver.NRContext, text: String, line: Int64, character: Int64): Json =
  match Names.at(text, line, character) with
  | None -> Json.Null
  | Some(name) ->
    match Names.resolve(ctx, name.parts) with
    | None -> Json.Null
    | Some(item) ->
      Json.Object(
        [ ("contents", Json.Object([ ("kind", Json.String("markdown")), ("value", Json.String(describe(ctx.branchId, item))) ]))
          ("range", nameRange(name)) ])


/// A store item opens as its own document (`Names.uriOf`), so a definition is its first line.
let definition(ctx: NameResolver.NRContext, text: String, line: Int64, character: Int64): Json =
  let start = Json.Object([ ("line", Json.Integer(0)), ("character", Json.Integer(0)) ])
  let at(uri: String): Json =
    Json.Object([ ("uri", Json.String(uri)), ("range", Json.Object([ ("start", start), ("end", start) ])) ])

  match Names.at(text, line, character) with
  | None -> Json.Null
  | Some(name) ->
    match Names.resolve(ctx, name.parts) with
    | Some(Fn(found)) -> at(Names.uriOf(found.location, ProgramTypes.ItemKind.Fn))
    | Some(Type(found)) -> at(Names.uriOf(found.location, ProgramTypes.ItemKind.Type))
    | Some(Value(found)) -> at(Names.uriOf(found.location, ProgramTypes.ItemKind.Value))
    | None -> Json.Null
