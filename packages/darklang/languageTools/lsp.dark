// Some of these types are general to the LSP spec, others specific to our implementation.
// TODO: written to back the old middle-man Node LSP server; migrate as that server is removed.
module Darklang.LanguageTools.LanguageServerProtocol


/// A tagging type for string properties that are actually document URIs.
type DocumentUri = String

/// A tagging type for string properties that are actually URIs
type URI = String

type Position = { line: Int; character: Int }

type Range = { start: Position; end_: Position }

/// Represents a location inside a resource, such as a line inside a text file
type Location = { uri: DocumentUri; range: Range }

// -- done with base types --
