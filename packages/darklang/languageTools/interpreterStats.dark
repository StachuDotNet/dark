/// The interpreter's performance counters: instruction count, call counts,
/// frame pushes, allocation, and (when detailed timing is on) per-builtin and
/// per-package-fn time.
///
/// Perf work reads these by hand, from a `.dark` workload or `dark eval`. Nothing in the
/// CLI surfaces them yet.
module Darklang.LanguageTools.InterpreterStats


/// How <fn resetWith> starts counting.
///
/// `detailedTiming` also records per-builtin and per-package-fn time. Off by
/// default: on some hosts reading the clock costs more than the call being
/// timed, so it's a deliberate choice for a profiling run, not something to
/// leave on.
type StatsConfig = { detailedTiming: Bool }


/// Zero the counters and start counting, as <param config> says.
let resetWith (config: StatsConfig) : Unit =
  Builtin.runtimeStatsReset config


/// Zero the counters and start counting, without detailed timing.
let reset () : Unit =
  resetWith (StatsConfig { detailedTiming = false })


/// The counters so far, as a JSON string. Every field is optional; a runtime
/// without counters answers `{}`.
let get () : String =
  Builtin.runtimeStats ()


/// The one field <fn allocatedBytes> reads out of <fn get>.
type Allocation = { allocatedBytes: Int64 }


/// Bytes this process has allocated since it started, including memory since
/// freed. Read it either side of a piece of work and subtract.
///
/// This is the number to compare two versions of the same code with: unlike
/// wall-clock time it repeats exactly, and it does not care how loaded the
/// machine is.
let allocatedBytes () : Int64 =
  match Stdlib.Json.parse<Allocation> (get ()) with
  | Ok a -> a.allocatedBytes
  | Error _ -> 0L
