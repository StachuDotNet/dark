      SyntaxSlip.ConcatOperator,
      "`a + b`",
      Safety.Apply,
      "let f(s: String): String = s ++ \"!\"",
      "let f(s: String): String = s + \"!\"") ]


let named(names: List<String>, written: String): Bool =
  let lower = Stdlib.String.toLowercase(written)
  Stdlib.List.any(names, fun n -> Stdlib.String.toLowercase(n) == lower)


/// The rows for a name that did not resolve, as written (`[Stdlib, Int64, toString]`): the ones
/// for its module first, then any module's, then the operator it names.
let forName(written: List<String>): List<Fix> =
  match Stdlib.List.reverse(written) with
  | [] -> []
  | [last, ...modules] ->
    let moduleName = Stdlib.List.head(modules) |> Stdlib.Option.map(Stdlib.String.toLowercase)
    table
    |> Stdlib.List.filter(fun fix ->
      match fix.slip with
      | Name(m, names) ->
        Option.Some(Stdlib.String.toLowercase(m)) == moduleName && named(names, last)
      | AnyModule(names) -> named(names, last)
      | Operator(names, _, _) -> named(names, last)
      | _ -> false)


/// Why <param written> does not exist, when the table says there is no such function.
let explanation(written: List<String>): Option<String> =
  forName(written)
  |> Stdlib.List.findFirst(fun fix -> fix.safety == Safety.Explain)
  |> Stdlib.Option.map(fun fix -> fix.write)


/// The operator a function name stands for, as (its trait, the trait's method, how it is
/// written): `mod` and `modulo` are `a % b`.
let operatorOf(written: String): Option<(String * String * String)> =
  table
  |> Stdlib.List.filterMap(fun fix ->
    match fix.slip with
    | Operator(names, traitName, method) when named(names, written) ->
      Option.Some((traitName, method, fix.write))
    | _ -> Option.None)
  |> Stdlib.List.head


/// The Stdlib name for a job any module's name stands for: `toString` is `Stdlib.display`.
let anyModuleName(written: String): Option<String> =
  table
  |> Stdlib.List.filterMap(fun fix ->
    match fix.slip with
    | AnyModule(names) when named(names, written) -> Option.Some(fix.write)
    | _ -> Option.None)
  |> Stdlib.List.head


/// The names search and near-name matching also read <param word> as: `size` is `length`, and
/// `toString` is `display`.
let synonyms(word: String): List<String> =
  table
  |> Stdlib.List.filterMap(fun fix ->
    match fix.slip with
    | Word(words) when named(words, word) -> Option.Some(fix.write)
    | AnyModule(names) when named(names, word) ->
      Stdlib.String.split(fix.write, ".") |> Stdlib.List.last
    | _ -> Option.None)


/// The conversion written from the other side: `UInt8.toInt64` is `Int64.fromUInt8`, and
/// `Int64.fromUInt8` is `UInt8.toInt64`. Each as (the module it is in, its name).
let conversion(modules: List<String>, written: String): Option<(List<String> * String)> =
  match Stdlib.List.reverse(modules) with
  | [] -> Option.None
  | [from, ...outerReversed] ->
    let outer = Stdlib.List.reverse(outerReversed)
    let other = fun prefix ->
      let rest = Stdlib.String.dropFirst(written, Stdlib.String.length(prefix))
      match Stdlib.String.toList(rest) with
      | [c, ...] when Stdlib.String.startsWith(written, prefix) && Stdlib.Char.isUppercase(c) ->
        Option.Some(rest)
      | _ -> Option.None

    match other("to"), other("from") with
    | Some(target), _ -> Option.Some((Stdlib.List.append(outer, target), "from" + from))
    | _, Some(source) -> Option.Some((Stdlib.List.append(outer, source), "to" + from))
    | _ -> Option.None


let forTypeMismatch(slip: TypeSlip): Option<Fix> =
  table |> Stdlib.List.findFirst(fun fix -> fix.slip == Slip.TypeMismatch(slip))


let forSyntax(slip: SyntaxSlip): Option<Fix> =
  table |> Stdlib.List.findFirst(fun fix -> fix.slip == Slip.Syntax(slip))


/// <param template> with `{0}`, `{1}` ... replaced by <param args>.
let fill(template: String, args: List<String>): String =
  args
  |> Stdlib.List.indexedMap(fun(i, arg) -> (i, arg))
  |> Stdlib.List.fold(template, fun(acc, (i, arg)) ->
    Stdlib.String.replaceAll(acc, "{" + Stdlib.display(i) + "}", arg))


/// What the checker says for <param slip>, filled with <param args>.
let typeHint(slip: TypeSlip, args: List<String>): String =
  match forTypeMismatch(slip) with
  | Some(fix) -> fill(fix.write, args)
  | None -> ""
