/// The slips code makes and the Dark form for each: a name another language uses, a function
/// name for an operator, a word search reads as another, a type mismatch the checker explains, a
/// syntax slip the parser refuses. CLI errors, search, the checker and the editor read this table.
module Darklang.LanguageTools.Fixes

/// Whether a rewrite can be made without asking.
type Safety =
  /// one candidate, with the same type and behaviour
  | Apply
  /// a choice, or a different type
  | Suggest
  /// no direct Dark form: `write` says what to do instead
  | Explain


/// A type mismatch the checker explains.
type TypeSlip =
  | NotAString
  | TupleParameters
  | ResultValue
  | OptionValue
  | AppendList
  | MixedNumbers


/// A syntax slip the parser refuses.
type SyntaxSlip =
  | Semicolon
  | DictOneTypeArgument
  | SpacedArguments
  | LambdaAnnotation
  | LongSuffix
  | CaseWithSpace
  | DictEntry
  | LetValue
  | LetRec
  | ConsOperator
  | AppendOperator
  | ConcatOperator


/// What a row recognizes. Names compare ignoring case.
type Slip =
  /// names in one module: `Char.toString`
  | Name(moduleName: String, names: List<String>)
  /// names in any module: `Int64.toString`, `Float64.toString`
  | AnyModule(names: List<String>)
  /// a function name for an operator, in a module whose type implements the trait's method
  | Operator(names: List<String>, traitName: String, method: String)
  /// words search and near-name matching read as `write`: `size` is `length`
  | Word(words: List<String>)
  | TypeMismatch(TypeSlip)
  | Syntax(SyntaxSlip)


type Fix =
  { slip: Slip
    /// the Dark form; `{0}`, `{1}` are filled in where it is shown
    write: String
    safety: Safety
    /// code with the slip, and the same code written in the Dark form: an expression for a
    /// name, operator or word, a whole declaration for a type or syntax slip
    before: String
    after: String }


let name(
  moduleName: String,
  names: List<String>,
  write: String,
  safety: Safety,
  before: String,
  after: String)
  : Fix =
  Fix
    { slip = Slip.Name(moduleName, names)
      write = write
      safety = safety
      before = before
      after = after }


let operator(
  names: List<String>,
  traitName: String,
  method: String,
  write: String,
  before: String,
  after: String)
  : Fix =
  Fix
    { slip = Slip.Operator(names, traitName, method)
      write = write
      safety = Safety.Suggest
      before = before
      after = after }


let word(words: List<String>, write: String, before: String, after: String): Fix =
  Fix
    { slip = Slip.Word(words)
      write = write
      safety = Safety.Suggest
      before = before
      after = after }


let typeMismatch(
  slip: TypeSlip,
  write: String,
  safety: Safety,
  before: String,
  after: String)
  : Fix =
  Fix
    { slip = Slip.TypeMismatch(slip)
      write = write
      safety = safety
      before = before
      after = after }


let syntax(slip: SyntaxSlip, write: String, safety: Safety, before: String, after: String): Fix =
  Fix { slip = Slip.Syntax(slip), write = write, safety = safety, before = before, after = after }


