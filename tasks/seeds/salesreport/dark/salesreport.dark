// Command line: dark run salesreport.dark SALES.csv
//
// Prints revenue by region and by month, and the best-selling product.
// Everything is in this one function; it grew that way.

let main(argv: List<String>): Int64 =
  match argv with
  | [ path ] ->
    match Stdlib.Cli.File.readText(path) with
    | Error(_) ->
      Stdlib.printErrorLine("Cannot read " + path)
      1
    | Ok(text) ->
      let lines =
        Stdlib.String.split(text, "\n")
        |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) != "")
      match lines with
      | [] ->
        Stdlib.printErrorLine(path + " is empty")
        1
      | [ _header, ...rows ] ->
        let (read, skipped, byRegion, byMonth, unitsByProduct) =
          Stdlib.List.fold(rows, (0, 0, Dict { }, Dict { }, Dict { }), fun(acc, line) ->
            let (read, skipped, byRegion, byMonth, unitsByProduct) = acc
            let read = read + 1
            // split one CSV line, honouring double quotes.
            // state 0: outside quotes, 1: inside quotes, 2: inside, just saw a quote
            let (doneFields, cur, _) =
              Stdlib.List.fold(Stdlib.String.toList(line), ([], "", 0), fun(st, ch) ->
                let (fs, cur, state) = st
                if state == 1 then
                  (if ch == '"' then (fs, cur, 2) else (fs, cur + Stdlib.String.fromChar(ch), 1))
                else if state == 2 && ch == '"' then
                  (fs, cur + "\"", 1)
                else if ch == '"' then
                  (fs, cur, 1)
                else if ch == ',' then
                  ([ ...fs, cur ], "", 0)
                else
                  (fs, cur + Stdlib.String.fromChar(ch), 0))
            let fields = Stdlib.List.map([ ...doneFields, cur ], fun f -> Stdlib.String.trim(f))
            match fields with
            | [ date, region, product, unitsS, priceS ] ->
              let allDigits(s: String): Bool =
                s != "" && Stdlib.List.all(Stdlib.String.toList(s), fun c -> Stdlib.Char.isDigit(c))
              let dateOk =
                Stdlib.String.length(date) == 10
                && Stdlib.String.charAt(date, 4) == Some('-')
                && Stdlib.String.charAt(date, 7) == Some('-')
              if !dateOk || !allDigits(unitsS) then
                (read, skipped + 1, byRegion, byMonth, unitsByProduct)
              else
                let units = Stdlib.Result.withDefault(Stdlib.Int64.parse(unitsS), 0)
                // price like 12, 12.5 or 12.50 -> cents
                let price =
                  match Stdlib.String.split(priceS, ".") with
                  | [ whole ] ->
                    if allDigits(whole) then
                      Some(Stdlib.Result.withDefault(Stdlib.Int64.parse(whole), 0) * 100)
                    else
                      None
                  | [ whole, frac ] ->
                    if allDigits(whole) && allDigits(frac) && Stdlib.String.length(frac) <= 2 then
                      Some(
                        Stdlib.Result.withDefault(Stdlib.Int64.parse(whole), 0) * 100
                        + Stdlib.Result.withDefault(Stdlib.Int64.parse(Stdlib.String.padEnd(frac, '0', 2)), 0)
                      )
                    else
                      None
                  | _ -> None
                match price with
                | None -> (read, skipped + 1, byRegion, byMonth, unitsByProduct)
                | Some(p) ->
                  let revenue = units * p
                  let month = Stdlib.String.first(date, 7)
                  let byRegion =
                    Stdlib.Dict.set(byRegion, region, Stdlib.Option.withDefault(Stdlib.Dict.get(byRegion, region), 0) + revenue)
                  let byMonth =
                    Stdlib.Dict.set(byMonth, month, Stdlib.Option.withDefault(Stdlib.Dict.get(byMonth, month), 0) + revenue)
                  let unitsByProduct =
                    Stdlib.Dict.set(
                      unitsByProduct,
                      product,
                      Stdlib.Option.withDefault(Stdlib.Dict.get(unitsByProduct, product), 0) + units
                    )
                  (read, skipped, byRegion, byMonth, unitsByProduct)
            | _ -> (read, skipped + 1, byRegion, byMonth, unitsByProduct))
        Stdlib.printLine("Rows: " + Stdlib.display(read) + " read, " + Stdlib.display(skipped) + " skipped")
        Stdlib.printLine("By region:")
        Stdlib.List.iter(Stdlib.List.sort(Stdlib.Dict.keys(byRegion)), fun region ->
          let c = Stdlib.Option.withDefault(Stdlib.Dict.get(byRegion, region), 0)
          let money = Stdlib.display(c / 100) + "." + Stdlib.String.padStart(Stdlib.display(c % 100), '0', 2)
          Stdlib.printLine("  " + Stdlib.String.padEnd(region, ' ', 10) + Stdlib.String.padStart(money, ' ', 12)))
        let best =
          Stdlib.List.fold(Stdlib.Dict.toList(unitsByProduct), None, fun(b, kv) ->
            let (name, units) = kv
            match b with
            | None -> Some((name, units))
            | Some((bName, bUnits)) ->
              if units > bUnits || (units == bUnits && name < bName) then Some((name, units)) else b)
        match best with
        | Some((name, units)) ->
          Stdlib.printLine("Top product: " + name + " (" + Stdlib.display(units) + " units)")
        | None -> Stdlib.printLine("Top product: none")
        Stdlib.printLine("By month:")
        Stdlib.List.iter(Stdlib.List.sort(Stdlib.Dict.keys(byMonth)), fun month ->
          let c = Stdlib.Option.withDefault(Stdlib.Dict.get(byMonth, month), 0)
          let money = Stdlib.display(c / 100) + "." + Stdlib.String.padStart(Stdlib.display(c % 100), '0', 2)
          Stdlib.printLine("  " + Stdlib.String.padEnd(month, ' ', 10) + Stdlib.String.padStart(money, ' ', 12)))
        0
  | _ ->
    Stdlib.printErrorLine("Usage: salesreport SALES.csv")
    2

main(args)
